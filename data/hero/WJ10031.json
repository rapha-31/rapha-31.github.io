35,54,74],"title":-1,"rank":"2","loyalty":"120","reputation":"16950","equipment":{"weapon":"WP1004902","armor":"WP1011305","helmet":"WP1022005","horse":"WP29017"},"couple":[]},{"story":{"id":"S10115","name":{"zh":"征讨南蛮","en":"Southern Campaign"},"year":"225","month":"3"},"faction":"WJ10104","city":"CS1003","noRecruit":false,"reject":null,"state":"2","role":3,"stats":[79,81,44,35,54,74],"title":-1,"rank":"2","loyalty":"120","reputation":"16950","equipment":{"weapon":"WP1004902","armor":"WP1011305","helmet":"WP1022005","horse":"WP29017"},"couple":[]},{"story":{"id":"S10915","name":{"zh":"北伐中原","en":"Northern Expedition"},"year":"227","month":"3"},"faction":"WJ10127","city":"CS1003","noRecruit":false,"reject":null,"state":"2","role":3,"stats":[79,81,44,35,54,74],"title":10,"rank":"2","loyalty":"120","reputation":"16950","equipment":{"weapon":"WP1004902","armor":"WP1011305","helmet":"WP1022005","horse":"WP29017"},"couple":[]},{"story":{"id":"S11015","name":{"zh":"再出岐山","en":"Return to Qishan"},"year":"231","month":"1"},"faction":"WJ10127","city":"CS1003","noRecruit":false,"reject":null,"state":"2","role":3,"stats":[79,81,44,35,54,74],"title":10,"rank":"2","loyalty":"120","reputation":"16950","equipment":{"weapon":"WP1004902","armor":"WP1011305","helmet":"WP1022005","horse":"WP29017"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":"WJ10127","city":"CS1003","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[79,81,44,35,54,74],"title":10,"rank":"2","loyalty":"120","reputation":"16950","equipment":{"weapon":"WP1004902","armor":"WP1011305","helmet":"WP1022005","horse":"WP29017"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1026","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[79,81,44,35,54,74],"title":-1,"rank":"2","loyalty":"120","reputation":"16950","equipment":{"weapon":"WP1004902","armor":"WP1011305","helmet":"WP1022005","horse":"WP29017"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1023","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[79,81,44,35,54,74],"title":-1,"rank":"9","loyalty":"120","reputation":"2550","equipment":{"weapon":"WP1004902","armor":"WP1011305","helmet":"WP1022005","horse":"WP29017"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10001","city":"CS1026","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[79,81,44,35,54,74],"title":-1,"rank":"9","loyalty":"120","reputation":"2550","equipment":{"weapon":"WP1004902","armor":"WP1011305","helmet":"WP1022005","horse":"WP29017"},"couple":[]}],"storyEvents":[],"biography":{"zh":"曹操的堂弟，有“军中豪右”之称。从曹操初次返乡募兵时便追随曹操，一同讨伐董卓。曹操在荥阳兵败失利时，关键之际曹洪舍身将自己的马献于曹操，使曹操成功脱险。后跟随曹操转战四方，多次抵御蜀张飞、马超、吴兰等大将的进攻，后因失守潼关险遭曹操斩首。曹丕年轻时曾向曹洪借钱，曹洪因吝啬拒绝，曹丕由此怀恨在心。黄初元年，曹丕称帝后，借曹洪的门客犯法一事，将曹洪下狱并欲处死。群臣（如卞太后、郭皇后、华歆等）纷纷求情，卞太后甚至威胁郭皇后：“若曹洪今日死，我明日便令皇帝废黜你！”最终曹丕虽免其死罪，但罢免其官职、爵位与封邑，将其贬为庶人。魏明帝曹叡即位后，出任后将军，受封乐城县侯，累拜骠骑将军。","tc":"曹操的堂弟，有“軍中豪右”之稱。從曹操初次返鄉募兵時便追隨曹操，一同討伐董卓。曹操在滎陽兵敗失利時，關鍵之際曹洪舍身將自己的馬獻于曹操，使曹操成功脫險。后跟隨曹操轉戰四方，多次抵御蜀張飛、馬超、吳蘭等大將的進攻，后因失守潼關險遭曹操斬首。曹丕年輕時曾向曹洪借錢，曹洪因吝嗇拒絕，曹丕由此懷恨在心。黃初元年，曹丕稱帝后，借曹洪的門客犯法一事，將曹洪下獄并欲處死。群臣（如卞太后、郭皇后、華歆等）紛紛求情，卞太后甚至威脅郭皇后：“若曹洪今日死，我明日便令皇帝廢黜你！”最終曹丕雖免其死罪，但罷免其官職、爵位與封邑，將其貶為庶人。魏明帝曹叡即位后，出任后將軍，受封樂城縣侯，累拜驃騎將軍。","en":"Cao Cao's cousin, known as ‘the bold and daring of the army.’ He followed Cao Cao from the very first recruitment at his hometown and joined the campaign against Dong Zhuo. When Cao Cao suffered defeat at Xingyang, Cao Hong offered his own horse to Cao Cao at a critical moment, saving his lord's life. He accompanied Cao Cao across many campaigns, repeatedly fending off Shu's Zhang Fei, Ma Chao, and Wu Lan, though he was nearly executed by Cao Cao for losing Tong Gate. In his youth, Cao Pi once asked Cao Hong for a loan, but Cao Hong's miserliness led him to refuse, causing Cao Pi to bear a grudge. In the 1st year of Huangchu, after Cao Pi proclaimed himself emperor, he seized upon a crime committed by Cao Hong's retainer to throw Cao Hong in prison and sentence him to death. Many officials (including Empress Dowager Bian, Empress Guo, and Hua Xin) pleaded for clemency. Empress Dowager Bian even threatened Empress Guo: ‘If Cao Hong dies today, tomorrow I will have the Emperor depose you!’ Cao Pi ultimately spared Cao Hong's life but stripped him of all offices, rank, and fief, reducing him to a commoner. After Emperor Cao Rui ascended the throne, Cao Hong was appointed Rear Commander, enfeoffed as Marquis of Lecheng, and eventually promoted to Horse Captain.","jp":"曹操の従弟。「軍中の豪右」と称された。曹操が初めて帰郷して募兵した時から付き従い、共に董卓を討伐した。曹操が滎陽で敗戦した際、危急の時に身を挺して自身の馬を曹操に譲り、窮地を脱出させた。その後も曹操に従い各地を転戦し、蜀の張飛、馬超、呉蘭ら大将の侵攻を幾度も防いだが、後に潼関を失陥したことで曹操に危うく斬首されかけた。曹丕が若かりし頃、曹洪に借金を申し入れたことがあったが、曹洪が吝嗇からこれを断ったため、曹丕から恨みを買っていた。黄初元年、曹丕が皇帝即位すると、曹洪の門客が法を犯した事件にかこつけて曹洪を投獄し、処刑しようとした。卞太后、郭皇后、華歆ら群臣がこぞって助命を嘆願し、卞太后に至っては郭皇后に対し「今日曹洪が死ねば、明日には皇帝に命じて其方を廃位させる！」と脅した。最終的に曹丕は死罪こそ免じたものの、官職・爵位・封邑を剥奪して庶民に落とした。魏の明帝・曹叡が即位すると後将軍に任じられ、楽城県侯に封じられ、累進して驃騎将軍となった。","kr":"조조의 사촌 동생으로, '군중호우(軍中豪右)'라 불렸다. 조조가 처음 고향으로 돌아가 군사를 모을 때부터 줄곧 그를 따르며 함께 동탁을 토벌했다. 조조가 형양에서 패퇴했을 때, 위급한 순간에 조홍이 자신의 말을 조조에게 내어준 덕분에 조조는 무사히 위기를 벗어날 수 있었다. 이후 조조를 따라 사방을 전전하며 촉의 장비, 마초, 오란 등 맹장들의 진격을 누차 저지했으나, 훗날 동관을 지켜내지 못해 조조에게 참수당할 뻔하기도 했다. 조비가 젊은 시절 조홍에게 돈을 빌리려 했을 때 조홍이 인색하게 굴며 거절하자 조비는 이를 깊이 원망했다. 황초 원년, 조비가 칭제한 후 조홍의 식객이 법을 어긴 일을 구실 삼아 조홍을 투옥하고 처형하려 했다. 변태후, 곽황후, 화흠 등 여러 신하가 앞다투어 구명을 청하였고, 변태후는 곽황후를 향해 '조홍이 오늘 죽는다면 내일 황제에게 명하여 너를 폐위할 것이다!'라고 위협하기까지 했다. 결국 조비는 사형은 면해 주었으나 관직과 작위, 봉읍을 모두 박탈하고 서인으로 강등시켰다. 위 명제 조예가 즉위한 후 후장군에 기용되고 낙성현후에 봉해졌으며, 누차 승진하여 표기장군에 이르렀다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10031","remark":"","surname":"曹","surnameTc":"曹","surnameEn":"Cao","surnameJp":"曹","surnameKr":"조","surnameOther":"","name":"洪","nameTc":"洪","nameEn":"Hong","nameJp":"洪","nameKr":"홍","nameOther":"","word":"子廉","wordTc":"子廉","wordEn":"Zilian","wordJp":"子廉","wordKr":"자염","wordOther":"","icon":"曹洪","power":"WJ10001","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"2","workYear":"189","city":"CS1023","gender":"0","rule":"79","force":"81","wise":"44","politics":"35","charm":"54","will":"74","ruleTalent":"10","forceTalent":"11","wiseTalent":"3","politicsTalent":"2","charmTalent":"5","willTalent":"8","weaponMaster":"30/30/30/78/30/13/50/30","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"1000202;1004302","battleSkill":"1003702;1002102","debateCard":"","warSoul":"S1002605","battleSoul":"1011905","debateSoul":"","warSoulPoint":"6200","battleSoulPoint":"7500","debateSoulPoint":"1900","strategy":"1008015;1009915","strategy2":"1000705;1000105","professions":"3/4/3/0/0/0/3/2/0/0/5/3/3/0/4/0/1/2/0/1/0/2/2/0","attribute2":"50/50/50/50/50/50","morality":"4","compatible":"16","loyalty":"120","reputation":"2550","evaluate":"-800","title":"","rank":"9","birth":"169","show":"184","death":"232","age":"0","injury":"","deathReason":"0","type":"1","npcTag":"0","npcNum":"1","microScene":"0","isImportant":"0","speaking":"3","weapon":"WP1004902","armor":"WP1011305","helmet":"WP1022005","treasure":"","horse":"WP29017","shield":"","character":"0/1;1/1;7/1;12/2;28/2;33/1;38/1;10/0;46/3;30/1;5/2","father":"","mother":"","children":"WJ1014002/100","family":"","modInfo":"","brother":"","couple":"","otherRelationship":"WJ10001/8;WJ10036/8;WJ10034/7;WJ10035/7","belief":"0","isVIP":"1","startVIPYear":"184","endVIPYear":"191","description":"曹操的堂弟，有“军中豪右”之称。从曹操初次返乡募兵时便追随曹操，一同讨伐董卓。曹操在荥阳兵败失利时，关键之际曹洪舍身将自己的马献于曹操，使曹操成功脱险。后跟随曹操转战四方，多次抵御蜀张飞、马超、吴兰等大将的进攻，后因失守潼关险遭曹操斩首。曹丕年轻时曾向曹洪借钱，曹洪因吝啬拒绝，曹丕由此怀恨在心。黄初元年，曹丕称帝后，借曹洪的门客犯法一事，将曹洪下狱并欲处死。群臣（如卞太后、郭皇后、华歆等）纷纷求情，卞太后甚至威胁郭皇后：“若曹洪今日死，我明日便令皇帝废黜你！”最终曹丕虽免其死罪，但罢免其官职、爵位与封邑，将其贬为庶人。魏明帝曹叡即位后，出任后将军，受封乐城县侯，累拜骠骑将军。","descriptionTc":"曹操的堂弟，有“軍中豪右”之稱。從曹操初次返鄉募兵時便追隨曹操，一同討伐董卓。曹操在滎陽兵敗失利時，關鍵之際曹洪舍身將自己的馬獻于曹操，使曹操成功脫險。后跟隨曹操轉戰四方，多次抵御蜀張飛、馬超、吳蘭等大將的進攻，后因失守潼關險遭曹操斬首。曹丕年輕時曾向曹洪借錢，曹洪因吝嗇拒絕，曹丕由此懷恨在心。黃初元年，曹丕稱帝后，借曹洪的門客犯法一事，將曹洪下獄并欲處死。群臣（如卞太后、郭皇后、華歆等）紛紛求情，卞太后甚至威脅郭皇后：“若曹洪今日死，我明日便令皇帝廢黜你！”最終曹丕雖免其死罪，但罷免其官職、爵位與封邑，將其貶為庶人。魏明帝曹叡即位后，出任后將軍，受封樂城縣侯，累拜驃騎將軍。","descriptionEn":"Cao Cao's cousin, known as ‘the bold and daring of the army.’ He followed Cao Cao from the very first recruitment at his hometown and joined the campaign against Dong Zhuo. When Cao Cao suffered defeat at Xingyang, Cao Hong offered his own horse to Cao Cao at a critical moment, saving his lord's life. He accompanied Cao Cao across many campaigns, repeatedly fending off Shu's Zhang Fei, Ma Chao, and Wu Lan, though he was nearly executed by Cao Cao for losing Tong Gate. In his youth, Cao Pi once asked Cao Hong for a loan, but Cao Hong's miserliness led him to refuse, causing Cao Pi to bear a grudge. In the 1st year of Huangchu, after Cao Pi proclaimed himself emperor, he seized upon a crime committed by Cao Hong's retainer to throw Cao Hong in prison and sentence him to death. Many officials (including Empress Dowager Bian, Empress Guo, and Hua Xin) pleaded for clemency. Empress Dowager Bian even threatened Empress Guo: ‘If Cao Hong dies today, tomorrow I will have the Emperor depose you!’ Cao Pi ultimately spared Cao Hong's life but stripped him of all offices, rank, and fief, reducing him to a commoner. After Emperor Cao Rui ascended the throne, Cao Hong was appointed Rear Commander, enfeoffed as Marquis of Lecheng, and eventually promoted to Horse Captain.","descriptionJp":"曹操の従弟。「軍中の豪右」と称された。曹操が初めて帰郷して募兵した時から付き従い、共に董卓を討伐した。曹操が滎陽で敗戦した際、危急の時に身を挺して自身の馬を曹操に譲り、窮地を脱出させた。その後も曹操に従い各地を転戦し、蜀の張飛、馬超、呉蘭ら大将の侵攻を幾度も防いだが、後に潼関を失陥したことで曹操に危うく斬首されかけた。曹丕が若かりし頃、曹洪に借金を申し入れたことがあったが、曹洪が吝嗇からこれを断ったため、曹丕から恨みを買っていた。黄初元年、曹丕が皇帝即位すると、曹洪の門客が法を犯した事件にかこつけて曹洪を投獄し、処刑しようとした。卞太后、郭皇后、華歆ら群臣がこぞって助命を嘆願し、卞太后に至っては郭皇后に対し「今日曹洪が死ねば、明日には皇帝に命じて其方を廃位させる！」と脅した。最終的に曹丕は死罪こそ免じたものの、官職・爵位・封邑を剥奪して庶民に落とした。魏の明帝・曹叡が即位すると後将軍に任じられ、楽城県侯に封じられ、累進して驃騎将軍となった。","descriptionKr":"조조의 사촌 동생으로, '군중호우(軍中豪右)'라 불렸다. 조조가 처음 고향으로 돌아가 군사를 모을 때부터 줄곧 그를 따르며 함께 동탁을 토벌했다. 조조가 형양에서 패퇴했을 때, 위급한 순간에 조홍이 자신의 말을 조조에게 내어준 덕분에 조조는 무사히 위기를 벗어날 수 있었다. 이후 조조를 따라 사방을 전전하며 촉의 장비, 마초, 오란 등 맹장들의 진격을 누차 저지했으나, 훗날 동관을 지켜내지 못해 조조에게 참수당할 뻔하기도 했다. 조비가 젊은 시절 조홍에게 돈을 빌리려 했을 때 조홍이 인색하게 굴며 거절하자 조비는 이를 깊이 원망했다. 황초 원년, 조비가 칭제한 후 조홍의 식객이 법을 어긴 일을 구실 삼아 조홍을 투옥하고 처형하려 했다. 변태후, 곽황후, 화흠 등 여러 신하가 앞다투어 구명을 청하였고, 변태후는 곽황후를 향해 '조홍이 오늘 죽는다면 내일 황제에게 명하여 너를 폐위할 것이다!'라고 위협하기까지 했다. 결국 조비는 사형은 면해 주었으나 관직과 작위, 봉읍을 모두 박탈하고 서인으로 강등시켰다. 위 명제 조예가 즉위한 후 후장군에 기용되고 낙성현후에 봉해졌으며, 누차 승진하여 표기장군에 이르렀다.","descriptionOther":"","noRecommendType":"0","noRecommendYear":"999","noRecommendReson":"","noRecommendResonTc":"","noRecommendResonEn":"","noRecommendResonJp":"","noRecommendResonKr":"","noRecommendResonOther":"","aiMarriageAge":"25","startPregnantAge":"0","toneJp":"1","isSpecialTone":"0"}}