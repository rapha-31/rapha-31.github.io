description2":{"zh":"挥动兵器展开噬气架势，本回合内的造成的伤害将会有一部分转化为自身真气。","en":"Brandish your weapon to enter a Qi-draining stance, a portion of damage dealt this turn is converted into Qi."},"ap":"2"},{"id":"1009202","name":{"zh":"玉女穿梭","en":"Jade Maiden Shuttle"},"level":"2","description2":{"zh":"在指定范围内移动，并为自身添加闪避状态。","en":"Move within the designated range and gain Evasion status."},"ap":"1"}],"debateCards":[],"warSouls":[{"id":"S1001405","name":{"zh":"破坏[大]","en":"Havoc [Great]"},"level":"1","description2":{"zh":"破坏提高33%","en":"Destruction increased by 33%"}},{"id":"S1000302","name":{"zh":"恢复[大]","en":"Recovery [Great]"},"level":"1","description2":{"zh":"部队在非交战状态时, 每秒恢复2%的伤兵","en":"When not in combat, recovers 2% of wounded troops per second"}}],"battleSouls":[{"id":"1008905","name":{"zh":"徐如林","en":"Gentle as the Forest"},"level":"2","description2":{"zh":"每回合开始时获得【徐如林】牌，使用后获得【徐如林】状态，（反击率提升50%，并在反击时拆除目标一张手牌，自身速度降低50%，持续两回合，回合结束时消除）。","en":"At the start of each turn, gain a 【Gentle as the Forest】 card. On use, gain the 【Gentle as the Forest】 status (Counter +50%, discard 1 card from the target's Hand on counter, own Speed -50%, lasts 2 turns, removed at turn end)."}}],"debateSouls":[],"soulPoints":{"war":8000,"battle":6500,"debate":4900},"equipment":[{"id":"WP1006302","name":{"zh":"寒星枪","en":"Cold Star Spear"},"level":"2","description":{"zh":"改良版的透甲枪，由于锻造材料难寻，故价格不菲。","en":"An improved armor-piercing spear, rare forging materials make it quite costly."},"atkVal":"11","mp":"200","price":"8800","slot":{"zh":"武器","en":"Weapon"}},{"id":"WP1031405","name":{"zh":"先锋袍·乙","en":"Vanguard Robe - II"},"level":"2","description":{"zh":"与武裙十分类似，不过多了一些护甲，增加了冲锋陷阵的存活率。","en":"Similar to a battle skirt, but with added armor, improving survivability when charging enemy lines."},"defenceVal":"8","hp":"600","price":"9000","slot":{"zh":"护甲","en":"Armor"}},{"id":"WP1012802","name":{"zh":"金翼钗","en":"Gold-Wing Clasp"},"level":"2","description":{"zh":"带有精心雕刻的金饰，在皇亲国戚中尤为流行。","en":"Featuring intricately carved gold decorations, especially popular among the imperial family."},"mp":"970","evade":"10","price":"7000","slot":{"zh":"头盔","en":"Helmet"}}],"family":{"father":{"label":{"zh":"父亲","en":"Father"},"people":[{"id":"WJ10013","code":"0"}]},"mother":{"label":{"zh":"母亲","en":"Mother"},"people":[{"id":"WJ10105","code":"0"}]},"couple":{"label":{"zh":"配偶","en":"Spouse"},"people":[{"id":"WJ10128","code":"100"}]},"family":{"label":{"zh":"亲属","en":"Relatives"},"people":[{"id":"WJ10661","code":"100"},{"id":"WJ10121","code":"100"}]}},"clans":[{"id":"GI111615","name":{"zh":"涿郡张氏","en":"The Zhang Clan of Zhuo Commandery"},"years":["209","999"],"desc":{"zh":"出自姬姓，黄帝之后。张飞世居涿郡，刘备称帝后进封西乡侯，家族显赫。蜀汉核心将门、外戚。张飞为“万人敌”，蜀汉元勋；两女为刘禅皇后；子张绍袭爵，孙张遵尽忠死节。","en":"Originating from the Ji surname, descendants of the Yellow Emperor. Zhang Fei's Family resided in Zhuo Commandery for generations. After Liu Bei proclaimed Emperor, Zhang Fei was promoted and enfeoffed as Marquis of Xixiang, elevating his Family to great prominence. A core military lineage and imperial in-laws of Shu Han. Renowned as a ‘match for ten thousand men,’ Zhang Fei was a founding pillar of Shu Han, his two daughters both served as Empresses to Liu Shan, his son Zhang Shao inherited his title, and his grandson Zhang Zun died a martyr in steadfast loyalty."},"talent":{"military":"8","commerce":"4","politics":"5"}}],"friendGroups":[],"body":null,"honorifics":[],"selfAddress":[[["WJ10228","妾身"],["WJ10228","妾身"],["WJ10228","This humble woman"],["WJ10228","わらわ"],["WJ10228","소첩"]]],"specialNames":[[["WJ10228","WJ10012","伯父"],["WJ10228","WJ10012","伯父"],["WJ10228","WJ10012","Elder Uncle"],["WJ10228","WJ10012","伯父上"],["WJ10228","WJ10012","백부"]]],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"35","startPregnantAge":"35"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":null,"city":"CS1064","noRecruit":false,"reject":null,"state":"0","role":0,"stats"