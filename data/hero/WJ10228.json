28"]},{"story":{"id":"S10915","name":{"zh":"北伐中原","en":"Northern Expedition"},"year":"227","month":"3"},"faction":"WJ10128","city":"CS1064","noRecruit":false,"reject":null,"state":"2","role":3,"stats":[80,83,70,25,86,79],"title":-1,"rank":"5","loyalty":"120","reputation":"0","equipment":{"weapon":"WP1006302","armor":"WP1031405","helmet":"WP1012802"},"couple":["WJ10128"]},{"story":{"id":"S11015","name":{"zh":"再出岐山","en":"Return to Qishan"},"year":"231","month":"1"},"faction":"WJ10128","city":"CS1064","noRecruit":false,"reject":null,"state":"2","role":3,"stats":[80,83,70,25,86,79],"title":-1,"rank":"5","loyalty":"120","reputation":"0","equipment":{"weapon":"WP1006302","armor":"WP1031405","helmet":"WP1012802"},"couple":["WJ10128"]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":"WJ10128","city":"CS1064","noRecruit":false,"reject":null,"state":"2","role":3,"stats":[80,83,70,25,86,79],"title":-1,"rank":"5","loyalty":"120","reputation":"0","equipment":{"weapon":"WP1006302","armor":"WP1031405","helmet":"WP1012802"},"couple":["WJ10128"]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ10128","city":"CS1005","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[80,83,70,25,86,79],"title":-1,"rank":"5","loyalty":"120","reputation":"0","equipment":{"weapon":"WP1006302","armor":"WP1031405","helmet":"WP1012802"},"couple":["WJ10128"]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1064","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[80,83,70,25,86,79],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1006302","armor":"WP1031405","helmet":"WP1012802"},"couple":["WJ10128"]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10011","city":"CS1005","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[80,83,70,25,86,79],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1006302","armor":"WP1031405","helmet":"WP1012802"},"couple":["WJ10128"]}],"storyEvents":[],"biography":{"zh":"张飞与夏侯氏所生长女，张苞、张绍之妹，刘禅之妻。温婉贤淑，武艺高强。章武元年，作为太子刘禅的妃子入宫，刘禅登基后因诸葛亮等人的建议，将年仅十七的张氏封为皇后。作为刘禅的皇后，在后宫中默默支持刘禅，处理后宫事务，展现出女性的细腻与智慧；同时英勇无畏，像花木兰（虽然当时还没有花木兰）一样跟随父亲张飞南征北战，在沙场上冲锋陷阵，为蜀汉江山立下赫赫战功。建兴十五年逝世，谥号敬哀皇后，死后葬于南陵。其妹继之成为刘禅皇后。","tc":"張飛與夏侯氏所生長女，張苞、張紹之妹，劉禪之妻。溫婉賢淑，武藝高強。章武元年，作為太子劉禪的妃子入宮，劉禪登基后因諸葛亮等人的建議，將年僅十七的張氏封為皇后。作為劉禪的皇后，在后宮中默默支持劉禪，處理后宮事務，展現出女性的細膩與智慧；同時英勇無畏，像花木蘭（雖然當時還沒有花木蘭）一樣跟隨父親張飛南征北戰，在沙場上沖鋒陷陣，為蜀漢江山立下赫赫戰功。建興十五年逝世，謚號敬哀皇后，死后葬于南陵。其妹繼之成為劉禪皇后。","en":"Eldest daughter of Zhang Fei and Lady Xiahou, younger sister of Zhang Bao and Zhang Shao, and wife of Liu Shan. Graceful and virtuous yet skilled in martial arts. In the first year of Zhangwu (221), she entered the palace as consort to Crown Prince Liu Shan. After Liu Shan's ascension, on the counsel of Zhuge Liang and others, the seventeen-year-old Lady Zhang was made Empress. As Empress, she quietly supported Liu Shan from within the inner palace, managing court affairs with feminine grace and wisdom. She was also fearless in battle, accompanying her father Zhang Fei on campaigns and charging into the fray like Hua Mulan (though Hua Mulan did not yet exist at the time), earning great merit for Shu-Han. She passed away in the fifteenth year of Jianxing (237) and was posthumously titled Empress Jing'ai, buried at Nanling. Her younger sister later became Liu Shan's next Empress.","jp":"張飛と夏侯氏の間に生まれた長女。張苞、張紹の妹であり、劉禅の妻。温厚で淑やかでありながら武芸にも秀でていた。章武元年、皇太子・劉禅の妃として入宮。劉禅の即位後、諸葛亮らの進言により、わずか十七歳にして皇后に立てられた。劉禅の皇后として後宮で彼を陰ながら支え、後宮の差配を取り仕切るなど女性ならではの細やかさと知恵を発揮する一方で、勇猛果敢でもあり、花木蘭（当時はまだ存在しないが）のごとく父・張飛に従って南征北戦し、戦場では先陣を切って敵陣へ突撃し、蜀漢の社稷のために赫々たる戦功を立てた。建興十五年に逝去し、敬哀皇后と諡され、南陵に葬られた。のちにその妹が劉禅の皇后を継いだ。","kr":"장비와 하후씨 사이에서 태어난 장녀이자 장포와 장소의 여동생이며, 유선의 아내이다. 온화하고 현숙한 성품에 무예 또한 뛰어났다. 장무 원년, 태자 유선의 태자비로 입궁하였고, 유선이 즉위한 뒤 제갈량 등의 건의로 불과 열일곱의 나이에 황후로 책봉되었다. 유선의 황후로서 묵묵히 내조하며 후궁의 대소사를 도맡아 처리해 여인의 섬세함과 지혜를 드러냈다. 동시에 용맹무쌍하여, 마치 화목란(비록 당시에는 화목란이 없었으나)처럼 아버지 장비를 따라 남정북벌하며 전장에서 앞장서 적진으로 돌격해 촉한의 사직을 위해 혁혁한 전공을 세웠다. 건흥 15년에 세상을 떠나 시호로 '경애황후'를 받았으며, 사후 남릉에 안장되었다. 이후 여동생 또한 뒤를 이어 유선의 황후가 되었다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10228","remark":"","surname":"张","surnameTc":"張","surnameEn":"Zhang","surnameJp":"張","surnameKr":"장","surnameOther":"","name":"星采","nameTc":"星采","nameEn":"Xingcai","nameJp":"星采","nameKr":"성채","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"张星采","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"0","workYear":"221","city":"CS1064","gender":"1","rule":"80","force":"83","wise":"70","politics":"25","charm":"86","will":"79","ruleTalent":"9","forceTalent":"6","wiseTalent":"6","politicsTalent":"4","charmTalent":"9","willTalent":"7","weaponMaster":"80/20/20/20/20/10/54/20","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"","battleSkill":"1005100;1008502;1005202;1009202","debateCard":"","warSoul":"S1001405;S1000302","battleSoul":"1008905","debateSoul":"","warSoulPoint":"8000","battleSoulPoint":"6500","debateSoulPoint":"4900","strategy":"1007215","strategy2":"1015701","professions":"0/4/0/0/0/0/2/4/3/1/4/0/0/4/1/3/1/0/0/0/3/0/3/0","attribute2":"82/88/78/45/86/80","morality":"5","compatible":"50","loyalty":"0","reputation":"0","evaluate":"7000","title":"","rank":"9","birth":"207","show":"219","death":"237","age":"0","injury":"","deathReason":"0","type":"1","npcTag":"0","npcNum":"1","microScene":"0","isImportant":"0","speaking":"4","weapon":"WP1006302","armor":"WP1031405","helmet":"WP1012802","treasure":"","horse":"","shield":"","character":"0/1;2/1;10/1;12/1;20/1;27/1;31/1;41/1;61/2;30/1;66/0;47/0","father":"WJ10013/0","mother":"WJ10105/0","childre