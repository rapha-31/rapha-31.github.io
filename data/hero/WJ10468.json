d":"WJ10002","code":"0"}]}},"clans":[{"id":"GI108515","name":{"zh":"谯郡许氏","en":"The Xu clan of Qiaojun"},"years":["0","263"],"desc":{"zh":"出自姜姓，许国之后。谯郡许氏为曹魏核心武人家族，许褚以勇力绝人闻名。曹魏武人家族。许褚聚宗族数千家投曹，为曹操宿卫统领二十余年，世称“虎痴”，与典韦并称曹营猛将。其兄许定亦以军功封侯。为曹魏禁军核心力量。","en":"Descended from the Jiang surname, successors to the State of Xu. The Xu clan of Qiao Commandery was a core military Family of Cao Wei, with Xu Chu renowned for his peerless might. A military Family of Cao Wei, Xu Chu rallied thousands of his clan's households to join Cao Cao and served as commander of his personal guard for over twenty years, known to the world as ‘Tiger Fool’ and hailed alongside Dian Wei as the fiercest warriors in Cao Cao's camp. His elder brother Xu Ding was also enfeoffed as a marquis for his military merits, serving as the core strength of Cao Wei's imperial guard."},"talent":{"military":"6","commerce":"3","politics":"1"}}],"friendGroups":[],"body":null,"honorifics":[],"selfAddress":[],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"25","startPregnantAge":"0"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":null,"city":"CS1016","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[48,67,20,21,47,49],"title":-1,"rank":"9","loyalty":"0","reputation":"600","equipment":{"weapon":"WP12013","armor":"WP1006705","helmet":"WP1023805"},"couple":[]},{"story":{"id":"S10215","name":{"zh":"汉末三杰","en":"Three Heroes of the Late Han"},"year":"185","month":"3"},"faction":null,"city":"CS1016","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[48,67,20,21,47,49],"title":-1,"rank":"9","loyalty":"0","reputation":"600","equipment":{"weapon":"WP12013","armor":"WP1006705","helmet":"WP1023805"},"couple":[]},{"story":{"id":"S10615","name":{"zh":"十常侍之乱","en":"Turmoil of the Ten Attendants"},"year":"188","month":"11"},"faction":null,"city":"CS1016","noRecruit":false,"reject":null,"state":"0","role