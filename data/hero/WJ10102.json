5"}}],"friendGroups":[],"body":null,"honorifics":[],"selfAddress":[[["WJ10102","妾身"],["WJ10102","妾身"],["WJ10102","this humble woman"],["WJ10102","妾"],["WJ10102","소첩"]]],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"33","startPregnantAge":"35"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":null,"city":"CS1054","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[47,30,74,72,87,62],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1008702","armor":"WP1030905","helmet":"WP1012502"},"couple":[]},{"story":{"id":"S10215","name":{"zh":"汉末三杰","en":"Three Heroes of the Late Han"},"year":"185","month":"3"},"faction":null,"city":"CS1054","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[47,30,74,72,87,62],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1008702","armor":"WP1030905","helmet":"WP1012502"},"couple":[]},{"story":{"id":"S10615","name":{"zh":"十常侍之乱","en":"Turmoil of the Ten Attendants"},"year":"188","month":"11"},"faction":null,"city":"CS1054","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[47,30,74,72,87,62],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1008702","armor":"WP1030905","helmet":"WP1012502"},"couple":[]},{"story":{"id":"S10402","name":{"zh":"诸侯讨董","en":"Coalition Against Dong Zhuo"},"year":"190","month":"3"},"faction":null,"city":"CS1054","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[47,30,74,72,87,62],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1008702","armor":"WP1030905","helmet":"WP1012502"},"couple":[]},{"story":{"id":"S10208","name":{"zh":"幽燕龙兴","en":"Dragon Rises in Youyan"},"year":"191","month":"3"},"faction":null,"city":"CS1054","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[47,30,74,72,87,62],"title":-1,"rank":"9","loyalty":"0","reputation":"