:"护甲","en":"Armor"}},{"id":"WP1023405","name":{"zh":"沿帻铁胄","en":"Veiled Iron Helm"},"level":"0","description":{"zh":"在铁盔下沿缝制了巾帻，用于抵挡风沙，多为游牧民族的战士佩戴。","en":"An iron helm with cloth sewn along the lower brim to block wind and sand, commonly worn by nomadic warriors."},"defenceVal":"2","price":"800","slot":{"zh":"头盔","en":"Helmet"}}],"family":{"father":{"label":{"zh":"父亲","en":"Father"},"people":[{"id":"WJ1010502","code":"0"}]},"children":{"label":{"zh":"子女","en":"Children"},"people":[{"id":"WJ1050515","code":"100"},{"id":"WJ1051015","code":"100"}]},"family":{"label":{"zh":"亲属","en":"Relatives"},"people":[{"id":"WJ1010702","code":"100"},{"id":"WJ1001008","code":"100"}]}},"clans":[{"id":"GI110215","name":{"zh":"百济扶余氏","en":"The Buyeo Clan of Baekje"},"years":["0","999"],"desc":{"zh":"出自扶余，始祖温祚为高句丽始祖朱蒙之子，南迁立国，以扶余为氏。朝鲜半岛西南强国，与高句丽、新罗鼎足。与辽东公孙氏联姻，立国六百七十八年，传三十一世。","en":"Originating from Buyeo, their founding ancestor Onjo was the son of Jumong, the founder of Goguryeo, migrating south to establish a kingdom, he took Buyeo as his surname. A formidable power in the southwest of the Korean Peninsula, it stood as a tripartite power alongside Goguryeo and Silla. Forging marital alliances with the Gongsun clan of Liaodong, the kingdom endured for 678 years across 31 generations."},"talent":{"military":"8","commerce":"4","politics":"6"}}],"friendGroups":[],"body":null,"honorifics":[],"selfAddress":[],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"25","startPregnantAge":"0"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":"WJ1010502","city":"CS1068","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[79,81,55,61,64,77],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP10017","armor":"WP1005905","helmet":"WP1023405"},"couple":[]},{"story":{"id":"S10215","name":{"zh":"汉末三杰","en":"Three Heroes of the Late Han"},"year":"185","month":"3"