made of slightly finer fabric adorned with patterns, with simple trim along the edges as well."},"defenceVal":"5","mp":"600","price":"3600","slot":{"zh":"护甲","en":"Armor"}},{"id":"WP1025405","name":{"zh":"高山冠","en":"Gaoshan Crown"},"level":"1","description":{"zh":"朝中官员最常见的冠帽之一，多在诸侯朝服时佩戴。","en":"One of the most common court caps, typically worn by lords in court attire."},"defenceVal":"4","mp":"860","price":"4200","slot":{"zh":"头盔","en":"Helmet"}}],"family":{"children":{"label":{"zh":"子女","en":"Children"},"people":[{"id":"WJ10419","code":"100"}]}},"clans":[{"id":"GI106315","name":{"zh":"东海王氏","en":"The Wang clan of Donghai"},"years":["0","999"],"desc":{"zh":"出自姬姓，周灵王太子晋之后。与琅琊王氏同源而异支。王朗为曹魏司徒，王肃为经学大师，孙女王元姬为司马昭之妻、司马炎之母，西晋皇太后。","en":"Originating from the Ji surname, descendants of Crown Prince Jin of King Ling of Zhou. Sharing common roots with the Wang clan of Langya but forming a separate branch. Wang Lang served as Minister of Education for Cao Wei, and Wang Su was a master of the Confucian Classics. His granddaughter Wang Yuanji was the wife of Sima Zhao, mother of Sima Yan, and Empress Dowager of Western Jin."},"talent":{"military":"2","commerce":"3","politics":"7"}}],"friendGroups":[{"story":"S10702","members":["WJ10104","WJ10009","WJ10054","WJ10082","WJ10083","WJ10380","WJ10112","WJ10010","WJ10177","WJ10274","WJ10577","WJ10087","WJ10005","WJ10189","WJ10415","WJ10204"]},{"story":"S10115","members":["WJ10104","WJ10380","WJ10112","WJ10010","WJ10177","WJ10274","WJ10577","WJ10005","WJ10189","WJ10415","WJ10204"]},{"story":"S10915","members":["WJ10104","WJ10380","WJ10112","WJ10010","WJ10177","WJ10274","WJ10577","WJ10005","WJ10189","WJ10415","WJ10204"]},{"story":"S11115","members":["WJ10104","WJ10380","WJ10112","WJ10010","WJ10177","WJ10274","WJ10577","WJ10005","WJ10189","WJ10415","WJ10204"]}],"body":null,"honorifics":[],"selfAddress":[],"specialNames":[],"vip":{"isVIP":1,"from":"195","to":"196"},"marriage":{"aiMarriageAge":"25","startPregnantAge":"0"},"scenarios":[{"story