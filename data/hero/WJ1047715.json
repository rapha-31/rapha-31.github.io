05"},"couple":[]},{"story":{"id":"S10915","name":{"zh":"北伐中原","en":"Northern Expedition"},"year":"227","month":"3"},"faction":null,"city":"CS1035","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[61,60,52,60,68,60],"title":-1,"rank":"9","loyalty":"0","reputation":"1950","equipment":{"weapon":"WP15004","armor":"WP1000505","helmet":"WP1020805"},"couple":[]},{"story":{"id":"S11015","name":{"zh":"再出岐山","en":"Return to Qishan"},"year":"231","month":"1"},"faction":null,"city":"CS1035","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[61,60,52,60,68,60],"title":-1,"rank":"9","loyalty":"0","reputation":"1950","equipment":{"weapon":"WP15004","armor":"WP1000505","helmet":"WP1020805"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":null,"city":"CS1035","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[61,60,52,60,68,60],"title":-1,"rank":"9","loyalty":"0","reputation":"1950","equipment":{"weapon":"WP15004","armor":"WP1000505","helmet":"WP1020805"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1074","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[61,60,52,60,68,60],"title":-1,"rank":"9","loyalty":"0","reputation":"1950","equipment":{"weapon":"WP15004","armor":"WP1000505","helmet":"WP1020805"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1035","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[61,60,52,60,68,60],"title":-1,"rank":"9","loyalty":"0","reputation":"150","equipment":{"weapon":"WP15004","armor":"WP1000505","helmet":"WP1020805"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":null,"city":"CS1074","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[61,60,52,60,68,60],"title":-1,"rank":"9","loyalty":"99","reputation":"150","equipment":{"weapon":"WP15004","armor":"WP1000505","helmet":"WP1020805"},"couple":[]}],"storyEvents":[],"biography":{"zh":"东汉末年白马氐族的首领，陇右的氐族豪帅，仇池杨氏政权的奠基人。其家族自秦汉以来世居陇右，为当地豪族。杨腾趁汉末战乱崛起成为白马河一带的氐族部落大帅，通过整合陇右氐人势力，逐步建立起以武都为核心的割据政权。杨腾在位期间注重发展部族经济，率部迁徙至仇池百顷山后，引泉灌田、煮土成盐，奠定了氐族在陇右的生存基础。杨腾病逝后，长子杨驹继承其位，孙子杨千万后随马超讨伐曹操。","tc":"東漢末年白馬氐族的首領，隴右的氐族豪帥，仇池楊氏政權的奠基人。其家族自秦漢以來世居隴右，為當地豪族。楊騰趁漢末戰亂崛起成為白馬河一帶的氐族部落大帥，通過整合隴右氐人勢力，逐步建立起以武都為核心的割據政權。楊騰在位期間注重發展部族經濟，率部遷徙至仇池百頃山后，引泉灌田、煮土成鹽，奠定了氐族在隴右的生存基礎。楊騰病逝后，長子楊駒繼承其位，孫子楊千萬后隨馬超討伐曹操。","en":"A chieftain of the Baima Di tribe in the late Eastern Han dynasty, a prominent Di leader of Longyou, and the founder of the Yang regime of Chouchi. His family had dwelled in Longyou for generations since the Qin and Han dynasties as a prominent local clan. Taking advantage of the turmoil at the end of the Han dynasty, Yang Teng rose to prominence as the grand chieftain of the Di tribes along the Baima River. By consolidating the Di faction in Longyou, he gradually established a regional regime centered in Wudou. During his rule, Yang Teng prioritized developing the tribal economy, after leading his people to relocate to Baiqing Mountain in Chouchi, he diverted spring waters to irrigate fields and boiled the earth to produce salt, laying the foundation for the Di people's survival in Longyou. Following his death from illness, his eldest son Yang Ju succeeded him, and his grandson Yang Qianwan later followed Ma Chao to campaign against Cao Cao.","jp":"後漢末期の白馬氐族の首領。隴右の氐族豪帥であり、仇池楊氏政権の礎を築いた人物。その家族は秦・漢の時代より代々隴右に定住し、現地の豪族であった。楊騰は漢末の乱に乗じて台頭し、白馬河一帯の氐族部族の大帥となると、隴右の氐族勢力を統合して武都を中心とする割拠政権を徐々に打ち立てた。在位中は部族の経済発展を重視し、部族を率いて仇池の百頃山へ移住した後は、泉の水を引いて田畑を潤し、土を煮て塩を製するなど、氐族が隴右に生き残るための基盤を固めた。楊騰が病没すると、長男の楊駒がその地位を継ぎ、後に孫の楊千万は馬超に従って曹操を討伐した。","kr":"후한 말 백마저족의 수령이자 농우 저족의 호수(豪帥)로, 구지 양씨 정권의 기틀을 마련한 인물입니다. 그 가문은 진한 이래 대대로 농우에 거주한 현지의 유력 호족이었습니다. 양등은 한말의 전란을 틈타 궐기하여 백마하 일대 저족 부족의 대수가 되었으며, 농우 저족의 세력을 규합하여 점차 무도를 중심으로 한 할거 정권을 확립했습니다. 재위 기간에는 부족의 경제 발전에 힘써 무리를 이끌고 구지 백경산으로 이주한 후, 샘물을 끌어다 농사를 짓고 흙을 끓여 소금을 얻으며 저족이 농우에서 살아갈 수 있는 기반을 다졌습니다. 양등이 병사하자 장남 양구가 그 자리를 계승하였으며, 손자인 양천만은 훗날 마초를 따라 조조를 토벌했습니다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ1047715","remark":"普武","surname":"杨","surnameTc":"楊","surnameEn":"Yang","surnameJp":"楊","surnameKr":"양","surnameOther":"","name":"腾","nameTc":"騰","nameEn":"Teng","nameJp":"騰","nameKr":"등","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"杨腾","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"2","workYear":"184","city":"CS1035","gender":"0","rule":"61","force":"60","wise":"52","politics":"60","charm":"68","will":"60","ruleTalent":"7","forceTalent":"6","wiseTalent":"3","politicsTalent":"7","charmTalent":"4","willTalent":"8","weaponMaster":"60/35/26/26/29/24/30/24","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"","battleSkill":"","debateCard":"","warSoul":"","battleSoul":"","debateSoul":"","warSoulPoint":"4400","battleSoulPoint":"6500","debateSoulPoint":"1900","strategy":"1003608","strategy2":"1005401","professions":"3/0/1/0/0/0/2/0/0/0/1/1/3/1/1/0/1/0/0/0/0/2/1/3","attribute2":"50/50/50/50/50/50","morality":"3","compatible":"40","loyalty":"0","reputation":"150","evaluate":"1300","title":"","rank":"9","birth":"146","show":"184","death":"210","age":"0","injury":"","deathReason":"0","type":"1","npcTag":"0","npcNum":"1","microScene":"0","isImportant":"0","speaking":"2","weapon":"WP15004","armor":"WP1000505","helmet":"WP1020805","treasure":"","horse":"","shield":"","character":"0/1;1/1;25/1;39/1;18/1;9/1;10/0;45/0;30/1;46/1","father":"","mother":"","children":"WJ1047815/100","family":"","modInfo":"","brother":"","couple":"","otherRelationship":"","belief":"0","isVIP":"0","startVIPYear":"0","endVIPYear":"0","description":"东汉末年白马氐族的首领，陇右的氐族豪帅，仇池杨