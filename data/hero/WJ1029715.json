ted before the halls of Wang and Xie now fly into the homes of common folk.'"},"talent":{"military":"1","commerce":"4","politics":"9"}}],"friendGroups":[],"body":{"name":"王融","height":"较矮","shape":"一般"},"honorifics":[],"selfAddress":[],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"25","startPregnantAge":"0"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":null,"city":"CS1018","noRecruit":true,"reject":null,"state":"2","role":0,"stats":[12,13,70,64,72,73],"title":-1,"rank":"9","loyalty":"0","reputation":"6100","equipment":{"weapon":"WP1007102","armor":"WP1014005","helmet":"WP1024205"},"couple":[]},{"story":{"id":"S10215","name":{"zh":"汉末三杰","en":"Three Heroes of the Late Han"},"year":"185","month":"3"},"faction":null,"city":"CS1018","noRecruit":true,"reject":null,"state":"2","role":0,"stats":[12,13,70,64,72,73],"title":-1,"rank":"9","loyalty":"0","reputation":"6100","equipment":{"weapon":"WP1007102","armor":"WP1014005","helmet":"WP1024205"},"couple":[]},{"story":{"id":"S10615","name":{"zh":"十常侍之乱","en":"Turmoil of the Ten Attendants"},"year":"188","month":"11"},"faction":null,"city":"CS1018","noRecruit":true,"reject":null,"state":"2","role":0,"stats":[12,13,70,64,72,73],"title":-1,"rank":"9","loyalty":"98","reputation":"6650","equipment":{"weapon":"WP1007102","armor":"WP1014005","helmet":"WP1024205"},"couple":[]},{"story":{"id":"S10402","name":{"zh":"诸侯讨董","en":"Coalition Against Dong Zhuo"},"year":"190","month":"3"},"faction":null,"city":"CS1018","noRecruit":true,"reject":null,"state":"2","role":0,"stats":[12,13,70,64,72,73],"title":-1,"rank":"9","loyalty":"98","reputation":"6650","equipment":{"weapon":"WP1007102","armor":"WP1014005","helmet":"WP1024205"},"couple":[]},{"story":{"id":"S10208","name":{"zh":"幽燕龙兴","en":"Dragon Rises in Youyan"},"year":"191","month":"3"},"faction":null,"city":"CS1018","noRecruit":true,"reject":null,"state":"2","role":0,"st