o unified the North, and Cao Pi replaced Han to establish Wei. Bound by generations of intermarriage with the Xiahou clan, they formed the core of the Cao Wei regime. After the Incident at Gaoping Tombs, the imperial power of the Cao clan was gradually hollowed out by the Sima clan and ultimately usurped."},"talent":{"military":"10","commerce":"5","politics":"8"}}],"friendGroups":[],"body":null,"honorifics":[],"selfAddress":[[["WJ10966","小女子"],["WJ10966","小女子"],["WJ10966","This humble maiden"],["WJ10966","私め"],["WJ10966","소녀"]]],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"35","startPregnantAge":"0"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":null,"city":"CS1026","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[44,33,75,83,74,61],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1007302","armor":"WP1010602","helmet":"WP1012702"},"couple":[]},{"story":{"id":"S10215","name":{"zh":"汉末三杰","en":"Three Heroes of the Late Han"},"year":"185","month":"3"},"faction":null,"city":"CS1026","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[44,33,75,83,74,61],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1007302","armor":"WP1010602","helmet":"WP1012702"},"couple":["WJ10779"]},{"story":{"id":"S10615","name":{"zh":"十常侍之乱","en":"Turmoil of the Ten Attendants"},"year":"188","month":"11"},"faction":null,"city":"CS1026","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[44,33,75,83,74,61],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1007302","armor":"WP1010602","helmet":"WP1012702"},"couple":[]},{"story":{"id":"S10402","name":{"zh":"诸侯讨董","en":"Coalition Against Dong Zhuo"},"year":"190","month":"3"},"faction":null,"city":"CS1026","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[44,33,75,83,74,61],"title":-1,"rank":"9","lo