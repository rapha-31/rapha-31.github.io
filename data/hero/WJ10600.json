tack)"}}],"debateSouls":[],"soulPoints":{"war":5300,"battle":5400,"debate":2300},"equipment":[{"id":"WP12012","name":{"zh":"钢刀","en":"Steel Saber"},"level":"1","description":{"zh":"钢制大刀，更加锋利。","en":"A steel great blade with a keener edge."},"atkVal":"6","price":"2400","slot":{"zh":"武器","en":"Weapon"}},{"id":"WP1005805","name":{"zh":"皮甲·甲","en":"Leather Armor - I"},"level":"1","description":{"zh":"因轻便、价值低、可防箭、便于制作等原因多为战场上普通士卒穿戴。","en":"Light, cheap, arrow-resistant, and easy to make, it is commonly worn by ordinary soldiers on the battlefield."},"defenceVal":"4","evade":"2","price":"2000","slot":{"zh":"护甲","en":"Armor"}},{"id":"WP1019905","name":{"zh":"铁盔·丁","en":"Iron Helm - IV"},"level":"1","description":{"zh":"战场上最常见的铁盔，从大将到伍长都有可能佩戴，偶尔会加些个人风格的装饰。","en":"The most common iron helm on the battlefield, worn by everyone from generals to squad leaders, sometimes with personal decorations added."},"defenceVal":"4","price":"2200","slot":{"zh":"头盔","en":"Helmet"}},{"id":"WP1001515","name":{"zh":"凉州马","en":"Liang Horse"},"level":"1","description":{"zh":"西部产战马，适应性强，常见于西凉骑兵部队。","en":"A warhorse bred in the western regions, highly adaptable, commonly seen in Xiliang cavalry units."},"price":"2400","slot":{"zh":"坐骑","en":"Mount"}}],"family":{"father":{"label":{"zh":"父亲","en":"Father"},"people":[{"id":"WJ10172","code":"100"}]},"children":{"label":{"zh":"子女","en":"Children"},"people":[{"id":"WJ1012915","code":"100"}]}},"clans":[{"id":"GI110315","name":{"zh":"挛鞮氏","en":"The Luanti Clan"},"years":["0","999"],"desc":{"zh":"出自匈奴，挛鞮氏为南匈奴王族。羌渠单于为东汉末南匈奴单于。南匈奴王族。於夫罗为羌渠单于之子，助汉镇压张纯叛乱，因内乱滞留中原，与袁绍、曹操等交战，后归顺曹操。其弟呼厨泉继位后入朝被留，其子刘豹为左贤王，其孙刘渊建立汉赵政权。","en":"Originating from the Xiongnu, the Luandi clan was the royal house of the Southern Xiongnu. Chanyu Qiangqu was the Chanyu of the Southern Xiongnu in the late Eastern Han. Yufuluo, son of Chanyu Qiangqu, aided the Han in suppressing the rebellion of Zhang Chun, stranded in the Central Plains due to internal strife, he clashed with warlords like Yuan Shao and Cao Cao before eventually submitting to Cao Cao. His younger brother Huchuquan succeeded him and was detained upon visiting the imperial court. Yufuluo's son Liu Bao became the Left Worthy Prince, and his grandson Liu Yuan founded the state of Han-Zhao."},"talent":{"military":"9","commerce":"6","politics":"7"}}],"friendGroups":[{"story":"S10802","members":["WJ10011","WJ10045","WJ10058","WJ10162","WJ10173","WJ10317","WJ10380"]},{"story":"S10615","members":["WJ10011","WJ10045","WJ10058","WJ10162","WJ10173","WJ10317","WJ10380"]},{"story":"S10402","members":["WJ10011","WJ10045","WJ10058","WJ10162","WJ10173","WJ10317","WJ10380","WJ10941"]},{"story":"S10415","members":["WJ10011","WJ10045","WJ10058","WJ10162","WJ10173","WJ10380","WJ10941","WJ10317"]},{"story":"S10202","members":["WJ10011","WJ10046","WJ10058","WJ10173","WJ10380"]},{"story":"S10215","members":["WJ10011","WJ10045","WJ10058","WJ10162","WJ10173","WJ10317","WJ10380"]},{"story":"S10208","members":["WJ10011","WJ10045","WJ10058","WJ10162","WJ10173","WJ10317","WJ10380","WJ10941"]}],"body":null,"honorifics":[],"selfAddress":[],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"25","startPregnantAge":"0"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":null,"city":"CS1033","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[73,74,48,52,26,31],"title":-1,"rank":"9","loyalty":"0","reputation":"3200","equipment":{"weapon":"WP12012","armor":"WP1005805","helmet":"WP1019905","horse":"WP1001515"},"couple":[]},{"story":{"id":"S10215","name":{"zh":"汉末三杰","en":"Three Heroes of the Late Han"},"year":"185","month":"3"},"faction":"WJ10172","city":"CS1075","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[73,74,48,52,26,31],"title":-1,"rank":"9","loyalty":"120","reputation":"3200","equipment":{"weapon":"WP12012","armor":"WP1005805","helmet":"WP1019905","horse":"WP1001515"},"couple":[]},{"st