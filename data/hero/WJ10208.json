":[73,75,43,41,67,68],"title":-1,"rank":"7","loyalty":"100","reputation":"3500","equipment":{"weapon":"WP1006702","armor":"WP1003505","helmet":"WP1020705"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ1000115","city":"CS1051","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[73,75,43,41,67,68],"title":-1,"rank":"7","loyalty":"100","reputation":"3500","equipment":{"weapon":"WP1006702","armor":"WP1003505","helmet":"WP1020705"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1051","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[73,75,43,41,67,68],"title":-1,"rank":"9","loyalty":"0","reputation":"550","equipment":{"weapon":"WP1006702","armor":"WP1003505","helmet":"WP1020705"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10104","city":"CS1013","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[73,75,43,41,67,68],"title":-1,"rank":"9","loyalty":"100","reputation":"550","equipment":{"weapon":"WP1006702","armor":"WP1003505","helmet":"WP1020705"},"couple":[]}],"storyEvents":[],"biography":{"zh":"乐进之子。诸葛亮北伐期间与张虎配合出击，但因司马懿败于诸葛亮而与张虎一同被捕，被涂面后放还。后随司马懿平定辽东之乱，并任命扬州刺史。诸葛诞反叛前收到警惕诸葛诞的密信，被诸葛诞发觉后被其杀害。","tc":"樂進之子。諸葛亮北伐期間與張虎配合出擊，但因司馬懿敗于諸葛亮而與張虎一同被捕，被涂面后放還。后隨司馬懿平定遼東之亂，并任命揚州刺史。諸葛誕反叛前收到警惕諸葛誕的密信，被諸葛誕發覺后被其殺害。","en":"Son of Yue Jin. During Zhuge Liang's Northern Expeditions, he fought alongside Zhang Hu but was captured when Sima Yi was defeated by Zhuge Liang. He was released with his face painted. He later accompanied Sima Yi in suppressing the Liaodong rebellion and was appointed Lt. Governor of Yang Province. Before Zhuge Dan's revolt, he received a secret warning about Zhuge Dan but was discovered and killed by Zhuge Dan.","jp":"楽進の子。諸葛亮の北伐において張虎と共に出撃するも、司馬懿が諸葛亮に敗れたことで張虎と共に捕らえられ、顔に墨を塗られて釈放された。後に司馬懿に従って遼東の乱を平定し、揚州刺史に任じられた。諸葛誕の反乱に先立って諸葛誕を警戒せよとの密書を受け取ったが、諸葛誕に察知されて殺害された。","kr":"악진의 아들이다. 제갈량의 북벌 당시 장호와 함께 출격했으나, 사마의가 제갈량에게 패하면서 장호와 함께 사로잡혔고 얼굴에 먹칠을 당한 채 풀려났다. 이후 사마의를 따라 요동의 난을 평정하였으며, 양주자사로 임명되었다. 제갈탄이 반란을 일으키기 전 그를 경계하라는 밀서를 받았으나, 제갈탄에게 발각되어 살해당했다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10208","remark":"","surname":"乐","surnameTc":"樂","surnameEn":"Yue","surnameJp":"楽","surnameKr":"악","surnameOther":"","name":"綝","nameTc":"綝","nameEn":"Chen","nameJp":"綝","nameKr":"침","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"乐綝","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"0","workYear":"210","city":"CS1051","gender":"0","rule":"73","force":"75","wise":"43","politics":"41","charm":"67","will":"68","ruleTalent":"8","forceTalent":"9","wiseTalent":"3","politicsTalent":"3","charmTalent":"7","willTalent":"7","weaponMaster":"27/27/27/27/74/12/50/27","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"","battleSkill":"","debateCard":"","warSoul":"","battleSoul":"1013205","debateSoul":"","warSoulPoint":"5300","battleSoulPoint":"5600","debateSoulPoint":"1800","strategy":"1007115","strategy2":"1008401","professions":"0/3/3/0/2/0/2/1/0/1/0/1/0/0/3/0/0/0/0/1/0/1/1/0","attribute2":"50/50/50/50/50/50","morality":"6","compatible":"15","loyalty":"0","reputation":"550","evaluate":"0","title":"","rank":"9","birth":"196","show":"210","death":"257","age":"0","injury":"","deathReason":"1","type":"1","npcTag":"0","npcNum":"1","microScene":"0","isImportant":"0","speaking":"3","weapon":"WP1006702","armor":"WP1003505","helmet":"WP1020705","treasure":"","horse":"","shield":"","character":"0/1;1/1;10/1;12/1;25/1;33/1;41/1;9/0","father":"WJ10006/0","mother":"","children":"","family":"","modInfo":"","brother":"","couple":"","otherRelationship":"","be