605"},"couple":[]},{"story":{"id":"S11015","name":{"zh":"再出岐山","en":"Return to Qishan"},"year":"231","month":"1"},"faction":"WJ10020","city":"CS1020","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[54,61,32,23,23,25],"title":-1,"rank":"9","loyalty":"95","reputation":"650","equipment":{"weapon":"WP10014","armor":"WP1001305","helmet":"WP1019605"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":"WJ10020","city":"CS1020","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[54,61,32,23,23,25],"title":-1,"rank":"9","loyalty":"95","reputation":"650","equipment":{"weapon":"WP10014","armor":"WP1001305","helmet":"WP1019605"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ10020","city":"CS1020","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[54,61,32,23,23,25],"title":-1,"rank":"9","loyalty":"95","reputation":"650","equipment":{"weapon":"WP10014","armor":"WP1001305","helmet":"WP1019605"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1019","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[54,61,32,23,23,25],"title":-1,"rank":"8","loyalty":"98","reputation":"3900","equipment":{"weapon":"WP10014","armor":"WP1001305","helmet":"WP1019605"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10068","city":"CS1020","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[54,61,32,23,23,25],"title":-1,"rank":"8","loyalty":"98","reputation":"3900","equipment":{"weapon":"WP10014","armor":"WP1001305","helmet":"WP1019605"},"couple":[]}],"storyEvents":[],"biography":{"zh":"原为陶谦部下武将，徐州被破后与兄长糜竺共投刘备。赤壁之战后刘备进军益州，糜芳被派去荆州援助关羽，但此期间因仓库失火遭到关羽惩罚而与之结怨。关羽出征襄樊期间驻守荆州，又吕蒙奇袭荆州时举城投降。最终于刘备亲征伐吴之时，与博士仁杀马忠携其首级前去向刘备请罪，但恼怒的刘备将二人处以凌迟之刑。","tc":"原為陶謙部下武將，徐州被破后與兄長糜竺共投劉備。赤壁之戰后劉備進軍益州，糜芳被派去荊州援助關羽，但此期間因倉庫失火遭到關羽懲罰而與之結怨。關羽出征襄樊期間駐守荊州，又呂蒙奇襲荊州時舉城投降。最終于劉備親征伐吳之時，與博士仁殺馬忠攜其首級前去向劉備請罪，但惱怒的劉備將二人處以凌遲之刑。","en":"Originally an officer under Tao Qian. After Xu Province fell, he joined Liu Bei along with his elder brother Mi Zhu. After the Battle of Red Cliffs, when Liu Bei advanced into Yi Province, Mi Fang was sent to Jing Province to assist Guan Yu. During this period, a warehouse fire led to punishment by Guan Yu, creating a bitter grudge between them. While Guan Yu marched on Xiangfan, Mi Fang was left to garrison Jing Province. When Lu Meng launched his surprise attack on Jing Province, Mi Fang surrendered the city. Later, during Liu Bei's campaign against Wu, Mi Fang and Fu Shiren killed Ma Zhong and brought his head to Liu Bei seeking clemency, but the enraged Liu Bei had both men executed by lingering death.","jp":"もとは陶謙配下の武将であったが、徐州陥落後に兄の糜竺とともに劉備に仕えた。赤壁の戦いの後、劉備が益州へ進軍すると、糜芳は荊州へ派遣されて関羽を補佐することとなったが、その間に倉庫の火災により関羽から処罰を受け、遺恨を抱くようになった。関羽が襄樊へ出陣している間は荊州を守備していたが、呂蒙が荊州を奇襲した際に城を挙げて降伏した。劉備が呉へ親征した際には、博士仁とともに馬忠を殺してその首級を携え劉備に罪を乞うたが、激怒した劉備によって二人は凌遅の刑に処された。","kr":"원래 도겸 휘하의 무장이었으며, 서주가 함락된 후 형 미축과 함께 유비에게 귀순했다. 적벽대전 후 유비가 익주로 진군하자 미방은 형주로 파견되어 관우를 지원했으나, 창고 화재로 인해 관우에게 처벌을 받으며 원한을 품게 되었다. 관우가 양번으로 출진한 동안 형주를 지키고 있었으나, 여몽이 형주를 기습했을 때 성을 들어 항복했다. 이후 유비가 친히 오나라 정벌에 나섰을 때 박사인과 함께 마충을 죽이고 그 수급을 바치며 유비에게 용서를 구했으나, 대노한 유비는 두 사람을 능지형에 처했다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10257","remark":"","surname":"糜","surnameTc":"糜","surnameEn":"Mi","surnameJp":"糜","surnameKr":"미","surnameOther":"","name":"芳","nameTc":"芳","nameEn":"Fang","nameJp":"芳","nameKr":"방","nameOther":"","word":"子方","wordTc":"子方","wordEn":"Zifang","wordJp":"子方","wordKr":"자방","wordOther":"","icon":"糜芳","power":"WJ10068","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"2","workYear":"188","city":"CS1019","gender"