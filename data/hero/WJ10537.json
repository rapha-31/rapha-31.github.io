234","month":"1"},"faction":null,"city":"CS1022","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[54,45,69,72,73,44],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1007002","armor":"WP1013805","helmet":"WP1024205"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1022","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[54,45,69,72,73,44],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1007002","armor":"WP1013805","helmet":"WP1024205"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1022","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[54,45,69,72,73,44],"title":-1,"rank":"7","loyalty":"94","reputation":"11650","equipment":{"weapon":"WP1007002","armor":"WP1013805","helmet":"WP1024205"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10317","city":"CS1022","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[54,45,69,72,73,44],"title":-1,"rank":"7","loyalty":"94","reputation":"11650","equipment":{"weapon":"WP1007002","armor":"WP1013805","helmet":"WP1024205"},"couple":[]}],"storyEvents":[],"biography":{"zh":"参与讨董的十八路诸侯之一。桥玄（东汉太尉，以刚直闻名）族子，率领军队至酸枣与曹操、张邈、刘岱等诸侯会师，成为讨董联盟的初始成员之一。虎牢关一战曾解救被吕布击败的王匡。联合军解散后因拒绝刘岱的借粮要求被刘岱杀害。","tc":"參與討董的十八路諸侯之一。橋玄（東漢太尉，以剛直聞名）族子，率領軍隊至酸棗與曹操、張邈、劉岱等諸侯會師，成為討董聯盟的初始成員之一。虎牢關一戰曾解救被呂布擊敗的王匡。聯合軍解散后因拒絕劉岱的借糧要求被劉岱殺害。","en":"One of the eighteen lords who joined the coalition against Dong Zhuo. A kinsman of Qiao Xuan (Chief Officer of the Eastern Han, famed for his integrity), he led his army to Suanzao to join forces with Cao Cao, Zhang Miao, Liu Dai, and other lords as a founding member of the anti-Dong Zhuo alliance. At the Battle of Hulao Gate, he rescued Wang Kuang after the latter was defeated by Lu Bu. After the coalition disbanded, he was killed by Liu Dai for refusing to lend him grain.","jp":"董卓討伐に参加した十八路諸侯のひとり。橋玄（東漢の太尉で、剛直な人柄で知られる）の族子。軍を率いて酸棗にて曹操、張邈、劉岱ら諸侯と合流し、董卓討伐連合の初期メンバーのひとりとなった。虎牢関の戦いでは呂布に敗れた王匡を救出した。連合軍解散後、劉岱からの兵糧借用の要求を拒絶したため、劉岱に殺害された。","kr":"동탁 토벌에 참여한 18로 제후 중 한 사람이다. 강직함으로 명성이 높았던 동한 태위 교현의 족자로, 군사를 이끌고 산조에 이르러 조조, 장막, 유대 등의 제후들과 합류하여 동탁 토벌 연합의 초기 구성원이 되었다. 호로관 전투에서는 여포에게 패배한 왕광을 구출하기도 했다. 연합군이 해산된 후 군량을 빌려달라는 유대의 요구를 거절했다가 유대에게 살해당했다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10537","remark":"","surname":"桥","surnameTc":"橋","surnameEn":"Qiao","surnameJp":"橋","surnameKr":"교","surnameOther":"","name":"瑁","nameTc":"瑁","nameEn":"Mao","nameJp":"瑁","nameKr":"모","nameOther":"","word":"元伟","wordTc":"元偉","wordEn":"Yuanwei","wordJp":"元偉","wordKr":"원위","wordOther":"","icon":"桥瑁","power":"WJ10317","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"2","workYear":"184","city":"CS1022","gender":"0","rule":"54","force":"45","wise":"69","politics":"72","charm":"73","will":"44","ruleTalent":"5","forceTalent":"4","wiseTalent":"7","politicsTalent":"8","charmTalent":"8","willTalent":"3","weaponMaster":"14/14/14/14/14/69/36/14","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"","battleSkill":"","debateCard":"","warSoul":"","battleSoul":"","debateSoul":"","warSoulPoint":"2900","battleSoulPoint":"2000","debateSoulPoint":"4700","strategy":"","strategy2":"1002105","professions":"0/1/1/0/0/0/0/2/2/2/1/1/0/3/0/1/2/0/3/1/1/0/1/1","attribute2":"50/50/50/50/50/50","morality":"5","compatible":"65","loyalty":"94","reputation":"11650","evaluate":"0","title":"","rank":"7","birth":"150","show":"184","death":"190","age":"0","injury":"","deathReason":"1","type":"0","npcTag":"0","npcNum":"1","microScene":"0","isImportant":"0","speaking":"0","weapon":"WP1007002","armor":"WP1013805","helmet":"W