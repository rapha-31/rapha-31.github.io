n":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1005","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[49,12,54,67,85,83],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1008702","armor":"WP1014702","helmet":"WP1012802"},"couple":["WJ10011"]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1024","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[49,12,54,67,85,83],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1008702","armor":"WP1014702","helmet":"WP1012802"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10011","city":"CS1005","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[49,12,54,67,85,83],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1008702","armor":"WP1014702","helmet":"WP1012802"},"couple":[]}],"storyEvents":[{"kind":"plot","id":"1003108","name":{"zh":"甘氏完婚","en":"Lady Gan's Wedding"},"year":"195","month":"11","desc":{"zh":"","en":""}}],"biography":{"zh":"刘备之妻，刘禅之母。皮肤白的玉一样，姿态妩媚，容貌美艳。早年与糜夫人随刘备流离各地，曾在关羽保护下重返刘备身边，随刘备前往荆州后产下刘禅。曾于长坂坡一战时与刘备走散，被赵云所寻回。赤壁之战不久后便逝世，导致周瑜想出出美人计，企图诱惑刘备来吴。刘禅即位后追谥为“昭烈皇后”。","tc":"劉備之妻，劉禪之母。皮膚白的玉一樣，姿態嫵媚，容貌美艷。早年與糜夫人隨劉備流離各地，曾在關羽保護下重返劉備身邊，隨劉備前往荊州后產下劉禪。曾于長坂坡一戰時與劉備走散，被趙云所尋回。赤壁之戰不久后便逝世，導致周瑜想出出美人計，企圖誘惑劉備來吳。劉禪即位后追謚為“昭烈皇后”。","en":"Wife of Liu Bei and mother of Liu Shan. Her skin was white as jade, her bearing graceful, and her beauty stunning. In the early years she endured hardship alongside Lady Mi, wandering with Liu Bei from place to place. She was once escorted safely back to Liu Bei by Guan Yu. After accompanying Liu Bei to Jing Province, she gave birth to Liu Shan. She became separated from Liu Bei during the Battle of Changban but was found and returned by Zhao Yun. She died not long after the Battle of Red Cliffs, which inspired Zhou Yu to devise the ‘beauty stratagem’ to lure Liu Bei to Wu. After Liu Shan ascended the throne, he posthumously honored her as ‘Empress Zhaolie.’","jp":"劉備の妻であり、劉禅の母。玉の如く白い肌を持ち、艶やかで美しい容貌をしていた。若くして糜夫人と共に劉備に従って各地を転々とし、関羽の保護を受けて劉備の元へと帰還した。劉備の荊州入りに従った後に劉禅を産む。長坂の戦いでは劉備とはぐれるも、趙雲によって救出された。赤壁の戦いの直後に亡くなり、これを機に周瑜は劉備を呉に誘い出す「美人計」を画策した。劉禅が即位すると「昭烈皇后」と追諡された。","kr":"유비의 아내이자 유선의 어머니이다. 피부가 옥처럼 희고 자태가 요염하며 용모가 빼어났다. 젊은 시절 미부인과 함께 유비를 따라 각지를 전전하였고, 관우의 보호를 받아 유비의 곁으로 돌아온 바 있다. 이후 유비를 따라 형주로 가 유선을 낳았다. 장판파 전투 당시 유비와 흩어졌으나 조운에게 구출되었다. 적벽대전이 끝나고 얼마 지나지 않아 세상을 떠났는데, 이로 인해 주유가 미인계를 내세워 유비를 오나라로 유인하려 하기도 했다. 유선이 즉위한 후 '소열황후'로 추시되었다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10183","remark":"","surname":"甘","surnameTc":"甘","surnameEn":"Gan","surnameJp":"甘","surnameKr":"감","surnameOther":"","name":"梅","nameTc":"梅","nameEn":"Mei","nameJp":"梅","nameKr":"매","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"甘梅","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"2","workYear":"189","city":"CS1024","gender":"1","rule":"49","force":"12","wise":"54","politics":"67","charm":"85","will":"83","ruleTalent":"4","forceTalent":"1","wiseTalent":"5","politicsTalent":"7","charmTalent":"10","willTalent":"7","weaponMaster":"4/4/4/4/4/28/84/4","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"","battleSkill":"","debateCard":"","warSoul":"S1002005","battleSoul":"","debateSoul":"","warSoulPoint":"4000","battleSoulPoint":"100","debateSoulPoint":"2900","strategy":"","strategy2":"1000205","professions":"0/0/0/1/0/0/0/0/3/1/0/0/0/2/0/0/1/2/1/0/2/0/3/1","attribute2":"52/22/64/72/90/90","morality":"3","compatible":"50","loyalty":"0","reputation":"0","evaluate":"4000","title":"","rank":"9","birth":"176","show":"188","death":"210","age":"0","injury":"","deathReason