1],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP28001","armor":"WP1014005","helmet":"WP1024805"},"couple":[]},{"story":{"id":"S10915","name":{"zh":"北伐中原","en":"Northern Expedition"},"year":"227","month":"3"},"faction":null,"city":"CS1009","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[43,21,84,70,39,61],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP28001","armor":"WP1014005","helmet":"WP1024805"},"couple":[]},{"story":{"id":"S11015","name":{"zh":"再出岐山","en":"Return to Qishan"},"year":"231","month":"1"},"faction":null,"city":"CS1009","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[43,21,84,70,39,61],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP28001","armor":"WP1014005","helmet":"WP1024805"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":null,"city":"CS1009","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[43,21,84,70,39,61],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP28001","armor":"WP1014005","helmet":"WP1024805"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1009","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[43,21,84,70,39,61],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP28001","armor":"WP1014005","helmet":"WP1024805"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1009","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[43,21,84,70,39,61],"title":-1,"rank":"7","loyalty":"99","reputation":"13000","equipment":{"weapon":"WP28001","armor":"WP1014005","helmet":"WP1024805"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10060","city":"CS1009","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[43,21,84,70,39,61],"title":-1,"rank":"7","loyalty":"99","reputation":"13000","equipment":{"weapon":"WP28001","armor":"WP1014005","helmet":"WP1024805"},"couple":[]}],"storyEvents":[],"biography":{"zh":"袁绍的谋士。初为何进心腹，献帝初年投奔袁绍。与许攸、淳于琼随袁绍自洛阳出逃。逢纪献策助袁绍不费一兵一卒夺取冀州，自此成为其核心幕僚。后来与其他幕僚一起掌管冀州行政。官渡之战时期，与审配共同主持后方粮草。先后与许攸、田丰对立，间接导致前者投敌后者被杀致使袁绍战败。袁绍死后，与审配矫诏拥立袁尚。后袁谭、袁尚兄弟火并。袁谭屯兵黎阳，求尚增兵，逢纪劝袁尚“勿与，以防谭强难制”，仅遣老弱千人前往，袁谭怒杀逢纪于营中。","tc":"袁紹的謀士。初為何進心腹，獻帝初年投奔袁紹。與許攸、淳于瓊隨袁紹自洛陽出逃。逢紀獻策助袁紹不費一兵一卒奪取冀州，自此成為其核心幕僚。后來與其他幕僚一起掌管冀州行政。官渡之戰時期，與審配共同主持后方糧草。先后與許攸、田豐對立，間接導致前者投敵后者被殺致使袁紹戰敗。袁紹死后，與審配矯詔擁立袁尚。后袁譚、袁尚兄弟火并。袁譚屯兵黎陽，求尚增兵，逢紀勸袁尚“勿與，以防譚強難制”，僅遣老弱千人前往，袁譚怒殺逢紀于營中。","en":"A strategist of Yuan Shao. He initially served as He Jin's confidant and joined Yuan Shao in the early years of Emperor Xian's reign. He, Xu You, and Chunyu Qiong fled Luoyang with Yuan Shao. Feng Ji devised the scheme that enabled Yuan Shao to seize Ji Province without expending a single soldier, becoming a core advisor thereafter. He managed Ji Province's administration alongside the other advisors. During the Battle of Guandu, he and Shen Pei managed supplies in the rear. His feuds with Xu You and Tian Feng indirectly caused the former's defection and the latter's execution, contributing to Yuan Shao's defeat. After Yuan Shao's death, he and Shen Pei forged a decree to install Yuan Shang as successor. When the Yuan brothers later turned on each other, Yuan Tan was stationed at Liyang and asked Yuan Shang for reinforcements. Feng Ji advised Yuan Shang, ‘Do not give them, lest Tan grow too strong to control,’ and only a thousand elderly and weak soldiers were sent. In a fury, Yuan Tan killed Feng Ji in his camp.","jp":"袁紹の謀士。初めは何進の腹心であったが、献帝の初年に袁紹の元へ身を寄せた。許攸や淳于瓊と共に袁紹に従って洛陽から脱出。逢紀の献策により、袁紹は一兵も損じることなく冀州を奪取し、以後はその中枢幕僚となった。後に他の幕僚らと共に冀州の行政を司る。官渡の戦いにおいては、審配と共に後方の兵糧を統括した。許攸や田豊と相次いで対立し、間接的に前者の寝返りや後者の処刑を招き、袁紹を敗戦へと至らしめた。袁紹の死後、審配と共に遺言を偽造して袁尚を擁立。その後、袁譚と袁尚の兄弟による内紛が勃発する。袁譚が黎陽に駐屯して袁尚に増兵を求めた際、逢紀は袁尚に「譚が強大化して制御できなくなるのを防ぐため、兵を与えてはなりません」と進言し、老弱兵千人のみを派遣させたため、激怒した袁譚により陣中で斬殺された。","kr":"원소의 모사. 처음에는 하진의 심복이었으나, 헌제 초에 원소에게 의탁했다. 허유, 순우경과 함께 원소를 따라 낙양에서 탈출했다. 봉기가 계책을 올려 원소가 일병일졸도 상하지 않고 기주를 손에 넣도록 도왔으며, 이때부터 핵심 막료가 되었다. 이후 다른 막료들과 함께 기주의 행정을 관장했다. 관도대전 당시에는 심배와 함께 후방의 군량을 총괄했다. 차례로 허유, 전풍과 대립하여 간접적으로 전자는 적에게 투항하고 후자는 죽임을 당하게 만들어 원소가 패배하는 빌미를 제공했다. 원소가 사망한 후에는 심배와 함께 조서를 위조해 원상을 옹립했다. 이후 원담과 원상 형제간에 골육상잔의 내분이 일어났다. 원담이 여양에 주둔하며 원상에게 증원을 요청하자, 봉기는 원상에게 '원담의 세력이 강해져 제어하기 어려워질 수 있으니 군사를 내어주지 마십시오'라고 진언하며 노약자 천 명만을 보내도록 했다. 이에 격노한 원담이 군영 안에서 봉기를 죽였다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10157","remark":"","surname":"逢","surnameTc":"逢","surnameEn":"Feng","surnameJp":"逢","surnameKr":"봉","surnameOther":"","name":"纪","nameTc":"紀","nameEn":"Ji","nameJp":"紀","nameKr":"기","nameOther":"","word":"元图","wordTc":"元圖","wordEn":"Yuantu","wordJp":"元図","wordKr":"원도","wordOther":"","icon":"逢纪","power":"WJ10060","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"2","workYear":"185","city":"CS1009","gender":"0","rule":"43","force":"21","wise":"84","politics":"70","charm":"39","will":"61","ruleTalent":"3","forceTalent":"1","wiseTalent":"12","politicsTalent":"8","charmTalent":"3","willTalent":"6","weaponMaster":"5/5/5/5/5/80/15/5","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"","battleSkill":"","debateCard":"1001501;1000705","warSoul":"S1003605;S1002505","battleSoul":"1019405","debateSoul":"1001805","warSoulPoint":"4000","battleSoulPoint":"400","debateSoulPoint":"7000","strategy":"1006515","strategy2":"1005301;1001215","professions":"0/0/0/2/0/0/0/2/0/2/1/1/0/0/0/2/4/4/3/3/0/0/0/1","attribute2":"50/50/50/50/50/50","morality":"3","compatible":"73","loyalty":"99","reputation":"13000","evaluate":"-7000","title":"","rank":"7","birth":"153","show":"185","death":"204","age":