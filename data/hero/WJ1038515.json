:"1200","slot":{"zh":"护甲","en":"Armor"}},{"id":"WP1027105","name":{"zh":"巧士冠·乙","en":"Artisan Crown - II"},"level":"2","description":{"zh":"更为精致的小冠，多为朝中职务多面之人佩戴。","en":"A more refined small crown, worn by officials serving in multiple capacities."},"mp":"670","evade":"10","price":"6000","slot":{"zh":"头盔","en":"Helmet"}}],"family":{"children":{"label":{"zh":"子女","en":"Children"},"people":[{"id":"WJ1038615","code":"100"},{"id":"WJ1038715","code":"100"},{"id":"WJ10106","code":"100"}]},"otherRelationship":{"label":{"zh":"其他关系","en":"Other relationships"},"people":[{"id":"WJ10060","code":"6"}]}},"clans":[{"id":"GI103515","name":{"zh":"中山甄氏","en":"The Zhen clan of Zhongshan"},"years":["180","265"],"desc":{"zh":"出自舜帝之后，周封陈国，后裔以地为氏。西汉末甄邯为太保、大司马，封承新公，家族始显。\t甄逸、甄宓、甄像\t冀州顶级外戚世家。甄宓为文昭皇后，生魏明帝。曹魏三代帝王与之联姻、结冥婚，甄像、甄畅父子皆位至将军。","en":"Originates from descendants of Emperor Shun. Enfeoffed in the State of Chen during the Zhou dynasty, his descendants adopted the fief as their clan name. In late Western Han, Zhen Han served as Grand Guardian and Grand Marshal, enfeoffed as Duke of Chengxin, marking the rise of the Family.\tZhen Yi, Zhen Mi, Zhen Xiang\tA premier imperial in-law clan of Ji Province. Zhen Mi became Empress Wenzhao and gave birth to Emperor Ming of Wei. Three generations of Cao Wei emperors intermarried with them or concluded posthumous marriages, and both Zhen Xiang and his son Zhen Chang rose to the rank of General."},"talent":{"military":"2","commerce":"7","politics":"6"}}],"friendGroups":[],"body":{"name":"甄逸","height":"平均","shape":"一般"},"honorifics":[],"selfAddress":[],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"25","startPregnantAge":"0"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":null,"city":"CS1013","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[33,20,62,78,55,58],"title":-1,"rank":"9","loyalty":"0","reputation":"7550","equipment"