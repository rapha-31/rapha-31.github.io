WP1006505","helmet":"WP1023505"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1056","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[73,76,45,31,37,70],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1006702","armor":"WP1006505","helmet":"WP1023505"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1053","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[73,76,45,31,37,70],"title":-1,"rank":"9","loyalty":"150","reputation":"4100","equipment":{"weapon":"WP1006702","armor":"WP1006505","helmet":"WP1023505"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10173","city":"CS1056","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[73,76,45,31,37,70],"title":-1,"rank":"9","loyalty":"150","reputation":"4100","equipment":{"weapon":"WP1006702","armor":"WP1006505","helmet":"WP1023505"},"couple":[]}],"storyEvents":[{"kind":"plot","id":"1007008","name":{"zh":"张英仕官改仕","en":"Zhang Ying Serves and Changes Allegiance"},"year":"196","month":"3","desc":{"zh":"","en":""}}],"biography":{"zh":"扬州刺史刘繇麾下武将，孙策进攻扬州时不顾友军而出阵迎战，被蒋钦周泰等人用火攻击败，也因此险被刘繇所处刑。在后续的攻防战中，于秣陵误认为孙策阵亡而与陈横等人发起了夜袭，被孙策手下大将陈武所杀。","tc":"揚州刺史劉繇麾下武將，孫策進攻揚州時不顧友軍而出陣迎戰，被蔣欽周泰等人用火攻擊敗，也因此險被劉繇所處刑。在后續的攻防戰中，于秣陵誤認為孫策陣亡而與陳橫等人發起了夜襲，被孫策手下大將陳武所殺。","en":"An officer under Liu Yao, Lt. Governor of Yang Province. When Sun Ce attacked Yang Province, he charged out to fight heedless of allied forces. Defeated by Jiang Qin, Zhou Tai, and others using fire attacks, he narrowly escaped execution by Liu Yao. In subsequent battles, he mistakenly believed Sun Ce had been killed and launched a night raid at Moling alongside Chen Heng and others, only to be slain by Sun Ce's general Chen Wu.","jp":"揚州刺史・劉繇配下の武将。孫策が揚州へ進攻した際、友軍を顧みずに出陣して迎え撃つも、蔣欽や周泰らによる火の攻撃を受けて敗れ、そのため劉繇に処刑されかけた。その後の攻防戦において、秣陵で孫策が陣没したと誤認し、陳横らと共に夜襲を仕掛けたが、孫策配下の大将・陳武に討ち取られた。","kr":"양주자사 유요 휘하의 무장. 손책이 양주를 침공했을 때 아군을 돌보지 않고 출진하여 맞서 싸우다가, 장흠과 주태 등에게 화공으로 패배하고 이 때문에 유요에게 처형당할 뻔했다. 이어진 공방전 중 말릉에서 손책이 전사한 것으로 오인하여 진횡 등과 함께 야습을 감행했으나, 손책 휘하의 대장 진무에게 목숨을 잃었다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10345","remark":"","surname":"张","surnameTc":"張","surnameEn":"Zhang","surnameJp":"張","surnameKr":"장","surnameOther":"","name":"英","nameTc":"英","nameEn":"Ying","nameJp":"英","nameKr":"영","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"张英","power":"WJ10173","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"2","workYear":"184","city":"CS1053","gender":"0","rule":"73","force":"76","wise":"45","politics":"31","charm":"37","will":"70","ruleTalent":"8","forceTalent":"9","wiseTalent":"4","politicsTalent":"2","charmTalent":"2","willTalent":"8","weaponMaster":"31/31/31/31/79/15/50/31","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"","battleSkill":"","debateCard":"","warSoul":"","battleSoul":"1012405","debateSoul":"","warSoulPoint":"5300","battleSoulPoint":"5700","debateSoulPoint":"2000","strategy":"","strategy2":"1008401","professions":"2/3/0/2/0/2/2/0/0/0/2/2/2/0/4/0/0/0/0/0/0/1/1/0","attribute2":"50/50/50/50/50/50","morality":"3","compatible":"7","loyalty":"150","reputation":"4100","evaluate":"0","title":"","rank":"9","birth":"154","show":"184","death":"195","age":"0","injury":"","deathReason":"1","type":"1","npcTag":"0","npcNum":"1","microScene":"0","isImportant":"0","speaking":"0","weapon":"WP1006702","armor":"WP1006505","helmet":"WP1023505","treasure":"","horse":"","shield":"","character":"0/1;1/1;18/1;30/1;9/1;26/0","father":"","mother":"","children":"","family":"","modInfo":"","brother":"","couple":"","otherRela