:"武器","en":"Weapon"}},{"id":"WP1010902","name":{"zh":"武裙","en":"Warrior Skirt"},"level":"2","description":{"zh":"采用轻便的长裙与肩甲组合成的衣甲，方便穿戴者活动的同时也兼具美感。","en":"Light armor combining a long skirt with pauldrons, balancing mobility and elegance."},"defenceVal":"10","mp":"350","evade":"4","price":"10000","slot":{"zh":"护甲","en":"Armor"}},{"id":"WP1026605","name":{"zh":"应贤冠","en":"Worthy Crown"},"level":"1","description":{"zh":"更有层次感、更华丽的小冠，多为朝中有能之士佩戴。","en":"A more layered and ornate small crown, worn by capable officials at court."},"mp":"700","evade":"6","price":"3900","slot":{"zh":"头盔","en":"Helmet"}}],"family":{"father":{"label":{"zh":"父亲","en":"Father"},"people":[{"id":"WJ10152","code":"0"}]}},"clans":[{"id":"GI106015","name":{"zh":"南郡黄氏","en":"The Huang clan of Nan Commandery"},"years":["0","999"],"desc":{"zh":"出自嬴姓，黄国之后。西汉邔侯黄极忠开基，东汉司徒黄尚、沔南名士黄承彦、江夏太守黄祖相继。荆襄最古老豪族之一。黄承彦为诸葛亮岳父，黄祖镇守江夏十余年射杀孙坚，为荆州士族网络核心节点。","en":"Originating from the Ying surname, descendants of the ancient State of Huang. Founded in the Western Han by Huang Jizhong, Marquis of Qi, followed successively by Minister over the Masses Huang Shang of the Eastern Han, the renowned scholar of Miannan Huang Chengyan, and Governor of Jiangxia Huang Zu. They were one of the oldest prominent clans in Jingxiang. Huang Chengyan was the father-in-law of Zhuge Liang, and Huang Zu guarded Jiangxia for over a decade and killed Sun Jian with arrows, they served as a vital hub in the gentry network of Jing Province."},"talent":{"military":"6","commerce":"2","politics":"5"}}],"friendGroups":[],"body":null,"honorifics":[],"selfAddress":[[["WJ11040","妾身"],["WJ11040","妾身"],["WJ11040","This humble woman"],["WJ11040","妾"],["WJ11040","소첩"]]],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"35","startPregnantAge":"35"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":null,"city":"CS1004","noRecruit":false,"reject":null,"state