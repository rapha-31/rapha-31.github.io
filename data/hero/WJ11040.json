h":"北伐中原","en":"Northern Expedition"},"year":"227","month":"3"},"faction":null,"city":"CS1047","noRecruit":false,"reject":["WJ10020",0],"state":"2","role":0,"stats":[70,75,71,51,76,68],"title":-1,"rank":"7","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1006702","armor":"WP1010902","helmet":"WP1026605"},"couple":[]},{"story":{"id":"S11015","name":{"zh":"再出岐山","en":"Return to Qishan"},"year":"231","month":"1"},"faction":null,"city":"CS1047","noRecruit":false,"reject":["WJ10020",0],"state":"2","role":0,"stats":[70,75,71,51,76,68],"title":-1,"rank":"7","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1006702","armor":"WP1010902","helmet":"WP1026605"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":null,"city":"CS1047","noRecruit":false,"reject":["WJ10020",0],"state":"3","role":0,"stats":[70,75,71,51,76,68],"title":-1,"rank":"7","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1006702","armor":"WP1010902","helmet":"WP1026605"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ10020","city":"CS1004","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[70,75,71,51,76,68],"title":-1,"rank":"7","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1006702","armor":"WP1010902","helmet":"WP1026605"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1004","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[70,75,71,51,76,68],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1006702","armor":"WP1010902","helmet":"WP1026605"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10152","city":"CS1004","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[70,75,71,51,76,68],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1006702","armor":"WP1010902","helmet":"WP1026605"},"couple":[]}],"storyEvents":[],"biography":{"zh":"汉末江夏太守黄祖之女，黄射之姊。黄玉香天性放荡不羁，嗜酒擅射，喜爱在江夏的竹林中彻夜游玩射猎。曾在黄祖部队被孙坚追击时接应士兵，并随众人一同射箭击杀孙坚。后在荆州游玩时拜访刘表，并将此时在荆州滞留的甘宁荐于黄祖，甘宁便暂时放弃了投奔孙权的想法，依附黄祖。但重视文人的黄祖始终不将做过水匪的甘宁放在眼里，最终甘宁与黄玉香、苏飞告别后投奔了孙权，从此未见黄玉香再上战场。","tc":"漢末江夏太守黃祖之女，黃射之姊。黃玉香天性放蕩不羈，嗜酒擅射，喜愛在江夏的竹林中徹夜游玩射獵。曾在黃祖部隊被孫堅追擊時接應士兵，并隨眾人一同射箭擊殺孫堅。后在荊州游玩時拜訪劉表，并將此時在荊州滯留的甘寧薦于黃祖，甘寧便暫時放棄了投奔孫權的想法，依附黃祖。但重視文人的黃祖始終不將做過水匪的甘寧放在眼里，最終甘寧與黃玉香、蘇飛告別后投奔了孫權，從此未見黃玉香再上戰場。","en":"The daughter of Huang Zu, Governor of Jiangxia in the late Han, and the elder sister of Huang She. Huang Yuxiang was wild and uninhibited by nature, fond of wine and skilled with the bow. She loved hunting through the bamboo groves of Jiangxia deep into the night. When Huang Zu's forces were pursued by Sun Jian, she helped cover the retreating soldiers and joined in the volley of arrows that killed Sun Jian. While visiting Jing Province, she called upon Liu Biao and recommended Gan Ning, who was then stranded in Jing Province, to Huang Zu. Gan Ning temporarily abandoned his plan to join Sun Quan and served under Huang Zu instead. However, Huang Zu, who valued scholars, never thought much of Gan Ning, a former river pirate. Eventually, Gan Ning bid farewell to Huang Yuxiang and Su Fei and defected to Sun Quan. She was never seen on the battlefield again.","jp":"後漢末期の江夏太守・黄祖の娘で、黄射の姉。黄玉香は生まれつき放蕩不羈な性格で、酒を好み弓術に長け、江夏の竹林で夜を徹して遊猟に興じることを好んだ。かつて黄祖の軍が孫堅に追撃された際には兵を収容して応戦し、皆と共に矢を放って孫堅を射殺した。のちに荊州を遊歴した際に劉表を訪ね、当時荊州に滞在していた甘寧を黄祖に推挙したことで、甘寧は孫権に身を寄せる考えを一時改め、黄祖を頼ることとなった。しかし文人を重んじる黄祖は、かつて水賊であった甘寧を決して眼中に置こうとしなかった。やがて甘寧は黄玉香や蘇飛に別れを告げて孫権の下へと奔り、以降、黄玉香が再び戦場に立つ姿は見られなくなった。","kr":"후한 말 강하태수 황조의 딸이자 황사의 누나이다. 황옥향은 천성이 방탕하여 얽매임이 없었으며, 술을 즐기고 활쏘기에 능해 강하의 대나무 숲에서 밤을 새워 노닐며 사냥하기를 좋아했다. 일찍이 황조의 군세가 손견에게 쫓길 때 병사들을 맞이하여 구원하였고, 여러 사람과 함께 활을 쏘아 손견을 사살하기도 했다. 이후 형주를 유람하던 중 유표를 찾아뵈었으며, 당시 형주에 머물던 감녕을 황조에게 천거하여 감녕이 손권에게 가려던 생각을 잠시 접고 황조에게 의탁하게 했다. 그러나 문인을 중시하던 황조는 수적 출신인 감녕을 끝끝내 안중에도 두지 않았고, 결국 감녕은 황옥향, 소비와 작별을 고한 뒤 손권에게 귀순하였다. 그 후로 황옥향이 다시 전장에 나선 모습은 찾아볼 수 없었다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ11040","remark":"","surname":"黄","surnameTc":"黃","surnameEn":"Huang","surnameJp":"黄","surnameKr":"황","surnameOther":"","name":"玉香","nameTc":"玉香","nameEn":"Yuxiang","nameJp":"玉香","nameKr":"옥향","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"黄玉香","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"2","workYear":"192","city":"CS1004","gender":"1","rule":"70","force":"75","wise":"71","politics":"51","charm":"76","will":"68","ruleTalent":"9","forceTalent":"8","wiseTalent":"9","politicsTalent":"6","charmTalent":"10","willTalent":"9","weaponMaster":"27/27/27/27/75/44/53/27","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"","battleSkill":"","debateCard":"","warSoul":"S1002605","battleSoul":"","debateSoul":"","warSoulPoint":"5200","battleSoulPoint":"5600","debateSoulPoint":"5000","strategy":"1007215","strategy2":"1001005","professions":"3/0/2/4/0/3/3/0/1/1/1/2/0/1/2/5/3/2/3/1/1/3/1/2","attribute2":"81/78/77/51/76/72","morality":"4","compatible":"58","loyalty":"100","reputation":"0","evaluate":"0","title":"","rank":"9","birth":"176","show":"188","death":"232","age":"0","injury":"","deathReason":"0","type":"1","npcTag":"0","npcNum":"1","microScene":"0","isImportant":"0","speaking":"6","weapon":"WP1006702","armor":"WP1010902","helmet":"WP1026605","treasure":"","horse":"","shield":"","character":"0/1;1/1;3/1;10/1;15/1;18/1;27/1;33/1;39/1;48/1","father":"WJ10152/0","mother":"","children":"","family":"","modInfo":"","brother":"","couple":"","otherRelationship":"","belief":"0","isVIP":"0","startVIPYear":"0","endVIPYear":"0","description":"汉末江夏太守黄祖之女，黄射之姊。黄玉香天性放荡不羁，嗜酒擅射，喜爱在江夏的竹林中彻夜游玩射猎。曾在黄祖部队被孙坚追击时接应士