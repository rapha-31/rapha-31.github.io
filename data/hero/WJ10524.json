":"WP18005","armor":"WP1008805","helmet":"WP1021105"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1009","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[74,65,65,49,62,58],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP18005","armor":"WP1008805","helmet":"WP1021105"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1009","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[74,65,65,49,62,58],"title":-1,"rank":"9","loyalty":"99","reputation":"15850","equipment":{"weapon":"WP18005","armor":"WP1008805","helmet":"WP1021105"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10060","city":"CS1009","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[74,65,65,49,62,58],"title":-1,"rank":"9","loyalty":"99","reputation":"15850","equipment":{"weapon":"WP18005","armor":"WP1008805","helmet":"WP1021105"},"couple":[]}],"storyEvents":[],"biography":{"zh":"袁绍的部将，豫州刺史。孙坚攻打董卓期间被派往夺取孙坚的阳城，迫使孙坚回军救援。袁术派公孙瓒之弟公孙越助孙坚攻打周昂，周昂未能守住，被击败。公孙越在此战中中箭身亡。后来，袁绍又任命周昂为九江太守。袁术派孙贲攻打周昂，周昂的弟弟周喁帮助周昂抵御袁术军，最终周昂在阴陵被孙贲击败。","tc":"袁紹的部將，豫州刺史。孫堅攻打董卓期間被派往奪取孫堅的陽城，迫使孫堅回軍救援。袁術派公孫瓚之弟公孫越助孫堅攻打周昂，周昂未能守住，被擊敗。公孫越在此戰中中箭身亡。后來，袁紹又任命周昂為九江太守。袁術派孫賁攻打周昂，周昂的弟弟周喁幫助周昂抵御袁術軍，最終周昂在陰陵被孫賁擊敗。","en":"An officer under Yuan Shao and Lt. Governor of Yu Province. During Sun Jian's campaign against Dong Zhuo, Zhou Ang was dispatched to seize Sun Jian's base at Yangcheng, forcing Sun Jian to withdraw his troops to defend it. Yuan Shu sent Gongsun Zan's brother Gongsun Yue to assist Sun Jian in attacking Zhou Ang. Zhou Ang was unable to hold his position and was defeated, though Gongsun Yue was killed by a stray arrow in this engagement. Later, Yuan Shao appointed Zhou Ang as Governor of Jiujiang. When Yuan Shu sent Sun Ben to attack Zhou Ang, his brother Zhou Yong came to his aid against Yuan Shu's forces, but ultimately Zhou Ang was defeated by Sun Ben at Yinling.","jp":"袁紹の部将。豫州刺史。孫堅が董卓を討伐している最中に孫堅の陽城を奪取すべく派遣され、孫堅を救援のために引き返させた。袁術が公孫瓚の弟である公孫越を派遣して孫堅を助けさせ、周昂を攻めさせると、周昂は守りきれずに敗れた。公孫越はこの戦いで矢に当たって戦死した。その後、袁紹によって九江太守に任じられた。袁術が孫賁を派遣して周昂を攻めさせると、弟の周喁が加勢して袁術軍を防いだが、最終的に周昂は陰陵で孫賁に敗れた。","kr":"원소의 부장이자 예주자사였다. 손견이 동탁을 치는 동안 손견의 양성을 빼앗기 위해 파견되어, 손견이 군대를 돌려 구원하러 오게 만들었다. 이에 원술이 공손찬의 아우 공손월을 보내 손견을 도와 주앙을 치게 하였으나, 주앙은 이를 지켜내지 못하고 패배했다. 공손월은 이 전투에서 화살에 맞아 전사했다. 이후 원소는 주앙을 다시 구강태수로 임명했다. 원술이 손분을 보내 주앙을 치게 하자 주앙의 동생 주우이 주앙을 도와 원술군에 맞섰으나, 결국 주앙은 음릉에서 손분에게 패했다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10524","remark":"","surname":"周","surnameTc":"周","surnameEn":"Zhou","surnameJp":"周","surnameKr":"주","surnameOther":"","name":"昂","nameTc":"昂","nameEn":"Ang","nameJp":"昂","nameKr":"앙","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"周昂","power":"WJ10060","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"2","workYear":"184","city":"CS1009","gender":"0","rule":"74","force":"65","wise":"65","politics":"49","charm":"62","will":"58","ruleTalent":"8","forceTalent":"7","wiseTalent":"7","politicsTalent":"4","charmTalent":"6","willTalent":"6","weaponMaster":"31/31/31/31/65/25/50/31","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"1001302;1004702","battleSkill":"","debateCard":"","warSoul":"","battleSoul":"","debateSoul":"","warSoulPoint":"5400","battleSoulPoint":"4200","debateSoulPoint":"4200","strategy":"1001508","strategy2":"","professions":"0/0/0/3/3/0/2/0/0/0/1/2/0/1/2/0/0/1/0/2/0/1/0/1","attribute2":"50/50/50/50/50/50","morality":"4","compatible":"76","loyalty":"99","reputation":"15850","evaluate":"0","title":"","rank":"9","birth":"152","show":"184","death":"195","age":"0","in