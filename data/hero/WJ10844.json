,58,54,47,47,52],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1001005","helmet":"WP1024205"},"couple":[]},{"story":{"id":"S10915","name":{"zh":"北伐中原","en":"Northern Expedition"},"year":"227","month":"3"},"faction":"WJ10127","city":"CS1031","noRecruit":false,"reject":null,"state":"2","role":3,"stats":[56,58,54,47,47,52],"title":-1,"rank":"5","loyalty":"100","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1001005","helmet":"WP1024205"},"couple":[]},{"story":{"id":"S11015","name":{"zh":"再出岐山","en":"Return to Qishan"},"year":"231","month":"1"},"faction":"WJ10127","city":"CS1031","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[56,58,54,47,47,52],"title":-1,"rank":"5","loyalty":"100","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1001005","helmet":"WP1024205"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":"WJ10127","city":"CS1031","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[56,58,54,47,47,52],"title":-1,"rank":"5","loyalty":"100","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1001005","helmet":"WP1024205"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1013","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[56,58,54,47,47,52],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1001005","helmet":"WP1024205"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1026","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[56,58,54,47,47,52],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1001005","helmet":"WP1024205"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10104","city":"CS1013","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[56,58,54,47,47,52],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1001005","helmet":"WP1024205"},"couple":[]}],"storyEvents":[],"biography":{"zh":"魏国安定太守。诸葛亮北伐时，崔谅率兵营救被困的夏侯楙，但被关兴、张苞所阻拦，便逃回安定，无奈路上又遇魏延，崔谅便又逃往天水，但又遇诸葛亮，崔谅走投无路便诈降，欲将蜀军引进南安后再战。但计谋被诸葛亮识破，蜀军入南安后直斩魏将杨陵，崔谅急忙骑马而逃，被张苞刺于马下。","tc":"魏國安定太守。諸葛亮北伐時，崔諒率兵營救被困的夏侯楙，但被關興、張苞所阻攔，便逃回安定，無奈路上又遇魏延，崔諒便又逃往天水，但又遇諸葛亮，崔諒走投無路便詐降，欲將蜀軍引進南安后再戰。但計謀被諸葛亮識破，蜀軍入南安后直斬魏將楊陵，崔諒急忙騎馬而逃，被張苞刺于馬下。","en":"Governor of Anding for Wei. During Zhuge Liang's Northern Expedition, Cui Liang led troops to rescue the besieged Xiahou Mao but was blocked by Guan Xing and Zhang Bao. He fled back toward Anding, only to encounter Wei Yan on the road. Changing direction to Tianshui, he ran into Zhuge Liang instead. Cornered and out of options, Cui Liang feigned surrender, intending to lure the Shu army into Nan'an for a counterattack. But Zhuge Liang saw through his scheme, and upon entering Nan'an, the Shu forces immediately executed the Wei general Yang Ling. Cui Liang desperately spurred his horse to escape, but Zhang Bao speared him from his horse.","jp":"魏の安定太守。諸葛亮の北伐時、崔諒は包囲された夏侯楙を救援すべく兵を率いて向かうも、関興や張苞に阻まれて安定へと退却する。しかし道中で魏延に遭遇したため天水へ逃れようとするが、そこでも諸葛亮に遭遇してしまう。進退窮まった崔諒は偽って降伏し、蜀軍を南安に誘い込んでから戦おうと目論んだ。だが、その計略は諸葛亮に見破られており、南安に入城した蜀軍によって魏将の楊陵は討ち取られた。崔諒は慌てて馬に乗って逃走を図るも、張苞に槍で突かれて落馬し、討ち取られた。","kr":"위나라의 안정태수. 제갈량이 북벌할 때 포위된 하후무를 구원하고자 군사를 이끌고 나섰으나 관흥과 장포에게 가로막혀 안정으로 달아났다. 그러나 도중에 위연과 마주쳐 다시 천수로 달아났고, 그곳에서도 제갈량과 마주쳐 진퇴양난에 빠지자 거짓 투항을 했다. 촉군을 남안으로 유인한 뒤 다시 싸우려 했으나 제갈량에게 계책을 간파당했고, 남안에 입성한 촉군이 위나라 장수 양릉을 단숨에 베어 버리자 최량은 급히 말을 타고 달아나다 장포에게 찔려 낙마했다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10844","remark":"","surname":"崔","surnameTc":"崔","surnameEn":"Cui","surnameJp":"崔","surnameKr":"최","surnameOther":"","name":"谅","nameT