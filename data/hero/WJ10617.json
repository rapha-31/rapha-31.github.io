10038","code":"0"}]},"mother":{"label":{"zh":"母亲","en":"Mother"},"people":[{"id":"WJ11001","code":"0"}]},"family":{"label":{"zh":"亲属","en":"Relatives"},"people":[{"id":"WJ10030","code":"100"},{"id":"WJ10393","code":"100"},{"id":"WJ11003","code":"100"},{"id":"WJ10020","code":"100"},{"id":"WJ10621","code":"100"},{"id":"WJ10040","code":"100"},{"id":"WJ11004","code":"100"}]}},"clans":[{"id":"GI100815","name":{"zh":"富春孙氏","en":"The Sun clan of Fuchun"},"years":["184","280"],"desc":{"zh":"出自妫姓，齐田完之后，孙武之子孙明封富春侯，世居富春。东吴皇族。孙坚、孙策奠基江东，孙权称帝建国，与魏蜀鼎立近六十年，最终为司马晋消灭，是三国中存在最久的政权。","en":"Originating from the Gui surname, descendants of Tian Wan of Qi. Sun Ming, son of Sun Wu, was enfeoffed as the Marquis of Fuchun, and the clan resided in Fuchun for generations. The imperial clan of Eastern Wu. Sun Jian and Sun Ce laid the foundation in Jiangdong, and Sun Quan would Proclaim Emperor to establish the state, standing in a tripartite balance with Wei and Shu for nearly sixty years before ultimately being destroyed by Sima Jin, enduring as the longest-lasting regime among the Three Kingdoms."},"talent":{"military":"9","commerce":"4","politics":"7"}}],"friendGroups":[{"story":"S10802","members":["WJ10039","WJ10020","WJ10040","WJ10393","WJ10258"]},{"story":"S10615","members":["WJ10039","WJ10020","WJ10040","WJ10393","WJ10258"]},{"story":"S10402","members":["WJ10039","WJ10020","WJ10040","WJ10393","WJ10258"]},{"story":"S10415","members":["WJ10039","WJ10020","WJ10040","WJ10393","WJ10258"]},{"story":"S10202","members":["WJ10039","WJ10258","WJ10020","WJ10040","WJ10393"]},{"story":"S10715","members":["WJ10039","WJ10258","WJ10020","WJ10040","WJ10393"]},{"story":"S10102","members":["WJ10039","WJ10258","WJ10020","WJ10040","WJ10393"]},{"story":"S10315","members":["WJ10039","WJ10020","WJ10393","WJ10040"]},{"story":"S10302","members":["WJ10039","WJ10020","WJ10393","WJ10040"]},{"story":"S10602","members":["WJ10039","WJ10020","WJ10040","WJ10393"]},{"story":"S10502","members":["WJ10039","WJ10393","WJ10040"