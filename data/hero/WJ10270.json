":"WP1007905","helmet":"WP1023305"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":null,"city":"CS1019","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[67,78,31,32,39,42],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1005902","armor":"WP1007905","helmet":"WP1023305"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1019","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[67,78,31,32,39,42],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1005902","armor":"WP1007905","helmet":"WP1023305"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1029","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[67,78,31,32,39,42],"title":-1,"rank":"7","loyalty":"100","reputation":"2350","equipment":{"weapon":"WP1005902","armor":"WP1007905","helmet":"WP1023305"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10050","city":"CS1019","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[67,78,31,32,39,42],"title":-1,"rank":"7","loyalty":"100","reputation":"2350","equipment":{"weapon":"WP1005902","armor":"WP1007905","helmet":"WP1023305"},"couple":[]}],"storyEvents":[],"biography":{"zh":"吕布麾下八健将之一。跟随从曹操手中夺走兖州的吕布和曹操军抗战。吕布进入徐州后，和宋宪购买艮马时被张飞袭击，愤怒的吕布就将刘备赶出徐州。之后，被曹操和刘备的联合军包围下邳，当同僚的侯成被吕布处罚时，便同侯成、宋宪共捕吕布向曹操投降。不久之后以曹操部下参加官渡之战，与宋宪一同被颜良所杀。","tc":"呂布麾下八健將之一。跟隨從曹操手中奪走兗州的呂布和曹操軍抗戰。呂布進入徐州后，和宋憲購買艮馬時被張飛襲擊，憤怒的呂布就將劉備趕出徐州。之后，被曹操和劉備的聯合軍包圍下邳，當同僚的侯成被呂布處罰時，便同侯成、宋憲共捕呂布向曹操投降。不久之后以曹操部下參加官渡之戰，與宋憲一同被顏良所殺。","en":"One of Lu Bu's Eight Elite Generals. He fought against Cao Cao's forces alongside Lu Bu during the struggle for Yan Province. After Lu Bu entered Xu Province, an incident in which Zhang Fei attacked while Wei Xu and Song Xian were purchasing horses enraged Lu Bu, who then expelled Liu Bei from Xu Province. Later, when Cao Cao and Liu Bei's combined forces besieged Xiapi and their colleague Hou Cheng was punished by Lu Bu, Wei Xu joined Hou Cheng and Song Xian in capturing Lu Bu and surrendering to Cao Cao. Shortly after, serving under Cao Cao at the Battle of Guandu, he was killed alongside Song Xian by Yan Liang.","jp":"呂布配下の八健将の一人。曹操から兗州を奪った呂布に従い、曹操軍と戦った。呂布が徐州に入ると、宋憲とともに馬を買い求めた際に張飛の襲撃を受け、激怒した呂布は劉備を徐州から追い払った。その後、曹操と劉備の連合軍に下邳を包囲され、同僚の侯成が呂布に処罰されると、侯成や宋憲とともに呂布を捕縛して曹操に降伏した。やがて曹操の配下として官渡の戦いに参加したが、宋憲とともに顔良に討ち取られた。","kr":"여포 휘하 팔건장 중 한 사람. 조조에게서 연주를 빼앗은 여포를 따라 조조군에 맞서 싸웠다. 여포가 서주에 들어간 후 송헌과 함께 말을 사들이던 중 장비의 습격을 받았고, 이에 분노한 여포는 유비를 서주에서 내쫓았다. 이후 하비에서 조조와 유비의 연합군에게 포위되었을 때, 동료인 후성이 여포에게 처벌을 받자 후성, 송헌과 함께 여포를 사로잡아 조조에게 항복했다. 얼마 뒤 조조의 부하로서 관도대전에 참전했으나 송헌과 함께 안량에게 죽임을 당했다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10270","remark":"","surname":"魏","surnameTc":"魏","surnameEn":"Wei","surnameJp":"魏","surnameKr":"위","surnameOther":"","name":"续","nameTc":"續","nameEn":"Xu","nameJp":"続","nameKr":"속","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"魏续","power":"WJ10048","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"2","workYear":"184","city":"CS1029","gender":"0","rule":"67","force":"78","wise":"31","politics":"32","charm":"39","will":"42","ruleTalent":"7","forceTalent":"10","wiseTalent":"2","politicsTalent":"2","charmTalent":"3","willTalent":"3","weaponMaster":"78/37/37/37/37/11/50/37","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"","battleSkill":"","debateCard":"","warSoul":"","battleSoul":"1005305","debateSoul":"","warSoulPoint":"4400","battleSoulPoint":"6000","debateSoulPoint":"900","strategy":"1008315","strategy2":"10