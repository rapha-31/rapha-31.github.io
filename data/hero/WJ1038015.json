002","armor":"WP1014905","helmet":"WP1027605"},"couple":[]},{"story":{"id":"S10915","name":{"zh":"北伐中原","en":"Northern Expedition"},"year":"227","month":"3"},"faction":"WJ10127","city":"CS1027","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[62,25,74,77,75,78],"title":-1,"rank":"5","loyalty":"99","reputation":"0","equipment":{"weapon":"WP1007002","armor":"WP1014905","helmet":"WP1027605"},"couple":[]},{"story":{"id":"S11015","name":{"zh":"再出岐山","en":"Return to Qishan"},"year":"231","month":"1"},"faction":"WJ10127","city":"CS1027","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[62,25,74,77,75,78],"title":-1,"rank":"5","loyalty":"99","reputation":"0","equipment":{"weapon":"WP1007002","armor":"WP1014905","helmet":"WP1027605"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":"WJ10127","city":"CS1027","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[62,25,74,77,75,78],"title":-1,"rank":"5","loyalty":"99","reputation":"0","equipment":{"weapon":"WP1007002","armor":"WP1014905","helmet":"WP1027605"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1027","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[62,25,74,77,75,78],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1007002","armor":"WP1014905","helmet":"WP1027605"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1027","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[62,25,74,77,75,78],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1007002","armor":"WP1014905","helmet":"WP1027605"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10127","city":"CS1016","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[62,25,74,77,75,78],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1007002","armor":"WP1014905","helmet":"WP1027605"},"couple":[]}],"storyEvents":[],"biography":{"zh":"曹魏重臣，西晋太保卫瓘之父。少年早成，以才学著称。被曹操征召后，建议置盐官专卖、招怀流民以安定关中，为曹操平定北方奠定了基础。魏国建立后，与王粲共同典掌制度。曹丕称帝后官至尚书，封阳吉亭侯；魏明帝时进封阌乡侯。卫觊同时也是一位书法家，著有《魏官仪》等。","tc":"曹魏重臣，西晉太保衛瓘之父。少年早成，以才學著稱。被曹操征召后，建議置鹽官專賣、招懷流民以安定關中，為曹操平定北方奠定了基礎。魏國建立后，與王粲共同典掌制度。曹丕稱帝后官至尚書，封陽吉亭侯；魏明帝時進封閿鄉侯。衛覬同時也是一位書法家，著有《魏官儀》等。","en":"A prominent minister of Cao Wei and father of Wei Guan, Grand Guardian of Western Jin. Precocious in his youth, he was renowned for his scholarship and talent. Summoned by Cao Cao, he advised appointing salt officials to establish state monopolies and resettling displaced refugees to stabilize Guanzhong, laying the foundation for Cao Cao's pacification of the north. Following the founding of the Wei state, he codified court institutions alongside Wang Can. After Cao Pi proclaimed himself emperor, Wei Ji rose to Master of Writing and was enfeoffed as Marquis of Yangji Pavilion, under Emperor Ming of Wei, he was advanced to Marquis of Wenxiang. He was also an accomplished calligrapher who authored works such as ‘Official Protocols of Wei.’","jp":"曹魏の重臣であり、西晋の太保・衛瓘の父。若くして大成し、才学によって名を馳せた。曹操に招聘された後、塩官を置いて専売を行い、流民を慰撫して関中を安定させるよう進言し、曹操による北方平定の基礎を築いた。魏国の建国後は王粲とともに制度の制定を掌った。曹丕の皇帝即位後は尚書に至り、陽吉亭侯に封じられ、明帝の代に閿郷侯に進封された。また書家でもあり、『魏官儀』などの著作を残した。","kr":"조위의 중신이자 서진 태보 위관의 부친. 어린 시절부터 일찍이 두각을 나타내어 뛰어난 재학과 식견으로 명성을 떨쳤다. 조조의 부름을 받은 뒤에는 소금 전매를 위한 염관을 설치하고 유민을 불러 모아 관중을 안정시킬 것을 건의하여, 조조가 북방을 평정하는 기틀을 마련했다. 위나라가 건국된 후 왕찬과 함께 국가의 제도를 정비하고 관장했다. 조비가 칭제한 후 관직이 상서에 이르고 양길정후에 봉해졌으며, 위 명제 때 문향후로 진봉되었다. 또한 당대의 뛰어난 서예가이기도 하여 저서로 《위관의》 등을 남겼다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ1038015","remark":"","surname":"卫","surnameTc":"衛","surnameEn":"Wei","surnameJp":"衛","surnameKr":"위","surnameOther":"","name":"觊","nameTc":"覬"