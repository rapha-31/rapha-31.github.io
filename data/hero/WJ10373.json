ate":"3","role":0,"stats":[62,41,79,78,52,84],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1006205","helmet":"WP1020905"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":null,"city":"CS1005","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[62,41,79,78,52,84],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1006205","helmet":"WP1020905"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1005","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[62,41,79,78,52,84],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1006205","helmet":"WP1020905"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1039","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[62,41,79,78,52,84],"title":-1,"rank":"9","loyalty":"0","reputation":"1050","equipment":{"weapon":"WP10014","armor":"WP1006205","helmet":"WP1020905"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10011","city":"CS1005","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[62,41,79,78,52,84],"title":-1,"rank":"9","loyalty":"100","reputation":"1050","equipment":{"weapon":"WP10014","armor":"WP1006205","helmet":"WP1020905"},"couple":[]}],"storyEvents":[],"biography":{"zh":"蜀国司马。为人忠心耿耿，屡屡劝谏。奉命在长江一带设立烽火，以提防敌人来袭。随后王甫举荐忠正廉直的赵累取代潘浚总督荆州，关羽并不采纳。关羽被困麦城时，与其一同守城，关羽父子弃城而逃时与周仓留守麦城。得知关羽被捕后拒降自尽。","tc":"蜀國司馬。為人忠心耿耿，屢屢勸諫。奉命在長江一帶設立烽火，以提防敵人來襲。隨后王甫舉薦忠正廉直的趙累取代潘浚總督荊州，關羽并不采納。關羽被困麥城時，與其一同守城，關羽父子棄城而逃時與周倉留守麥城。得知關羽被捕后拒降自盡。","en":"Jnr Minister of War of Shu. Loyal and devoted, he repeatedly offered sound counsel. He was assigned to set up signal beacons along the Yangtze to guard against enemy incursions. He recommended the upright Zhao Lei to replace Pan Jun as chief administrator of Jing Province, but Guan Yu refused. When Guan Yu was trapped at Maicheng, Wang Fu remained with him to defend the city. After Guan Yu and his son abandoned the city in an attempt to flee, Wang Fu and Zhou Cang stayed behind. Upon learning of Guan Yu's capture, he refused to surrender and took his own life.","jp":"蜀の司馬。人となりは忠誠篤く、度々諫言を行った。命を受けて長江一帯に烽火を設け、敵の来襲に備えた。その後、王甫が忠正廉直な趙累を推挙して潘濬に代わり荊州を総督させようとしたが、関羽には容れられなかった。関羽が麦城に追い詰められた際は共に城を守り、関羽父子が城を脱出する際にも周倉と共に麦城の留守を預かった。関羽が捕らえられたと知ると、降伏を拒んで自害した。","kr":"촉나라의 사마다. 충성심이 지극하여 누차 간언을 올렸다. 적의 내습에 대비하고자 명을 받아 장강 일대에 봉화를 설치했다. 이후 충직하고 청렴한 조루를 천거해 반준을 대신하여 형주를 총괄하게 하려 했으나 관우는 이를 받아들이지 않았다. 관우가 맥성에 포위되었을 때 함께 성을 지켰으며, 관우 부자가 성을 버리고 탈출하자 주창과 함께 맥성에 남았다. 관우가 사로잡혔다는 소식을 듣고는 투항을 거부한 채 자결했다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10373","remark":"","surname":"王","surnameTc":"王","surnameEn":"Wang","surnameJp":"王","surnameKr":"왕","surnameOther":"","name":"甫","nameTc":"甫","nameEn":"Fu","nameJp":"甫","nameKr":"보","nameOther":"","word":"国山","wordTc":"國山","wordEn":"Guoshan","wordJp":"国山","wordKr":"국산","wordOther":"","icon":"王甫","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"1","workYear":"190","city":"CS1039","gender":"0","rule":"62","force":"41","wise":"79","politics":"78","charm":"52","will":"84","ruleTalent":"6","forceTalent":"3","wiseTalent":"10","politicsTalent":"10","charmTalent":"4","willTalent":"7","weaponMaster":"15/15/62/15/15/61/50/15","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"","battleSkill":"","debateCard":"","warSoul":"","battleSoul":"1015805","debateSoul":"1003705","warSoulPoint":"3800","battleSoulPoint":"4000","debateSoulPoint":"6200","strategy":"","strategy2":"1000305","professi