te":"3","role":0,"stats":[68,72,38,35,42,82],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1008005","helmet":"WP1021105","shield":"WP1009502"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":null,"city":"CS1036","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[68,72,38,35,42,82],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1008005","helmet":"WP1021105","shield":"WP1009502"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1036","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[68,72,38,35,42,82],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1008005","helmet":"WP1021105","shield":"WP1009502"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1036","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[68,72,38,35,42,82],"title":-1,"rank":"9","loyalty":"0","reputation":"2600","equipment":{"weapon":"WP10014","armor":"WP1008005","helmet":"WP1021105","shield":"WP1009502"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10160","city":"CS1036","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[68,72,38,35,42,82],"title":-1,"rank":"9","loyalty":"99","reputation":"2600","equipment":{"weapon":"WP10014","armor":"WP1008005","helmet":"WP1021105","shield":"WP1009502"},"couple":[]}],"storyEvents":[],"biography":{"zh":"张鲁麾下武将。曹操兵至汉中时，防守阳平关。夜袭曹军时使得张郃撤退，后与杨任试图行刺巡查曹操，但被许褚击退。后来曹操设计诈退，杨昂不听杨任劝阻，率军追击，在雾中被张郃拦截并斩杀。","tc":"張魯麾下武將。曹操兵至漢中時，防守陽平關。夜襲曹軍時使得張郃撤退，后與楊任試圖行刺巡查曹操，但被許褚擊退。后來曹操設計詐退，楊昂不聽楊任勸阻，率軍追擊，在霧中被張郃攔截并斬殺。","en":"An officer under Zhang Lu. When Cao Cao's forces arrived in Hanzhong, he was responsible for defending Yangping Pass. His night raid on the Cao army forced Zhang He to retreat. He later attempted to assassinate Cao Cao during an inspection tour alongside Yang Ren, but was repelled by Xu Chu. When Cao Cao subsequently employed a feigned retreat, Yang Ang disregarded Yang Ren's warnings and led his troops in pursuit, only to be intercepted and slain by Zhang He in the fog.","jp":"張魯配下の武将。曹操が漢中に進軍した際、陽平関の守備に就いた。曹操軍へ夜襲を仕掛けて張郃を退却させ、その後、楊任とともに巡察中の曹操の暗殺を試みるも許褚に撃退された。やがて曹操が計略により偽装退却を行うと、楊昂は楊任の制止を聞かずに軍を率いて追撃したが、霧の中で張郃に阻まれて討ち取られた。","kr":"장로 휘하의 무장. 조조의 군세가 한중에 이르렀을 때 양평관을 수비했다. 조조군을 야습하여 장합을 퇴각시켰고, 이후 양임과 함께 순시 중이던 조조를 기습하려 했으나 허저에게 격퇴당했다. 훗날 조조가 거짓으로 물러나는 계책을 쓰자, 양앙은 양임의 만류를 뿌리치고 군사를 이끌고 추격했다가 안개 속에서 장합에게 가로막혀 참살당했다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10593","remark":"","surname":"杨","surnameTc":"楊","surnameEn":"Yang","surnameJp":"楊","surnameKr":"양","surnameOther":"","name":"昂","nameTc":"昂","nameEn":"Ang","nameJp":"昂","nameKr":"앙","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"杨昂","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"0","workYear":"191","city":"CS1036","gender":"0","rule":"68","force":"72","wise":"38","politics":"35","charm":"42","will":"82","ruleTalent":"7","forceTalent":"8","wiseTalent":"3","politicsTalent":"2","charmTalent":"3","willTalent":"9","weaponMaster":"50/50/51/50/50/50/50/50","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"","battleSkill":"","debateCard":"","warSoul":"","battleSoul":"1012105","debateSoul":"","warSoulPoint":"4600","battleSoulPoint":"5100","debateSoulPoint":"1400","strategy":"1003108","strategy2":"","professions":"1/1/1/1/0/0/1/0/0/0/1/2/1/0/2/0/0/0/0/0/0/0/0/0","attribute2":"50/50/50/50/50/50","morality":"3","compatible":"10","loyalty":"0