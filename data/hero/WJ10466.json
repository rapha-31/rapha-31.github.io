:"249","month":"1"},"faction":"WJ1000115","city":"CS1026","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[58,62,33,38,40,56],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1000905","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1026","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[58,62,33,38,40,56],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1000905","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10225","city":"CS1072","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[58,62,33,38,40,56],"title":-1,"rank":"9","loyalty":"120","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1000905","helmet":"WP1023105"},"couple":[]}],"storyEvents":[],"biography":{"zh":"魏国武将，毌丘俭之弟。毌丘俭发动叛乱时随其起兵，被前来镇压的大将军司马师所击败，毌丘俭被射杀后与毌丘重一起逃往吴国。","tc":"魏國武將，毌丘儉之弟。毌丘儉發動叛亂時隨其起兵，被前來鎮壓的大將軍司馬師所擊敗，毌丘儉被射殺后與毌丘重一起逃往吳國。","en":"An officer of Wei and younger brother of Guanqiu Jian. When Guanqiu Jian launched his rebellion, he rose in arms alongside him. Defeated by Grand General Sima Shi, who came to suppress the revolt, he fled to Wu together with Guanqiu Zhong after Guanqiu Jian was shot and killed.","jp":"魏の武将。毌丘倹の弟。毌丘倹が反乱を起こした際にこれに従って挙兵したが、鎮圧に赴いた大将軍の司馬師に敗北した。毌丘倹が射殺された後、毌丘重とともに呉へと逃れた。","kr":"위나라의 무장이자 관구검의 아우. 관구검이 반란을 일으켰을 때 함께 거병하였으나, 진압에 나선 대장군 사마사에게 패배했다. 관구검이 사살된 후 관구중과 함께 오나라로 달아났다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10466","remark":"","surname":"毌丘","surnameTc":"毌丘","surnameEn":"Guanqiu","surnameJp":"毌丘","surnameKr":"관구","surnameOther":"","name":"秀","nameTc":"秀","nameEn":"Xiu","nameJp":"秀","nameKr":"수","nameOther":"","word":"叔恭","wordTc":"叔恭","wordEn":"Sh