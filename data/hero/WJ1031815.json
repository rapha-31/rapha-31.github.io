rice":"2500","slot":{"zh":"头盔","en":"Helmet"}}],"family":{"father":{"label":{"zh":"父亲","en":"Father"},"people":[{"id":"WJ1031615","code":"0"}]},"family":{"label":{"zh":"亲属","en":"Relatives"},"people":[{"id":"WJ1031715","code":"100"},{"id":"WJ10791","code":"100"}]}},"clans":[{"id":"GI107615","name":{"zh":"冯翊李氏","en":"The Li clan of Fengyi"},"years":["0","254"],"desc":{"zh":"出自嬴姓，皋陶之后。冯翊东县“旧无冠族”，李义以寒门崛起，数十年间成曹魏政治家族。曹魏时期从寒门崛起的传奇家族。李丰官至中书令，与夏侯玄密谋诛杀司马师，事泄被杀，家族几近覆灭。冯翊李氏的兴衰折射曹魏中后期权力斗争。","en":"Descended from the Ying surname and the lineage of Gaoyao. In Dong County of Fengyi, where there had 'traditionally been no prominent clans', Li Yi rose from humble origins, turning them into a Cao Wei political Family within decades. A legendary Family that rose from modest roots during the Cao Wei era. Li Feng rose to Director of the Secretariat and conspired with Xiahou Xuan to assassinate Sima Shi, when the plot was exposed, he was executed, bringing the Family to near extinction. The rise and fall of the Li clan of Fengyi reflects the power struggles of the mid-to-late Cao Wei period."},"talent":{"military":"2","commerce":"3","politics":"7"}}],"friendGroups":[],"body":{"name":"李伟","height":"很矮","shape":"一般"},"honorifics":[],"selfAddress":[],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"25","startPregnantAge":"0"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":null,"city":"CS1016","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[34,40,54,51,43,39],"title":-1,"rank":"9","loyalty":"0","reputation":"3350","equipment":{"weapon":"WP1007102","armor":"WP1014905","helmet":"WP1026405"},"couple":[]},{"story":{"id":"S10215","name":{"zh":"汉末三杰","en":"Three Heroes of the Late Han"},"year":"185","month":"3"},"faction":null,"city":"CS1016","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[34,40,54,51,43,39],"title":-1,"rank":"9","loyalty":"0","reputation":