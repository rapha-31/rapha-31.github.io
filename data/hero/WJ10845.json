ily":{"children":{"label":{"zh":"子女","en":"Children"},"people":[{"id":"WJ10782","code":"100"}]}},"clans":[{"id":"GI101215","name":{"zh":"博陵崔氏","en":"The Cui clan of Boling"},"years":["0","999"],"desc":{"zh":"同出姜姓，与清河崔氏同源而分支，博陵郡顶级望族。崔州平为诸葛亮好友。魏晋南北朝与清河崔氏并称“崔氏两望”。","en":"Also originating from the Jiang surname, sharing common ancestry with the Cui clan of Qinghe as a branch lineage, and standing as the premier prominent Family of Boling Commandery. Cui Zhouping was a Good friend of Zhuge Liang. Throughout the Wei, Jin, Northern and Southern Dynasties, they and the Cui clan of Qinghe were collectively hailed as the ‘Two Prestigious Cui Clans.’"},"talent":{"military":"3","commerce":"2","politics":"8"}}],"friendGroups":[],"body":null,"honorifics":[],"selfAddress":[],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"25","startPregnantAge":"0"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":"WJ10072","city":"CS1028","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[37,12,75,73,72,77],"title":-1,"rank":"3","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1007802","armor":"WP1015505","helmet":"WP1026405"},"couple":[]},{"story":{"id":"S10215","name":{"zh":"汉末三杰","en":"Three Heroes of the Late Han"},"year":"185","month":"3"},"faction":"WJ10072","city":"CS1029","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[37,12,75,73,72,77],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1007802","armor":"WP1015505","helmet":"WP1026405"},"couple":[]},{"story":{"id":"S10615","name":{"zh":"十常侍之乱","en":"Turmoil of the Ten Attendants"},"year":"188","month":"11"},"faction":"WJ10072","city":"CS1028","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[37,12,75,73,72,77],"title":-1,"rank":"2","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1007802","armor":"WP1015505","helmet":"WP1026405"},"couple":[]},{