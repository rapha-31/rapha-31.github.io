5,15,58,55],"title":-1,"rank":"9","loyalty":"0","reputation":"8300","equipment":{"weapon":"WP10014","armor":"WP1003205","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S10915","name":{"zh":"北伐中原","en":"Northern Expedition"},"year":"227","month":"3"},"faction":null,"city":"CS1030","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[47,60,55,15,58,55],"title":-1,"rank":"9","loyalty":"0","reputation":"8300","equipment":{"weapon":"WP10014","armor":"WP1003205","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S11015","name":{"zh":"再出岐山","en":"Return to Qishan"},"year":"231","month":"1"},"faction":null,"city":"CS1030","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[47,60,55,15,58,55],"title":-1,"rank":"9","loyalty":"0","reputation":"8300","equipment":{"weapon":"WP10014","armor":"WP1003205","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":null,"city":"CS1030","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[47,60,55,15,58,55],"title":-1,"rank":"9","loyalty":"0","reputation":"8300","equipment":{"weapon":"WP10014","armor":"WP1003205","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ1000115","city":"CS1030","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[47,60,55,15,58,55],"title":-1,"rank":"9","loyalty":"99","reputation":"8300","equipment":{"weapon":"WP10014","armor":"WP1003205","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1030","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[47,60,55,15,58,55],"title":-1,"rank":"9","loyalty":"0","reputation":"9450","equipment":{"weapon":"WP10014","armor":"WP1003205","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10125","city":"CS1035","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[47,60,55,15,58,55],"title":-1,"rank":"9","loyalty":"88","reputation":"9450","equipment":{"weapon":"WP10014","armor":"WP1003205","helmet":"WP1023105"},"couple":[]}],"storyEvents":[],"biography":{"zh":"魏国武将。邓艾、钟会讨伐蜀国时跟随邓艾，占领江油后因提出应让士兵休憩整备而使得邓艾愤怒，也因此对邓艾产生了不满。钟会之乱平定后，参与了诬陷邓艾的监军卫瓘怕其父子对自身进行报复，便遣田续押送邓艾父子的途中将二人灭口。","tc":"魏國武將。鄧艾、鐘會討伐蜀國時跟隨鄧艾，占領江油后因提出應讓士兵休憩整備而使得鄧艾憤怒，也因此對鄧艾產生了不滿。鐘會之亂平定后，參與了誣陷鄧艾的監軍衛瓘怕其父子對自身進行報復，便遣田續押送鄧艾父子的途中將二人滅口。","en":"An officer of Wei. During the conquest of Shu by Deng Ai and Zhong Hui, he served under Deng Ai. After capturing Jiangyou, he suggested that the soldiers should be allowed to rest and regroup, which angered Deng Ai and led him to harbor resentment toward Deng Ai. After Zhong Hui's rebellion was suppressed, the military supervisor Wei Guan, who had participated in framing Deng Ai and feared retribution from him and his son, dispatched Tian Xu to kill the father and son during their escort, silencing them permanently.","jp":"魏の武将。鄧艾と鍾会による蜀討伐の際、鄧艾に従軍した。江油を占領した後、兵を休息させて軍勢を整えるべきだと進言したことで鄧艾の怒りを買い、鄧艾に対して不満を抱くようになった。鍾会の乱が平定された後、鄧艾を陥れる計略に加担していた監軍の衛瓘は鄧艾父子の復讐を恐れ、田続を派遣して護送中の二人を口封じのために殺害させた。","kr":"위나라의 무장. 등애와 종회가 촉나라를 토벌할 때 등애를 따랐으며, 강유를 점령한 뒤 군사를 쉬게 하고 재정비해야 한다고 건의했다가 등애의 노여움을 샀고, 이로 인해 등애에게 불만을 품게 되었다. 종회의 난이 평정된 후, 등애를 모함하는 데 가담했던 감군 위관은 등애 부자가 자신에게 보복할 것을 두려워하여, 전속을 보내 등애 부자를 호송하던 도중에 두 사람을 입막음하고자 살해했다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10701","remark":"","surname":"田","surnameTc":"田","surnameEn":"Tian","surnameJp":"田","surnameKr":"전","surnameOther":"","name":"续","nameTc":"續","nameEn":"Xu","nameJp":"続","nameKr":"속","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"田续","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1",