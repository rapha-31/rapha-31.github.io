p":"270","price":"3000","slot":{"zh":"护甲","en":"Armor"}},{"id":"WP1019205","name":{"zh":"毛胄","en":"Fur Helm"},"level":"0","description":{"zh":"采用了与铁札甲类似的工序锻造的头盔，并带有兽毛作为装饰，多为北方游牧民族佩戴。","en":"A helmet forged in a process similar to lamellar armor, trimmed with animal fur, commonly worn by northern nomadic peoples."},"defenceVal":"2","price":"800","slot":{"zh":"头盔","en":"Helmet"}}],"family":{"family":{"label":{"zh":"亲属","en":"Relatives"},"people":[{"id":"WJ10120","code":"100"}]}},"clans":[{"id":"GI114015","name":{"zh":"南中孟氏","en":"The Meng Clan of Nanzhong"},"years":["200","999"],"desc":{"zh":"出自汉族移民后裔，为世居南中的汉族大姓。孟获为南中豪强大姓首领，“为夷、汉所服”。雍闿死后继任叛军主帅，被诸葛亮“七擒七纵”后归降，官至季汉御史中丞。","en":"Descended from Han migrants, they were a prominent Han clan that dwelt in Nanzhong for generations. Meng Huo was a chieftain of the powerful clans of Nanzhong, ‘revered by both the Yi and Han peoples.’ Following the death of Yong Kai, he succeeded him as Commander of the rebel forces. After being ‘captured and released seven times’ by Zhuge Liang, he surrendered, eventually rising to Chief of Records in Shu Han."},"talent":{"military":"7","commerce":"1","politics":"4"}}],"friendGroups":[{"story":"S10115","members":["WJ10120","WJ10124","WJ10213","WJ10216","WJ10231","WJ10422","WJ10432","WJ10433","WJ10434","WJ10548","WJ10664","WJ10665","WJ10666","WJ10667","WJ10668"]},{"story":"S10915","members":["WJ10120","WJ10124","WJ10213","WJ10216","WJ10231","WJ10422","WJ10432","WJ10433","WJ10434","WJ10548","WJ10664","WJ10665","WJ10666","WJ10667","WJ10668"]},{"story":"S11015","members":["WJ10120","WJ10124","WJ10213","WJ10216","WJ10231","WJ10422","WJ10432","WJ10433","WJ10434","WJ10548","WJ10664","WJ10665","WJ10666","WJ10667","WJ10668"]},{"story":"S11115","members":["WJ10120","WJ10124","WJ10213","WJ10216","WJ10231","WJ10422","WJ10432","WJ10433","WJ10434","WJ10548","WJ10664","WJ10665","WJ10666","WJ10667","WJ10668"]}],"body":null,"honorifics":[],"selfAddress":[],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"