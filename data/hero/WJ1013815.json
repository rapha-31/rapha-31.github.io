0","slot":{"zh":"头盔","en":"Helmet"}}],"family":{"children":{"label":{"zh":"子女","en":"Children"},"people":[{"id":"WJ10406","code":"100"},{"id":"WJ10860","code":"100"}]},"otherRelationship":{"label":{"zh":"其他关系","en":"Other relationships"},"people":[{"id":"WJ10001","code":"7"}]}},"clans":[{"id":"GI112615","name":{"zh":"沛国丁氏","en":"The Ding clan of Pei"},"years":["0","999"],"desc":{"zh":"出自姜姓，周武王封齐太公之子伋为丁公，后裔以丁为氏。沛国丁氏为沛国谯县顶级名门，汉末出过三公丁宫，门第远在同县的夏侯氏之上。曹嵩的夫人为丁氏，曹操本人正妻也是丁夫人，曹氏、夏侯氏、丁氏三族世代联姻，为谯沛地区的核心政治集团。","en":"Descended from the Jiang surname. When King Wu of Zhou enfeoffed Ji, son of the Grand Duke of Qi, as Duke Ding, his descendants adopted Ding as their surname. The Ding clan of Pei was a preeminent Family in Qiao County of Pei Commandery, producing the Three Excellencies minister Ding Gong during the late Han dynasty, with a clan stature far surpassing the Xiahou clan of the same county. Cao Song's wife was of the Ding clan, and Cao Cao's own principal wife was Lady Ding. The Cao, Xiahou, and Ding clans intermarried for generations, forming the core political coalition of the Qiao-Pei region."},"talent":{"military":"3","commerce":"4","politics":"6"}}],"friendGroups":[],"body":{"name":"丁冲","height":"平均","shape":"一般"},"honorifics":[],"selfAddress":[],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"25","startPregnantAge":"0"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":null,"city":"CS1025","noRecruit":false,"reject":["WJ10074",0],"state":"2","role":0,"stats":[41,23,66,67,58,54],"title":-1,"rank":"2","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1007102","armor":"WP1015505","helmet":"WP1026405"},"couple":[]},{"story":{"id":"S10215","name":{"zh":"汉末三杰","en":"Three Heroes of the Late Han"},"year":"185","month":"3"},"faction":null,"city":"CS1055","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[41,23,66,67,58,54],"title":-1,"rank":"9",