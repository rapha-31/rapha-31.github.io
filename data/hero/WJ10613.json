,65,56],"title":-1,"rank":"5","loyalty":"100","reputation":"14050","equipment":{"weapon":"WP1004602","armor":"WP1001505","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S11215","name":{"zh":"威震华夏","en":"Might Resounds Across China"},"year":"219","month":"7"},"faction":"WJ10020","city":"CS1055","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[77,70,75,73,65,56],"title":-1,"rank":"5","loyalty":"100","reputation":"14050","equipment":{"weapon":"WP1004602","armor":"WP1001505","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S10702","name":{"zh":"夷陵之战","en":"Battle of Yiling"},"year":"221","month":"5"},"faction":"WJ10020","city":"CS1057","noRecruit":false,"reject":null,"state":"2","role":3,"stats":[77,70,75,73,65,56],"title":-1,"rank":"5","loyalty":"100","reputation":"12300","equipment":{"weapon":"WP1004602","armor":"WP1001505","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S10115","name":{"zh":"征讨南蛮","en":"Southern Campaign"},"year":"225","month":"3"},"faction":"WJ10020","city":"CS1057","noRecruit":false,"reject":null,"state":"2","role":3,"stats":[77,70,75,73,65,56],"title":-1,"rank":"5","loyalty":"100","reputation":"12300","equipment":{"weapon":"WP1004602","armor":"WP1001505","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S10915","name":{"zh":"北伐中原","en":"Northern Expedition"},"year":"227","month":"3"},"faction":"WJ10020","city":"CS1057","noRecruit":false,"reject":null,"state":"2","role":3,"stats":[77,70,75,73,65,56],"title":-1,"rank":"5","loyalty":"100","reputation":"12300","equipment":{"weapon":"WP1004602","armor":"WP1001505","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S11015","name":{"zh":"再出岐山","en":"Return to Qishan"},"year":"231","month":"1"},"faction":"WJ10020","city":"CS1057","noRecruit":false,"reject":null,"state":"2","role":3,"stats":[77,70,75,73,65,56],"title":-1,"rank":"5","loyalty":"100","reputation":"12300","equipment":{"weapon":"WP1004602","armor":"WP1001505","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":"WJ10020","city":"CS1057","noRecruit":false,"reject":null,"state":"2","role":3,"stats":[77,70,75,73,65,56],"title":-1,"rank":"5","loyalty":"100","reputation":"12300","equipment":{"weapon":"WP1004602","armor":"WP1001505","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ10020","city":"CS1053","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[77,70,75,73,65,56],"title":-1,"rank":"5","loyalty":"100","reputation":"12300","equipment":{"weapon":"WP1004602","armor":"WP1001505","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1056","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[77,70,75,73,65,56],"title":-1,"rank":"9","loyalty":"0","reputation":"12500","equipment":{"weapon":"WP1004602","armor":"WP1001505","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10020","city":"CS1053","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[77,70,75,73,65,56],"title":-1,"rank":"9","loyalty":"100","reputation":"12500","equipment":{"weapon":"WP1004602","armor":"WP1001505","helmet":"WP1023105"},"couple":[]}],"storyEvents":[],"biography":{"zh":"吴国大臣，张昭之子。为人勇壮刚毅、忠诚正直，能甄识人物，勤于提携后进之士。张承年少时以才学知名，与诸葛瑾、步骘、严畯交好。孙权任骠骑将军时，征辟张承为骠骑将军西曹掾，后出任长沙西部都尉，他率军讨伐山越，获得精兵一万五千人。后来，张承担任濡须都督、奋威将军，被封为都乡侯，统领部曲五千人。孙权协助诸葛亮北伐时，张承领命与孙绍一同进攻魏国淮南一带。赤乌七年，张承病逝，享年六十七岁，谥号 “定”。","tc":"吳國大臣，張昭之子。為人勇壯剛毅、忠誠正直，能甄識人物，勤于提攜后進之士。張承年少時以才學知名，與諸葛瑾、步騭、嚴畯交好。孫權任驃騎將軍時，征辟張承為驃騎將軍西曹掾，后出任長沙西部都尉，他率軍討伐山越，獲得精兵一萬五千人。后來，張承擔任濡須都督、奮威將軍，被封為都鄉侯，統領部曲五千人。孫權協助諸葛亮北伐時，張承領命與孫紹一同進攻魏國淮南一帶。赤烏七年，張承病逝，享年六十七歲，謚號 “定”。","en":"A senior minister of Wu and the son of Zhang Zhao. He was brave, resolute, loyal, and upright, with a keen eye for talent and a dedication to mentoring younger scholars. In his youth, Zhang Cheng was renowned for his scholarship and befriended Zhuge Jin, Bu Zhi, and Yan Jun. When Sun Quan held the title of Horse Captain, he recruited Zhang Cheng as Western Section Clerk to the Horse Captain. Zhang Cheng later served as Western Commandant of Changsha, where he led campaigns against the Shanyue, gaining fifteen thousand elite soldiers. He subsequently served as Viceroy of Ruxu and General Who Inspires Authority, enfeoffed as Marquis of Duxiang, commanding a private force of five thousand troops. When Sun Quan assisted Zhuge Liang's Northern Expedition, Zhang Cheng was ordered alongside Sun Shao to attack Wei's Huainan region. In the seventh year of Chiwu (244 AD), Zhang Cheng died of illness at the age of sixty-seven and was posthumously titled ‘Ding’ (Steadfast).","jp":"呉の大臣で、張昭の子。勇壮剛毅かつ忠誠正直な人柄で、人物を鑑識する眼力に長け、後進の引き立てに尽力した。若くして才学で知られ、諸葛瑾、歩騭、厳畯と親交を結んだ。孫権が驃騎将軍となると、召し出されて驃騎将軍西曹掾となり、後に長沙西部都尉に就任した。軍を率いて山越を討伐し、精兵一万五千人を得た。後に濡須都督、奮威将軍に任じられ、都郷侯に封じられて部曲五千人を統率した。孫権が諸葛亮の北伐に協力した際には、命を受けて孫紹とともに魏の淮南一帯を攻めた。赤烏七年に病没、享年六十七歳。諡号は「定」。","kr":"오나라의 대신이자 장소의 아들이다. 사람됨이 용맹하고 강의하며 충성스럽고 정직하였으며, 인물을 알아보는 안목이 뛰어나 후진을 이끌어 주는 데 힘썼다. 장승은 젊은 시절 재주와 학식으로 명성을 떨쳐 제갈근, 보즐, 엄준과 두터운 친분을 맺었다. 손권이 표기장군이 되었을 때 장승을 표기장군 서조연으로 초빙하였고, 이후 장사서부도위로 나아가 군사를 이끌고 산월을 토벌하여 정예병 1만 5천 명을 얻었다. 훗날 유수도독과 분위장군에 임명되고 도향후에 봉해졌으며, 부곡 5천 명을 통솔했다. 손권이 제갈량의 북벌을 지원할 때 명을 받들어 손소와 함께 위나라의 회남 일대를 공격했다. 적오 7년에 병사하니 향년 67세였으며, 시호는 '정(定)'이다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10613","remark":"","surname":"张","surnameTc":"張","surnameEn":"Zhang","surnameJp":"張","surnameKr":"장","surnameOther":"","name":"承","nameTc":"承","nameEn":"Cheng","nameJp":"承","nameKr":"승","nameOther":"","word":"仲嗣","wordTc":"仲嗣","wordEn":"Zhongsi","wordJp":"仲嗣","wordKr":"중사","wordOther":"","icon":"张承","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0"