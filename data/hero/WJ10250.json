"warSkills":[],"battleCards":[],"debateCards":[{"id":"1001905","name":{"zh":"言毒诛心","en":"Venomlash"},"level":"1","description2":{"zh":"特殊攻击牌，造成较高伤害，命中时消除目标1点AP并拆除一张手牌。","en":"Special Attack Card. Deals high damage. On hit, removes 1 AP from the target and discards 1 card from their hand."},"ap":"2"},{"id":"1005805","name":{"zh":"反唇相讥","en":"Sharp Retort"},"level":"1","description2":{"zh":"回避牌，使用时对攻击方造成3倍杀伤。","en":"Evade Card. On use, deals 3x damage to the attacker."}}],"warSouls":[],"battleSouls":[{"id":"1019905","name":{"zh":"大补刀","en":"Grand Finishing Blow"},"level":"2","description2":{"zh":"攻击红血敌人时暴击率提高20%，击杀目标时立刻获得3点行动AP并为自身添加攻击提高状态","en":"Crit +20% when attacking red-HP enemies. On killing the target, instantly gain 3 AP and grant self Attack Up status"}}],"debateSouls":[{"id":"1000201","name":{"zh":"直击要害","en":"Vital Strike"},"level":"2","description2":{"zh":"回合开始时摸一张【必中】，使用后下一张攻击牌无法闪避。","en":"Draw a 【Sure Hit】 card at the start of your turn. After using it, your next Attack Card cannot be evaded."}}],"soulPoints":{"war":1600,"battle":5300,"debate":5000},"equipment":[{"id":"WP1004602","name":{"zh":"精铁剑","en":"Refined Iron Sword"},"level":"1","description":{"zh":"采用了质量较好的铁冶炼的长剑。","en":"A longsword forged from higher-quality iron."},"atkVal":"5","price":"2000","slot":{"zh":"武器","en":"Weapon"}},{"id":"WP1018005","name":{"zh":"锦绣长袍","en":"Embroidered Long Robe"},"level":"1","description":{"zh":"采用了普通的面料并进行了纹饰处理的衣袍，衣服的边缘处也添加了简单的纹饰。","en":"A robe made from ordinary patterned fabric, with simple decorative trim along the edges."},"defenceVal":"4","hp":"300","price":"2600","slot":{"zh":"护甲","en":"Armor"}},{"id":"WP1026105","name":{"zh":"鹊尾冠","en":"Magpie-Tail Crown"},"level":"1","description":{"zh":"汉朝特制小冠，由高祖所设，现多为老臣或喜好传统之人所佩戴。","en":"A small Han dynasty crown instituted by Emperor Gaozu, now mostly worn by veteran officials or traditionalists."},"mp":"660","evade":"7","price":"4000","slot":{"zh":"头盔","en":"Helmet"}}],"family":{"father":{"label":{"zh":"父亲","en":"Father"},"people":[{"id":"WJ10482","code":"0"}]},"otherRelationship":{"label":{"zh":"其他关系","en":"Other relationships"},"people":[{"id":"WJ10716","code":"6"}]}},"clans":[{"id":"GI100815","name":{"zh":"富春孙氏","en":"The Sun clan of Fuchun"},"years":["184","280"],"desc":{"zh":"出自妫姓，齐田完之后，孙武之子孙明封富春侯，世居富春。东吴皇族。孙坚、孙策奠基江东，孙权称帝建国，与魏蜀鼎立近六十年，最终为司马晋消灭，是三国中存在最久的政权。","en":"Originating from the Gui surname, descendants of Tian Wan of Qi. Sun Ming, son of Sun Wu, was enfeoffed as the Marquis of Fuchun, and the clan resided in Fuchun for generations. The imperial clan of Eastern Wu. Sun Jian and Sun Ce laid the foundation in Jiangdong, and Sun Quan would Proclaim Emperor to establish the state, standing in a tripartite balance with Wei and Shu for nearly sixty years before ultimately being destroyed by Sima Jin, enduring as the longest-lasting regime among the Three Kingdoms."},"talent":{"military":"9","commerce":"4","politics":"7"}}],"friendGroups":[],"body":null,"honorifics":[],"selfAddress":[],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"25","startPregnantAge":"0"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":null,"city":"CS1057","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[41,40,71,43,68,40],"title":-1,"rank":"9","loyalty":"0","reputation":"1000","equipment":{"weapon":"WP1004602","armor":"WP1018005","helmet":"WP1026105"},"couple":[]},{"story":{"id":"S10215","name":{"zh":"汉末三杰","en":"Three Heroes of the Late Han"},"year":"185","month":"3"},"faction":null,"city":"CS1057","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[41,40,71,43,68,40],"title":-1,"rank":"9","loyalty":"0","reputation":"1000","equipment":{"weapon":"WP1004602","armor":"WP1018005","helmet":"WP1026105"},"couple":[]},{"story":{"id":"S10615","name":{"zh":"十常侍之乱","en":"Turmoil of the Ten Attendants"},"year":"188","month":"11"},"faction":null,"city":"CS1057","noRecruit":false,"