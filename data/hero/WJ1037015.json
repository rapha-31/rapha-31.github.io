31","month":"1"},"faction":null,"city":"CS1026","noRecruit":true,"reject":null,"state":"2","role":0,"stats":[20,20,72,65,75,70],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1007102","armor":"WP1017005","helmet":"WP1024205"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":null,"city":"CS1026","noRecruit":true,"reject":null,"state":"2","role":0,"stats":[20,20,72,65,75,70],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1007102","armor":"WP1017005","helmet":"WP1024205"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1026","noRecruit":true,"reject":null,"state":"3","role":0,"stats":[20,20,72,65,75,70],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1007102","armor":"WP1017005","helmet":"WP1024205"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1026","noRecruit":true,"reject":null,"state":"3","role":0,"stats":[20,20,72,65,75,70],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1007102","armor":"WP1017005","helmet":"WP1024205"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":null,"city":"CS1026","noRecruit":true,"reject":null,"state":"2","role":0,"stats":[20,20,72,65,75,70],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1007102","armor":"WP1017005","helmet":"WP1024205"},"couple":[]}],"storyEvents":[],"biography":{"zh":"庾乘之子，庾嶷之弟，曹魏太中大夫。史载庾遁廉退贞固，养志不仕，表明其虽身处官场，却保持清廉谦退的品格。庾遁的后代极为显赫，其子庾峻、庾纯在《晋书》中均有列传；其曾孙庾亮、庾冰更是东晋初期举足轻重的权臣。庾遁一脉，是颍川庾氏在魏晋时期走向鼎盛的关键。","tc":"庾乘之子，庾嶷之弟，曹魏太中大夫。史載庾遁廉退貞固，養志不仕，表明其雖身處官場，卻保持清廉謙退的品格。庾遁的后代極為顯赫，其子庾峻、庾純在《晉書》中均有列傳；其曾孫庾亮、庾冰更是東晉初期舉足輕重的權臣。庾遁一脈，是潁川庾氏在魏晉時期走向鼎盛的關鍵。","en":"Son of Yu Cheng, younger brother of Yu Yi, and Orator of Cao Wei. Historical records note that Yu Dun was upright, unassuming, and steadfast, nurturing his character rather than coveting high rank, showing that though he served in the officialdom, he preserved an incorruptible and modest spirit. His descendants were exceedingly illustrious: his sons Yu Jun and Yu Chun both have biographies in the Book of Jin, while his great-grandsons Yu Liang and Yu Bing were pivotal, powerful ministers in the early Eastern Jin. Yu Dun's line was the cornerstone that carried the Yingchuan Yu family to the height of its prosperity during the Wei and Jin dynasties.","jp":"庾乗の子、庾嶷の弟。曹魏の太中大夫。史書には「廉退貞固にして、志を養いて仕えず」と記されており、官界に身を置きながらも清廉で謙虚な品格を保っていたことがうかがえる。庾遁の子孫は極めて栄達し、子の庾峻や庾純はともに『晋書』に列伝があり、曾孫の庾亮や庾氷は東晋初期に重きをなした権臣であった。庾遁の血筋は、潁川庾氏が魏晋期に最盛期を迎える鍵となった。","kr":"유승의 아들이자 유의의 아우로, 조위의 태중대부를 지냈다. 사서에는 유둔이 청렴결백하고 지조가 굳어 뜻을 기르며 출사하지 않았다고 기록되어 있는데, 이는 그가 비록 관직에 몸담았으나 청렴하고 겸양한 인품을 지켰음을 보여준다. 유둔의 후손은 대단히 현달하여 아들 유준과 유순은 모두 《진서》에 열전이 실렸으며, 증손자인 유량과 유빙은 동진 초기에 막강한 영향력을 떨친 권신이었다. 유둔의 가계는 영천 유씨가 위진 시기에 전성기를 구가하는 핵심이 되었다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ1037015","remark":"","surname":"庾","surnameTc":"庾","surnameEn":"Yu","surnameJp":"庾","surnameKr":"유","surnameOther":"","name":"遁","nameTc":"遁","nameEn":"Dun","nameJp":"遁","nameKr":"둔","nameOther":"","word":"德先","wordTc":"德先","wordEn":"Dexian","wordJp":"徳先","wordKr":"덕선","wordOther":"","icon":"庾遁","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"0","travel":"0","state":"2","workYear":"223","city":"CS1026","gender":"0","rule":"20","force":"20","wise":"72","politics":"65","charm":"75","will":"70","ruleTalent":"4","forceTalent":"1","wiseTalent":"5","politicsTalent":"8","charmTalent":"9","willTalent":"9","weaponMaster":"10/10/10/10/10/83/32/10","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"