n":"WP13008","armor":"WP1001505","helmet":"WP1026005"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":null,"city":"CS1030","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[54,43,65,67,51,42],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP13008","armor":"WP1001505","helmet":"WP1026005"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1030","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[54,43,65,67,51,42],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP13008","armor":"WP1001505","helmet":"WP1026005"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1026","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[54,43,65,67,51,42],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP13008","armor":"WP1001505","helmet":"WP1026005"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10957","city":"CS1030","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[54,43,65,67,51,42],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP13008","armor":"WP1001505","helmet":"WP1026005"},"couple":[]}],"storyEvents":[{"kind":"plot","id":"1005817","name":{"zh":"血诏未寒","en":"Before the Blood Decree Cools"},"year":"214","month":"10","desc":{"zh":"汉室衰微，曹操专权，挟天子以令诸侯。伏皇后与父伏完密谋，欲除曹操以安汉室。\n\n触发条件：伏皇后、刘协、曹操存活且身属正确势力。\n\n亲历条件：【家将数量至少为1】且【与伏完关系等级至少为2级】。\n\n禁忌条件：曹操、伏完、伏寿不为玩家家将，主角不为伏寿、刘协、伏完、伏德、曹操、华歆、许褚、董昭、程昱、贾诩。\n\n逆天改命：【使伏皇后、伏完存活并使其成为家将】","en":"The Han Dynasty waned and Cao Cao monopolized power, holding the emperor hostage to command the warlords in his name. Empress Fu secretly conspired with her father Fu Wan, plotting to eliminate Cao Cao and secure the Han house.\n\n\n\nTrigger Condition: Empress Fu, Liu Xie, and Cao Cao are alive and belong to the correct Factions.\n\n\n\nParticipation Requirements: 【Number of Retainers is at least 1】 and 【Relationship level with Fu Wan is at least Level 2】.\n\n\n\nIneligible Conditions: Cao Cao, Fu Wan, and Fu Shou are not the player's Retainers, the protagonist is not Fu Shou, Liu Xie, Fu Wan, Fu De, Cao Cao, Hua Xin, Xu Chu, Dong Zhao, Cheng Yu, or Jia Xu.\n\n\n\nDefy Fate: 【Keep Empress Fu and Fu Wan alive and recruit them as Retainers】"}}],"biography":{"zh":"汉末官臣，伏完之子、伏皇后之兄。伏皇后与伏完密谋害曹一事被发现后，伏皇后被曹操关入冷宫，被逼自尽；伏德等亲属亦因此事丧命。","tc":"漢末官臣，伏完之子、伏皇后之兄。伏皇后與伏完密謀害曹一事被發現后，伏皇后被曹操關入冷宮，被逼自盡；伏德等親屬亦因此事喪命。","en":"An official of the late Han, son of Fu Wan and elder brother of Empress Fu. After the conspiracy between Empress Fu and Fu Wan to assassinate Cao Cao was uncovered, Empress Fu was confined to the cold palace by Cao Cao and forced to take her own life, Fu De and other relatives also lost their lives as a consequence.","jp":"後漢末期の官吏。伏完の子で、伏皇后の兄。伏皇后と伏完による曹操謀殺の密謀が露見した後、伏皇后は曹操によって冷宮に幽閉され、自害に追い込まれた。伏徳ら親族もこの一件により命を落とした。","kr":"후한 말의 관료로, 복완의 아들이자 복황후의 오빠입니다. 복황후와 복완이 조조를 시해하려던 모의가 발각된 후, 복황후는 조조에 의해 냉궁에 유폐되어 자결을 강요당했고, 복덕 등의 친족 또한 이 일로 목숨을 잃었습니다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10882","remark":"","surname":"伏","surnameTc":"伏","surnameEn":"Fu","surnameJp":"伏","surnameKr":"복","surnameOther":"","name":"德","nameTc":"德","nameEn":"De","nameJp":"徳","nameKr":"덕","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"伏德","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"0","workYear":"211","city":"CS1026","gender":"0","rule":"54","force":"43","wise":"65","politics":"67","charm":"51","will":"42","ruleTalent":"7","forceTalent":"5","wis