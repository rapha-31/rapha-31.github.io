WP1023005"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1055","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[71,66,59,46,37,70],"title":-1,"rank":"9","loyalty":"0","reputation":"1000","equipment":{"weapon":"WP10014","armor":"WP1001905","helmet":"WP1023005"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10250","city":"CS1057","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[71,66,59,46,37,70],"title":-1,"rank":"9","loyalty":"0","reputation":"1000","equipment":{"weapon":"WP10014","armor":"WP1001905","helmet":"WP1023005"},"couple":[]}],"storyEvents":[],"biography":{"zh":"吴国武将，官至水军督，留赞之孙，留平之子。凤凰元年，步阐叛吴降晋，晋武帝命巴东监军徐胤率水军攻打建平，意图从西线牵制吴军。陆抗令水军督留虑与镇西将军朱琬共同抵御徐胤。留虑率吴军水师在建平方向成功阻击晋军水师，使其无法突破防线，最终晋军无功而返。","tc":"吳國武將，官至水軍督，留贊之孫，留平之子。鳳凰元年，步闡叛吳降晉，晉武帝命巴東監軍徐胤率水軍攻打建平，意圖從西線牽制吳軍。陸抗令水軍督留慮與鎮西將軍朱琬共同抵御徐胤。留慮率吳軍水師在建平方向成功阻擊晉軍水師，使其無法突破防線，最終晉軍無功而返。","en":"An officer of Wu who rose to Navy Commander. He was the grandson of Liu Zan and the son of Liu Ping. In the 1st year of Fenghuang, Bu Chan rebelled against Wu and surrendered to Jin. Emperor Wu of Jin ordered Xu Yin, Supervisor of Badong, to lead a navy to attack Jianping, attempting to pin down Wu forces from the west. Lu Kang ordered Navy Commander Liu Lü and West Off. (subjugation) Zhu Wan to jointly defend against Xu Yin. Liu Lü led the Wu naval forces to successfully intercept the Jin fleet toward Jianping, preventing them from breaching the defensive line, ultimately forcing the Jin forces to withdraw empty-handed.","jp":"呉の武将。官位は水軍督に至る。留賛の孫で、留平の子。鳳凰元年、歩闡が呉に背いて晋に降ると、晋の武帝は巴東監軍の徐胤に水軍を率いて建平を攻めさせ、西側から呉軍を牽制しようとした。陸抗は水軍督の留慮と鎮西将軍の朱琬に命じ、徐胤を共同で迎撃させた。留慮は呉の水軍を率いて建平方面で晋の水軍の阻止に成功し、防衛線を突破させず、最終的に晋軍を功なくして撤退させた。","kr":"오나라의 무장으로, 관직은 수군독에 이르렀다. 유찬의 손자이자 유평의 아들이다. 봉황 원년, 보천이 오나라를 배반하고 진나라에 투항하자, 진 무제는 파동감군 서윤에게 수군을 이끌고 건평을 공격하게 하여 서쪽에서 오군을 견제하고자 했다. 이에 육항은 수군독 유려와 진서장군 주완에게 함께 서윤을 막도록 명했다. 유려는 오나라 수군을 이끌고 건평 방면에서 진나라 수군을 성공적으로 요격하여 방어선을 돌파하지 못하도록 저지했고, 결국 진군은 아무런 소득 없이 물러났다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ1036415","remark":"普武","surname":"留","surnameTc":"留","surnameEn":"Liu","surnameJp":"留","surnameKr":"유","surnameOther":"","name":"虑","nameTc":"慮","nameEn":"Lü","nameJp":"慮","nameKr":"려","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"留虑","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"0","workYear":"220","city":"CS1055","gender":"0","rule":"71","force":"66","wise":"59","politics":"46","charm":"37","will":"70","ruleTalent":"8","forceTalent":"7","wiseTalent":"5","politicsTalent":"4","charmTalent":"2","willTalent":"11","weaponMaster":"50/50/66/50/50/22/11/50","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"","battleSkill":"","debateCard":"","warSoul":"","battleSoul":"","debateSoul":"","warSoulPoint":"5000","battleSoulPoint":"4300","debateSoulPoint":"3400","strategy":"1000815","strategy2":"1001001","professions":"3/0/0/2/0/3/2/0/0/0/2/2/2/0/2/1/1/1/1/0/0/2/2/1","attribute2":"50/50/50/50/50/50","morality":"4","compatible":"86","loyalty":"0","reputation":"1000","evaluate":"3000","title":"","rank":"9","birth":"236","show":"249","death":"296","age":"0","injury":"","deathReason":"0","type":"1","npcTag":"0","npcNum":"1","microScene":"0","isImportant":"0","speaking":"3","weapon":"WP10014","armor":"WP1001905","helmet":"WP1023005","treasure":"","horse":"","shield":"","character":"0/1;1/1;18/1;26/1;57/1;44/1;30/0","father":"WJ10474/0","mother":"","children":"","family":"","modInfo":"","brother":"","couple":"","otherRelationship":"","belief":"0","isVIP":"0","startVIPYear":"0","endVIPYear":"0","description":"吴国武将，官至水军督，留赞之孙，留平之子。凤凰元年，步阐叛吴降晋，晋武帝命巴东监军徐胤率水军攻打建平，意图从西线牵制吴军。陆抗令水