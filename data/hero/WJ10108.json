t":[{"id":"WP10014","name":{"zh":"长剑","en":"Longsword"},"level":"1","description":{"zh":"流传最久、随处可见的经典款式。","en":"The most enduring and ubiquitous classic design."},"atkVal":"5","price":"2000","slot":{"zh":"武器","en":"Weapon"}},{"id":"WP1015302","name":{"zh":"轻佻长裙","en":"Alluring Gown"},"level":"2","description":{"zh":"布料轻盈，款式大胆。","en":"Light cloth and a daring design."},"defenceVal":"9","evade":"10","price":"10000","slot":{"zh":"护甲","en":"Armor"}},{"id":"WP1012702","name":{"zh":"玛瑙钗","en":"Agate Hairpin"},"level":"2","description":{"zh":"带有玛瑙装饰的钗子。玛瑙又称马脑，由遥远的异族商人传入大汉的宝石，十分罕见。","en":"A hair clasp with agate decoration. Agate, also called horse-brain stone, was brought to the Han by distant foreign merchants and is extremely rare."},"evade":"8","price":"6500","slot":{"zh":"头盔","en":"Helmet"}}],"family":{"children":{"label":{"zh":"子女","en":"Children"},"people":[{"id":"WJ10979","code":"100"},{"id":"WJ10229","code":"100"},{"id":"WJ10130","code":"100"}]}},"clans":[{"id":"GI114715","name":{"zh":"河内张氏","en":"The Zhang Clan of Henei"},"years":["0","999"],"desc":{"zh":"出自姬姓，为汉初三杰之一留侯张良的后裔。东汉时，张歆官至司徒，其子张延官至太尉，家族“二世三公”，是河内郡的顶级士族。西晋时，河内张氏一支自河内迁至清河，成为清河张氏的开基始祖。","en":"Descended from the Ji surname, they were posterity of Zhang Liang, Marquis of Liu and one of the Three Heroes of the early Han. During the Eastern Han, Zhang Xin rose to Senior Minister, and his son Zhang Yan attained Chief Officer. Honored with ‘Three Excellencies across two generations,’ the family stood as the foremost gentry clan of Henei Commandery. In the Western Jin, a branch migrated from Henei to Qinghe, becoming the founding lineage of the Zhang clan of Qinghe."},"talent":{"military":"5","commerce":"6","politics":"7"}}],"friendGroups":[],"body":null,"honorifics":[],"selfAddress":[[["WJ10108","妾身"],["WJ10108","妾身"],["WJ10108","This humble woman"],["WJ10108","妾"],["WJ10108","소첩"]]],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"35","startPregnantAge":"35"},"scenarios":[{"s