:"Wuzhang Plains"},"year":"234","month":"1"},"faction":null,"city":"CS1076","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[83,77,62,61,73,87],"title":1,"rank":"1","loyalty":"100","reputation":"6600","equipment":{"weapon":"WP13002","armor":"WP1002205","helmet":"WP1023705","horse":"WP1001015"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1076","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[83,77,62,61,73,87],"title":1,"rank":"1","loyalty":"100","reputation":"6600","equipment":{"weapon":"WP13002","armor":"WP1002205","helmet":"WP1023705","horse":"WP1001015"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1076","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[83,77,62,61,73,87],"title":-1,"rank":"9","loyalty":"0","reputation":"3400","equipment":{"weapon":"WP13002","armor":"WP1002205","helmet":"WP1023705","horse":"WP1001015"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":null,"city":"CS1076","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[83,77,62,61,73,87],"title":-1,"rank":"9","loyalty":"100","reputation":"3400","equipment":{"weapon":"WP13002","armor":"WP1002205","helmet":"WP1023705","horse":"WP1001015"},"couple":[]}],"storyEvents":[],"biography":{"zh":"河西鲜卑部首领，北魏先祖拓跋诘汾长子，秃发树机能曾祖父。因父拓跋诘汾以次子拓跋力微为继承人，匹孤率部自塞北西迁河西，其领地东至麦田、牵屯，西至湿罗，南至浇河，北接大漠。匹孤死后，子秃发寿阗继位，奠定河西鲜卑的割据基础。","tc":"河西鮮卑部首領，北魏先祖拓跋詰汾長子，禿發樹機能曾祖父。因父拓跋詰汾以次子拓跋力微為繼承人，匹孤率部自塞北西遷河西，其領地東至麥田、牽屯，西至濕羅，南至澆河，北接大漠。匹孤死后，子禿發壽闐繼位，奠定河西鮮卑的割據基礎。","en":"Chieftain of the Hexi Xianbei, eldest son of Tuoba Jiefen (ancestor of Northern Wei), and great-grandfather of Tufa Shujineng. Because his father named his second son Tuoba Liwei as heir, Pigu led his tribe west from north of the frontier to settle in Hexi. His territory reached east to Maitian and Qiantun, west to Shiluo, south to Jiaohe, and north to the Great Desert. Following Pigu's death, his son Tufa Shoutian succeeded him, laying the foundation for the Hexi Xianbei's independence.","jp":"河西鮮卑の首領。北魏の先祖である拓跋詰汾の長男であり、禿髪樹機能の曾祖父にあたる。父の拓跋詰汾が次男の拓跋力微を後継者としたため、匹孤は部族を率いて塞北から河西へと西遷した。その領地は東は麦田・牽屯、西は湿羅、南は澆河、北は大漠に及んだ。匹孤の死後、子の禿髪寿闐が後を継ぎ、河西鮮卑の割拠の基礎を築いた。","kr":"하서 선비부의 수령이자 북위의 선조 탁발힐분의 장남이며, 독발수기능의 증조부이다. 부친 탁발힐분이 차남 탁발역미를 후계자로 삼자, 필고는 무리를 이끌고 새북에서 하서로 서천하였다. 영지는 동으로 맥전과 견둔, 서로 습라, 남으로 요하에 이르고 북으로는 대막과 맞닿았다. 필고가 세상을 떠난 뒤에는 아들 독발수전이 뒤를 이어 하서 선비가 할거하는 기틀을 다졌다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ1043215","remark":"普武","surname":"秃发","surnameTc":"禿發","surnameEn":"Tufa","surnameJp":"禿髪","surnameKr":"독발","surnameOther":"","name":"匹孤","nameTc":"匹孤","nameEn":"Pigu","nameJp":"匹孤","nameKr":"필고","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"秃发匹孤","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"2","workYear":"188","city":"CS1076","gender":"0","rule":"83","force":"77","wise":"62","politics":"61","charm":"73","will":"87","ruleTalent":"8","forceTalent":"7","wiseTalent":"4","politicsTalent":"6","charmTalent":"7","willTalent":"11","weaponMaster":"38/77/45/45/32/32/33/33","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"1015202","battleSkill":"","debateCard":"","warSoul":"","battleSoul":"","debateSoul":"","warSoulPoint":"7000","battleSoulPoint":"6000","debateSoulPoint":"5000","strategy":"","strategy2":"1010301;1001005;1001715","professions":"2/1/4/3/0/0/3/0/0/0/3/4/2/1/2/0/3/1/0/0/0/4/4/1","attribute2":"50/50/50/50/50/50","morality":"5","compatible":"32","loyalty":"0","reputation":"3400","evaluate":"-1300","title":"","rank":"9","birth":"170","show":"184","death":"230","age":"0","injury":"","deathReaso