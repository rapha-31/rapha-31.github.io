 함께 마초에게 참살당했다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10262","remark":"","surname":"马","surnameTc":"馬","surnameEn":"Ma","surnameJp":"馬","surnameKr":"마","surnameOther":"","name":"玩","nameTc":"玩","nameEn":"Wan","nameJp":"玩","nameKr":"완","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"马玩","power":"WJ10042","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"2","workYear":"189","city":"CS1033","gender":"0","rule":"71","force":"74","wise":"16","politics":"23","charm":"37","will":"75","ruleTalent":"8","forceTalent":"8","wiseTalent":"1","politicsTalent":"1","charmTalent":"2","willTalent":"9","weaponMaster":"35/75/35/35/35/6/50/35","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"","battleSkill":"","debateCard":"","warSoul":"","battleSoul":"1012205","debateSoul":"","warSoulPoint":"5000","battleSoulPoint":"5400","debateSoulPoint":"200","strategy":"1008315","strategy2":"1000905","professions":"0/2/3/0/0/0/2/0/0/0/3/3/2/0/1/0/0/0/0/0/0/3/2/0","attribute2":"50/50/50/50/50/50","morality":"4","compatible":"32","loyalty":"98","reputation":"1450","evaluate":"0","title":"","rank":"9","birth":"170","show":"189","death":"211","age":"0","injury":"","deathReason":"1","type":"1","npcTag":"0","npcNum":"1","microScene":"0","isImportant":"0","speaking":"2","weapon":"WP14003","armor":"WP1005805","helmet":"WP1023405","treasure":"","horse":"","shield":"","character":"0/1;1/1;3/1;9/1;19/1","father":"","mother":"","children":"","family":"","modInfo":"","brother":"","couple":"","otherRelationship":"","belief":"0","isVIP":"0","startVIPYear":"0","endVIPYear":"0","description":"韩遂八将之一，随韩遂马超起兵共同进攻曹操。马超韩遂中贾诩离间计后，同其他五将围攻马超，皆难取胜，后随韩遂密谋降曹被马超撞到，与梁兴一同被马超斩杀。","descriptionTc":"韓遂八將之一，隨韓遂馬超起兵共同進攻曹操。馬超韓遂中賈詡離間計后，同其他五將圍攻馬超，皆難取勝，后隨韓遂密謀降曹被馬超撞到，與梁興一同被馬超斬殺。","descriptio