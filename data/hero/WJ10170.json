{"id":"WJ10170","icon":"士徽","surname":{"zh":"士","tc":"士","en":"Shi","jp":"士","kr":"사"},"givenName":{"zh":"徽","tc":"徽","en":"Hui","jp":"徽","kr":"휘"},"courtesy":{"zh":"","tc":"","en":"","jp":"","kr":""},"gender":0,"type":{"code":1,"en":"Military","zh":"武官"},"years":{"birth":165,"debut":184,"death":227,"deathReasonCode":"1","workYear":"184","age":"0"},"faction":{"id":"WJ10169"},"hostileFaction":null,"city":{"id":"CS1060","name":{"zh":"交趾","en":"Jiaozhi"},"region":{"zh":"交州","en":"Jiao Province"}},"stats":[{"key":"rule","zh":"统率","en":"LEA","value":69,"talent":7},{"key":"force","zh":"武力","en":"STR","value":64,"talent":6},{"key":"wise","zh":"智略","en":"INT","value":44,"talent":3},{"key":"politics","zh":"政略","en":"POL","value":31,"talent":2},{"key":"charm","zh":"魅力","en":"CHA","value":49,"talent":4},{"key":"will","zh":"意志","en":"DET","value":28,"talent":1}],"attribute2":"50/50/50/50/50/50","weaponMastery":[{"zh":"长柄穿刺","en":"Long Pierce","value":20},{"zh":"长柄挥砍","en":"Long Slash","value":20},{"zh":"短柄穿刺","en":"Short Pierce","value":20},{"zh":"短柄挥砍","en":"Short Slash","value":64},{"zh":"远程","en":"Ranged","value":20},{"zh":"文官","en":"Scholar","value":30},{"zh":"艺术","en":"Art","value":50},{"zh":"盾","en":"Shield","value":20}],"duelWeaponMultipliers":[{"zh":"长柄穿刺","en":"Long Pierce","value":1.0},{"zh":"长柄挥砍","en":"Long Slash","value":1.0},{"zh":"短柄穿刺","en":"Short Pierce","value":1.0},{"zh":"短柄挥砍","en":"Short Slash","value":1.0},{"zh":"远程","en":"Ranged","value":1.0},{"zh":"文官","en":"Scholar","value":1.0},{"zh":"艺术","en":"Art","value":1.0},{"zh":"盾","en":"Shield","value":1.0}],"debateAttribute":"1/1/1","professions":[{"zh":"短兵","en":"Blade","value":0},{"zh":"枪兵","en":"Spear","value":1},{"zh":"骑兵","en":"Cavalry","value":0},{"zh":"弓兵","en":"Archery","value":1},{"zh":"器械","en":"Siege","value":0},{"zh":"水军","en":"Navy","value":0},{"zh":"军学","en":"Military Science","value":2},{"zh":"商业","en":"Commerce","value":0},{"zh":"农业","en":"Agriculture","value":0},{"zh":"建造","en":"Construction","value":0},{"zh":"征兵","en":"Conscription","value":2},{"zh":"练兵","en":"Drill","value":2},{"zh":"治安","en":"Order","value":1},{"zh":"巡访","en":"Outreach","value":0},{"zh":"城防","en":"Fortification","value":1},{"zh":"探索","en":"Explore","value":0},{"zh":"外交","en":"Diplomacy","value":1},{"zh":"辩才","en":"Eloquence","value":0},{"zh":"潜伏","en":"Stealth","value":0},{"zh":"科研","en":"Research","value":1},{"zh":"医术","en":"Medicine","value":0},{"zh":"酒力","en":"Drinking","value":0},{"zh":"旅游","en":"Travel","value":0},{"zh":"驯兽","en":"Taming","value":0}],"traits":[{"id":0,"level":1},{"id":1,"level":1},{"id":2,"level":1},{"id":14,"level":1},{"id":33,"level":1},{"id":58,"level":1},{"id":28,"level":0},{"id":46,"level":2}],"values":{"morality":"3","alignment":"-6000","affinity":"96","loyalty":"120","reputation":"2750","belief":"0"},"officialTitle":null,"officialRank":{"index":8,"name":{"zh":"八品官","en":"Eighth Rank"}},"personalTitles":[],"strategies":[],"warSkills":[],"battleCards":[],"debateCards":[],"warSouls":[],"battleSouls":[],"debateSouls":[],"soulPoints":{"war":4700,"battle":4000,"debate":1900},"equipment":[{"id":"WP12013","name":{"zh":"铁刀","en":"Iron Saber"},"level":"1","description":{"zh":"流传最久、随处可见的经典款式。","en":"The most enduring and ubiquitous classic design."},"atkVal":"5","price":"2000","slot":{"zh":"武器","en":"Weapon"}},{"id":"WP1003005","name":{"zh":"铁札甲·甲","en":"Iron Lamellar Armor - I"},"level":"1","description":{"zh":"历史悠久的甲胄，由于甲片形似书札，故称扎甲。经过几代改良，扎甲既贴身又灵活，因此各地战场皆能看到它的身影。","en":"An ancient armor type named for plates resembling writing slips. Refined over generations, lamellar armor is both form-fitting and flexible, found on battlefields everywhere."},"defenceVal":"6","mp":"180","price":"2500","slot":{"zh":"护甲","en":"Armor"}},{"id":"WP1020805","name":{"zh":"陷阵盔","en":"Shock Helm"},"level":"1","description":{"zh":"据说比常规铁盔多一道稳固工序，并且会用特制盔沿的头盔，多为陷阵冲锋之人佩戴。","en":"A helmet said to undergo an extra reinforcing process compared to standard iron helms and feature a specially crafted brim, mostly worn by those who charge the front lines."},"defenceVal":"3","price":"2600","slot":{"zh":"头盔","en":"Helmet"}}],"family":{"father":{"label":{"zh":"父亲","en":"Father"},"people":[{"id":"WJ10169","code":"0"}]},"family":{"label":{"zh":"亲属","en":"Relatives"},"people":[{"id":"WJ10541","code":"100"}]}},"clans":[{"id":"GI106815","name":{"zh":"苍梧士氏","en":"The Shi clan of Cangwu"},"years":["184","226"],"desc":{"zh":"出自姬姓，帝尧之后。士氏世为交州大族。交州割据势力士燮家族，控制交州近四十年，为岭南地区文化保存者。士燮及其三个兄弟共领四郡，占岭南疆土过半。在岭南及越南历史上，士燮威望极高，不在南越王赵佗之下。后越南陈朝追赠士燮善感嘉应灵武大王。","en":"Descended from the Ji surname, lineage of Emperor Yao. The Shi clan was an eminent house of Jiao Province for generations. They were the Family of Shi Xie, an independent warlord Faction who held sway over Jiao Province for nearly four decades and preserved the cultural heritage of the Lingnan region. Shi Xie and his three brothers governed four commanderies among them, encompassing over half the territories of Lingnan. In the histories of Lingnan and Vietnam, Shi Xie enjoyed supreme prestige, rivaling even Zhao Tuo, King of Nanyue. In later centuries, the Trần dynasty of Vietnam posthumously honored Shi Xie as King Shangan Jiaying Lingwu."},"talent":{"military":"5","commerce":"6","politics":"7"}}],"friendGroups":[],"body":null,"honorifics":[],"selfAddress":[],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"25","startPregnantAge":"0"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":"WJ10169","city":"CS1060","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[69,64,44,31,49,28],"title":-1,"rank":"9","loyalty":"120","reputation":"2700","equipment":{"weapon":"WP12013","armor":"WP1003005","helmet":"WP1020805"},"couple":[]},{"story":{"id":"S10215","name":{"zh":"汉末三杰","en":"Three Heroes of the Late Han"},"year":"185","month":"3"},"faction":"WJ10169","city":"CS1060","noRecruit":false,"reject":null,"state":"2","role