:"231","month":"1"},"faction":null,"city":"CS1028","noRecruit":true,"reject":null,"state":"3","role":0,"stats":[23,58,62,60,74,70],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1018105","helmet":"WP1025905"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":null,"city":"CS1028","noRecruit":true,"reject":null,"state":"3","role":0,"stats":[23,58,62,60,74,70],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1018105","helmet":"WP1025905"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ1000115","city":"CS1028","noRecruit":true,"reject":null,"state":"2","role":4,"stats":[23,58,62,60,74,70],"title":0,"rank":"1","loyalty":"100","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1018105","helmet":"WP1025905","treasure":"WP1000908"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1028","noRecruit":true,"reject":null,"state":"3","role":0,"stats":[23,58,62,60,74,70],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1018105","helmet":"WP1025905"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10127","city":"CS1016","noRecruit":true,"reject":null,"state":"2","role":0,"stats":[23,58,62,60,74,70],"title":-1,"rank":"1","loyalty":"99","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1018105","helmet":"WP1025905"},"couple":[]}],"storyEvents":[{"kind":"plot","id":"1005918","name":{"zh":"曹芳被废","en":"Cao Fang Deposed"},"year":"254","month":"9","desc":{"zh":"","en":""}},{"kind":"plot","id":"1006918","name":{"zh":"王凌叛乱","en":"Wang Ling's Rebellion"},"year":"251","month":"1","desc":{"zh":"","en":""}}],"biography":{"zh":"曹魏第三位皇帝，魏武帝曹操曾孙，任城威王曹彰之孙，曹楷之子、魏明帝曹睿养子。曹叡死后即位，由大将军曹爽和太尉司马懿共同辅政。正始十年，经历高平陵之变，曹爽倒台，政权落入司马氏手中。嘉平六年，中书令李丰和光禄大夫张缉图谋废掉司马师，改立夏侯玄为大将军，结果事败被杀后，司马师将曹芳废为齐王，拥戴高贵乡公曹髦继位。泰始十年，曹芳病逝，终年四十三岁，谥号为厉。","tc":"曹魏第三位皇帝 ，魏武帝曹操曾孫，任城威王曹彰之孫，曹楷之子、魏明帝曹睿養子。曹叡死后即位，由大將軍曹爽和太尉司馬懿共同輔政。正始十年，經歷高平陵之變，曹爽倒臺，政權落入司馬氏手中。嘉平六年，中書令李豐和光祿大夫張緝圖謀廢掉司馬師，改立夏侯玄為大將軍，結果事敗被殺后，司馬師將曹芳廢為齊王，擁戴高貴鄉公曹髦繼位。泰始十年，曹芳病逝，終年四十三歲，謚號為厲。","en":"The third emperor of Cao Wei, a great-grandson of Emperor Wu Cao Cao, grandson of Cao Zhang the Mighty Prince of Rencheng, son of Cao Kai, and adopted son of Emperor Ming Cao Rui. Upon Cao Rui's death, he ascended the throne, with Grand General Cao Shuang and Chief Officer Sima Yi serving as co-regents. In the tenth year of Zhengshi, the Incident at Gaoping Tombs brought down Cao Shuang, and power passed into the hands of the Sima clan. In the sixth year of Jiaping, when Jnr Minister Li Feng and Minister of Oration Zhang Ji plotted to replace Sima Shi with Xiahou Xuan as Grand General, the conspiracy was exposed and all involved were executed. Sima Shi subsequently deposed Cao Fang as Prince of Qi and installed Cao Mao, Duke of Gaoguixiang, as the new emperor. In the tenth year of Taishi, Cao Fang died of illness at the age of forty-three, receiving the posthumous name Li.","jp":"曹魏の第3代皇帝。魏武帝曹操の曾孫、任城威王曹彰の孫、曹楷の子であり、魏明帝曹叡の養子。曹叡の死後に即位し、大将軍曹爽と太尉司馬懿が共に補佐を務めた。正始十年、高平陵の変を経て曹爽が失脚すると、政権は司馬氏の手に落ちた。嘉平六年、中書令李豊と光禄大夫張緝が司馬師の排除と夏侯玄の大将軍擁立を企てるも露見して誅殺され、司馬師により曹芳は斉王へと廃位され、高貴郷公曹髦が擁立されて帝位を継いだ。泰始十年、曹芳は病没。享年四十三歳、諡号は厲。","kr":"조위의 제3대 황제. 위 무제 조조의 증손이자 임성위왕 조창의 손자, 조해의 아들이며 위 명제 조예의 양자이다. 조예 사후 즉위하였으며, 대장군 조상과 태위 사마의가 함께 보정하였다. 정시 10년, 고평릉의 변을 겪으며 조상이 실각하고 정권이 사마씨의 손에 넘어갔다. 가평 6년, 중서령 이풍과 광록대부 장집이 사마사를 폐하고 하후현을 대장군으로 세우려 모의하였으나 발각되어 살해당한 뒤, 사마사는 조방을 폐위하여 제왕으로 강등하고 고귀향공 조모를 옹립하여 제위를 잇게 하였다. 태시 10년, 조방이 병사하니 향년 43세였으며 시호는 여(厲)이다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ1000115","remark":"","surname":"曹","surnameTc":"曹","surnameEn":"Cao","su