 with Wei and Shu for nearly sixty years before ultimately being destroyed by Sima Jin, enduring as the longest-lasting regime among the Three Kingdoms."},"talent":{"military":"9","commerce":"4","politics":"7"}}],"friendGroups":[],"body":null,"honorifics":[],"selfAddress":[],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"25","startPregnantAge":"0"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":null,"city":"CS1053","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[32,26,78,70,79,75],"title":-1,"rank":"9","loyalty":"0","reputation":"1050","equipment":{"weapon":"WP10014","armor":"WP1018105","helmet":"WP1025905"},"couple":[]},{"story":{"id":"S10215","name":{"zh":"汉末三杰","en":"Three Heroes of the Late Han"},"year":"185","month":"3"},"faction":null,"city":"CS1053","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[32,26,78,70,79,75],"title":-1,"rank":"9","loyalty":"0","reputation":"1050","equipment":{"weapon":"WP10014","armor":"WP1018105","helmet":"WP1025905"},"couple":[]},{"story":{"id":"S10615","name":{"zh":"十常侍之乱","en":"Turmoil of the Ten Attendants"},"year":"188","month":"11"},"faction":null,"city":"CS1053","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[32,26,78,70,79,75],"title":-1,"rank":"9","loyalty":"0","reputation":"1000","equipment":{"weapon":"WP10014","armor":"WP1018105","helmet":"WP1025905"},"couple":[]},{"story":{"id":"S10402","name":{"zh":"诸侯讨董","en":"Coalition Against Dong Zhuo"},"year":"190","month":"3"},"faction":null,"city":"CS1053","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[32,26,78,70,79,75],"title":-1,"rank":"9","loyalty":"0","reputation":"1000","equipment":{"weapon":"WP10014","armor":"WP1018105","helmet":"WP1025905"},"couple":[]},{"story":{"id":"S10208","name":{"zh":"幽燕龙兴","en":"Dragon Rises in Youyan"},"year":"191","month":"3"},"faction":null,"city":"CS1053","noRecruit":false,"re