2","armor":"WP1014005","helmet":"WP1025105"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":null,"city":"CS1033","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[15,10,35,44,30,32],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1007102","armor":"WP1014005","helmet":"WP1025105"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1033","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[15,10,35,44,30,32],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1007102","armor":"WP1014005","helmet":"WP1025105"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1033","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[15,10,35,44,30,32],"title":-1,"rank":"9","loyalty":"0","reputation":"9850","equipment":{"weapon":"WP1007102","armor":"WP1014005","helmet":"WP1025105"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10127","city":"CS1016","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[15,10,35,44,30,32],"title":-1,"rank":"9","loyalty":"120","reputation":"9850","equipment":{"weapon":"WP1007102","armor":"WP1014005","helmet":"WP1025105"},"couple":[]}],"storyEvents":[],"biography":{"zh":"曹魏明元郭皇后之父，出身河西望族西平郭氏。黄初年间，西平郡发生了叛乱，被朝廷派兵平定后，郭氏等当地名门望族的家眷按照当时的规则，作为叛臣家眷被没收入宫，其中就包括郭满的女儿郭宁。生平无仕宦记载、事迹全佚，仅因女儿成为魏明帝皇后、曹芳时期太后，被追封为西都定侯。","tc":"曹魏明元郭皇后之父，出身河西望族西平郭氏。黃初年間，西平郡發生了叛亂，被朝廷派兵平定后，郭氏等當地名門望族的家眷按照當時的規則，作為叛臣家眷被沒收入宮，其中就包括郭滿的女兒郭寧。生平無仕宦記載、事跡全佚，僅因女兒成為魏明帝皇后、曹芳時期太后，被追封為西都定侯。","en":"Father of Empress Mingyuan (Empress Guo) of Cao Wei, hailing from the prestigious Guo clan of Xiping in Hexi. During the Huangchu era, a rebellion broke out in Xiping Commandery. After imperial troops quelled the uprising, the families of prominent local clans—including the Guos—were confiscated into the palace as dependents of rebel subjects in accordance with contemporary laws, among whom was Guo Man's daughter, Guo Ning. There are no records of his official career and details of his life are lost, solely because his daughter became Empress to Emperor Ming of Wei and later Empress Dowager during Cao Fang's reign, he was posthumously enfeoffed as Marquis Ding of Xidu.","jp":"曹魏の明元郭皇后の父。河西の名門である西平郭氏の出身。黄初年間、西平郡で反乱が勃発し、朝廷の派遣軍により平定されると、当時の規定に従って郭氏ら現地の名門望族の家族は叛臣の縁者として後宮に没収された。その中には郭満の娘である郭寧も含まれていた。生涯において仕官の記録はなく、事績も失われているが、娘が魏の明帝の皇后、曹芳の治世には皇太后となったことから、西都定侯を追封された。","kr":"조위 명원곽황후의 아버지로, 하서의 망족인 서평 곽씨 출신이다. 황초 연간에 서평군에서 반란이 일어나 조정이 군사를 파견해 평정한 뒤, 곽씨 등 현지 명문가의 가솔은 당시의 규례에 따라 반역자의 가속으로서 궁에 적몰되었는데 그중에 곽만의 딸 곽녕도 포함되어 있었다. 생전에 벼슬을 지낸 기록은 없으며 사적 또한 전혀 전해지지 않으나, 오직 딸이 위 명제의 황후와 조방 시기의 태후가 된 덕분에 서도정후로 추봉되었다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ1027715","remark":"","surname":"郭","surnameTc":"郭","surnameEn":"Guo","surnameJp":"郭","surnameKr":"곽","surnameOther":"","name":"满","nameTc":"滿","nameEn":"Man","nameJp":"満","nameKr":"만","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"郭满","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"0","workYear":"194","city":"CS1033","gender":"0","rule":"15","force":"10","wise":"35","politics":"44","charm":"30","will":"32","ruleTalent":"1","forceTalent":"1","wiseTalent":"4","politicsTalent":"4","charmTalent":"5","willTalent":"3","weaponMaster":"1/1/1/1/1/82/33/1","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"","battleSkill":"","debateCard":"","warSoul":"","battleSoul":"","debateSoul":"","warSoulPoint":"2000","battleSoulPoint":"100","debateSoulPoint":"6800","strategy":"","strategy2":"1000105","