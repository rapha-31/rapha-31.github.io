ao Wei. One of the ‘Five Surnames and Seven Clans’, they were ranked among the ‘Lu, Cui, Zheng, and Wang’ when Emperor Xiaowen of Northern Wei categorized the aristocratic clans."},"talent":{"military":"4","commerce":"5","politics":"8"}}],"friendGroups":[{"story":"S10802","members":["WJ10072","WJ10146","WJ10325","WJ10178","WJ10001","WJ10060","WJ10056","WJ10057","WJ10058","WJ10054","WJ10912","WJ10062","WJ10332","WJ10168"]},{"story":"S10615","members":["WJ10072","WJ10178","WJ10054","WJ10912","WJ10060","WJ10168","WJ10166","WJ10332","WJ10011"]},{"story":"S10615","members":["WJ10072","WJ10054","WJ10001","WJ10060","WJ10058","WJ10153","WJ10178","WJ10912","WJ10056","WJ10057","WJ10157","WJ10146","WJ10168","WJ10332"]}],"body":{"name":"郑泰","height":"较矮","shape":"一般"},"honorifics":[],"selfAddress":[],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"25","startPregnantAge":"0"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":"WJ10072","city":"CS1029","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[25,15,88,80,85,79],"title":-1,"rank":"9","loyalty":"100","reputation":"18000","equipment":{"weapon":"WP1007002","armor":"WP1014905","helmet":"WP1025805"},"couple":[]},{"story":{"id":"S10215","name":{"zh":"汉末三杰","en":"Three Heroes of the Late Han"},"year":"185","month":"3"},"faction":null,"city":"CS1025","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[25,15,88,80,85,79],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1007002","armor":"WP1014905","helmet":"WP1025805"},"couple":[]},{"story":{"id":"S10615","name":{"zh":"十常侍之乱","en":"Turmoil of the Ten Attendants"},"year":"188","month":"11"},"faction":"WJ10072","city":"CS1028","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[25,15,88,80,85,79],"title":-1,"rank":"7","loyalty":"100","reputation":"18200","equipment":{"weapon":"WP1007002","armor":"WP1014905","hel