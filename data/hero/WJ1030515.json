met":"WP1026905"},"couple":[]},{"story":{"id":"S11015","name":{"zh":"再出岐山","en":"Return to Qishan"},"year":"231","month":"1"},"faction":null,"city":"CS1070","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[45,23,77,79,81,70],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1007102","armor":"WP1016205","helmet":"WP1026905"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":null,"city":"CS1070","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[45,23,77,79,81,70],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1007102","armor":"WP1016205","helmet":"WP1026905"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1070","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[45,23,77,79,81,70],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1007102","armor":"WP1016205","helmet":"WP1026905"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1001","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[45,23,77,79,81,70],"title":-1,"rank":"8","loyalty":"98","reputation":"9650","equipment":{"weapon":"WP1007102","armor":"WP1016205","helmet":"WP1026905"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10011","city":"CS1005","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[45,23,77,79,81,70],"title":-1,"rank":"8","loyalty":"98","reputation":"9650","equipment":{"weapon":"WP1007102","armor":"WP1016205","helmet":"WP1026905"},"couple":[]}],"storyEvents":[],"biography":{"zh":"东汉末年至蜀汉初期官员，襄阳大族。荆楚大地的名士俊杰。有风流，善谈论，以其风度翩翩、才华横溢和卓越的谈吐辞令而闻名。时人对其评价极高，认为习祯的名声仅次于“凤雏”庞统，而在“白眉”马良之上。建安六年，刘备依附刘表时主动归附；建安十六年，随刘备入蜀取益州，平蜀后历任雒令、郫令、广汉太守，入《季汉辅臣赞》，是蜀汉早期荆州集团地方重臣。","tc":"東漢末年至蜀漢初期官員，襄陽大族。荊楚大地的名士俊杰。有風流，善談論，以其風度翩翩、才華橫溢和卓越的談吐辭令而聞名。時人對其評價極高，認為習禎的名聲僅次于“鳳雛”龐統，而在“白眉”馬良之上。建安六年，劉備依附劉表時主動歸附；建安十六年，隨劉備入蜀取益州，平蜀后歷任雒令、郫令、廣漢太守，入《季漢輔臣贊》，是蜀漢早期荊州集團地方重臣。","en":"Official of the late Eastern Han to early Shu Han, hailing from a prominent clan in Xiangyang. A renowned scholar and talent of Jingchu. Refined and eloquent, he was famed for his graceful bearing, overflowing talent, and articulate speech. Contemporaries held him in high esteem, considering Xi Zhen's reputation second only to the ‘Fledgling Phoenix’ Pang Tong and above ‘White Eyebrows’ Ma Liang. In the 6th year of Jian'an, he voluntarily joined Liu Bei when Liu Bei took refuge with Liu Biao, in the 16th year of Jian'an, he accompanied Liu Bei into Shu to take Yi Province. Following the pacification of Shu, he served successively as Magistrate of Luo, Magistrate of Pi, and Governor of Guanghan. Recorded in the Ji Han Fu Chen Zan, he was an important regional official of the Jing Province Faction in early Shu Han.","jp":"後漢末期から蜀漢初期の官吏であり、襄陽の豪族出身。荊楚の地における名士・俊英である。風流で談論を好み、洗練された立ち居振る舞いと溢れる才気、そして卓越した弁舌で名を馳せた。当時の人々からの評価は極めて高く、習禎の名声は「鳳雛」龐統に次ぎ、「白眉」馬良を凌ぐと称された。建安六年、劉備が劉表を頼った際に自ら帰順。建安十六年には劉備に従って入蜀し益州平定に貢献した。蜀平定後は雒令、郫令、広漢太守を歴任し、『季漢輔臣賛』にも名を連ねるなど、蜀漢初期における荊州閥の地方重臣として活躍した。","kr":"동한 말기부터 촉한 초기의 관리이자 양양의 대족 출신이다. 형초 땅의 이름 높은 명사이자 준걸이었다. 풍류를 알고 담론에 능하여, 준수한 풍모와 넘치는 재능, 탁월한 언변으로 명성을 떨쳤다. 당대 사람들에게 매우 높은 평가를 받았는데, 습정의 명성은 '봉추' 방통의 다음이며 '백미' 마량보다 위라고 여겨졌다. 건안 6년, 유비가 유표에게 의탁했을 때 자진하여 귀부했다. 건안 16년에는 유비를 따라 입촉하여 익주를 취하는 데 종군했고, 평정 후 낙령, 비령, 광한태수를 역임했다. 《계한보신찬》에 수록되었으며, 촉한 초기 형주 집단의 주요 지방 중신이었다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ1030515","remark":"","surname":"习","surnameTc":"習","surnameEn":"Xi","surnameJp":"習","surnameKr":"습","surnameOther":"","name":"祯","nameTc":"禎","nameEn":"Zhen","nameJp":"禎","nameKr":"정","nameOther":"","word":"文祥","wordTc":"文祥","wordEn":"Wenxiang","wordJp":"文祥","wordKr":"문상","wordOther":"","ic