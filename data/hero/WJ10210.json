lmet":"WP1022305","horse":"WP29009"},"couple":["WJ10224"]},{"story":{"id":"S10915","name":{"zh":"北伐中原","en":"Northern Expedition"},"year":"227","month":"3"},"faction":"WJ10128","city":"CS1040","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[80,88,66,47,90,74],"title":-1,"rank":"7","loyalty":"150","reputation":"4000","equipment":{"weapon":"WP13002","armor":"WP1009505","helmet":"WP1022305","horse":"WP29009"},"couple":["WJ10224"]},{"story":{"id":"S11015","name":{"zh":"再出岐山","en":"Return to Qishan"},"year":"231","month":"1"},"faction":"WJ10128","city":"CS1040","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[80,88,66,47,90,74],"title":-1,"rank":"7","loyalty":"150","reputation":"4000","equipment":{"weapon":"WP13002","armor":"WP1009505","helmet":"WP1022305","horse":"WP29009"},"couple":["WJ10224"]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":"WJ10128","city":"CS1040","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[80,88,66,47,90,74],"title":-1,"rank":"7","loyalty":"150","reputation":"4000","equipment":{"weapon":"WP13002","armor":"WP1009505","helmet":"WP1022305","horse":"WP29009"},"couple":["WJ10224"]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ10128","city":"CS1042","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[80,88,66,47,90,74],"title":-1,"rank":"7","loyalty":"150","reputation":"4000","equipment":{"weapon":"WP13002","armor":"WP1009505","helmet":"WP1022305","horse":"WP29009"},"couple":["WJ10224"]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1004","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[80,88,66,47,90,74],"title":-1,"rank":"9","loyalty":"0","reputation":"900","equipment":{"weapon":"WP13002","armor":"WP1009505","helmet":"WP1022305","horse":"WP29009"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10210","city":"CS1042","noRecruit":false,"reject":null,"state":"2","role":1,"stats":[80,88,66,47,90,74],"title":-1,"rank":"9","loyalty":"100","reputation":"900","equipment":{"weapon":"WP13002","armor":"WP1009505","helmet":"WP1022305","horse":"WP29009"},"couple":[]}],"storyEvents":[{"kind":"plot","id":"1004808","name":{"zh":"鲍三娘完婚","en":"Bao Sanniang's Wedding"},"year":"220","month":"10","desc":{"zh":"","en":""}},{"kind":"plot","id":"1004908","name":{"zh":"花鬘完婚","en":"Hua Man's Wedding"},"year":"999","month":"999","desc":{"zh":"","en":""}}],"biography":{"zh":"蜀国武将，关羽之子，关兴之弟。武艺高强，异性缘佳。关羽逃难时，其妻胡氏怀胎三月，后生子关索。七岁时关索观灯走失，被索员外收养，九岁拜花岳先生学艺，故取名“花关索”。荆州失陷后养病鲍家庄，伤愈后在诸葛亮平定南蛮期间作为先锋出阵，多次奉命生擒孟获。","tc":"蜀國武將，關羽之子，關興之弟。武藝高強，異性緣佳。關羽逃難時，其妻胡氏懷胎三月，后生子關索。七歲時關索觀燈走失，被索員外收養，九歲拜花岳先生學藝，故取名“花關索”。荊州失陷后養病鮑家莊，傷愈后在諸葛亮平定南蠻期間作為先鋒出陣，多次奉命生擒孟獲。","en":"An officer of Shu, son of Guan Yu and younger brother of Guan Xing. A warrior of great martial skill and popular with women. When Guan Yu was fleeing, his wife Lady Hu was three months pregnant and later gave birth to Guan Suo. At seven, Guan Suo was separated from his family while watching lanterns and was raised by a man surnamed Suo. At nine he began studying martial arts under Master Hua Yue, hence the nickname ‘Hua Guan Suo.’ After Jing Province fell, he recuperated from illness at the Bao family estate. Once recovered, he served as vanguard during Zhuge Liang's pacification of the Nanman, repeatedly capturing Meng Huo on Zhuge Liang's orders.","jp":"蜀の武将。関羽の子で、関興の弟。武芸に優れ、異性縁に恵まれていた。関羽が難を逃れた際、妻の胡氏は身ごもって三ヶ月であり、後に関索を産んだ。七歳の時に関索は灯籠見物の折にはぐれ、索員外に引き取られ、九歳で花岳先生に弟子入りして技を学んだことから「花関索」と名乗った。荊州陥落後は鮑家荘で療養し、傷が癒えた後は諸葛亮の南蛮平定において先鋒として出陣し、幾度も命を受けて孟獲を生け捕りにした。","kr":"촉나라의 무장으로, 관우의 아들이자 관흥의 동생이다. 무예가 출중하고 이성에게 인기가 많았다. 관우가 난을 피해 달아날 때 그의 처 호씨가 임신 3개월이었으며, 이후 아들 관색을 낳았다. 관색은 7세 때 등불 구경을 나섰다가 길을 잃어 색 원외에게 거두어졌고, 9세에 화악 선생을 스승으로 모시고 기예를 배워 '화관색'이라는 이름을 얻었다. 형주가 함락된 뒤에는 포가장에서 요양하였으며, 상처가 아문 뒤 제갈량이 남만을 평정할 때 선봉으로 출진하여 여러 차례 명을 받들고 맹획을 사로잡았다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10210","remark":"","surname":"关","surnameTc":"關","surnameEn":"Guan","surnameJp":"関","surnameKr":"관","surnameOther":"","name":"索","nameTc":"索","nameEn":"Suo","nameJp":"索","nameKr":"색","nameOther":"","word":"维之","wordTc":"維之","wordEn":"Weizhi","wordJp":"維之","wordKr":"유지","wordOther":"","icon":"关索","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"0","workYear":"214","city":"CS1004","gender":"0","rule":"80","force":"88","wise":"66","politics":"47","charm":"90","will":"74","ruleTalent":"8","forceTalent":"13","wiseTalent":"5","politicsTalent":"4","charmTalent":"14","willTalent":"8","weaponMaster":"35/91/35/35/35/18/50/35","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"","battleSkill":"1002900;1006000","debateCard":"","warSoul":"S1002105;S1001205","battleSoul":"1013105","debateSoul":"","warSoulPoint":"6000","battleSoulPoint":"7700","debateSoulPoint":"4300","strategy":"1012115","strategy2":"1008501;1000705","professions":"3/2/4/0/0/3/2/0/0/0/1/1/4/4/5/3/0/1/2/0/0/1/4/5","attribute2":"50/50/50/50/50/50","morality":"6","compatible":"50","loyalty":"0","reputation":"900","evaluate":"6000","title":"","rank":"9","birth":"200","show":"214","death":"239","age":"0","injury":"","deathReason":"0","type":"1","npcTag":"0","npcNum":"1","microScene":"0","isImportant":"0","speaking":"6","weapon":"WP13002","armor":"WP1009505","helmet":"WP1022305","treasure":"","horse":"WP29009","shield":"","character":"0/1;1/2;12/2;18/1;41/1;57/1;10/0;43/1;36/2;5/1;30/0;38/0","father":"WJ10012/0","mother":"","children":"","family":"WJ10122/100;WJ10126/100","modInfo":"","brother":"","couple":"","otherRelationship":"","belief":"0","isVIP":"0","startVIPYear":"0","endVIPYear":"0","description":"蜀国武将，关羽之子，关兴之弟。