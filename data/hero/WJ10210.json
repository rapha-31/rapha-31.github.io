":"2","description2":{"zh":"找准时机，对敌人要害发起连击，有效而致命。使敌人短时间内处于眩晕状态。","en":"Find the right moment to strike the enemy's vitals with an effective and lethal combo. Briefly inflicts Stun on the enemy."},"ap":"3","mp":"400"}],"debateCards":[],"warSouls":[{"id":"S1002105","name":{"zh":"增速","en":"Hasten"},"level":"0","description2":{"zh":"移动速度提高15%","en":"Move Speed increased by 15%"}},{"id":"S1001205","name":{"zh":"聚气[大]","en":"Qi Charge [Great]"},"level":"1","description2":{"zh":"武将蓄力点恢复速度提高22%","en":"Officer Charge Point recovery speed increased by 22%"}}],"battleSouls":[{"id":"1013105","name":{"zh":"嫉恶如仇","en":"Righteous"},"level":"2","description2":{"zh":"自身反击率提高30%，无限反击和回合外攻击，当攻击范围内的敌人对友军使用攻击牌时，30%概率对其进行【乘势一击】。","en":"Own Counter +30%, with unlimited Counters and Out of Turn Attacks, when an enemy within Attack Range uses an Attack Card on an ally, 30% chance to perform a 【Opportunity Strike】 against them."}}],"debateSouls":[],"soulPoints":{"war":6000,"battle":7700,"debate":4300},"equipment":[{"id":"WP13002","name":{"zh":"钩镰刀","en":"Hooked Sickle Saber"},"level":"2","description":{"zh":"前端带有锋利弯钩的长刀，可轻易将敌将拖与马下完成斩杀，亦可对敌人从造成出其不意的方向造成伤害","en":"A long saber with a sharp hook at the tip, capable of easily dragging enemy generals from their horses for the kill, or striking enemies from unexpected angles"},"atkVal":"10","price":"8500","slot":{"zh":"武器","en":"Weapon"}},{"id":"WP1009505","name":{"zh":"山纹将军铠","en":"Mountain-Pattern General's Armor"},"level":"2","description":{"zh":"在山纹甲基础上增添了披风和吞肩兽，多为统军者、统领者所穿戴。","en":"Mountain-pattern armor enhanced with a cloak and beast-head pauldrons, typically worn by army commanders and leaders."},"defenceVal":"12","price":"9000","slot":{"zh":"护甲","en":"Armor"}},{"id":"WP1022305","name":{"zh":"赤玉金纹盔","en":"Red Jade Gold-Patterned Helm"},"level":"2","description":{"zh":"在盔沿添加了金色纹饰处理过的陷阵盔，方便在战场上表明自己的身份。盔沿中间的红色宝玉或许有着特殊寓意。","en":"A vanguard helm adorned with golden patterns along its brim, making it easy to identify the wearer on the battlefield. The red gemstone at the center of the brim may hold special significance."},"defenceVal":"7","price":"7000","slot":{"zh":"头盔","en":"Helmet"}},{"id":"WP29009","name":{"zh":"灰影","en":"Grey Shadow"},"level":"1","description":{"zh":"比通常黑马略显棕稚色，此马奔袭专注，不知疲倦，做冲锋战马最为适合。","en":"Slightly more brown than a typical black horse, this mount charges with unwavering focus and tireless stamina, ideal as a charger."},"price":"3000","slot":{"zh":"坐骑","en":"Mount"}}],"family":{"father":{"label":{"zh":"父亲","en":"Father"},"people":[{"id":"WJ10012","code":"0"}]},"family":{"label":{"zh":"亲属","en":"Relatives"},"people":[{"id":"WJ10122","code":"100"},{"id":"WJ10126","code":"100"}]}},"clans":[{"id":"GI111515","name":{"zh":"河东关氏","en":"The Guan Clan of Hedong"},"years":["200","264"],"desc":{"zh":"出自姬姓，周太王古公亶父之后。关羽为河东解人，蜀汉核心将门。关公为“万人敌”，蜀汉元勋；其子关兴承袭爵位；孙关统娶公主，一门在蜀汉地位尊崇。","en":"Originating from the Ji clan, descendants of King Tai of Zhou, Gugong Danfu. Guan Yu was a native of Xie in Hedong, heading a core military Family of Shu Han. Lord Guan was known as ‘a match for ten thousand men’ and a founding stalwart of Shu Han, his son Guan Xing inherited his noble rank, his grandson Guan Tong married an imperial princess. The Family held an exalted status throughout Shu Han."},"talent":{"military":"8","commerce":"3","politics":"4"}}],"friendGroups":[],"body":null,"honorifics":[],"selfAddress":[],"specialNames":[[["WJ10210","WJ10013","三叔"],["WJ10210","WJ10013","三叔"],["WJ10210","WJ10013","Third Uncle"],["WJ10210","WJ10013","三叔父上"],["WJ10210","WJ10013","셋째 삼촌"]]],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"25","startPregnantAge":"0"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":null,"city":"CS1004","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[80,88,66,47,90,74],"title":-1,"rank":"9","loyalty":"0","reputation":"950","equipment":{"weapon":"WP13002","armor":"WP1009505","helmet":"WP1022305"