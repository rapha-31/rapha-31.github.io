WP1026705"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":null,"city":"CS1031","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[76,71,62,61,72,83],"title":-1,"rank":"9","loyalty":"0","reputation":"3050","equipment":{"weapon":"WP1004902","armor":"WP1001505","helmet":"WP1026705"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ10128","city":"CS1031","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[76,71,62,61,72,83],"title":-1,"rank":"9","loyalty":"0","reputation":"3050","equipment":{"weapon":"WP1004902","armor":"WP1001505","helmet":"WP1026705"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1031","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[76,71,62,61,72,83],"title":-1,"rank":"9","loyalty":"0","reputation":"900","equipment":{"weapon":"WP1004902","armor":"WP1001505","helmet":"WP1026705"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10005","city":"CS1013","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[76,71,62,61,72,83],"title":-1,"rank":"9","loyalty":"100","reputation":"900","equipment":{"weapon":"WP1004902","armor":"WP1001505","helmet":"WP1026705"},"couple":[]}],"storyEvents":[],"biography":{"zh":"魏晋武将，魏车骑将军胡遵之孙，西晋秦州刺史胡烈之子。随父亲胡烈参与了魏灭蜀之战。战后，钟会与姜维密谋叛乱，胡烈被扣押。胡烈暗中遣人通知胡渊。胡渊当机立断，率父亲旧部率先擂鼓出击，各军紧随其后。这场兵变最终导致钟会与姜维被杀，胡渊“一战成名”，时年十八岁。元康六年，出任豫章太守。永康二年，八王之乱中，赵王司马伦命胡渊率军抵御齐王司马冏。胡渊屡次击败齐王军队。然而，随着成都王司马颖击败司马伦的主力，胡渊兵败后投降并被处死。","tc":"魏晉武將，魏車騎將軍胡遵之孫，西晉秦州刺史胡烈之子。隨父親胡烈參與了魏滅蜀之戰。戰后，鐘會與姜維密謀叛亂，胡烈被扣押。胡烈暗中遣人通知胡淵。胡淵當機立斷，率父親舊部率先擂鼓出擊，各軍緊隨其后。這場兵變最終導致鐘會與姜維被殺，胡淵“一戰成名”，時年十八歲。元康六年，出任豫章太守。永康二年，八王之亂中，趙王司馬倫命胡淵率軍抵御齊王司馬冏。胡淵屢次擊敗齊王軍隊。然而，隨著成都王司馬穎擊敗司馬倫的主力，胡淵兵敗后投降并被處死。","en":"An officer of Wei and Western Jin, grandson of Wei's Marshal Hu Zun, and son of Hu Lie, Lt. Governor of Qin Province in Western Jin. He accompanied his father Hu Lie in the campaign to conquer Shu. Following the war, Zhong Hui plotted rebellion with Jiang Wei, and Hu Lie was detained. Hu Lie secretly dispatched a messenger to alert Hu Yuan. Hu Yuan acted decisively, leading his father's former subordinates to strike first to the beat of war drums, with the other forces following close behind. This mutiny ultimately led to the deaths of Zhong Hui and Jiang Wei, bringing Hu Yuan ‘fame in a single battle’ at the age of eighteen. In the sixth year of the Yuankang era, he was appointed Governor of Yuzhang. In the second year of the Yongkang era, amid the War of the Eight Princes, Prince of Zhao Sima Lun ordered Hu Yuan to lead an army to resist Prince of Qi Sima Jiong. Hu Yuan defeated the Prince of Qi's forces repeatedly. However, after Prince of Chengdu Sima Ying defeated Sima Lun's main force, Hu Yuan suffered defeat, surrendered, and was executed.","jp":"魏・西晋の武将。魏の車騎将軍胡遵の孫で、西晋の秦州刺史胡烈の子。父の胡烈に従って魏の蜀平定戦に従軍した。戦後、鍾会と姜維が反乱を企てて胡烈が監禁されると、胡烈は密かに使者を送って胡淵に急報した。胡淵は即座に決断を下し、父の旧部を率いて先頭で太鼓を打ち鳴らし出撃すると、諸軍がこれに続いた。この兵変によって鍾会と姜維は討たれ、胡淵は十八歳にして一躍名を馳せた。元康六年、豫章太守に就任。永康二年、八王の乱において趙王司馬倫の命を受け、軍を率いて斉王司馬冏を迎撃し、度々斉王軍を撃破した。しかし成都王司馬穎が司馬倫の主力を撃破したことで、胡淵も敗れて降伏した後に処刑された。","kr":"위진 시기의 무장으로, 위나라 거기장군 호준의 손자이자 서진 진주자사 호열의 아들이다. 아버지 호열을 따라 위나라의 촉 정벌전에 참전했다. 전후 종회와 강유가 반란을 꾀하며 호열을 감금하자, 호열은 은밀히 사람을 보내 호연에게 이를 알렸다. 호연은 과감히 결단을 내려 아버지의 옛 부하들을 이끌고 앞장서서 북을 울리며 출격했고, 여러 군사가 그 뒤를 따랐다. 이 병변으로 결국 종회와 강유는 목숨을 잃었으며, 호연은 단번에 명성을 떨쳤는데 당시 그의 나이는 18세였다. 원강 6년에는 예장태수에 임명되었다. 영강 2년, 팔왕의 난 중에 조왕 사마륜의 명을 받아 군사를 이끌고 제왕 사마경을 막아섰다. 호연은 제왕의 군대를 여러 차례 격파했으나, 성도왕 사마영이 사마륜의 주력군을 격파하면서 결국 패배하여 항복한 뒤 처형당했다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ1036715","remark":"普武","surname":"胡","surnameTc":"胡","surnameEn":"Hu","surnameJp":"胡","surnameKr":"호","surnameOther":"","name":"渊","nameTc":"淵","nameEn":"Yuan","nameJp":"淵"