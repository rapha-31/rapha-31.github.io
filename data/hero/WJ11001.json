],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1005702","armor":"WP1010602","helmet":"WP1014202"},"couple":["WJ10038"]},{"story":{"id":"S10115","name":{"zh":"征讨南蛮","en":"Southern Campaign"},"year":"225","month":"3"},"faction":null,"city":"CS1071","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[65,55,74,70,73,61],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1005702","armor":"WP1010602","helmet":"WP1014202"},"couple":["WJ10038"]},{"story":{"id":"S10915","name":{"zh":"北伐中原","en":"Northern Expedition"},"year":"227","month":"3"},"faction":null,"city":"CS1071","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[65,55,74,70,73,61],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1005702","armor":"WP1010602","helmet":"WP1014202"},"couple":["WJ10038"]},{"story":{"id":"S11015","name":{"zh":"再出岐山","en":"Return to Qishan"},"year":"231","month":"1"},"faction":null,"city":"CS1071","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[65,55,74,70,73,61],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1005702","armor":"WP1010602","helmet":"WP1014202"},"couple":["WJ10038"]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":null,"city":"CS1071","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[65,55,74,70,73,61],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1005702","armor":"WP1010602","helmet":"WP1014202"},"couple":["WJ10038"]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1071","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[65,55,74,70,73,61],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1005702","armor":"WP1010602","helmet":"WP1014202"},"couple":["WJ10038"]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1047","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[65,55,74,70,73,61],"title":-1,"rank":"6","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1005702","armor":"WP1010602","helmet":"WP1014202"},"couple":["WJ10038"]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10038","city":"CS1071","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[65,55,74,70,73,61],"title":-1,"rank":"6","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1005702","armor":"WP1010602","helmet":"WP1014202"},"couple":["WJ10038"]}],"storyEvents":[],"biography":{"zh":"孙坚之妻，孙策、孙权之母，汉末丹阳太守之女，为人贞烈，少有才华，文武双全。吴旖早年失去双亲，与弟弟吴景依附于亲戚家中，担任县令的孙坚听闻吴旖的才华，便想娶之为妻。吴旖虽遭到了亲戚们的反对，但仍然选择了跟随孙坚。在孙坚南征北战期间，吴夫人携子随孙坚转战各地，多次为孙坚出谋划策。孙坚战死后，吴旖作为单身母亲，在乱世中抚养教育诸子。在孙策平定江东后，吴旖阻止了孙策诛杀当地豪杰的行为。","tc":"孫堅之妻，孫策、孫權之母，漢末丹陽太守之女，為人貞烈，少有才華，文武雙全。吳旖早年失去雙親，與弟弟吳景依附于親戚家中，擔任縣令的孫堅聽聞吳旖的才華，便想娶之為妻。吳旖雖遭到了親戚們的反對，但仍然選擇了跟隨孫堅。在孫堅南征北戰期間，吳夫人攜子隨孫堅轉戰各地，多次為孫堅出謀劃策。孫堅戰死后，吳旖作為單身母親，在亂世中撫養教育諸子。在孫策平定江東后，吳旖阻止了孫策誅殺當地豪杰的行為。","en":"The wife of Sun Jian and mother of Sun Ce and Sun Quan. She was the daughter of the Governor of Danyang in the late Han, renowned for her virtue and rare talent, equally accomplished in letters and arms. Having lost her parents in her youth, Wu Yi and her younger brother Wu Jing depended on relatives for support. Sun Jian, then serving as Magistrate, heard of her talent and sought her hand in marriage. Despite opposition from her relatives, Wu Yi chose to follow Sun Jian. During his many campaigns, Lady Wu traveled with her children at his side and repeatedly offered him strategic counsel. After Sun Jian's death in battle, Wu Yi raised their sons as a single mother through the chaos of war. After Sun Ce pacified Jiangdong, she dissuaded him from executing local heroes.","jp":"孫堅の妻、孫策・孫権の母。後漢末の丹陽太守の娘。貞烈な人柄で、若くして才気に溢れ、文武に秀でていた。呉旖は早くに両親を亡くし、弟の呉景とともに親戚の家に身を寄せていたが、県令を務めていた孫堅がその才名を聞き、妻に迎えようとした。親戚たちには反対されたものの、呉旖は孫堅のもとへ嫁ぐことを選んだ。孫堅が南征北戦を繰り広げる間、呉夫人は子を連れて各地を転戦し、幾度となく孫堅のために献策した。孫堅の戦死後は、女手一つで乱世の中で子らを育て上げた。孫策が江東を平定した際には、孫策が現地の豪傑たちを誅殺するのを思いとどまらせた。","kr":"손견의 아내이자 손책과 손권의 어머니로, 한말 단양태수의 딸이다. 성품이 정렬하고 어려서부터 재능이 뛰어나 문무를 겸비하였다. 오의는 일찍이 부모를 여의고 동생 오경과 함께 친척 집에 몸을 의탁하였는데, 현령으로 재임 중이던 손견이 오의의 재능을 전해 듣고 아내로 맞이하고자 하였다. 친척들의 반대가 심했으나, 오의는 손견을 따르기로 뜻을 굽히지 않았다. 손견이 남북을 누비며 정벌에 나섰을 때에도 오부인은 아이들을 데리고 각지를 함께 전전하며 누차 계책을 내놓았다. 손견이 전사한 뒤에는 홀어머니의 몸으로 난세 속에서 자식들을 부양하고 가르쳤으며, 손책이 강동을 평정한 뒤 현지 호걸들을 주살하려 하자 이를 만류하였다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ11001","remark":"","surname":"吴","surnameTc":"吳","surnameEn":"Wu","surnameJp":"呉","surnameKr":"오","surnameOther":"","name":"旖","nameTc":"旖","nameEn":"Yi","nameJp":"旖","nameKr":"의","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"吴旖","power":"WJ10038","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"2","workYear":"184","city":"CS1047","gender":"1","rule":"65","force":"55","wise":"74","politics":"70","charm":"73","will":"61","ruleTalent":"8","forceTalent":"7","wiseTalent":"9","politicsTalent":"9","charmTalent":"9","willTalent":"8","weaponMaster":"77/24/24/24/24/45/66/24","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"","battleSkill":"","debateCard":"","warSoul":"S1000102","battleSoul":"","debateSoul":"","warSoulPoint":"4200","battleSoulPoint":"3000","debateSoulPoint":"5500","strategy":"","strategy2":"1004401;1009601","professions":"2/3/0/0/0/2/2/3/2/3/1/1/0/3/1/0/0/2/2/2/1/0/1/0","attribute2":"65/55/78/74/73/65","morality":"7","compatible":"85","loyalty":"100","reputation":"0","evaluate":"4000","title":"","rank":"6","birth":"158","show":"184","death":"202","age":"0","injury":"","deathReason":"0","type":"0","npcTag":"0","npcNum":"1","microScene":"0","isImportant":"0","speaking":"3","weapon":"WP1005702","armor":"WP1010602","helmet":"WP1014202","treasure":"","horse":"","shield":"","character":"0/1;1/1;9/1;12/1;15/2;21/1;23/1;31/2;38/1;47/1","father":"","mother":"","children":"WJ10393/100;WJ11003/100;WJ10020/100;WJ10617/100;WJ10040/100;WJ11004/100","family":"WJ10258/100;WJ10039/100","modInfo":"","brother":"","couple":"WJ10038/100","otherRelationship":"WJ10152/0;WJ11040/2","belief":"0","isVIP":"0","startVIPYear":"0","endVIPYear":"0","description":"孙坚之妻，孙策、孙权之母，汉末丹阳太守之女，为人贞烈，少有才华，文武双全。吴旖早年失去双亲，与弟弟吴景依附于亲戚家中，担任县令的孙坚听闻吴旖的才华，便想娶之为妻。吴旖虽遭到了亲戚们的反对，但仍然选择了跟随孙坚。在孙坚南征北战期间，吴夫人携子随孙坚转战各地，多次为孙坚出谋划策。孙坚战死后，吴旖作为单身母亲，在乱世中抚养教育诸子。在孙策平定江东后，吴旖阻止了孙策诛杀当地豪杰的行为。","descriptionTc":"孫堅之妻，孫策、孫權之母，漢末丹陽太守之女，為人貞烈，少有才華，文武雙全。吳旖早年失去雙親，與弟弟吳景依附于親戚家中，擔任縣令的孫堅聽聞吳旖的才華，便想娶之為妻。吳旖雖遭到了親戚們的反對，但仍然選擇了跟隨孫堅。在孫堅南征北戰期間，吳夫人攜子隨孫堅轉戰各地，多次為孫堅出謀劃策。孫堅戰死后，吳旖作為單身母親，在亂世中撫養教育諸子。在孫策平定江東后，吳旖阻止了孫策誅殺當地豪杰的行為。","descriptionEn":"The wife of Sun Jian and mother of Sun Ce and Sun Quan. She was the daughter of the Governor of Danyang in the late Han, renowned for her virtue and rare talent, equally accomplished in letters and arms. Having lost her parents in her youth, Wu Yi and her younger brother Wu Jing depended on relatives for support. Sun Jian, then serving as Magistrate, heard of her talent and sought her hand in marriage. Despite opposition from her relatives, Wu Yi chose to follow Sun Jian. During his many campaigns, Lady Wu traveled with her children at his side and repeatedly offered him strategic counsel. After Sun Jian's death in battle, Wu Yi raised their sons as a single mother through the chaos of war. After Sun Ce pacified Jiangdong, she dissuaded him from executing local heroes.","descriptionJp":"孫堅の妻、孫策・孫権の母。後漢末の丹陽太守の娘。貞烈な人柄で、若くして才気に溢れ、文武に秀でていた。呉旖は早くに両親を亡くし、弟の呉景とともに親戚の家に身を寄せていたが、県令を務めていた孫堅がその才名を聞き、妻に迎えようとした。親戚たちには反対されたものの、呉旖は孫堅のもとへ嫁ぐことを選んだ。孫堅が南征北戦を繰り広げる間、呉夫人は子を連れて各地を転戦し、幾度となく孫堅のために献策した。孫堅の戦死後は、女手一つで乱世の中で子らを育て上げた。孫策が江東を平定した際には、孫策が現地の豪傑たちを誅殺するのを思いとどまらせた。","descriptionKr":"손견의 아내이자 