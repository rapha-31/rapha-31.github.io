met":"WP1020805"},"couple":[]},{"story":{"id":"S10115","name":{"zh":"征讨南蛮","en":"Southern Campaign"},"year":"225","month":"3"},"faction":null,"city":"CS1009","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[76,71,34,10,46,72],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP13008","armor":"WP1008405","helmet":"WP1020805"},"couple":[]},{"story":{"id":"S10915","name":{"zh":"北伐中原","en":"Northern Expedition"},"year":"227","month":"3"},"faction":null,"city":"CS1009","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[76,71,34,10,46,72],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP13008","armor":"WP1008405","helmet":"WP1020805"},"couple":[]},{"story":{"id":"S11015","name":{"zh":"再出岐山","en":"Return to Qishan"},"year":"231","month":"1"},"faction":null,"city":"CS1009","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[76,71,34,10,46,72],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP13008","armor":"WP1008405","helmet":"WP1020805"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":null,"city":"CS1009","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[76,71,34,10,46,72],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP13008","armor":"WP1008405","helmet":"WP1020805"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1009","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[76,71,34,10,46,72],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP13008","armor":"WP1008405","helmet":"WP1020805"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1009","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[76,71,34,10,46,72],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP13008","armor":"WP1008405","helmet":"WP1020805"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10060","city":"CS1009","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[76,71,34,10,46,72],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP13008","armor":"WP1008405","helmet":"WP1020805"},"couple":[]}],"storyEvents":[],"biography":{"zh":"袁绍麾下重要将领，擅长指挥轻骑兵进行快速机动，官渡之战前多次劫掠曹操边境，迫使曹军收缩防线。官渡之战中沮授曾建议袁绍派蒋奇率偏师护卫乌巢粮道，但袁绍未采纳。此决策失误直接导致曹操奇袭乌巢成功。后袁绍命其领兵一万支援乌巢，途中被张辽所斩。","tc":"袁紹麾下重要將領，擅長指揮輕騎兵進行快速機動，官渡之戰前多次劫掠曹操邊境，迫使曹軍收縮防線。官渡之戰中沮授曾建議袁紹派蔣奇率偏師護衛烏巢糧道，但袁紹未采納。此決策失誤直接導致曹操奇襲烏巢成功。后袁紹命其領兵一萬支援烏巢，途中被張遼所斬。","en":"A key general under Yuan Shao, skilled at commanding light cavalry in rapid maneuvers. Before the Battle of Guandu, he repeatedly raided Cao Cao's border territory, forcing Cao Cao's forces to contract their defensive lines. During the Battle of Guandu, Ju Shou advised Yuan Shao to send Jiang Qi with a detached force to protect the supply route to Wuchao, but Yuan Shao ignored the counsel. This critical oversight directly enabled Cao Cao's successful surprise attack on Wuchao. Yuan Shao later ordered Jiang Qi to lead ten thousand men to reinforce Wuchao, but he was intercepted and slain by Zhang Liao en route.","jp":"袁紹配下の有力武将。軽騎兵を指揮した迅速な機動戦を得意とし、官渡の戦いの前には度々曹操の辺境を略奪して防衛線を後退させた。官渡の戦いにおいて、沮授は袁紹に対し、蒋奇に別動隊を率いさせて烏巣の糧道を護衛させるよう進言したが、袁紹はこれを受け入れなかった。この判断の誤りが、曹操による烏巣奇襲を成功させる直接の原因となった。その後、袁紹の命を受けて一万の兵を率い烏巣の救援に向かったが、途中で張遼に討ち取られた。","kr":"원소 휘하의 주요 장수로, 경기병을 지휘한 신속한 기동전에 능했다. 관도대전 이전에는 조조의 접경 지역을 여러 차례 약탈하여 조조군이 방어선을 물리도록 압박했다. 관도대전 당시 저수가 원소에게 장기에게 별동대를 이끌고 오소의 군량 수송로를 호위하게 할 것을 진언했으나, 원소는 이를 받아들이지 않았다. 이 판단 착오는 곧 조조의 오소 기습 성공으로 직결되었다. 이후 원소의 명을 받아 1만 군사를 이끌고 오소를 구원하러 가던 중, 장료에게 목이 베였다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":