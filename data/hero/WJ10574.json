,74,55,45,62,76],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP12012","armor":"WP1001505","helmet":"WP1024305"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1025","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[76,74,55,45,62,76],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP12012","armor":"WP1001505","helmet":"WP1024305"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1025","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[76,74,55,45,62,76],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP12012","armor":"WP1001505","helmet":"WP1024305"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10074","city":"CS1025","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[76,74,55,45,62,76],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP12012","armor":"WP1001505","helmet":"WP1024305"},"couple":[]}],"storyEvents":[{"kind":"plot","id":"1068002","name":{"zh":"全国比武大会","en":"National Martial Tournament"},"year":"0","month":"0","desc":{"zh":"全国比武大会已经拉开帷幕，若有意参与请尽快前往。","en":"The National Martial Tournament has begun. Head there at once if you wish to participate."}},{"kind":"plot","id":"1068102","name":{"zh":"全国群武大会","en":"National Team Combat"},"year":"0","month":"0","desc":{"zh":"全国比武大会已经拉开帷幕，若有意参与请尽快前往。","en":"The National Martial Tournament has begun. Head there at once if you wish to participate."}},{"kind":"plot","id":"1080102","name":{"zh":"全国辩论大赛","en":"National Debate Contest"},"year":"0","month":"0","desc":{"zh":"全国辩论大赛已经拉开帷幕，若有意参与请尽快前往。","en":"The National Debate Contest has begun. Head there at once if you wish to participate."}},{"kind":"plot","id":"1080202","name":{"zh":"全国群辩大赛","en":"National Team Debate"},"year":"0","month":"0","desc":{"zh":"全国群辩大赛已经拉开帷幕，若有意参与请尽快前往。","en":"The National Team Debate has begun. Head there at once if you wish to participate."}},{"kind":"plot","id":"1009602","name":{"zh":"全国演兵大会","en":"National War Games"},"year":"0","month":"0","desc":{"zh":"全国演兵大会已经拉开帷幕，若有意参与请尽快前往。","en":"The National War Games have begun. Head there at once if you wish to participate."}}],"biography":{"zh":"豫州颍川郡黄巾军渠帅，张角三十六方中东方渠帅之一。中平元年张角发动起义后，与其余地区的黄巾军相应纷纷起兵，长社之战中率军与右中郎将朱儁交战，大破官军，并将朱儁围困于长社城内。左中郎将皇甫嵩率军救援朱儁，进驻长社。以优势兵力围困皇甫嵩，一度使汉军陷入恐慌。然而，波才依草结营，被皇甫嵩乘夜纵火焚烧营寨，导致阵脚大乱。后被曹操等援军奇袭所杀。","tc":"豫州潁川郡黃巾軍渠帥，張角三十六方中東方渠帥之一。中平元年張角發動起義后，與其余地區的黃巾軍相應紛紛起兵，長社之戰中率軍與右中郎將朱儁交戰，大破官軍，并將朱儁圍困于長社城內。左中郎將皇甫嵩率軍救援朱儁，進駐長社。以優勢兵力圍困皇甫嵩，一度使漢軍陷入恐慌。然而，波才依草結營，被皇甫嵩乘夜縱火焚燒營寨，導致陣腳大亂。后被曹操等援軍奇襲所殺。","en":"A Yellow Turban commander in Yingchuan Commandery of Yu Province, and one of the division commanders of the east among Zhang Jiao's Thirty-Six Divisions. After Zhang Jiao launched the uprising in the first year of Zhongping, Bo Cai rose in rebellion alongside Yellow Turban forces across other regions. In the Battle of Changshe, he clashed with Zhu Jun, General of the Household of the Right, decisively crushing the imperial army and besieging Zhu Jun inside the city of Changshe. Huangfu Song, General of the Household of the Left, led troops to relieve Zhu Jun and garrisoned Changshe. Bo Cai besieged Huangfu Song with superior troops, plunging the Han army into panic for a time. However, Bo Cai had pitched his camp amidst dense grass. Under cover of night, Huangfu Song set fire to the camp, throwing his lines into disarray. Bo Cai was later killed in a surprise raid by support forces led by Cao Cao and others.","jp":"豫州潁川郡の黄巾軍渠帥で、張角の「三十六方」における「東方渠帥」の一人。中平元年に張角が蜂起すると、他地域の黄巾軍に呼応して相次ぎ挙兵した。長社の戦いでは軍を率いて右中郎将の朱儁と交戦して官軍を大破し、朱儁を長社城内に包囲した。左中郎将の皇甫嵩が朱儁を救援するために長社に進駐すると、優勢な兵力をもって皇甫嵩を包囲し、一時漢軍を恐慌に陥れた。しかし、草木を頼りに陣を敷いていたため、皇甫嵩に夜陰に乗じて火を放たれて陣営を焼き払われ、陣が総崩れとなった。その後、曹操らの援軍による奇襲を受けて討ち取られた。","kr":"예주 영천군 황건적의 거수로, 장각의 36방 중 동방 거수 중 한 사람이다. 중평 원년 장각이 봉기하자, 다른 지역 황건적과 호응하여 잇달아 거병했다. 장사 전투에서 군사를 이끌고 우중랑장 주준과 교전하여 관군을 대파하고, 주준을 장사성 안에 포위했다. 좌중랑장 황보숭이 주준을 구원하기 위해 군사를 이끌고 장사에 진주하자, 우세한 병력으로 황보숭마저 포위하여 한때 한군을 공황에 빠뜨렸다. 그러나 파재가 풀숲을 의지해 영채를 세운 탓에, 밤을 틈타 화공을 펼친 황보숭에게 영채가 불타며 진형이 크게 무너졌다. 이후 조조 등 원군의 기습을 받아 전사했다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10574","remark":"","surname":"波","surnameTc":"波","surnameEn":"Bo","surnameJp":"波","surnameKr":"파","surnameOther":"","name":"才","nameTc":"才","nameEn":"Cai","nameJp":"才","nameKr":"재","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"波才","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"3","workYear":"184","city":"CS1025","gender":"0","rule":"76","force":"74","wise":"55","politics":"45","charm":"62","will":"76","ruleTalent":"8","forceTalent":"8","wiseTalent":"5","politicsTalent":"4","charmTalent":"7","willTalent":"9","weaponMaster":"34/34/34/74/34/20/50/34","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"1006802","battleSkill":"","debateCard":"","warSoul":"S1002605","battleSoul":"1007505","debateSoul":"","warSoulPoint":"5400","battleSoulPoint":"5400","debateSoulPoint":"3000","strategy":"1010915","strategy2":"1005201","professions":"3/3/0/0/3/0/2/0/0/0/3/2/2/2/2/0/0/0/0/1/0/2/1/0","attribute2":"50/50/50/50/50/50","morality":"3","compatible":"96","loyalty":"0","reputation":"0","evaluate":"-3000","title":"","rank":"9","birth":"145","show":"184","death":"184","age":"0","injury":"","deathReason":"1","type":"1","npcTag":"0","npcNum":"1","microScene":"0","isImportant":"0","speaking":"2","weapon":"WP12012","armor":"WP1001505","helmet":"WP1024305","treasure":"","horse":"","shield":"","character":"0/1;1/1;18/1;25/2;28/1;12/1;30/1;10/0","father":"","mother":"","children":"","f