,65,72,80],"title":-1,"rank":"3","loyalty":"100","reputation":"9850","equipment":{"weapon":"WP1006002","armor":"WP1011805","helmet":"WP1022705","horse":"WP29001"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ10020","city":"CS1053","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[88,83,79,65,72,80],"title":-1,"rank":"3","loyalty":"100","reputation":"9850","equipment":{"weapon":"WP1006002","armor":"WP1011805","helmet":"WP1022705","horse":"WP29001"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1053","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[88,83,79,65,72,80],"title":-1,"rank":"9","loyalty":"0","reputation":"1850","equipment":{"weapon":"WP1006002","armor":"WP1011805","helmet":"WP1022705","horse":"WP29001"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10020","city":"CS1053","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[88,83,79,65,72,80],"title":-1,"rank":"9","loyalty":"100","reputation":"1850","equipment":{"weapon":"WP1006002","armor":"WP1011805","helmet":"WP1022705","horse":"WP29001"},"couple":[]}],"storyEvents":[],"biography":{"zh":"吴国大将，位列江表十二虎臣，与丁奉互为得力搭档。跟随孙权转战各地，为人负责好强，合肥之战时与周泰助孙权突围使其得以脱险。曹丕试图渡江伐吴时，提出城墙外用篱笆、草人等迷惑曹丕，孙权采纳了这一建议，百里疑城一夜建成。曹丕见吴军城防森严、军容整肃，感叹魏虽有武骑千群，无所用也，最终因冬季江水浅狭、战船难行而退兵。众臣无一不对徐盛拜服。曹丕退兵后，曹魏数十年未敢大规模南征。徐盛于黄武年间去世。其官爵由儿子徐楷继承。","tc":"吳國大將，位列江表十二虎臣，與丁奉互為得力搭檔。跟隨孫權轉戰各地，為人負責好強，合肥之戰時與周泰助孫權突圍使其得以脫險。曹丕試圖渡江伐吳時，提出城墻外用籬笆、草人等迷惑曹丕，孫權采納了這一建議，百里疑城一夜建成。曹丕見吳軍城防森嚴、軍容整肅，感嘆魏雖有武騎千群，無所用也，最終因冬季江水淺狹、戰船難行而退兵。眾臣無一不對徐盛拜服。曹丕退兵后，曹魏數十年未敢大規模南征。徐盛于黃武年間去世。其官爵由兒子徐楷繼承。","en":"A prominent general of Wu, counted among the Twelve Tiger Officials of Jiangbiao, and a trusted partner of Ding Feng. He campaigned across various regions alongside Sun Quan, known for his sense of duty and unyielding spirit. During the Battle of Hefei, he and Zhou Tai aided Sun Quan in breaking through the encirclement to escape danger. When Cao Pi attempted to cross the Yangtze to invade Wu, Xu Sheng proposed setting up fences and scarecrows outside the walls to deceive him. Sun Quan adopted the plan, and a hundred-li mock defensive wall was erected overnight. Seeing Wu's fortifications so formidable and their troops in strict order, Cao Pi lamented that though Wei possessed thousands of armored cavalry, they were of no use. In winter, as the river waters grew shallow and narrow, making warships difficult to navigate, Cao Pi was ultimately forced to withdraw. The ministers were all filled with admiration for Xu Sheng. After Cao Pi's retreat, Cao Wei did not dare launch a large-scale southern expedition for decades. Xu Sheng passed away during the Huangwu era, and his title was inherited by his son, Xu Kai.","jp":"呉の大将。「江表十二虎臣」の一人に数えられ、丁奉とは良き相棒であった。孫権に従って各地を転戦した。責任感が強く負けず嫌いな性格で、合肥の戦いでは周泰と共に孫権の包囲突破を助け、危機を脱せしめた。曹丕が長江を渡って呉を討とうとした際、城壁の外に柴垣や藁人形などを設けて曹丕を欺く策を進言し、孫権がこれを受け入れたことで百里に及ぶ疑城が一夜にして築かれた。曹丕は呉軍の「城防森厳にして、軍容整粛たり」という様を見て、「魏に武騎千群ありと雖も、用うるところ無し」と感嘆し、最終的には冬の長江の水が浅く狭まり戦船の航行が難しくなったため兵を引いた。群臣は誰一人として徐盛に服さぬ者はいなかった。曹丕の撤退後、曹魏は数十年にわたり大規模な南征に踏み切れなかった。徐盛は黄武年間に死去。その官爵は子の徐楷が継いだ。","kr":"오나라의 대장으로, 강표십이호신의 일원이며 정봉과 훌륭한 호흡을 맞춘 단짝이었다. 손권을 따라 각지를 전전하였으며, 매사에 책임감이 강하고 지기 싫어하는 성품이었다. 합비 전투 때는 주태와 함께 손권이 포위를 뚫고 탈출할 수 있도록 도왔다. 조비가 강을 건너 오나라를 정벌하려 하자 성벽 밖에 울타리와 허수아비 등을 세워 조비를 현혹하자는 계책을 내놓았고, 손권이 이를 받아들여 하룻밤 사이에 백 리에 이르는 의성(疑城)을 완성했다. 조비는 오군의 도시 방어가 삼엄하고 군용이 정제된 것을 보고 '위나라에 비록 천 무리의 기병이 있다 한들 쓸모가 없구나'라며 탄식했고, 결국 겨울에 강수가 얕고 좁아 전선이 운행하기 어렵게 되자 군사를 물렸다. 신하들 중 서성에게 탄복하지 않는 이가 없었다. 조비가 물러간 후, 조위는 수십 년 동안 감히 대규모로 남정에 나서지 못했다. 서성은 황무 연간에 세상을 떠났으며, 그의 관작은 아들 서해가 계승했다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10098","remark":"","surname":"徐","surnameTc":"徐","surnameEn":"Xu","surnameJp":"徐","surnameKr":"서","surnameOther":"","name":"盛","n