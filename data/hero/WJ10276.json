905","helmet":"WP1020805"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":null,"city":"CS1029","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[74,75,68,56,60,42],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1006702","armor":"WP1001905","helmet":"WP1020805"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1029","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[74,75,68,56,60,42],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1006702","armor":"WP1001905","helmet":"WP1020805"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1030","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[74,75,68,56,60,42],"title":-1,"rank":"7","loyalty":"100","reputation":"2750","equipment":{"weapon":"WP1006702","armor":"WP1001905","helmet":"WP1020805"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10048","city":"CS1029","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[74,75,68,56,60,42],"title":-1,"rank":"7","loyalty":"100","reputation":"2750","equipment":{"weapon":"WP1006702","armor":"WP1001905","helmet":"WP1020805"},"couple":[]}],"storyEvents":[],"biography":{"zh":"吕布部下八健将之一。随吕布多次和曹操交战，后同吕布一同逃往徐州，后下邳与吕布等人被曹操包围，制止了部下投降刘备的意图。因违反禁酒令与宋宪遭到吕布棒刑，怀恨心，最终和宋宪等人一同将吕布捆绑送于曹操以投降。","tc":"呂布部下八健將之一。隨呂布多次和曹操交戰，后同呂布一同逃往徐州，后下邳與呂布等人被曹操包圍，制止了部下投降劉備的意圖。因違反禁酒令與宋憲遭到呂布棒刑，懷恨心，最終和宋憲等人一同將呂布捆綁送于曹操以投降。","en":"One of Lu Bu's Eight Elite Generals. He fought alongside Lu Bu in numerous engagements against Cao Cao and later fled with him to Xu Province. Later at Xiapi, when surrounded by Cao Cao alongside Lu Bu and others, he prevented his subordinates from surrendering to Liu Bei. After he and Song Xian were flogged by Lu Bu for violating the ban on alcohol, he harbored a grudge. Ultimately, he joined Song Xian and others in binding Lu Bu and delivering him to Cao Cao to surrender.","jp":"呂布配下の八健将の一人。呂布に従って度々曹操と交戦し、後に呂布と共に徐州へ逃れた。その後、下邳で呂布らと共に曹操に包囲された際には、部下が劉備に降伏するのを制止した。しかし禁酒令に違反した廉で宋憲と共に呂布から棒刑に処されたことを恨み、最終的には宋憲らと共に呂布を捕縛して曹操に引き渡し、降伏した。","kr":"여포 휘하 팔건장 중 한 사람이다. 여포를 따라 조조와 여러 차례 맞서 싸웠으며, 이후 여포와 함께 서주로 달아났다. 훗날 하비에서 여포 등과 함께 조조에게 포위되었을 때, 부하들이 유비에게 항복하려던 것을 제지하였다. 그러나 금주령을 어겼다는 이유로 송헌과 함께 여포에게 곤장형을 당하자 앙심을 품었고, 끝내 송헌 등과 함께 여포를 결박하여 조조에게 넘기고 항복하였다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10276","remark":"","surname":"侯","surnameTc":"侯","surnameEn":"Hou","surnameJp":"侯","surnameKr":"후","surnameOther":"","name":"成","nameTc":"成","nameEn":"Cheng","nameJp":"成","nameKr":"성","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"侯成","power":"WJ10048","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"2","workYear":"184","city":"CS1030","gender":"0","rule":"74","force":"75","wise":"68","politics":"56","charm":"60","will":"42","ruleTalent":"8","forceTalent":"9","wiseTalent":"7","politicsTalent":"5","charmTalent":"6","willTalent":"3","weaponMaster":"36/36/36/36/77/26/50/36","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"","battleSkill":"","debateCard":"","warSoul":"","battleSoul":"1013005","debateSoul":"","warSoulPoint":"5400","battleSoulPoint":"5600","debateSoulPoint":"4600","strategy":"1008315","strategy2":"1000905","professions":"2/2/3/2/0/0/2/1/0/1/2/2/1/0/2/0/1/1/0/2/0/3/0/1","attribute2":"50/50/50/50/50/50","morality":"3","compatible":"98","loyalty":"100","reputation":"2750","evaluate":"0","title":"","rank":"7","birth":"158","show":"184","death":"200","age":"0","injury":"","deathReason":"0","type":"1","npcTag":"0","