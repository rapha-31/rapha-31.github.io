atkVal":"5","price":"2000","slot":{"zh":"武器","en":"Weapon"}},{"id":"WP1009805","name":{"zh":"山纹将军铠·丙","en":"Mountain Pattern General Armor - III"},"level":"2","description":{"zh":"在山纹甲基础上增添了披风和吞肩兽，多为统军者、统领者所穿戴。","en":"Mountain-pattern armor enhanced with a cloak and beast-head pauldrons, typically worn by army commanders and leaders."},"defenceVal":"12","price":"9000","slot":{"zh":"护甲","en":"Armor"}},{"id":"WP1021205","name":{"zh":"统帅陷阵盔","en":"Commander's Shock Helm"},"level":"2","description":{"zh":"在盔沿添加了额外装饰的陷阵盔，是对常年冲锋陷阵又全身而退之人的奖赏。","en":"A vanguard helm with extra brim decorations, a reward for those who repeatedly charge into battle and emerge unscathed."},"defenceVal":"6","price":"5500","slot":{"zh":"头盔","en":"Helmet"}},{"id":"WP29001","name":{"zh":"战马","en":"Warhorse"},"level":"1","description":{"zh":"战场上必不可少的身影。","en":"An indispensable presence on the battlefield."},"price":"2000","slot":{"zh":"坐骑","en":"Mount"}}],"family":{"family":{"label":{"zh":"亲属","en":"Relatives"},"people":[{"id":"WJ10381","code":"100"}]}},"clans":[{"id":"GI114615","name":{"zh":"陈留高氏","en":"The Gao Clan of Chenliu"},"years":["0","999"],"desc":{"zh":"出自姜姓，为齐太公之后。始祖高固于新莽时拒仕，以节烈闻名。子高慎官至东莱太守，以清贫勤俭传家。此后三代皆有人任郡守、刺史，至汉末已发展为“世秩二千石”的望族，并与陈郡何氏、汝南袁氏联姻。高干任并州刺史，其从弟高柔在曹操时代以精于法理著称，任廷尉二十三年，以执法公正闻名。高平陵之变时，他代理曹爽大将军之职，占据曹爽营地，为司马懿控制京师起到关键作用，事后被比作西汉平定吕氏的周勃。陈留高氏在曹魏后期是司马氏士族联盟的重要成员，家族影响力贯穿整个曹魏兴衰。","en":"Descended from the Jiang surname, tracing their ancestry to Grand Duke Jiang of Qi. Their founding ancestor, Gao Gu, refused to serve during the Xin dynasty of Wang Mang and became famed for his unyielding integrity. His son Gao Shen rose to Governor of Donglai, establishing a family heritage of frugality and upright modesty. For the subsequent three generations, members served as Governors and Inspectors, by the late Han, they had flourished into an illustrious lineage ‘holding two-thousand-bushel posts for generations,’ intermarrying with the He clan of Chen Commandery and the Yuan clan of Runan. Gao Gan served as Lt. Governor of Bing Province, while his cousin Gao Rou was acclaimed for his legal acumen during Cao Cao's era, serving as Court Officer for twenty-three years, he was renowned for his just enforcement of the law. During the Incident at the Gaoping Tombs, he acted as Grand General in Cao Shuang's stead and occupied Cao Shuang's camp, playing a pivotal role in Sima Yi securing control of the capital, and was afterward compared to Zhou Bo of the Western Han who quelled the Lü clan. In the late Cao Wei period, the Gao clan of Chenliu stood as an essential pillar of the Sima gentry alliance, their family influence spanning the entire rise and fall of the dynasty."},"talent":{"military":"6","commerce":"4","politics":"7"}}],"friendGroups":[{"story":"S10802","members":["WJ10188","WJ10291","WJ10157","WJ10563","WJ10564"]},{"story":"S10402","members":["WJ10188","WJ10291","WJ10157","WJ10563","WJ10564"]},{"story":"S10415","members":["WJ10188","WJ10291","WJ10157","WJ10563","WJ10564"]},{"story":"S10202","members":["WJ10188","WJ10291","WJ10157","WJ10563","WJ10564"]},{"story":"S10715","members":["WJ10188","WJ10291","WJ10157","WJ10563","WJ10564"]},{"story":"S10102","members":["WJ10188","WJ10291","WJ10157","WJ10563","WJ10564"]},{"story":"S10215","members":["WJ10188","WJ10291","WJ10157","WJ10563","WJ10564"]},{"story":"S10208","members":["WJ10188","WJ10291","WJ10157","WJ10563","WJ10564"]},{"story":"S10108","members":["WJ10188","WJ10291","WJ10157","WJ10563","WJ10564"]}],"body":null,"honorifics":[],"selfAddress":[],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"25","startPregnantAge":"0"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":null,"city":"CS1028","noRecruit":false,"reject":["WJ10074",24],"state":"2","role":0,"stats":[79,67,68,69,66,81],"title":-1,"rank":"9","loyalty":"0","reputation":"14500","equipment":{"weapon":"WP10014","armor":"WP1009805","helmet":"WP1