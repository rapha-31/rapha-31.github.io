h":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":null,"city":"CS1053","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[57,58,59,61,68,57],"title":-1,"rank":"9","loyalty":"0","reputation":"8550","equipment":{"weapon":"WP10014","armor":"WP1008405","helmet":"WP1021805"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ10020","city":"CS1053","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[57,58,59,61,68,57],"title":-1,"rank":"9","loyalty":"100","reputation":"8550","equipment":{"weapon":"WP10014","armor":"WP1008405","helmet":"WP1021805"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1053","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[57,58,59,61,68,57],"title":-1,"rank":"9","loyalty":"0","reputation":"900","equipment":{"weapon":"WP10014","armor":"WP1008405","helmet":"WP1021805"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10005","city":"CS1028","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[57,58,59,61,68,57],"title":-1,"rank":"9","loyalty":"97","reputation":"900","equipment":{"weapon":"WP10014","armor":"WP1008405","helmet":"WP1021805"},"couple":[]}],"storyEvents":[],"biography":{"zh":"吴、晋武将，孙坚曾孙、孙匡之孙。孙秀初为吴国宗室，但因惧怕喜怒无常的后主孙皓，而携家眷投奔西晋，并被封为骠骑将军。吴国被晋所灭后，孙秀哭泣的感叹孙策辛苦打下的江东被孙皓所弃，但这忠义的一面也得到了司马炎的赏识，将自己的小姨蒯氏嫁给了孙秀。","tc":"吳、晉武將，孫堅曾孫、孫匡之孫。孫秀初為吳國宗室，但因懼怕喜怒無常的后主孫皓，而攜家眷投奔西晉，并被封為驃騎將軍。吳國被晉所滅后，孫秀哭泣的感嘆孫策辛苦打下的江東被孫皓所棄，但這忠義的一面也得到了司馬炎的賞識，將自己的小姨蒯氏嫁給了孫秀。","en":"An officer who served both Wu and Jin, a great-grandson of Sun Jian and grandson of Sun Kuang. Sun Xiu initially served as a member of the Wu royal clan but, fearing the capricious and unpredictable last ruler Sun Hao, fled with his family to Western Jin, where he was enfeoffed as Horse Captain. After Jin conquered Wu, Sun Xiu wept and lamented how the Jiangdong domain that Sun Ce had fought so hard to establish had been thrown away by Sun Hao. This display of loyalty earned the admiration of Sima Yan, who married his own sister-in-law, Lady Kuai, to Sun Xiu.","jp":"呉・晋の武将。孫堅の曾孫で、孫匡の孫。孫秀は当初呉の宗室であったが、喜怒常無き後主・孫皓を恐れ、一族を連れて西晋へ身を寄せ、驃騎将軍に任じられた。呉が晋に滅ぼされると、孫秀は孫策が苦心して築き上げた江東の地が孫皓によって失われたことを涙ながらに嘆いたが、その忠義な一面を司馬炎に評価され、司馬炎は自身の妻の妹である蒯氏を孫秀に娶らせた。","kr":"오나라와 진나라의 무장으로, 손견의 증손이자 손광의 손자입니다. 본래 오나라의 종실이었으나, 변덕스러운 후주 손호를 두려워하여 가솔을 이끌고 서진으로 투항한 뒤 표기장군에 봉해졌습니다. 오나라가 진나라에 멸망하자, 손책이 피땀 흘려 일군 강동을 손호가 저버렸다며 눈물을 흘리며 탄식했습니다. 그러나 이러한 충의로운 면모를 가상히 여긴 사마염은 처제인 괴씨를 손수에게 시집보냈습니다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10723","remark":"","surname":"孙","surnameTc":"孫","surnameEn":"Sun","surnameJp":"孫","surnameKr":"손","surnameOther":"","name":"秀","nameTc":"秀","nameEn":"Xiu","nameJp":"秀","nameKr":"수","nameOther":"","word":"彦才","wordTc":"彥才","wordEn":"Yancai","wordJp":"彦才","wordKr":"언재","wordOther":"","icon":"孙秀","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"0","workYear":"249","city":"CS1053","gender":"0","rule":"57","force":"58","wise":"59","politics":"61","charm":"68","will":"57","ruleTalent":"5","forceTalent":"5","wiseTalent":"5","politicsTalent":"6","charmTalent":"7","willTalent":"5","weaponMaster":"18/18/61/18/18/41/50/18","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"","battleSkill":"","debateCard":"","warSoul":"","battleSoul":"","debateSoul":"","warSoulPoint":"3200","battleSoulPoint":"3300","debateSoulPoint":"3400","strategy":"","strategy2":"1001805","professions":"0/1/0/3/0/3/1/1/0/1/0/0/0/0/2/0/0/1/0/1/0/0/1/1","attribute2":"50/50/50/50/50/50","morality":"4","compatible":"86","loyalty":"0","reputation":"900","evaluate":"2000","title":"","rank":"9","birth":"235","show":"249","death":"301",