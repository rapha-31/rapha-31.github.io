4505","helmet":"WP1019905"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":null,"city":"CS1039","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[67,53,74,73,79,74],"title":-1,"rank":"9","loyalty":"0","reputation":"1550","equipment":{"weapon":"WP1005702","armor":"WP1004505","helmet":"WP1019905"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ10128","city":"CS1039","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[67,53,74,73,79,74],"title":-1,"rank":"9","loyalty":"100","reputation":"1550","equipment":{"weapon":"WP1005702","armor":"WP1004505","helmet":"WP1019905"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1039","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[67,53,74,73,79,74],"title":-1,"rank":"9","loyalty":"0","reputation":"1500","equipment":{"weapon":"WP1005702","armor":"WP1004505","helmet":"WP1019905"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10128","city":"CS1039","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[67,53,74,73,79,74],"title":-1,"rank":"9","loyalty":"100","reputation":"1500","equipment":{"weapon":"WP1005702","armor":"WP1004505","helmet":"WP1019905"},"couple":[]}],"storyEvents":[],"biography":{"zh":"蜀国武将，蒋琬之子，蒋琬去世后袭爵安阳亭侯，官绥武将军、汉城护军。姜维第九次北伐时与王含负责左军，但因不敌邓艾夜袭而逃，并一同向姜维请罪。炎兴元年，魏国大将钟会率军伐蜀，进兵至汉城，蒋斌据城坚守。钟会围攻汉城期间，曾写信给蒋斌，提及敬仰其父蒋琬，并希望告知蒋琬墓地的具体位置，以便祭扫致敬。蒋斌巧妙借用“颜回视孔子为父”的典故回信。后得知刘禅投降后，便向钟会投降。随钟会入成都后，因局势失控死于乱军，与其弟蒋显一同尽忠。","tc":"蜀國武將，蔣琬之子，蔣琬去世后襲爵安陽亭侯，官綏武將軍、漢城護軍。姜維第九次北伐時與王含負責左軍，但因不敵鄧艾夜襲而逃，并一同向姜維請罪。炎興元年，魏國大將鐘會率軍伐蜀，進兵至漢城，蔣斌據城堅守。鐘會圍攻漢城期間，曾寫信給蔣斌，提及敬仰其父蔣琬，并希望告知蔣琬墓地的具體位置，以便祭掃致敬。蔣斌巧妙借用“顏回視孔子為父”的典故回信。后得知劉禪投降后，便向鐘會投降。隨鐘會入成都后，因局勢失控死于亂軍，與其弟蔣顯一同盡忠。","en":"An officer of Shu and the son of Jiang Wan. Following Jiang Wan's death, he inherited the title of Marquis of Anyang Pavilion and served as General of Pacifying Valor and Guard of Hancheng. During Jiang Wei's ninth Northern Expedition, he and Wang Han took charge of the left army, but they fled after being routed by Deng Ai's night raid, subsequently reporting to Jiang Wei to confess their failure. In the first year of Yanxing, the Wei general Zhong Hui led an army to subjugate Shu and advanced to Hancheng, where Jiang Bin held the city firmly. During the siege of Hancheng, Zhong Hui wrote to Jiang Bin, expressing his admiration for Jiang Wan and asking for the location of his tomb so he could pay his respects. Jiang Bin cleverly replied by invoking the allusion of ‘Yan Hui regarding Confucius as a father.’ After learning of Liu Shan's surrender, he surrendered to Zhong Hui. After accompanying Zhong Hui to Chengdu, he was killed in the chaotic fighting when the situation spiraled out of control, remaining loyal to the end alongside his younger brother Jiang Xian.","jp":"蜀の武将。蒋琬の子。蒋琬の死後に安陽亭侯の爵位を継ぎ、官職は綏武将軍、漢城護軍に至った。姜維の九度目の北伐では王含と共に左軍を担当したが、鄧艾の夜襲を防ぎきれずに逃走し、共に姜維へ罪を請うた。炎興元年、魏の大将・鍾会が軍を率いて蜀に侵攻し漢城へ進軍してくると、蒋斌は城に籠もって堅守した。漢城包囲中、鍾会は蒋斌へ書簡を送り、父の蒋琬への敬仰の念を伝えるとともに、墓参のために墓所の詳しい位置を教えるよう求めた。蒋斌は「顔回が孔子を父と見なした」故事を巧みに引用して返書を送った。その後、劉禅が降伏したことを知ると鍾会に降伏した。鍾会に従って成都に入った後、情勢の混乱により乱軍の中で命を落とし、弟の蒋顕と共に忠義を尽くした。","kr":"촉나라의 무장이자 장완의 아들이다. 장완이 세상을 떠난 후 안양정후의 작위를 계승하였으며, 관직은 수무장군과 한성호군을 지냈다. 강유의 제9차 북벌 당시 왕함과 함께 좌군을 통솔했으나, 등애의 야습을 막아내지 못하고 달아난 뒤 함께 강유에게 죄를 청했다. 염흥 원년, 위나라의 대장 종회가 군사를 이끌고 촉을 정벌하며 한성까지 진격해 오자 장빈은 성을 굳게 지켰다. 종회는 한성을 포위 공격하는 동안 장빈에게 서신을 보내 부친 장완을 흠모해 왔음을 밝히며, 묘소를 참배하여 경의를 표하고자 하니 구체적인 위치를 알려 달라고 청했다. 이에 장빈은 '안회가 공자를 아버지처럼 섬겼다'는 고사를 절묘하게 인용하여 답장을 보냈다. 이후 유선이 항복했다는 소식을 듣고 종회에게 항복했다. 종회를 따라 성도에 입성했으나, 정세가 걷잡을 수 없이 흐르자 난군 속에서 목숨을 잃었으며 아우 장현과 함께 끝까지 충절을 다했다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10470","remark":"","surname":"蒋","surnameTc":"蔣","surnameEn":"Jiang","surnameJp":"蒋","surnameKr":"장","surnameOther":"","name":"斌","nameTc":"斌","nameEn":"Bin","nameJp":"斌","nameKr":"빈","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"蒋斌","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"0","workYear":"230","city":"CS1039","gender":"0","rule":"67","force":"53","wise":"74","politics":"73","charm":"79","will":"74","ruleTalent":"7","forceTalent":"6","wiseTalent":"6","politicsTalent":"8","charmTalent":"9","willTalent":"7","weaponMaster":"51/8/8/56/8/57/50/8","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"","battleSkill":"","debateCard":"","warSoul":"S1000705","battleSoul":"","debateSoul":"1007805","warSoulPoint":"4700","battleSoulPoint":"3500","debateSoulPoint":"4000","strategy":"1003208","strategy2":"1001205","professions":"1/2/0/2/0/0/3/3/2/3/2/2/0/1/4/1/3/3/1/2/0/0/0/2","attribute2":"50/50/50/50/50/50","morality":"3","compatible":"52","loyalty":"0","reputation":"1500","evaluate":"0","title":"","rank":"9","birth":"216","show":"230","death":"264","age":"0","injury":"","deathReason":"1","type":"1","npcTag":"0","npcNum":"1","microScene":"0","isImportant":"0","speaking":"0","weapon":"WP1005702","armor":"WP1004505","helmet":"WP1019905","treasure":"","horse":"","shield":"","character":"0/1;2/1;26/1;31/1;33/1;9/1;42/0;13/0;43/0","father":"WJ10114/0","mother":"","children":"","family":"WJ10794/100","modInfo":"","brother":"","couple":"","otherRelationship":"","belief":"0","isVIP":"0","startVIPYear":"0","endVIPYear":"0","description":"蜀国武将，蒋琬之子，蒋琬去世后袭爵安阳亭侯，官绥武将军、汉城护军。姜维第九次北伐时与王含负责左军，但因不敌邓艾夜袭而逃，并一同向姜维请罪。炎兴元年，魏国大将钟会率军伐蜀，进兵至汉城，蒋斌据城坚守。钟会围攻汉城期间，曾写信给蒋斌，提及敬仰其父蒋琬，并希望告知蒋琬墓地的具体位置，以便祭扫致敬。蒋斌巧妙借用“颜回视孔子为父”的典故回信。后得知刘禅投降后，便向钟会投降。随钟会入成都后，因局势失控死于乱军，与其弟蒋显一同尽忠。","descriptionTc":"蜀國武將，蔣琬之子，蔣琬去世后襲爵安陽亭侯，官綏武將軍、漢城護軍。姜維第九次北伐時與王含負責左軍，但因不敵鄧艾夜襲而逃，并一同向姜維請罪。炎興元年，魏國大將鐘會率軍伐蜀，進兵至漢城，蔣斌據城堅守。鐘會圍攻漢城期間，曾寫信給蔣