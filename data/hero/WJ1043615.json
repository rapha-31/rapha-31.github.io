ade":"5","price":"3200","slot":{"zh":"头盔","en":"Helmet"}}],"family":{"father":{"label":{"zh":"父亲","en":"Father"},"people":[{"id":"WJ10656","code":"0"}]}},"clans":[{"id":"GI112515","name":{"zh":"安定胡氏","en":"The Hu clan of Anding"},"years":["0","999"],"desc":{"zh":"出自妫姓，舜帝之后。周武王封陈国，陈国公族胡公满为得姓始祖。该家族自汉至唐保持士族地位近八百年，形成“天下胡氏出安定”的郡望格局。胡广历仕六帝，为汉太傅。魏晋时期胡遵任曹魏车骑将军，其子胡奋为西晋镇南大将军，女胡芳为晋武帝贵嫔。胡质、胡威父子以清慎名世。","en":"Descended from the Gui surname, the lineage of Emperor Shun. King Wu of Zhou enfeoffed the State of Chen, and Duke Hu Man of Chen became the lineage's founding ancestor. The Family maintained its gentry status from the Han to the Tang dynasty for nearly eight hundred years, establishing the renowned choronym that ‘all Hu under Heaven hail from Anding.’ Hu Guang served six emperors and rose to Grand Tutor of the Han. During the Wei and Jin periods, Hu Zun served as General of Chariots and Cavalry in Cao Wei, his son Hu Fen became Senior General Who Guards the South in the Western Jin, and his daughter Hu Fang became an Imperial Noble Consort to Emperor Wu of Jin. Hu Zhi and his son Hu Wei were renowned throughout the realm for their integrity and prudence."},"talent":{"military":"7","commerce":"1","politics":"6"}}],"friendGroups":[],"body":{"name":"胡威","height":"平均","shape":"一般"},"honorifics":[],"selfAddress":[],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"25","startPregnantAge":"0"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":null,"city":"CS1053","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[55,25,62,65,63,78],"title":-1,"rank":"9","loyalty":"0","reputation":"12600","equipment":{"weapon":"WP1007502","armor":"WP1015105","helmet":"WP1027505"},"couple":[]},{"story":{"id":"S10215","name":{"zh":"汉末三杰","en":"Three Heroes of the Late Han"},"year":"185","month":"3"},"faction":null,"city":"CS1053","noRecruit":false,"reject":null,"state":"0","role":0