:"7"}}],"friendGroups":[],"body":{"name":"许玚","height":"平均","shape":"一般"},"honorifics":[],"selfAddress":[],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"25","startPregnantAge":"0"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":null,"city":"CS1003","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[46,11,68,71,76,36],"title":-1,"rank":"9","loyalty":"0","reputation":"26250","equipment":{"weapon":"WP1007002","armor":"WP1018005","helmet":"WP1026005"},"couple":[]},{"story":{"id":"S10215","name":{"zh":"汉末三杰","en":"Three Heroes of the Late Han"},"year":"185","month":"3"},"faction":null,"city":"CS1003","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[46,11,68,71,76,36],"title":-1,"rank":"9","loyalty":"0","reputation":"26250","equipment":{"weapon":"WP1007002","armor":"WP1018005","helmet":"WP1026005"},"couple":[]},{"story":{"id":"S10615","name":{"zh":"十常侍之乱","en":"Turmoil of the Ten Attendants"},"year":"188","month":"11"},"faction":"WJ10741","city":"CS1025","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[46,11,68,71,76,36],"title":-1,"rank":"7","loyalty":"99","reputation":"25250","equipment":{"weapon":"WP1007002","armor":"WP1018005","helmet":"WP1026005"},"couple":[]},{"story":{"id":"S10402","name":{"zh":"诸侯讨董","en":"Coalition Against Dong Zhuo"},"year":"190","month":"3"},"faction":"WJ10324","city":"CS1025","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[46,11,68,71,76,36],"title":-1,"rank":"7","loyalty":"99","reputation":"25250","equipment":{"weapon":"WP1007002","armor":"WP1018005","helmet":"WP1026005"},"couple":[]},{"story":{"id":"S10208","name":{"zh":"幽燕龙兴","en":"Dragon Rises in Youyan"},"year":"191","month":"3"},"faction":"WJ10324","city":"CS1025","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[46,11,68,71,76,36],"title":-1,"rank":"7","loyalty":"99","reputation":"25250","equipment":{"weapon":