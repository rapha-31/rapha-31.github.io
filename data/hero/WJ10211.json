,"armor":"WP1009505","helmet":"WP1021605","horse":"WP29001"},"couple":[]},{"story":{"id":"S10702","name":{"zh":"夷陵之战","en":"Battle of Yiling"},"year":"221","month":"5"},"faction":"WJ10020","city":"CS1047","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[84,73,76,68,64,63],"title":-1,"rank":"2","loyalty":"120","reputation":"8200","equipment":{"weapon":"WP1006002","armor":"WP1009505","helmet":"WP1021605","horse":"WP29001"},"couple":[]},{"story":{"id":"S10115","name":{"zh":"征讨南蛮","en":"Southern Campaign"},"year":"225","month":"3"},"faction":"WJ10020","city":"CS1047","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[84,73,76,68,64,63],"title":-1,"rank":"2","loyalty":"120","reputation":"8200","equipment":{"weapon":"WP1006002","armor":"WP1009505","helmet":"WP1021605","horse":"WP29001"},"couple":[]},{"story":{"id":"S10915","name":{"zh":"北伐中原","en":"Northern Expedition"},"year":"227","month":"3"},"faction":"WJ10020","city":"CS1048","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[84,73,76,68,64,63],"title":-1,"rank":"2","loyalty":"120","reputation":"8200","equipment":{"weapon":"WP1006002","armor":"WP1009505","helmet":"WP1021605","horse":"WP29001"},"couple":[]},{"story":{"id":"S11015","name":{"zh":"再出岐山","en":"Return to Qishan"},"year":"231","month":"1"},"faction":"WJ10020","city":"CS1048","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[84,73,76,68,64,63],"title":-1,"rank":"2","loyalty":"120","reputation":"8200","equipment":{"weapon":"WP1006002","armor":"WP1009505","helmet":"WP1021605","horse":"WP29001"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":"WJ10020","city":"CS1048","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[84,73,76,68,64,63],"title":-1,"rank":"2","loyalty":"120","reputation":"8200","equipment":{"weapon":"WP1006002","armor":"WP1009505","helmet":"WP1021605","horse":"WP29001"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ10020","city":"CS1053","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[84,73,76,68,64,63],"title":-1,"rank":"2","loyalty":"120","reputation":"8200","equipment":{"weapon":"WP1006002","armor":"WP1009505","helmet":"WP1021605","horse":"WP29001"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1047","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[84,73,76,68,64,63],"title":-1,"rank":"9","loyalty":"0","reputation":"1050","equipment":{"weapon":"WP1006002","armor":"WP1009505","helmet":"WP1021605","horse":"WP29001"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10020","city":"CS1053","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[84,73,76,68,64,63],"title":-1,"rank":"9","loyalty":"100","reputation":"1050","equipment":{"weapon":"WP1006002","armor":"WP1009505","helmet":"WP1021605","horse":"WP29001"},"couple":[]}],"storyEvents":[],"biography":{"zh":"吴国的宗室将领。他是孙坚之弟孙静的曾孙，官至安东中郎将，封丹徒侯。吕蒙袭取荆州时从军。刘备兴师伐吴时，与朱然听命于陆逊共同抗敌，并得到了陆逊的赞许。陆逊火烧连营后，与众将追击撤围的蜀军，并率领部队击杀张南、冯习等人，甚至差点生擒刘备，立下大功。刘备翻山越岭，姑且取得自保，怨恨地感叹道：“我从前去到京城，孙桓还是个小儿，如今竟然把我逼到这个地步！”战后，孙桓以功拜建武将军，封丹徒侯。后被派去修筑横江坞，年二十六岁英年早逝。","tc":"吳國的宗室將領。他是孫堅之弟孫靜的曾孫，官至安東中郎將，封丹徒侯。呂蒙襲取荊州時從軍。劉備興師伐吳時，與朱然聽命于陸遜共同抗敵，并得到了陸遜的贊許。陸遜火燒連營后，與眾將追擊撤圍的蜀軍，并率領部隊擊殺張南、馮習等人，甚至差點生擒劉備，立下大功。劉備翻山越嶺，姑且取得自保，怨恨地感嘆道：“我從前去到京城，孫桓還是個小兒，如今竟然把我逼到這個地步！”戰后，孫桓以功拜建武將軍，封丹徒侯。后被派去修筑橫江塢，年二十六歲英年早逝。","en":"A Sun clan general of Wu. He was the great-grandson of Sun Jing, Sun Jian's younger brother, and rose to Household General of the Pacified East, enfeoffed as Marquis of Dantu. He served during Lu Meng's seizure of Jing Province. When Liu Bei invaded Wu, he and Zhu Ran served under Lu Xun, earning the latter's praise. After Lu Xun's fire attack on the connected camps, he pursued the retreating Shu army alongside the other generals, killing Zhang Nan, Feng Xi, and others, and even nearly captured Liu Bei, achieving great merit. Liu Bei fled through the mountains and barely escaped, bitterly lamenting: ‘When I visited the capital years ago, Sun Huan was just a child. Now he has pushed me to such straits!’ After the battle, Sun Huan was named General Who Establishes Martial Valor and Marquis of Dantu for his achievements. He was later assigned to build the Hengjiang Fortress and died young at twenty-six.","jp":"呉の宗室の武将。孫堅の弟・孫静の曾孫にあたる。官位は安東中郎将に至り、丹徒侯に封じられた。呂蒙が荊州を急襲した際に従軍。劉備が呉征伐の軍を起こした折には、朱然とともに陸遜の命を受けて敵を防ぎ、陸遜から称賛を受けた。陸遜が火計で連営を焼き払った後、諸将とともに包囲を解いて退却する蜀軍を追撃し、部隊を率いて張南や馮習らを討ち取ると、劉備を生け捕りにする寸前まで追い詰めるなど大功を立てた。劉備は山野を越えてからくも身を守ると、「わしがかつて京城に赴いた頃、孫桓などまだ小児にすぎなかった。それが今やこのわしをここまで追い詰めるとは！」と恨めしげに嘆いた。戦後、孫桓はその功績により建武将軍に任じられ、丹徒侯に封じられた。後に横江塢の築造を命じられたが、二十六歳の若さで早世した。","kr":"오나라의 종실 무장이다. 손견의 아우 손정의 증손으로, 관직은 안동중랑장에 이르고 단도후에 봉해졌다. 여몽이 형주를 기습해 취할 때 종군하였다. 유비가 군사를 일으켜 오나라를 정벌하자, 주연과 함께 육손의 절도를 받들어 적을 막아내며 육손의 칭찬을 받았다. 육손이 화공으로 연영을 불태운 후, 여러 장수와 함께 포위를 풀고 퇴각하는 촉군을 추격하였으며, 부대를 이끌고 장남, 풍습 등을 격살하고 유비를 생포하기 직전까지 몰아붙여 큰 공을 세웠다. 유비는 산을 넘고 험로를 지나 가까스로 몸을 보전하고는 분통을 터뜨리며 탄식했다. '내가 예전에 경성에 갔을 때는 손환이 어린아이에 불과했거늘, 지금 나를 이 지경까지 몰아붙이다니!' 싸움이 끝난 후, 손환은 공로로 건무장군에 배령되고 단도후에 봉해졌다. 이후 횡강오를 축조하러 파견되었다가, 26세의 젊은 나이에 요절하였다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10211","remark":"","surname":"孙","surnameTc":"孫","surnameEn":"Sun","surnameJp":"孫","surnameKr":"손","surnameOther":"","name":"桓","nameTc":"桓","nameEn":"Huan","nameJp":"桓","nameKr":"환","nameOther":"","word":"叔武","wordTc":"叔武","wordEn":"Shuwu","wordJp":"叔武","wordKr":"숙무","wordOther":"","icon":"孙桓","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"2","workYear":"210","city":"CS1047","gender":"0","rule":"84","force":"73","wise":"76","politics":"68","charm":"64","will":"63","ruleTalent":"12","forceTalent":"8","wiseTalent":"9","politicsTalent":"7","charmTalent":"6","willTalent":"6","weaponMaster":"69/22/54/22/22/51/50/22","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"1022202;1007202","battleSkill":"","debateCard":"","warSoul":"S1002205;S1003605","battleSoul":"1012005","debateSoul":"1007805","warSoulPoint":"7000","battleSoulPoint":"7000","debateSoulPoint":"5700","strategy":"1003615","strategy2":"1010401","professions":"3/2/0/4/2/3/3/1/1/2/1/2/4/0/4/0/2/0/1/2/1/1/1/0","attribute2":"50/50/50/50/50/50","morality":"6","compatible":"84","loyalty":"0","reputation":"1050","evaluate":"0","title":"","rank":"9","birth":"198","show":"210","death":"223","age":"0","injury":"","deathReason":"0","type":"1","npcTag":"0","npcNum":"1","microScene":"0","isImportant":"0","speaking":"3","weapon":"WP1006002","armor":"WP1009505","helmet":"WP1021605","treasure":"","horse":"WP29001","shield":"","character":"0/1;1/1;12/1;15/1;23/1;31/1;57/1;30/2;26/3;8/0","father":"","mother":"","children":"","family":"","modInfo":"","brother":"","couple":"","otherRelationship":"","belief":"0","isVIP":"0","startVIPYear":"0","endVIPYear":"0","description":"吴国的宗室将领。他是孙坚之弟孙静的曾孙，官至安东中郎将，封丹徒侯。吕蒙袭取荆州时从军。刘备兴师伐吴时，与朱然听命于陆逊共同抗敌，并得到了陆逊的赞许。陆逊火烧连营后，与众将追击撤围的蜀军，并率领部队击杀张南、冯习等人，甚至差点生擒刘备，立下大功。刘备翻山越岭，姑且取得自保，怨恨地感叹道：“我从前去到京城，孙桓还是个小儿，如今竟然把我逼到这个地步！”战后，孙桓以功拜建武将军，封丹徒侯。后被派去修筑横江坞，年二十六岁英年早逝。","descriptionTc":"吳國的宗室將領。他是孫堅之弟孫靜的曾孫，官至安東中郎將，封丹徒侯。呂蒙襲取荊州時從軍。劉備興師伐吳時，與朱然聽命于陸遜共同抗敵，并得到了陸遜的贊許。陸遜火燒連營后，與眾將追擊撤圍的蜀軍，并率領部隊擊殺張南、馮習等人，甚至差點生擒劉備，立下大功。劉備翻山越嶺，姑且取得自保，怨恨地感嘆道：“我從前去到京城，孫桓還是個小兒，如今竟然把我逼到這個地步！”戰后，孫桓以功拜建武將軍，封丹徒侯。后被派去修筑橫江塢，年二十六歲英年早逝。","descriptionEn":"A Sun clan general of Wu. He was the great-grandson of Sun Jing, Sun Jian's younger brother, and rose to Household General of the Pacified East, enfeoffed as Marquis of Dantu. He served during Lu Meng's seizure of Jing Province. When Liu Bei invaded Wu, he and Zhu Ran served under Lu Xun, earning the latter's praise. After Lu Xun's fire attack on the connected camps, he