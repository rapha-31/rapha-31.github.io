{"id":"WJ10505","icon":"张羡","surname":{"zh":"张","tc":"張","en":"Zhang","jp":"張","kr":"장"},"givenName":{"zh":"羡","tc":"羨","en":"Xian","jp":"羨","kr":"선"},"courtesy":{"zh":"","tc":"","en":"","jp":"","kr":""},"gender":0,"type":{"code":0,"en":"Civil","zh":"文官"},"years":{"birth":155,"debut":184,"death":202,"deathReasonCode":"1","workYear":"190","age":"0"},"faction":null,"hostileFaction":null,"city":{"id":"CS1029","name":{"zh":"弘农","en":"Hongnong"},"region":{"zh":"司隶","en":"Si Protectorate"}},"stats":[{"key":"rule","zh":"统率","en":"LEA","value":70,"talent":6},{"key":"force","zh":"武力","en":"STR","value":43,"talent":3},{"key":"wise","zh":"智略","en":"INT","value":75,"talent":8},{"key":"politics","zh":"政略","en":"POL","value":82,"talent":8},{"key":"charm","zh":"魅力","en":"CHA","value":81,"talent":6},{"key":"will","zh":"意志","en":"DET","value":76,"talent":9}],"attribute2":"50/50/50/50/50/50","weaponMastery":[{"zh":"长柄穿刺","en":"Long Pierce","value":12},{"zh":"长柄挥砍","en":"Long Slash","value":12},{"zh":"短柄穿刺","en":"Short Pierce","value":12},{"zh":"短柄挥砍","en":"Short Slash","value":12},{"zh":"远程","en":"Ranged","value":12},{"zh":"文官","en":"Scholar","value":68},{"zh":"艺术","en":"Art","value":26},{"zh":"盾","en":"Shield","value":12}],"duelWeaponMultipliers":[{"zh":"长柄穿刺","en":"Long Pierce","value":1.0},{"zh":"长柄挥砍","en":"Long Slash","value":1.0},{"zh":"短柄穿刺","en":"Short Pierce","value":1.0},{"zh":"短柄挥砍","en":"Short Slash","value":1.0},{"zh":"远程","en":"Ranged","value":1.0},{"zh":"文官","en":"Scholar","value":1.0},{"zh":"艺术","en":"Art","value":1.0},{"zh":"盾","en":"Shield","value":1.0}],"debateAttribute":"1/1/1","professions":[{"zh":"短兵","en":"Blade","value":1},{"zh":"枪兵","en":"Spear","value":0},{"zh":"骑兵","en":"Cavalry","value":0},{"zh":"弓兵","en":"Archery","value":0},{"zh":"器械","en":"Siege","value":1},{"zh":"水军","en":"Navy","value":0},{"zh":"军学","en":"Military Science","value":1},{"zh":"商业","en":"Commerce","value":1},{"zh":"农业","en":"Agriculture","value":4},{"zh":"建造","en":"Construction","value":1},{"zh":"征兵","en":"Conscription","value":3},{"zh":"练兵","en":"Drill","value":0},{"zh":"治安","en":"Order","value":3},{"zh":"巡访","en":"Outreach","value":1},{"zh":"城防","en":"Fortification","value":3},{"zh":"探索","en":"Explore","value":2},{"zh":"外交","en":"Diplomacy","value":0},{"zh":"辩才","en":"Eloquence","value":1},{"zh":"潜伏","en":"Stealth","value":3},{"zh":"科研","en":"Research","value":0},{"zh":"医术","en":"Medicine","value":0},{"zh":"酒力","en":"Drinking","value":0},{"zh":"旅游","en":"Travel","value":1},{"zh":"驯兽","en":"Taming","value":1}],"traits":[{"id":2,"level":1},{"id":15,"level":1},{"id":21,"level":1},{"id":24,"level":1},{"id":29,"level":1},{"id":38,"level":1},{"id":57,"level":1},{"id":26,"level":2},{"id":43,"level":2},{"id":42,"level":2}],"values":{"morality":"3","alignment":"0","affinity":"22","loyalty":"0","reputation":"0","belief":"0"},"officialTitle":null,"officialRank":{"index":9,"name":{"zh":"九品官","en":"Ninth Rank"}},"personalTitles":[],"strategies":[],"warSkills":[{"id":"1004802","name":{"zh":"坚若磐石","en":"Solid as Bedrock"},"level":"0","description2":{"zh":"自身防御力增加50%。","en":"Increases own Defense by 50%."},"shortName":{"zh":"磐石","en":"Bedrock"}}],"battleCards":[],"debateCards":[],"warSouls":[],"battleSouls":[],"debateSouls":[],"soulPoints":{"war":3800,"battle":1800,"debate":5000},"equipment":[{"id":"WP1007102","name":{"zh":"竹简","en":"Bamboo Slip"},"level":"1","description":{"zh":"与木简一样用来记载文字的竹简，竹简在南方更为常见。","en":"Bamboo slips used for writing like wooden slips, more common in the south."},"atkVal":"3","hp":"110","mp":"160","price":"2000","slot":{"zh":"武器","en":"Weapon"}},{"id":"WP1014705","name":{"zh":"披肩衣","en":"Shoulder Wrap Garment"},"level":"0","description":{"zh":"在粗布衣的基础上增添了披肩作为装饰，曾在中原一带流行。","en":"Coarse clothing enhanced with a shoulder wrap for decoration, once fashionable in the Central Plains."},"defenceVal":"1","mp":"150","price":"300","slot":{"zh":"护甲","en":"Armor"}},{"id":"WP1028105","name":{"zh":"贤士冠·甲","en":"Sage's Crown - I"},"level":"1","descripti