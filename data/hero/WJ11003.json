ily":{"label":{"zh":"亲属","en":"Relatives"},"people":[{"id":"WJ10030","code":"100"},{"id":"WJ10393","code":"100"},{"id":"WJ10020","code":"100"},{"id":"WJ10617","code":"100"},{"id":"WJ10621","code":"100"},{"id":"WJ11004","code":"100"},{"id":"WJ10040","code":"100"}]},"otherRelationship":{"label":{"zh":"其他关系","en":"Other relationships"},"people":[{"id":"WJ10152","code":"0"},{"id":"WJ11040","code":"2"}]}},"clans":[{"id":"GI100815","name":{"zh":"富春孙氏","en":"The Sun clan of Fuchun"},"years":["184","280"],"desc":{"zh":"出自妫姓，齐田完之后，孙武之子孙明封富春侯，世居富春。东吴皇族。孙坚、孙策奠基江东，孙权称帝建国，与魏蜀鼎立近六十年，最终为司马晋消灭，是三国中存在最久的政权。","en":"Originating from the Gui surname, descendants of Tian Wan of Qi. Sun Ming, son of Sun Wu, was enfeoffed as the Marquis of Fuchun, and the clan resided in Fuchun for generations. The imperial clan of Eastern Wu. Sun Jian and Sun Ce laid the foundation in Jiangdong, and Sun Quan would Proclaim Emperor to establish the state, standing in a tripartite balance with Wei and Shu for nearly sixty years before ultimately being destroyed by Sima Jin, enduring as the longest-lasting regime among the Three Kingdoms."},"talent":{"military":"9","commerce":"4","politics":"7"}}],"friendGroups":[],"body":null,"honorifics":[],"selfAddress":[[["WJ11003","小女子"],["WJ11003","小女子"],["WJ11003","This humble maiden"],["WJ11003","私め"],["WJ11003","소녀"]]],"specialNames":[[["WJ11003","WJ10140","叔父"],["WJ11003","WJ10140","叔父"],["WJ11003","WJ10140","Uncle"],["WJ11003","WJ10140","叔父上"],["WJ11003","WJ10140","숙부"]]],"vip":{"isVIP":1,"from":"185","to":"200"},"marriage":{"aiMarriageAge":"35","startPregnantAge":"35"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":null,"city":"CS1047","noRecruit":false,"reject":["WJ10074",24],"state":"0","role":0,"stats":[72,54,81,75,89,72],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1029505","armor":"WP1015102","helmet":"WP1013002"},"couple":[]},{"story":{"id":"S10