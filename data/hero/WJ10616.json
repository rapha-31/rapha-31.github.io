05","helmet":"WP1024305"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1058","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[68,71,51,44,66,74],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP14006","armor":"WP1001205","helmet":"WP1024305"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1053","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[68,71,51,44,66,74],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP14006","armor":"WP1001205","helmet":"WP1024305"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10672","city":"CS1058","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[68,71,51,44,66,74],"title":-1,"rank":"9","loyalty":"99","reputation":"0","equipment":{"weapon":"WP14006","armor":"WP1001205","helmet":"WP1024305"},"couple":[]}],"storyEvents":[],"biography":{"zh":"丹杨山越首领，后被曹操任命为蕲春太守。费栈原是丹杨地区的山越势力首领 。当时曹操正与孙权争雄，便授予费栈印绶，任命他为蕲春太守，鼓动他在孙权的腹地煽动山越部落起事，作为内应 。这对孙权的统治构成了威胁。孙权派遣陆逊前去讨伐费栈 。当时费栈党羽众多，而陆逊带领的兵力不足 。陆逊便设下疑兵之计，趁夜突袭，击溃了费栈的队伍 。击败费栈后，陆逊整顿了东三郡，将费栈部众中的精壮招募为兵，体弱者则编入民户，共收得精兵数万 ，不仅消除了隐患，还增强了孙吴的实力。","tc":"丹楊山越首領，后被曹操任命為蘄春太守。費棧原是丹楊地區的山越勢力首領 。當時曹操正與孫權爭雄，便授予費棧印綬，任命他為蘄春太守，鼓動他在孫權的腹地煽動山越部落起事，作為內應 。這對孫權的統治構成了威脅。孫權派遣陸遜前去討伐費棧 。當時費棧黨羽眾多，而陸遜帶領的兵力不足 。陸遜便設下疑兵之計，趁夜突襲，擊潰了費棧的隊伍 。擊敗費棧后，陸遜整頓了東三郡，將費棧部眾中的精壯招募為兵，體弱者則編入民戶，共收得精兵數萬 ，不僅消除了隱患，還增強了孫吳的實力。","en":"A Shanyue tribal leader in Danyang who was later appointed Governor of Qichun by Cao Cao. Fei Zhan was originally a chieftain of the Shanyue forces in the Danyang region. At the time, Cao Cao was contending with Sun Quan for supremacy and granted Fei Zhan an official seal, appointing him Governor of Qichun and encouraging him to incite the Shanyue tribes within Sun Quan's heartland to revolt and aid from within. This posed a serious threat to Sun Quan's rule. Sun Quan dispatched Lu Xun to subjugate Fei Zhan. Although Fei Zhan had numerous followers, Lu Xun's troops were insufficient. Lu Xun employed a stratagem with decoy troops and launched a nighttime surprise attack, routing Fei Zhan's forces. After defeating Fei Zhan, Lu Xun reorganized the three eastern commanderies, enlisting the able-bodied among Fei Zhan's followers as soldiers and registering the rest as civilian households. He recruited tens of thousands of elite troops in total, not only eliminating the hidden threat but also significantly bolstering Eastern Wu's strength.","jp":"丹陽の山越の首領。後に曹操より蘄春太守に任命された。費桟はもともと丹陽地方における山越勢力の首領であった。当時、曹操は孫権と覇を競っており、費桟に印綬を授けて蘄春太守に任じ、孫権の背後で山越の部族を扇動して蜂起させ、内応とするよう促した。これは孫権の統治にとって大きな脅威となった。孫権は陸遜を派遣して費桟の討伐に向かわせた。当時、費桟の党羽は多く、陸遜の率いる兵力は不足していた。そこで陸遜は疑兵の計を巡らせ、夜陰に乗じて急襲し、費桟の軍勢を壊滅させた。費桟を撃破した後、陸遜は東三郡を整え、費桟の部衆のうち屈強な者を兵として募り、弱者を民戸に編入して、合わせて数万の精兵を得た。こうして憂患を取り除いたのみならず、孫呉の勢力を大いに増強させた。","kr":"단양 산월의 수령으로, 훗날 조조에게 기춘태수로 임명되었다. 비잔은 본래 단양 지역 산월 세력의 수령이었다. 당시 조조는 손권과 패권을 다투며 비잔에게 인수를 내리고 기춘태수로 삼아, 손권의 배후에서 산월 부족을 선동해 거병하고 내응하도록 부추겼다. 이는 손권의 통치에 큰 위협이 되었다. 손권은 육손을 파견하여 비잔을 토벌하게 했다. 당시 비잔의 당여는 많았으나 육손이 이끄는 병력은 부족했다. 이에 육손은 의병지계를 펼치고 야습을 감행하여 비잔의 군대를 격파했다. 비잔을 꺾은 육손은 동삼군을 정돈하고, 비잔의 무리 중 건장한 자는 병사로 징모하고 허약한 자는 민호에 편입하여 정예병 수만 명을 거두었으니, 우환을 없앴을 뿐만 아니라 손오의 전력 또한 증강시켰다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10616","remark":"","surname":"费","surnameTc":"費","surnameEn":"Fei","surnameJp":"費","surnameKr":"비","surnameOther":"","name":"栈","nameTc":"棧","nameEn":"Zhan","nameJp":"桟","nameKr":"잔","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"费栈","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"0","workYear":"200","city":"CS1053","gender":"0","rule":"68","force":