S10115","name":{"zh":"征讨南蛮","en":"Southern Campaign"},"year":"225","month":"3"},"faction":null,"city":"CS1073","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[65,71,46,51,70,74],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1004702","armor":"WP1006105","helmet":"WP1020105"},"couple":[]},{"story":{"id":"S10915","name":{"zh":"北伐中原","en":"Northern Expedition"},"year":"227","month":"3"},"faction":null,"city":"CS1073","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[65,71,46,51,70,74],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1004702","armor":"WP1006105","helmet":"WP1020105"},"couple":[]},{"story":{"id":"S11015","name":{"zh":"再出岐山","en":"Return to Qishan"},"year":"231","month":"1"},"faction":null,"city":"CS1073","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[65,71,46,51,70,74],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1004702","armor":"WP1006105","helmet":"WP1020105"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":null,"city":"CS1073","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[65,71,46,51,70,74],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1004702","armor":"WP1006105","helmet":"WP1020105"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ10128","city":"CS1073","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[65,71,46,51,70,74],"title":-1,"rank":"9","loyalty":"99","reputation":"0","equipment":{"weapon":"WP1004702","armor":"WP1006105","helmet":"WP1020105"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1073","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[65,71,46,51,70,74],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1004702","armor":"WP1006105","helmet":"WP1020105"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10132","city":"CS1073","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[65,71,46,51,70,74],"title":-1,"rank":"9","loyalty":"99","reputation":"0","equipment":{"weapon":"WP1004702","armor":"WP1006105","helmet":"WP1020105"},"couple":[]}],"storyEvents":[],"biography":{"zh":"初为蜀国武将，后降魏。姜维北伐时，奉命与李歆麹山筑城屯守。郭淮袭来后因不敌魏军而陷入苦战，李歆便杀出重围求援，句安死守不久后便被断水源，不得不降魏。后随钟会参加灭蜀之战，参与追击姜维，因有功劳而受封列侯。在钟会之乱中死于乱军之中。","tc":"初為蜀國武將，后降魏。姜維北伐時，奉命與李歆麹山筑城屯守。郭淮襲來后因不敵魏軍而陷入苦戰，李歆便殺出重圍求援，句安死守不久后便被斷水源，不得不降魏。后隨鐘會參加滅蜀之戰，參與追擊姜維，因有功勞而受封列侯。在鐘會之亂中死于亂軍之中。","en":"Originally an officer of Shu who later surrendered to Wei. During Jiang Wei's northern campaigns, he was ordered to build fortifications and garrison troops at Qushan alongside Li Xin. When Guo Huai launched a surprise attack, Ju An was outmatched and found himself in a desperate fight. Li Xin broke through the encirclement to seek reinforcements, but Ju An's garrison was soon cut off from its water supply, leaving him no choice but to surrender to Wei. He later joined Zhong Hui's campaign to conquer Shu, participating in the pursuit of Jiang Wei, and was enfeoffed as a marquis for his contributions. He died in the chaotic fighting during Zhong Hui's rebellion.","jp":"初めは蜀国の武将であったが、後に魏に降った。姜維の北伐の際、命を受けて李歆と共に麹山に城を築いて屯守した。郭淮が来襲すると魏軍に敵わず苦戦に陥り、李歆は重囲を突破して救援を求めに向かったが、句安は死守したものの程なくして水を断たれ、魏に降伏せざるを得なくなった。後に鍾会に従って蜀滅亡の戦いに従軍し、姜維の追撃に加わって功績を挙げ、列侯に封じられた。鍾会の乱において乱軍の中で命を落とした。","kr":"처음에는 촉의 무장이었으나 훗날 위에 항복했다. 강유가 북벌할 때 명을 받아 이흠과 함께 국산에 성을 쌓고 주둔했다. 곽회가 습격해 오자 위군을 당해내지 못하고 고전에 빠졌으며, 이흠이 포위를 뚫고 나가 구원을 청했으나 구안은 결사 항전하다 얼마 못 가 수원이 끊기자 어쩔 수 없이 위에 항복했다. 이후 종회를 따라 촉 멸망전에 참전하여 강유를 추격하는 공을 세워 열후에 봉해졌다. 종회의 난 때 난군 속에서 목숨을 잃었다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10515","remark":