1003005","helmet":"WP1019805"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":null,"city":"CS1021","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[22,38,58,55,65,80],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP10018","armor":"WP1003005","helmet":"WP1019805"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1021","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[22,38,58,55,65,80],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP10018","armor":"WP1003005","helmet":"WP1019805"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1021","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[22,38,58,55,65,80],"title":-1,"rank":"4","loyalty":"100","reputation":"4850","equipment":{"weapon":"WP10018","armor":"WP1003005","helmet":"WP1019805"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10957","city":"CS1030","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[22,38,58,55,65,80],"title":-1,"rank":"4","loyalty":"100","reputation":"4850","equipment":{"weapon":"WP10018","armor":"WP1003005","helmet":"WP1019805"},"couple":[]}],"storyEvents":[],"biography":{"zh":"臧霸之父，东汉县狱掾。泰山郡华县人，任职县狱掾（县级司法小吏）。太守出于私意欲擅自处决囚犯，臧戒严守律法，拒不遵从太守私命。太守震怒，下令逮捕臧戒押送郡府治罪。时臧霸年仅十八，率宾客数十人于山道劫囚，押送百余人畏惧不敢阻拦；父子一同亡命东海郡，臧霸由此勇名传遍青徐。","tc":"臧霸之父，東漢縣獄掾。泰山郡華縣人，任職縣獄掾（縣級司法小吏）。太守出于私意欲擅自處決囚犯，臧戒嚴守律法，拒不遵從太守私命。太守震怒，下令逮捕臧戒押送郡府治罪。時臧霸年僅十八，率賓客數十人于山道劫囚，押送百余人畏懼不敢阻攔；父子一同亡命東海郡，臧霸由此勇名傳遍青徐。","en":"Father of Zang Ba and a county prison officer during the Eastern Han dynasty. A native of Hua County in Taishan Commandery, he served as a county prison officer (a petty judicial official). When the Governor sought to unlawfully execute a prisoner for personal reasons, Zang Jie strictly upheld the law and refused to obey the Governor's private order. Enraged, the Governor ordered Zang Jie arrested and escorted to the commandery seat for trial. At the time, Zang Ba was only eighteen years old, he led several dozen retainers to intercept the escort on a mountain road. Over a hundred escorts were terrified and dared not intervene. Father and son fled together to Donghai Commandery, and Zang Ba's reputation for bravery spread across Qingzhou and Xuzhou.","jp":"臧覇の父。後漢の県獄掾（県の司法を司る小役人）。泰山郡華県の人。太守が私情により囚人を独断で処刑しようとした際、臧戒は法を厳守してその私命に従わなかった。激怒した太守は臧戒を逮捕し、罪に問うため郡府へ護送させた。当時わずか十八歳であった臧覇が食客数十人を率いて山道で父を奪還すると、百余名の護送兵らは恐れて手出しができなかった。父子はともに東海郡へと亡命し、これにより臧覇の勇名は青州・徐州に広く知れ渡ることとなった。","kr":"장패의 아버지이자 동한의 현 옥연이다. 태산군 화현 사람으로, 현 옥연(현급 사법 하급 관리)을 지냈다. 태수가 사사로운 뜻으로 죄수를 멋대로 처형하려 하자, 장계는 율법을 엄격히 수호하며 태수의 사사로운 명을 따르지 않았다. 이에 태수가 격노하여 장계를 체포하고 군부로 압송해 죄를 다스리도록 명했다. 당시 장패는 나이 겨우 열여덟이었으나, 빈객 수십 명을 이끌고 산길에서 아버지를 구출하였으며 압송하던 백여 명은 두려움에 감히 가로막지 못했다. 부자가 함께 동해군으로 망명하니, 장패는 이 일로 청주와 서주 전역에 용명을 떨쳤다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ1033515","remark":"拽武","surname":"臧","surnameTc":"臧","surnameEn":"Zang","surnameJp":"臧","surnameKr":"장","surnameOther":"","name":"戒","nameTc":"戒","nameEn":"Jie","nameJp":"戒","nameKr":"계","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"臧戒","power":"WJ10048","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"2","workYear":"184","city":"CS1028","gender":"0","rule":"22","force":"38","wise":"58","politics":"55","charm":"65","will":"80","ruleTalent":"3","forceTalent":"4","wiseTalent":"6","politicsTalent":"5","charmTalent":"7","willTalent":"8","weaponMaster":"27/27/54/51/32/52/12/27","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"","battleSkill":