":{"zh":"护甲","en":"Armor"}},{"id":"WP1019805","name":{"zh":"铁盔·丙","en":"Iron Helm - III"},"level":"1","description":{"zh":"战场上最常见的铁盔，从大将到伍长都有可能佩戴，偶尔会加些个人风格的装饰。","en":"The most common iron helm on the battlefield, worn by everyone from generals to squad leaders, sometimes with personal decorations added."},"defenceVal":"4","price":"2200","slot":{"zh":"头盔","en":"Helmet"}}],"family":{"children":{"label":{"zh":"子女","en":"Children"},"people":[{"id":"WJ10320","code":"100"}]}},"clans":[{"id":"GI108615","name":{"zh":"泰山臧氏","en":"The Zang clan of Taishan"},"years":["0","999"],"desc":{"zh":"出自姬姓，臧氏为泰山著姓。臧霸父臧戒为县狱掾，以孝烈闻名。徐州豪强臧霸，割据开阳，后归曹操，镇守青徐二州，拜镇东将军。","en":"Descended from the Ji clan, the Zang clan was a prominent lineage of Taishan. Zang Ba's father, Zang Jie, served as a county prison officer and was renowned for filial piety and fierce integrity. Zang Ba, a local magnate of Xu Province, held sway over Kaiyang before submitting to Cao Cao, he guarded the two provinces of Qing and Xu and was appointed General Who Guards the East."},"talent":{"military":"7","commerce":"1","politics":"5"}}],"friendGroups":[],"body":{"name":"臧戒","height":"较高","shape":"精壮"},"honorifics":[],"selfAddress":[],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"25","startPregnantAge":"0"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":null,"city":"CS1021","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[22,38,58,55,65,80],"title":-1,"rank":"9","loyalty":"0","reputation":"1750","equipment":{"weapon":"WP10018","armor":"WP1003005","helmet":"WP1019805"},"couple":[]},{"story":{"id":"S10215","name":{"zh":"汉末三杰","en":"Three Heroes of the Late Han"},"year":"185","month":"3"},"faction":null,"city":"CS1021","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[22,38,58,55,65,80],"title":-1,"rank":"9","loyalty":"100","reputation":"1750","equipment":{"weapon":"WP10018","armor":"WP10