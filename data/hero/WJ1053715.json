":4900,"battle":5300,"debate":4600},"equipment":[{"id":"WP10010","name":{"zh":"松纹厢宝剑","en":"Pine-Vein Jeweled Sword"},"level":"2","description":{"zh":"多为边境少数民族所佩，剑身嵌有如松纹般脉络的装饰，故有此名","en":"Commonly worn by frontier peoples, the blade bears pine-bark patterns, hence its name"},"atkVal":"8","hp":"400","price":"7000","slot":{"zh":"武器","en":"Weapon"}},{"id":"WP1015805","name":{"zh":"锦绣挂衣","en":"Embroidered Tunic"},"level":"1","description":{"zh":"采用了普通的面料并进行了纹饰处理的挂衣，衣服的边缘处也添加了简单的纹饰。","en":"A coat-style garment made of ordinary fabric and adorned with patterns, with simple decorative trim also added along the edges."},"defenceVal":"3","hp":"400","price":"2800","slot":{"zh":"护甲","en":"Armor"}},{"id":"WP1028705","name":{"zh":"发带","en":"Headband"},"level":"0","description":{"zh":"民间随处可见的头带，摘下来看不过是一块布料而已。","en":"A common headband seen everywhere, nothing more than a strip of cloth when removed."},"mp":"100","evade":"1","price":"200","slot":{"zh":"头盔","en":"Helmet"}}],"family":{"father":{"label":{"zh":"父亲","en":"Father"},"people":[{"id":"WJ1053015","code":"0"}]},"family":{"label":{"zh":"亲属","en":"Relatives"},"people":[{"id":"WJ1010202","code":"100"},{"id":"WJ1054415","code":"100"},{"id":"WJ1010002","code":"100"}]}},"clans":[{"id":"GI110115","name":{"zh":"玄菟高氏","en":"The Gao clan of Xuantu"},"years":["0","999"],"desc":{"zh":"出自扶余，始祖高朱蒙本为扶余王子，南奔建国，因以高为氏。东北亚强国，与汉朝、公孙氏、曹魏长期互动。毌丘俭曾大破之。历六百余年，传二十八王。","en":"Originating from Buyeo, the founding ancestor Go Jumong was originally a prince of Buyeo who fled South to establish his kingdom, adopting Gao as his clan name. A formidable power in Northeast Asia, it engaged in long-term interactions with the Han dynasty, the Gongsun clan, and Cao Wei. Guanqiu Jian once dealt it a crushing defeat. It endured for over 600 years across 28 kings."},"talent":{"military":"8","commerce":"3","politics":"7"}}],"friendGroups":[],"body":{"name":"高罽须","height":"平均","shape":"精壮"},"honorifics":[],"selfAddress":[],"specialNames":[],"vip":{"isVIP":1,"from":"180