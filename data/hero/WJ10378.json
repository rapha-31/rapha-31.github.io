:"231","month":"1"},"faction":"WJ10128","city":"CS1073","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[31,7,78,78,80,85],"title":-1,"rank":"9","loyalty":"99","reputation":"13950","equipment":{"weapon":"WP1007102","armor":"WP1018405","helmet":"WP1024205"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":"WJ10128","city":"CS1073","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[31,7,78,78,80,85],"title":-1,"rank":"9","loyalty":"99","reputation":"13950","equipment":{"weapon":"WP1007102","armor":"WP1018405","helmet":"WP1024205"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ10128","city":"CS1005","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[31,7,78,78,80,85],"title":-1,"rank":"9","loyalty":"99","reputation":"13950","equipment":{"weapon":"WP1007102","armor":"WP1018405","helmet":"WP1024205"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1039","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[31,7,78,78,80,85],"title":-1,"rank":"9","loyalty":"0","reputation":"3900","equipment":{"weapon":"WP1007102","armor":"WP1018405","helmet":"WP1024205"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10011","city":"CS1005","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[31,7,78,78,80,85],"title":-1,"rank":"9","loyalty":"100","reputation":"3900","equipment":{"weapon":"WP1007102","armor":"WP1018405","helmet":"WP1024205"},"couple":[]}],"storyEvents":[],"biography":{"zh":"蜀汉名臣、学者。早年州郡多次征召，皆称病不往，隐居治学，名声在外。起初为刘璋的幕僚，刘备入川后改仕刘备，擅于辩论。荆州被袭后刘备伐吴，秦宓劝阻引发刘备大怒，被下狱，后被释放。诸葛亮主政后，派邓芝出使东吴重修旧好。秦宓在诸葛亮设立的宴会上，与吴使张温展开一场载入史册的精彩辩论，大展蜀汉文采风流。著有《周易摘》《尚书驳》《论语弼》等，其言论被谯周收录于《春秋然否论》，奠定蜀汉经学基础。","tc":"蜀漢名臣、學者。早年州郡多次征召，皆稱病不往，隱居治學，名聲在外。起初為劉璋的幕僚，劉備入川后改仕劉備，擅于辯論。荊州被襲后劉備伐吳，秦宓勸阻引發劉備大怒，被下獄，后被釋放。諸葛亮主政后，派鄧芝出使東吳重修舊好。秦宓在諸葛亮設立的宴會上，與吳使張溫展開一場載入史冊的精彩辯論，大展蜀漢文采風流。著有《周易摘》《尚書駁》《論語弼》等，其言論被譙周收錄于《春秋然否論》，奠定蜀漢經學基礎。","en":"Renowned minister and scholar of Shu-Han. In his early years, he was repeatedly summoned by provincial and commandery authorities but declined all offers, citing illness to remain in seclusion and pursue scholarship, building a considerable reputation. He initially served Liu Zhang, then switched allegiance to Liu Bei after Liu Bei entered Shu. He was known for his sharp debating skills. When Liu Bei launched his expedition against Wu after the loss of Jing Province, Qin Mi counseled against it, provoking Liu Bei's fury and earning himself imprisonment, though he was later released. After Zhuge Liang assumed governance, he dispatched Deng Zhi to Wu to restore the alliance. At a banquet arranged by Zhuge Liang, Qin Mi engaged the Wu envoy Zhang Wen in a legendary battle of wits that showcased the literary brilliance of Shu-Han. He authored works such as ‘Extracts from the Book of Changes’, ‘Refutations of the Book of Documents’, and ‘Aids to the Analects’. His arguments were collected by Qiao Zhou in the ‘Treatise on the Veracity of the Spring and Autumn Annals’, laying the foundation for classical scholarship in Shu-Han.","jp":"蜀漢の名臣にして学者。若くして州郡から度々招かれたが、いずれも病と称して応じず、隠棲して学問を修め、その名声は外にまで聞こえていた。当初は劉璋の幕僚を務め、劉備が入蜀した後は劉備に仕えた。弁舌に長けていた。荊州が奪われた後、劉備が呉を討とうとした際、秦宓がこれを諫止したことで劉備の逆鱗に触れて投獄されたが、後に釈放された。諸葛亮が政を執ると、鄧芝を使者として東呉へ派遣し旧好を重修させた。秦宓は諸葛亮が催した宴会にて、呉の使者・張温と歴史に残る見事な論戦を繰り広げ、蜀漢の文采風流を大いに示した。『周易摘』『尚書駁』『論語弼』などの著作を残し、その言論は譙周の『春秋然否論』に収録され、蜀漢における経学の基礎を築いた。","kr":"촉한의 명신이자 학자. 젊은 시절 주와 군에서 여러 차례 불렀으나 모두 병을 핑계로 나아가지 않고, 은거하며 학문에 힘써 널리 명성을 떨쳤다. 처음에는 유장의 막료로 있었으나 유비가 입촉한 뒤 유비를 섬겼으며, 변론에 능했다. 형주를 기습당한 뒤 유비가 오나라를 정벌하려 하자, 진복이 이를 만류하다가 유비의 노여움을 사 옥에 갇혔으나 이후 풀려났다. 제갈량이 정권을 잡은 뒤, 등지를 동오에 사신으로 파견하여 다시 우호를 다졌다. 진복은 제갈량이 베푼 연회에서 오나라 사신 장온과 역사에 길이 남을 빼어난 논쟁을 펼쳐 촉한의 문채와 풍류를 드높였다. 저서로 《주역적》, 《상서박》, 《논어필》 등이 있으며, 그의 언론은 초주에 의해 《춘추연불론》에 수록되어 촉한 경학의 기틀을 다졌다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10378","remark":"","surname":"秦","surnameTc":"秦","surnameEn":"Qin","surnameJp":"秦","surnameKr":"진","surnameOther":"","name":"宓","nameTc":"宓","nameEn":"Mi","nameJp":"宓","nameKr":"복","nameOther":"","word":"子敕","wordTc":"子敕","wordEn":"Zichi","wordJp":"子勅","wordKr":"자칙","wordOther":"","icon":"秦宓","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"0","workYear":"192","city":"CS1039","gender":"0","rule":"31","force":"7","wise":"78","politics":"78","charm":"80","will":"85","ruleTalent":"2","forceTalent":"1","wiseTalent":"8","politicsTalent":"10","charmTalent":"8","willTalent":"7","weaponMaster":"2/2/2/2/2/77/36/2","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"","battleSkill":"","debateCard":"1002102;1005805","warSoul":"","battleSoul":"","debateSoul":"1002105","warSoulPoint":"900","battleSoulPoint":"0","debateSoulPoint":"6000","strategy":"1004008","strategy2":"1001605;1005601","professions":"0/0/0/0/0/0/2/2/3/2/3/0/0/1/0/3/3/6/0/4/0/2/1/1","attribute2":"50/50/50/50/50/50","morality":"6","compatible":"44","loyalty":"0","reputation":"3900","evaluate":"0","title":"","rank":"9","birth":"173","show":"192","death":"226","age":"0","injury":"","deathReason":"0","type":"0","npcTag":"0","npcNum":"1","microScene":"0","isImportant":"0","speaking":"0","weapon":"WP1007102","armor":"WP1018405","helmet":"WP1024205","treasure":"","horse":"","shield":"","character":"2/1;11/1;39/1;9/1;12/1;15/1;8/1;27/1;29/1;42/1;31/0;41/0","father":"","mother":"","children":"","family":"","modInfo":"","brother":"","couple":"","otherRelationship":"","belief":"0","isVIP":"0","startVIPYear":"0","endVIPYear":"0","description":"蜀汉名臣、学者。早年州郡多次征召，皆称病不往，隐居治学，名声在外。起初为刘璋的幕僚，刘备入川后改仕刘备，擅于辩论。荆州被袭后刘备伐吴，秦宓劝阻引发刘备大怒，被下狱，后被释放。诸葛亮主政后，派邓芝出使东吴重修旧好。秦宓在诸葛亮设立的宴会上，与吴使张温展开一场载入