:"1"},"faction":"WJ10127","city":"CS1028","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[69,44,83,78,85,72],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1008702","armor":"WP1015102","helmet":"WP1012302"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":"WJ10127","city":"CS1028","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[69,44,83,78,85,72],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1008702","armor":"WP1015102","helmet":"WP1012302"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ1000115","city":"CS1028","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[69,44,83,78,85,72],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1008702","armor":"WP1015102","helmet":"WP1012302"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1028","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[69,44,83,78,85,72],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1008702","armor":"WP1015102","helmet":"WP1012302"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10005","city":"CS1028","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[69,44,83,78,85,72],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1008702","armor":"WP1015102","helmet":"WP1012302"},"couple":[]}],"storyEvents":[],"biography":{"zh":"魏国重臣司马懿之女，与妻子张春华在许都所生。司马霜作为司马懿与张春华唯一的女儿，从小便饱受母亲的庇护，公主不仅善读典籍，也因张春华的教导，习得了优异的剑法。在司马氏控制魏国大权后，为稳定朝内氛围，便将公主嫁予了荀彧之孙荀霬，并为其生下三子，三子皆对魏晋做出了不可忽视的贡献。","tc":"魏國重臣司馬懿之女，與妻子張春華在許都所生。司馬霜作為司馬懿與張春華唯一的女兒，從小便飽受母親的庇護，公主不僅善讀典籍，也因張春華的教導，習得了優異的劍法。在司馬氏控制魏國大權后，為穩定朝內氛圍，便將公主嫁予了荀彧之孫荀霬，并為其生下三子，三子皆對魏晉做出了不可忽視的貢獻。","en":"The daughter of Sima Yi, the great minister of Wei, born to him and his wife Zhang Chunhua in Xuchang. As the only daughter of Sima Yi and Zhang Chunhua, she was doted upon by her mother from childhood. The princess was not only an avid reader of classical texts but also, under Zhang Chunhua's tutelage, became proficient in swordsmanship. After the Sima clan seized control of Wei's government, she was married to Xun Yi, a grandson of Xun Yu, to help stabilize the political atmosphere at court. She bore three sons, all of whom made notable contributions to the Wei-Jin transition.","jp":"魏の重臣・司馬懿が妻の張春華との間に許都で儲けた娘。司馬霜は司馬懿と張春華の一人娘として、幼少期より母の庇護を一身に受けて育った。公主は典籍に通じていただけでなく、張春華の薫陶を受けて優れた剣法を修めていた。司馬氏が魏の実権を掌握すると、朝廷内の融和を図るため荀彧の孫である荀霬に嫁ぎ、三男をもうけた。その三子はみな、魏と晋において多大な貢献を果たした。","kr":"위나라의 중신 사마의가 부인 장춘화와의 사이에서 허도에서 얻은 딸이다. 사마상은 사마의와 장춘화의 유일한 딸로서 어려서부터 어머니의 극진한 비호를 받으며 자랐다. 공주는 전적을 두루 섭렵했을 뿐만 아니라, 장춘화의 가르침을 받아 뛰어난 검술까지 익혔다. 사마씨 일족이 위나라의 대권을 장악한 후 조정 내부를 안정시키고자 공주를 순욱의 손자인 순익에게 출가시켰다. 공주는 슬하에 세 아들을 두었으며, 세 아들 모두 위진 양대에 걸쳐 결코 간과할 수 없는 큰 공헌을 세웠다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10979","remark":"","surname":"司马","surnameTc":"司馬","surnameEn":"Sima","surnameJp":"司馬","surnameKr":"사마","surnameOther":"","name":"霜","nameTc":"霜","nameEn":"Shuang","nameJp":"霜","nameKr":"상","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"司马霜","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"0","workYear":"221","city":"CS1028","gender":"1","rule":"69","force":"44","wise":"83","politics":"78","charm":"85","will":"72","ruleTalent":"9","forceTalent":"6","wiseTalent":"10","politicsTalent":"10","charmTalent":"11","willTalent":"9","weaponMaster":"93/36/36/36/36/27/94/36","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"","battl