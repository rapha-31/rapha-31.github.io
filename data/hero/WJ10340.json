,42,31,68,68],"title":-1,"rank":"9","loyalty":"94","reputation":"6500","equipment":{"weapon":"WP1006702","armor":"WP1005605","helmet":"WP1019105","horse":"WP1001515"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1075","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[71,73,42,31,68,68],"title":-1,"rank":"9","loyalty":"110","reputation":"2600","equipment":{"weapon":"WP1006702","armor":"WP1005605","helmet":"WP1019105","horse":"WP1001515"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10172","city":"CS1075","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[71,73,42,31,68,68],"title":-1,"rank":"9","loyalty":"120","reputation":"2600","equipment":{"weapon":"WP1006702","armor":"WP1005605","helmet":"WP1019105","horse":"WP1001515"},"couple":[]}],"storyEvents":[],"biography":{"zh":"呼厨泉是南匈奴羌渠单于之子，于夫罗的弟弟。兴平二年，于夫罗单于去世后，呼厨泉成为单于。建安七年，呼厨泉统领南匈奴诸部在平阳作乱，钟繇率诸军围攻。河北袁氏将领高干、郭援等前来增援，与钟繇及关中诸将大战于平阳。最终呼厨泉惨败，归降曹操。建安二十一年，呼厨泉被留在了邺城，南匈奴遂被分为五部。","tc":"呼廚泉是南匈奴羌渠單于之子，于夫羅的弟弟。興平二年，于夫羅單于去世后，呼廚泉成為單于。建安七年，呼廚泉統領南匈奴諸部在平陽作亂，鐘繇率諸軍圍攻。河北袁氏將領高干、郭援等前來增援，與鐘繇及關中諸將大戰于平陽。最終呼廚泉慘敗，歸降曹操。建安二十一年，呼廚泉被留在了鄴城，南匈奴遂被分為五部。","en":"Huchuquan was the son of Qiangqu Chanyu of the Southern Xiongnu and younger brother of Yufuluo. In the second year of Xingping, after Chanyu Yufuluo died, Huchuquan became Chanyu. In the seventh year of Jian'an, Huchuquan led the Southern Xiongnu tribes in a revolt at Pingyang. Zhong Yao rallied the armies to besiege him. Yuan forces led by Gao Gan and Guo Yuan reinforced the rebels, clashing with Zhong Yao and the Guanzhong generals at Pingyang. Huchuquan suffered a devastating defeat and surrendered to Cao Cao. In the twenty-first year of Jian'an, Huchuquan was detained at the capital Ye, and the Southern Xiongnu were divided into five administrative districts.","jp":"呼厨泉は南匈奴の羌渠単于の子で、于夫羅の弟。興平2年、于夫羅単于が死去すると、呼厨泉が単于の座を継いだ。建安7年、呼厨泉は南匈奴の諸部族を率いて平陽で反乱を起こしたが、鍾繇率いる諸軍に包囲された。河北の袁氏の将である高幹や郭援らが増援として駆けつけ、平陽にて鍾繇および関中の諸将と激戦を繰り広げたものの、最終的に呼厨泉は惨敗して曹操に降伏した。建安21年、呼厨泉は鄴に留め置かれ、南匈奴は五部に分割された。","kr":"호주천은 남흉노 강거 선우의 아들이자 어부라의 동생이다. 흥평 2년, 어부라 선우가 세상을 떠난 뒤 호주천이 선우가 되었다. 건안 7년, 호주천이 남흉노의 여러 부족을 이끌고 평양에서 난을 일으키자 종요가 여러 군대를 이끌고 포위 공격하였다. 하북 원씨의 장수 고간과 곽원 등이 구원하러 와 종요 및 관중의 여러 장수와 평양에서 대전을 벌였다. 결국 호주천은 참패하여 조조에게 귀순하였다. 건안 21년, 호주천은 업성에 머물게 되었고, 남흉노는 마침내 5부로 나뉘었다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10340","remark":"","surname":"","surnameTc":"","surnameEn":"","surnameJp":"","surnameKr":"","surnameOther":"","name":"呼厨泉","nameTc":"呼廚泉","nameEn":"Huchuquan","nameJp":"呼厨泉","nameKr":"호주천","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"呼厨泉","power":"WJ10172","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"2","workYear":"188","city":"CS1075","gender":"0","rule":"71","force":"73","wise":"42","politics":"31","charm":"68","will":"68","ruleTalent":"8","forceTalent":"8","wiseTalent":"3","politicsTalent":"2","charmTalent":"7","willTalent":"7","weaponMaster":"21/21/21/21/69/10/50/21","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"","battleSkill":"","debateCard":"","warSoul":"","battleSoul":"1019905","debateSoul":"","warSoulPoint":"4900","battleSoulPoint":"5000","debateSoulPoint":"1600","strategy":"1015615","strategy2":"1005001","professions":"2/0/4/2/0/0/2/0/0/0/2/3/1/0/1/2/2/0/0/1/0/3/3/0","attribute2":"50/50/50/50/50/50","morality":"3","compatible":"18","loyalty":"110","reputation":"2600","evaluate":"-7000","title":"","rank":"9","birth":"169","show":"184","death":"230","age":"0","injury":"","deathReason":"0","type":"1","npcTag":"0","npcNum":"1","microScene":"0","isImportant":"0","speaking":"5","weapon":"WP1006702","armor":"WP1005605","helmet":"WP1019105","trea