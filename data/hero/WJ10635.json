23105"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":"WJ10127","city":"CS1046","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[56,62,54,61,36,23],"title":-1,"rank":"9","loyalty":"98","reputation":"1950","equipment":{"weapon":"WP10014","armor":"WP1006505","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ1000115","city":"CS1046","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[56,62,54,61,36,23],"title":-1,"rank":"5","loyalty":"98","reputation":"1950","equipment":{"weapon":"WP10014","armor":"WP1006505","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1046","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[56,62,54,61,36,23],"title":-1,"rank":"9","loyalty":"100","reputation":"1450","equipment":{"weapon":"WP10014","armor":"WP1006505","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10186","city":"CS1046","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[56,62,54,61,36,23],"title":-1,"rank":"9","loyalty":"90","reputation":"1450","equipment":{"weapon":"WP10014","armor":"WP1006505","helmet":"WP1023105"},"couple":[]}],"storyEvents":[],"biography":{"zh":"地方豪强,魏国武将。出身西平、上庸大族，凭借家族威望聚众数千家，与汉中张鲁结盟以维持自治。曹操平定汉中后，申耽敏锐察觉局势变化，主动遣使归附，获封上庸太守、员乡侯，成为曹魏在东三郡（上庸、房陵、西城）的代理人。汉中之战时随军出征，与弟弟申仪被迫降于蜀国。襄樊之战期间因孟达没有救援曹操而与申仪劝其降魏，后官至上庸太守。孟达复叛、回归蜀国之际泄露给司马懿，导致孟达被害。","tc":"地方豪強,魏國武將。出身西平、上庸大族，憑借家族威望聚眾數千家，與漢中張魯結盟以維持自治。曹操平定漢中后，申耽敏銳察覺局勢變化，主動遣使歸附，獲封上庸太守、員鄉侯，成為曹魏在東三郡（上庸、房陵、西城）的代理人。漢中之戰時隨軍出征，與弟弟申儀被迫降于蜀國。襄樊之戰期間因孟達沒有救援曹操而與申儀勸其降魏，后官至上庸太守。孟達復叛、回歸蜀國之際泄露給司馬懿，導致孟達被害。","en":"A local strongman and officer of Wei. Hailing from a prominent clan in Xiping and Shangyong, he gathered thousands of households through his family's prestige and allied with Zhang Lu of Hanzhong to maintain local autonomy. After Cao Cao pacified Hanzhong, Shen Dan astutely recognized the shifting situation and proactively sent an envoy to pledge allegiance, receiving appointments as Governor of Shangyong and Marquis of Yuanxiang, becoming Cao Wei's proxy over the Three Eastern Commanderies (Shangyong, Fangling, and Xicheng). During the Battle of Hanzhong, he marched with the army and was forced to surrender to Shu along with his younger brother Shen Yi. During the Battle of Xiangfan, because Meng Da failed to send reinforcements to Cao Cao, Shen Dan and Shen Yi persuaded Meng Da to defect to Wei, after which he was appointed Governor of Shangyong. When Meng Da later plotted to rebel and return to Shu, Shen Dan leaked the plan to Sima Yi, leading to Meng Da's death.","jp":"地方の豪強、魏の武将。西平・上庸の大族出身で、家族の威望を頼みに数千家を集め、漢中の張魯と同盟を結んで自治を維持した。曹操が漢中を平定すると、申耽は鋭く情勢の変化を察知して自ら使者を送って帰順し、上庸太守、員郷侯に封じられて曹魏の東三郡（上庸・房陵・西城）における代理人となった。漢中の戦いでは軍に従って出陣したが、弟の申儀とともにやむなく蜀に降伏した。襄樊の戦いの最中、孟達が曹操を救援しなかったことから申儀とともに魏への降伏を勧め、後に官位は上庸太守に至った。孟達が再び寝返って蜀へ復帰しようとした際には司馬懿に密告し、孟達が害される原因を作った。","kr":"지방 호족이자 위나라의 무장. 서평과 상용의 유력 가문 출신으로, 가문의 명망을 바탕으로 수천 가구를 규합하고 한중의 장로와 동맹을 맺어 자치를 유지했다. 조조가 한중을 평정하자 정세의 변화를 기민하게 알아채고 먼저 사절을 보내 귀부했으며, 상용태수와 원향후에 봉해져 조위가 동삼군(상용, 방릉, 서성)을 다스리는 대리인이 되었다. 한중 전투 당시 군을 따라 출진했으나 아우 신의와 함께 어쩔 수 없이 촉나라에 항복했다. 양번 전투 때 맹달이 조조를 구원하지 않자 신의와 함께 맹달에게 위나라에 항복할 것을 권유했고, 이후 관직이 상용태수에 이르렀다. 맹달이 다시 배반하고 촉나라로 복귀하려 하자 이를 사마의에게 누설하여 맹달을 죽음에 이르게 했다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10635","remark":"","surname":"申","surnameTc":"申","surnameEn":"Shen","surnameJp":"申","surnameKr":"신","surnameOther":"","name":"耽","nameTc":"耽","nameEn":"Dan","nameJp":"耽","nameKr":"탐","nameOther":"","word":"义举","wordTc":"義舉","wordEn":"Yiju","wordJp":"義挙","wordKr":"의거","wordOther":"","icon":"申耽","power":"WJ10635","rejectPower":"","rejectDuration":"0","ignoreUn