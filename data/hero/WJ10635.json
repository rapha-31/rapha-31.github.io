,"name":{"zh":"铁胄·甲","en":"Iron Helm - I"},"level":"0","description":{"zh":"最简易的头盔，在士兵与伍长之间最为常见。","en":"The simplest helmet, most common among soldiers and squad leaders."},"defenceVal":"2","price":"800","slot":{"zh":"头盔","en":"Helmet"}}],"family":{"family":{"label":{"zh":"亲属","en":"Relatives"},"people":[{"id":"WJ10414","code":"100"}]}},"clans":[{"id":"GI114315","name":{"zh":"上庸申氏","en":"The Shen Clan of Shangyong"},"years":["190","230"],"desc":{"zh":"出自姜姓，为周宣王母舅申伯之后，以国为氏。上庸申氏世居西平、上庸一带，是汉末汉中地区拥有数千家部曲的地方豪族，初附张鲁，后归曹操。","en":"Originating from the Jiang surname, they descended from the Earl of Shen, maternal uncle of King Xuan of Zhou, taking the name of their state as their clan name. The Shen clan of Shangyong dwelt around Xiping and Shangyong for generations. In the late Han period, they were a powerful local magnate family in the Hanzhong region commanding thousands of private retainers, first aligning with Zhang Lu and later submitting to Cao Cao."},"talent":{"military":"5","commerce":"3","politics":"4"}}],"friendGroups":[],"body":null,"honorifics":[],"selfAddress":[],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"25","startPregnantAge":"0"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":null,"city":"CS1046","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[56,62,54,61,36,23],"title":-1,"rank":"9","loyalty":"0","reputation":"1350","equipment":{"weapon":"WP10014","armor":"WP1006505","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S10215","name":{"zh":"汉末三杰","en":"Three Heroes of the Late Han"},"year":"185","month":"3"},"faction":null,"city":"CS1046","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[56,62,54,61,36,23],"title":-1,"rank":"9","loyalty":"0","reputation":"1350","equipment":{"weapon":"WP10014","armor":"WP1006505","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S10615","name":{"zh":"十常侍之乱","en":"Turmoil of the Ten