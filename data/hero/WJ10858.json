"340","price":"1200","slot":{"zh":"护甲","en":"Armor"}},{"id":"WP1027105","name":{"zh":"巧士冠·乙","en":"Artisan Crown - II"},"level":"2","description":{"zh":"更为精致的小冠，多为朝中职务多面之人佩戴。","en":"A more refined small crown, worn by officials serving in multiple capacities."},"mp":"670","evade":"10","price":"6000","slot":{"zh":"头盔","en":"Helmet"}}],"family":{"father":{"label":{"zh":"父亲","en":"Father"},"people":[{"id":"WJ10855","code":"0"}]}},"clans":[{"id":"GI112615","name":{"zh":"沛国丁氏","en":"The Ding clan of Pei"},"years":["0","999"],"desc":{"zh":"出自姜姓，周武王封齐太公之子伋为丁公，后裔以丁为氏。沛国丁氏为沛国谯县顶级名门，汉末出过三公丁宫，门第远在同县的夏侯氏之上。曹嵩的夫人为丁氏，曹操本人正妻也是丁夫人，曹氏、夏侯氏、丁氏三族世代联姻，为谯沛地区的核心政治集团。","en":"Descended from the Jiang surname. When King Wu of Zhou enfeoffed Ji, son of the Grand Duke of Qi, as Duke Ding, his descendants adopted Ding as their surname. The Ding clan of Pei was a preeminent Family in Qiao County of Pei Commandery, producing the Three Excellencies minister Ding Gong during the late Han dynasty, with a clan stature far surpassing the Xiahou clan of the same county. Cao Song's wife was of the Ding clan, and Cao Cao's own principal wife was Lady Ding. The Cao, Xiahou, and Ding clans intermarried for generations, forming the core political coalition of the Qiao-Pei region."},"talent":{"military":"3","commerce":"4","politics":"6"}}],"friendGroups":[{"story":"S10515","members":["WJ10226","WJ10438","WJ10415","WJ1028715","WJ10853","WJ10828","WJ10674"]},{"story":"S11315","members":["WJ10226","WJ10438","WJ10415","WJ1028715","WJ10853","WJ10828","WJ10674"]}],"body":null,"honorifics":[],"selfAddress":[],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"25","startPregnantAge":"0"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":null,"city":"CS1028","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[33,21,68,66,51,37],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weap