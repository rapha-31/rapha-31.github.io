2","armor":"WP1016905","helmet":"WP1025305"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":"WJ10020","city":"CS1047","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[76,58,79,87,88,72],"title":-1,"rank":"8","loyalty":"100","reputation":"8700","equipment":{"weapon":"WP1007102","armor":"WP1016905","helmet":"WP1025305"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ10020","city":"CS1053","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[76,58,79,87,88,72],"title":-1,"rank":"8","loyalty":"100","reputation":"8700","equipment":{"weapon":"WP1007102","armor":"WP1016905","helmet":"WP1025305"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1056","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[76,58,79,87,88,72],"title":-1,"rank":"9","loyalty":"0","reputation":"5850","equipment":{"weapon":"WP1007102","armor":"WP1016905","helmet":"WP1025305"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10020","city":"CS1053","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[76,58,79,87,88,72],"title":-1,"rank":"9","loyalty":"99","reputation":"5850","equipment":{"weapon":"WP1007102","armor":"WP1016905","helmet":"WP1025305"},"couple":[]}],"storyEvents":[],"biography":{"zh":"东吴名臣，诤臣、谏臣。出身官宦世家，父亲骆俊曾任陈国相。年少时因战乱与母亲失散，后重逢于江东。孙权继位后仕官于东吴，赤壁前夕参与了与众臣辩论诸葛亮的会议，但被其说服。会稽大旱时，骆统据理力争，最终说服孙权减免赋税，救活无数百姓。临终前仍上书劝谏孙权勤政爱民，孙权读后流泪道：失此良臣，吴之不幸。","tc":"東吳名臣，諍臣、諫臣。出身官宦世家，父親駱俊曾任陳國相。年少時因戰亂與母親失散，后重逢于江東。孫權繼位后仕官于東吳，赤壁前夕參與了與眾臣辯論諸葛亮的會議，但被其說服。會稽大旱時，駱統據理力爭，最終說服孫權減免賦稅，救活無數百姓。臨終前仍上書勸諫孫權勤政愛民，孫權讀后流淚道：失此良臣，吳之不幸。","en":"A renowned minister of Eastern Wu, known as a forthright and outspoken advisor. Born into an official family, his father Luo Jun served as Chancellor of the State of Chen. Separated from his mother in youth due to war, he was later reunited with her in Jiangdong. After Sun Quan's accession, he served as an official of Eastern Wu. On the eve of the Battle of Red Cliffs, he participated in the debate among court ministers against Zhuge Liang but was persuaded by him. During a severe drought in Huiji, Luo Tong argued forcefully and ultimately convinced Sun Quan to reduce taxes, saving countless lives. On his deathbed, he still submitted a memorial urging Sun Quan to govern diligently and care for the people. After reading it, Sun Quan wept and said that losing such a fine minister was a misfortune for all of Wu.","jp":"東呉の名臣にして諍臣、諫臣。名門官吏の家柄に生まれ、父の駱俊は陳国の相を務めた。年少の頃に戦乱で母と生き別れたが、後に江東で再会を果たす。孫権の代に東呉へ仕官し、赤壁の戦いの前夕には群臣らとともに諸葛亮と論争を繰り広げるも説き伏せられた。会稽が大旱魃に見舞われた際には理を尽くして直言し、孫権を説得して減税を実現させ、数多くの民を救った。臨終の際にも上書して孫権に勤政愛民を諫言し、これを読んだ孫権は涙を流して「この良臣を失ったことは、呉の不幸である」と嘆いた。","kr":"동오의 명신이자 간쟁(諫諍)을 아끼지 않던 충신. 대대로 관직을 지낸 가문 출신으로, 부친 낙준은 진국상을 지냈다. 어린 시절 전란으로 어머니와 헤어졌으나 훗날 강동에서 재회했다. 손권이 즉위하자 동오에 사관하였고, 적벽대전 직전 여러 신하와 함께 제갈량과 논쟁을 벌였으나 도리어 설득당했다. 회계에 큰 가뭄이 들었을 때 낙통이 조리에 맞추어 극력 간언하여 마침내 손권을 설득해 조세를 감면케 하였고, 수많은 백성을 살려냈다. 임종 직전까지도 손권에게 정사에 힘쓰고 백성을 아낄 것을 간언하는 상소를 올렸으며, 손권은 이를 읽고 눈물을 흘리며 '이러한 양신을 잃었으니, 오나라의 불행이로다.'라고 한탄했다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10632","remark":"","surname":"骆","surnameTc":"駱","surnameEn":"Luo","surnameJp":"駱","surnameKr":"낙","surnameOther":"","name":"统","nameTc":"統","nameEn":"Tong","nameJp":"統","nameKr":"통","nameOther":"","word":"公绪","wordTc":"公緒","wordEn":"Gongxu","wordJp":"公緒","wordKr":"공서","wordOther":"","icon":"骆统","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"0","workYear":"207","city":"CS1056","gender":"0","rule":"76","force":"58","wise":"79","politics":"87","charm":"88","will":"72","ruleTalent":"9","forceTalent":"5","wiseTalen