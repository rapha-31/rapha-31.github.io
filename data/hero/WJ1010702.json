":"WP1013102"},"couple":[]},{"story":{"id":"S11015","name":{"zh":"再出岐山","en":"Return to Qishan"},"year":"231","month":"1"},"faction":"WJ1010602","city":"CS1068","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[80,79,73,32,83,69],"title":-1,"rank":"6","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1005702","armor":"WP1030605","helmet":"WP1013102"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":"WJ1010602","city":"CS1068","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[80,79,73,32,83,69],"title":-1,"rank":"6","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1005702","armor":"WP1030605","helmet":"WP1013102"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1068","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[80,79,73,32,83,69],"title":-1,"rank":"6","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1005702","armor":"WP1030605","helmet":"WP1013102"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1068","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[80,79,73,32,83,69],"title":-1,"rank":"7","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1005702","armor":"WP1030605","helmet":"WP1013102"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ1010502","city":"CS1068","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[80,79,73,32,83,69],"title":-1,"rank":"7","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1005702","armor":"WP1030605","helmet":"WP1013102"},"couple":[]}],"storyEvents":[],"biography":{"zh":"百济肖古王之次女，仇首王之妹。虽然燕臻是族中后辈地位最高的女性，但丝毫没有喜爱权力的样子，经常在辽东一带游猎探险，并把兄长仇首当作竞争对象来努力。仇首王继位后，燕臻统领着一只秘密部队，帮助兄长与新罗周旋。显露出卓越的军事才能。","tc":"百濟肖古王之次女，仇首王之妹。雖然燕臻是族中后輩地位最高的女性，但絲毫沒有喜愛權力的樣子，經常在遼東一帶游獵探險，并把兄長仇首當作競爭對象來努力。仇首王繼位后，燕臻統領著一只秘密部隊，幫助兄長與新羅周旋。顯露出卓越的軍事才能。","en":"The second daughter of King Chogo of Baekje and younger sister of King Gusu. Although Yeonjin held the highest status among the women of her generation, she showed no interest in power whatsoever, preferring instead to hunt and explore the Liaodong region, treating her brother Gusu as a rival to spur her own efforts. After King Gusu took the throne, Yeonjin commanded a secret force, helping her brother maneuver against Silla. She displayed remarkable military talent.","jp":"百済の肖古王の次女で、仇首王の妹。燕臻は一族の若輩の中で最も高い身分を持つ女性であったが、権力への執着は微塵も見せず、よく遼東一帯で狩猟や探検に興じては、兄の仇首を好敵手として鍛錬に励んでいた。仇首王が即位した後は秘密部隊を率いて兄を補佐し、新羅と渡り合って卓越した軍才を発揮した。","kr":"백제 초고왕의 차녀이자 구수왕의 누이이다. 연진은 일족의 후대 중 가장 지위가 높은 여인이었으나 권력을 탐하는 기색은 전혀 없었으며, 자주 요동 일대에서 수렵과 탐험을 즐기며 오라비인 구수를 경쟁 상대로 삼아 정진했다. 구수왕이 즉위한 후에는 비밀 부대를 통솔하여 오라비를 도와 신라와 맞서며 탁월한 군사적 재능을 드러냈다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ1010702","remark":"","surname":"","surnameTc":"","surnameEn":"","surnameJp":"","surnameKr":"","surnameOther":"","name":"燕臻","nameTc":"燕臻","nameEn":"Yan Zhen","nameJp":"燕臻","nameKr":"연진","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"燕臻","power":"WJ1010502","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"2","workYear":"188","city":"CS1068","gender":"1","rule":"80","force":"79","wise":"73","politics":"32","charm":"83","will":"69","ruleTalent":"8","forceTalent":"9","wiseTalent":"8","politicsTalent":"6","charmTalent":"10","willTalent":"7","weaponMaster":"84/32/32/32/32/24/83/32","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"","battleSkill":"","debateCard":"","warSoul":"S1000202","battleSoul":"","debateSoul":"","warSoulPoint":"6400","battleSoulPoint":"5900","debateSoulPoint":"5300","strategy"