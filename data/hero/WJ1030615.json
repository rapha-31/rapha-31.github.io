:"234","month":"1"},"faction":"WJ10128","city":"CS1039","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[32,41,71,70,70,68],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1007102","armor":"WP1015805","helmet":"WP1024505"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ10128","city":"CS1039","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[32,41,71,70,70,68],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1007102","armor":"WP1015805","helmet":"WP1024505"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1039","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[32,41,71,70,70,68],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1007102","armor":"WP1015805","helmet":"WP1024505"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10128","city":"CS1039","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[32,41,71,70,70,68],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1007102","armor":"WP1015805","helmet":"WP1024505"},"couple":[]}],"storyEvents":[],"biography":{"zh":"蜀汉文臣，习祯之子，承袭家族名士声望，活跃于诸葛亮至蒋琬执政时期，官至尚书郎，任职蜀汉中枢尚书台，掌管诏令、文书、奏章，属于皇帝、丞相身边近臣机要岗位；史载“亦有名”，延续习氏士林。其子习隆官步兵校尉、掌校秘书，掌管宫廷藏书禁军，是蜀汉后期中枢文臣。","tc":"蜀漢文臣，習禎之子，承襲家族名士聲望，活躍于諸葛亮至蔣琬執政時期，官至尚書郎，任職蜀漢中樞尚書臺，掌管詔令、文書、奏章，屬于皇帝、丞相身邊近臣機要崗位；史載“亦有名”，延續習氏士林。其子習隆官步兵校尉、掌校秘書，掌管宮廷藏書禁軍，是蜀漢后期中樞文臣。","en":"A civil official of Shu Han and the son of Xi Zhen, he inherited his Family's Renown as celebrated scholars. Active during the administrations of Zhuge Liang and Jiang Wan, he rose to the rank of Gentleman of the Masters of Writing in the central Imperial Secretariat, overseeing imperial decrees, official documents, and memorials in a vital confidential post close to the Emperor and Chancellor. Historical records note that he ‘was also renowned,’ carrying on the scholarly prestige of the Xi clan.His son, Xi Long, served as Colonel of Infantry and supervised the imperial archives, overseeing the court library and imperial guard, serving as a key central civil official in the late Shu Han era.","jp":"蜀漢の文臣。習禎の子。家族の名士としての名声を受け継ぎ、諸葛亮から蒋琬の執政期にかけて活躍した。官位は尚書郎に至り、蜀漢の中枢である尚書台に任じられ、詔令、文書、奏章を司るなど、皇帝や丞相の側近として機要の職責を担った。史書には「亦た名有り」と記され、習氏の士林としての家名を繋いだ。子の習隆は歩兵校尉、掌校秘書となって宮廷の蔵書や禁軍を管掌し、蜀漢後期における中枢の文臣となった。","kr":"촉한의 문신이자 습정의 아들이다. 가문의 명사로서 명성을 이어받아 제갈량부터 장완이 집권하던 시기에 걸쳐 활약하였다. 관직은 상서랑에 이르렀으며, 촉한의 중추인 상서대에 재직하며 조령과 문서, 상소문을 관장하는 등 황제와 승상 측근의 핵심 요직을 맡았다. 사서에는 '역시 명성이 있었다(亦有名)'고 기록되어 습씨 가문 사림의 명맥을 이었다. 아들 습륭은 보병교위이자 장교비서로서 궁중의 장서와 금군을 관장하며 촉한 후기의 중추 문신으로 활약하였다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ1030615","remark":"","surname":"习","surnameTc":"習","surnameEn":"Xi","surnameJp":"習","surnameKr":"습","surnameOther":"","name":"忠","nameTc":"忠","nameEn":"Zhong","nameJp":"忠","nameKr":"충","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"习忠","power":"WJ10011","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"0","workYear":"217","city":"CS1039","gender":"0","rule":"32","force":"41","wise":"71","politics":"70","charm":"70","will":"68","ruleTalent":"3","forceTalent":"4","wiseTalent":"5","politicsTalent":"7","charmTalent":"7","willTalent":"8","weaponMaster":"14/14/13/14/14/62/56/14","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"","battleSkill":"","debateCard":"","warSoul":"","battleSoul":"","debateSoul":"","warSoulPoint":"2400","battleSoulPoint":"1500","debateSoulPoint":"4500","strategy":"","strategy2":"1000805","professions":"1/1/0/0/0/0/1/0/2/2/1/2/2/2/0/1/2/2/1/2/0/0/2/0","attrib