","month":"3"},"faction":"WJ10128","city":"CS1037","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[76,61,77,67,71,80],"title":-1,"rank":"8","loyalty":"100","reputation":"4850","equipment":{"weapon":"WP10014","armor":"WP1009305","helmet":"WP1019605"},"couple":[]},{"story":{"id":"S10915","name":{"zh":"北伐中原","en":"Northern Expedition"},"year":"227","month":"3"},"faction":"WJ10128","city":"CS1037","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[76,61,77,67,71,80],"title":-1,"rank":"8","loyalty":"100","reputation":"4850","equipment":{"weapon":"WP10014","armor":"WP1009305","helmet":"WP1019605"},"couple":[]},{"story":{"id":"S11015","name":{"zh":"再出岐山","en":"Return to Qishan"},"year":"231","month":"1"},"faction":"WJ10128","city":"CS1037","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[76,61,77,67,71,80],"title":-1,"rank":"8","loyalty":"100","reputation":"4850","equipment":{"weapon":"WP10014","armor":"WP1009305","helmet":"WP1019605"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":"WJ10128","city":"CS1037","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[76,61,77,67,71,80],"title":-1,"rank":"8","loyalty":"100","reputation":"4850","equipment":{"weapon":"WP10014","armor":"WP1009305","helmet":"WP1019605"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ10128","city":"CS1039","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[76,61,77,67,71,80],"title":-1,"rank":"8","loyalty":"100","reputation":"4850","equipment":{"weapon":"WP10014","armor":"WP1009305","helmet":"WP1019605"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1035","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[76,61,77,67,71,80],"title":-1,"rank":"9","loyalty":"0","reputation":"4650","equipment":{"weapon":"WP10014","armor":"WP1009305","helmet":"WP1019605"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10128","city":"CS1039","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[76,61,77,67,71,80],"title":-1,"rank":"9","loyalty":"100","reputation":"4650","equipment":{"weapon":"WP10014","armor":"WP1009305","helmet":"WP1019605"},"couple":[]}],"storyEvents":[],"biography":{"zh":"蜀汉将领、中都督、中领军。向朗之侄，刘备伐吴惨败，各营损失惨重，唯向宠所部完好无损。后官至都督。诸葛亮北伐期间，任御林总督负责成都的护卫工作。在《出师表》中被诸葛亮亲笔点名，称其“性行淑均，晓畅军事”，并推荐给后主刘禅，委以宫廷禁卫重任。延熙三年（240年）平叛时，亲冒矢石战死。","tc":"蜀漢將領、中都督、中領軍。向朗之侄，劉備伐吳慘敗，各營損失慘重，唯向寵所部完好無損。后官至都督。諸葛亮北伐期間，任御林總督負責成都的護衛工作。在《出師表》中被諸葛亮親筆點名，稱其“性行淑均，曉暢軍事”，并推薦給后主劉禪，委以宮廷禁衛重任。延熙三年（240年）平叛時，親冒矢石戰死。","en":"General, Central Viceroy, and Commander of the Central Army of Shu-Han. Nephew of Xiang Lang. When Liu Bei's campaign against Wu ended in catastrophic defeat and nearly every camp was destroyed, only Xiang Chong's unit emerged intact. He later rose to Viceroy. During Zhuge Liang's Northern Expeditions, he served as Commander of the Imperial Guard, responsible for the defense of Chengdu. He was personally named by Zhuge Liang in the ‘Memorial on the Expedition’, praised as ‘virtuous in nature, fair in conduct, and well-versed in military affairs’, and recommended to the Later Ruler Liu Shan for the critical responsibility of palace security. In the third year of Yanxi (240), he died in battle braving arrows and stones while quelling a rebellion.","jp":"蜀漢の武将、中都督、中領軍。向朗の甥。劉備の呉征伐が惨敗に終わり各陣営が大損害を被る中、向寵の部隊のみが無傷を保った。後に官位は都督に至る。諸葛亮の北伐中は、御林総督として成都の警備を務めた。『出師表』において諸葛亮自らその名を挙げ、「性行淑均、軍事に暁暢す」と称えられ、後主劉禅に推薦されて宮中禁衛の重任を委ねられた。延熙3年（240年）、反乱鎮圧の際に自ら矢石を冒して戦死した。","kr":"촉한의 장수이자 중도독, 중영군. 상랑의 조카이다. 유비의 오나라 정벌이 참패하여 각 진영의 피해가 막심했을 때도 오직 상총이 이끄는 부대만이 온전함을 유지했다. 훗날 관직이 도독에 이르렀다. 제갈량의 북벌 기간에는 어림총독으로서 성도의 방위를 책임졌다. 《출사표》에서 제갈량이 친히 거명하며 '성품과 행실이 선량하고 치우침이 없으며 군사에 밝다'라고 평했고, 후주 유선에게 천거되어 궁궐 금위의 중책을 맡았다. 연희 3년(240년), 반란을 평정하던 중 몸소 빗발치는 화살과 돌을 무릅쓰고 싸우다 전사했다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10426","remark":"","surname":"向","surnameTc":"向","surnameEn":"Xiang","surnameJp":"向","surnameKr":"상","surnameOther":"","name":"宠","nameTc":"寵","nameEn":"Chong","nameJp":"寵","nameKr":"총","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"向宠","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"0","workYear":"214","city":"CS1035","gender":"0","rule":"76","force":"61","wise":"77","politics":"67","charm":"71","will":"80","ruleTalent":"9","forceTalent":"6","wiseTalent":"9","politicsTalent":"7","charmTalent":"6","willTalent":"9","weaponMaster":"22/22/64/22/22/58/50/22","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"1018102;1010502","battleSkill":"1003702","debateCard":"","warSoul":"","battleSoul":"","debateSoul":"","warSoulPoint":"5700","battleSoulPoint":"3700","debateSoulPoint":"5900","strategy":"1003108","strategy2":"1001605","professions":"2/2/0/3/0/0/3/0/0/0/3/2/3/3/2/4/1/1/0/2/0/0/0/2","attribute2":"50/50/50/50/50/50","morality":"6","compatible":"52","loyalty":"0","reputation":"4650","evaluate":"0","title":"","rank":"9","birth":"195","show":"214","death":"240","age":"0","injury":"","deathReason":"1","type":"1","npcTag":"0","npcNum":"1","microScene":"0","isImportant":"0","speaking":"0","weapon":"WP10014","armor":"WP1009305","helmet":"WP1019605","treasure":"","horse":"","shield":"","character":"0/1;1/1;10/1;26/2;22/1;12/2;27/2;31/2;43/1","father":"","mother":"","children":"","family":"","modInfo":"","brother":"","couple":"","otherRelationship":"","belief":"0","isVIP":"0","startVIPYear":"0","endVIPYear":"0","description":"蜀汉将领、中都督、中领军。向朗之侄，刘备伐吴惨败，各营损失惨重，唯向宠所部完好无损。后官至都督。诸葛亮北伐期间，任御林总督负责成都的护卫工作。在《出师表》中被诸葛亮亲笔点名，称其“性行淑均，晓畅军事”，并推荐给后主刘禅，委以宫廷禁卫重任。延熙三年（240年）平叛时，亲冒矢石战死。","descripti