tle":600,"debate":5600},"equipment":[{"id":"WP1007102","name":{"zh":"竹简","en":"Bamboo Slip"},"level":"1","description":{"zh":"与木简一样用来记载文字的竹简，竹简在南方更为常见。","en":"Bamboo slips used for writing like wooden slips, more common in the south."},"atkVal":"3","hp":"110","mp":"160","price":"2000","slot":{"zh":"武器","en":"Weapon"}},{"id":"WP1016205","name":{"zh":"华丽长衣·甲","en":"Ornate Long Coat - I"},"level":"1","description":{"zh":"采用了稍微好一些的面料并进行了纹饰处理的长袍，衣服的边缘处也添加了简单的纹饰。","en":"A long robe made of slightly finer fabric adorned with patterns, with simple trim along the edges as well."},"defenceVal":"5","mp":"600","price":"3600","slot":{"zh":"护甲","en":"Armor"}},{"id":"WP1025605","name":{"zh":"纶巾","en":"Silk Turban"},"level":"2","description":{"zh":"配有青色丝带的冠帻，朝中官员最常见的冠帽之一，多在诸侯朝服时佩戴。","en":"A cap with blue silk ribbons, one of the most common court caps, typically worn by lords in court attire."},"defenceVal":"5","mp":"800","price":"5000","slot":{"zh":"头盔","en":"Helmet"}}],"family":{"father":{"label":{"zh":"父亲","en":"Father"},"people":[{"id":"WJ1013615","code":"0"}]},"children":{"label":{"zh":"子女","en":"Children"},"people":[{"id":"WJ1039115","code":"100"}]},"otherRelationship":{"label":{"zh":"其他关系","en":"Other relationships"},"people":[{"id":"WJ10163","code":"6"}]}},"clans":[{"id":"GI112715","name":{"zh":"高密郑氏","en":"The Zheng clan of Gaomi"},"years":["0","999"],"desc":{"zh":"出自姬姓，战国韩哀侯灭郑后，子孙以国为氏。是西汉以来的山东强宗大族，。经学世家之冠。八世祖郑崇在汉哀帝时任尚书仆射，家族“世与王家相嫁娶”，为西汉外戚家族。后因郑崇被诬陷惨死，家族中落。至郑玄时，祖父郑明、父亲郑谨皆未出仕，以农耕为生。郑玄遍注群经，创立“郑学”，为两汉经学集大成者，在《十三经注疏》中占据四部。袁绍、曹操等群雄争相礼聘；刘备曾师事郑玄，诸葛亮称“先帝亦言，吾周旋陈元方、郑康成间”；姜维亦好郑学。子郑益恩被孔融举荐，孙郑小同在曹魏官至侍中。家族虽未显于武勋，但文化影响力冠绝汉末，是连接东汉与魏晋学术的核心纽带。","en":"Originating from the Ji clan. After Marquis Ai of Han conquered Zheng during the Warring States period, his descendants took the state name as their surname. A powerful and prominent clan East of the mountains since the Western Han, and foremost among scholarly lineages of the Confucian Classics. His eighth-generation ancestor Zheng Chong served as Supervisor of the Masters of Writing under Emperor Ai of Han, the Family had 'intermarried with the imperial clan for generations,' being an imperial in-law Family of the Western Han. Later, because Zheng Chong was falsely accused and met a tragic death, the Family declined. By the time of Zheng Xuan, his grandfather Zheng Ming and father Zheng Jin held no official posts, earning their living through farming. Zheng Xuan annotated all the Confucian Classics and founded 'Zheng Learning,' becoming the great synthesizer of Han classical scholarship, occupying four parts of the Thirteen Classics with Commentaries and Subcommentaries. Warlords such as Yuan Shao and Cao Cao vied to courteously recruit him, Liu Bei once studied under Zheng Xuan, and Zhuge Liang stated, 'The Late Emperor also said, ‘I have conversed and associated with the likes of Chen Yuanfang and Zheng Kangcheng’', Jiang Wei was also fond of Zheng Learning. His son Zheng Yien was recommended by Kong Rong, and his grandson Zheng Xiaotong rose to Palace Attendant in Cao Wei. Although the Family did not distinguish itself in martial exploits, its cultural influence was unsurpassed at the end of the Han, serving as the core bridge connecting Eastern Han and Wei-Jin scholarship."},"talent":{"military":"1","commerce":"2","politics":"8"}}],"friendGroups":[],"body":{"name":"郑益","height":"较高","shape":"一般"},"honorifics":[],"selfAddress":[],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"25","startPregnantAge":"0"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":null,"city":"CS1017","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[55,50,70,55,78,85],"title":-1,"rank":"9","loyalty":"0","reputation":"8600","equipment":{"weapon":"WP1007102","armor":"WP1016205","helmet":"WP1025605"},"couple":[]},{"story":{"id":"S10215","name":{"zh":"汉末三杰","en":"Three Heroes of the Late Han"},"year":"185","m