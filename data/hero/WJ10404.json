:[62,72,45,27,21,60],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1029705","armor":"WP1003105","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1049","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[62,72,45,27,21,60],"title":-1,"rank":"9","loyalty":"0","reputation":"550","equipment":{"weapon":"WP1029705","armor":"WP1003105","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10582","city":"CS1049","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[62,72,45,27,21,60],"title":-1,"rank":"9","loyalty":"100","reputation":"550","equipment":{"weapon":"WP1029705","armor":"WP1003105","helmet":"WP1023105"},"couple":[]}],"storyEvents":[],"biography":{"zh":"桂阳太守赵范部将，猎户出身，擅用一把飞叉。刘备取荆州期间作为部将出阵，后随赵范降于刘备。赵范与赵云结怨后又奉命与鲍隆谋害赵云，被其察觉后反被杀。","tc":"桂陽太守趙范部將，獵戶出身，擅用一把飛叉。劉備取荊州期間作為部將出陣，后隨趙范降于劉備。趙范與趙云結怨后又奉命與鮑隆謀害趙云，被其察覺后反被殺。","en":"Officer under Zhao Fan, Governor of Guiyang. Born a hunter, he was skilled with a flying trident. During Liu Bei's campaign to take Jing Province, he served as a subordinate commander and later surrendered to Liu Bei along with Zhao Fan. After Zhao Fan fell out with Zhao Yun, he was ordered along with Bao Long to assassinate Zhao Yun, but the plot was detected and he was killed instead.","jp":"桂陽太守・趙範の部将。猟師の出身で、飛叉の扱いに長けていた。劉備が荊州を攻略した際に部将として出陣し、後に趙範に従って劉備に降伏した。趙範が趙雲と不和になると、命を受けて鮑隆とともに趙雲を謀殺しようとしたが、趙雲に見破られて逆に討ち取られた。","kr":"계양태수 조범의 부장으로 사냥꾼 출신이며 비차를 능숙하게 다루었다. 유비가 형주를 취할 당시 부장으로 출진했다가 이후 조범을 따라 유비에게 항복했다. 조범이 조운과 원한을 맺은 뒤에는 명을 받고 포륭과 함께 조운을 시해하려 했으나, 이를 눈치챈 조운에게 도리어 살해당했다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10404","remark":"","surname":"陈","surnameTc":"陳","surnameEn":"Chen","surnameJp":"陳","surnameKr":"진","surnameOther":"","