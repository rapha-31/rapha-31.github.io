":"231","month":"1"},"faction":"WJ10128","city":"CS1039","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[67,63,77,69,77,82],"title":-1,"rank":"9","loyalty":"100","reputation":"2450","equipment":{"weapon":"WP10014","armor":"WP1004305","helmet":"WP1023305"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":"WJ10128","city":"CS1039","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[67,63,77,69,77,82],"title":-1,"rank":"9","loyalty":"100","reputation":"2450","equipment":{"weapon":"WP10014","armor":"WP1004305","helmet":"WP1023305"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ10128","city":"CS1039","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[67,63,77,69,77,82],"title":-1,"rank":"9","loyalty":"100","reputation":"2450","equipment":{"weapon":"WP10014","armor":"WP1004305","helmet":"WP1023305"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1039","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[67,63,77,69,77,82],"title":-1,"rank":"9","loyalty":"0","reputation":"2350","equipment":{"weapon":"WP10014","armor":"WP1004305","helmet":"WP1023305"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10128","city":"CS1039","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[67,63,77,69,77,82],"title":-1,"rank":"9","loyalty":"100","reputation":"2350","equipment":{"weapon":"WP10014","armor":"WP1004305","helmet":"WP1023305"},"couple":[]}],"storyEvents":[],"biography":{"zh":"蜀汉末年官员、尚书郎、黄权之子。其父黄权，原为刘璋部下，后归刘备，在夷陵之战后因归路被断，不得已投降曹魏，但深受刘备理解。官至尚书郎，在邓艾奇袭阴平后，随卫将军诸葛瞻前往绵竹迎敌。力劝诸葛瞻应迅速抢占险要地势，据险固守，不可让敌军进入平原。谏言未被采纳，蜀军战败，他激愤之下，奋而冲阵，战死沙场。","tc":"蜀漢末年官員、尚書郎、黃權之子。其父黃權，原為劉璋部下，后歸劉備，在夷陵之戰后因歸路被斷，不得已投降曹魏，但深受劉備理解。官至尚書郎，在鄧艾奇襲陰平后，隨衛將軍諸葛瞻前往綿竹迎敵。力勸諸葛瞻應迅速搶占險要地勢，據險固守，不可讓敵軍進入平原。諫言未被采納，蜀軍戰敗，他激憤之下，奮而沖陣，戰死沙場。","en":"An official of the late Shu Han era, serving as Palace Secretary and son of Huang Quan. His father Huang Quan had originally served Liu Zhang before joining Liu Bei. After the Battle of Yiling, when his retreat was cut off, Huang Quan reluctantly surrendered to Cao Wei, though Liu Bei understood his predicament. Huang Chong served as Palace Secretary. When Deng Ai crossed Yinping in his surprise invasion, Huang Chong accompanied Guard Captain Zhuge Zhan to meet the enemy at Mianzhu. He strongly urged Zhuge Zhan to quickly seize the high ground and defend the passes, preventing the enemy from reaching the plains. His counsel was ignored, and when the Shu army was defeated, Huang Chong charged into the enemy ranks in fury and died fighting.","jp":"蜀漢末期の官吏、尚書郎。黄権の子。父の黄権は、もとは劉璋の配下で後に劉備に帰順したが、夷陵の戦いの後に退路を断たれ、やむなく曹魏に降伏したものの、劉備から深く理解されていた。官職は尚書郎に至り、鄧艾が陰平を奇襲した後は、衛将軍諸葛瞻に従って綿竹へ敵を迎え撃ちに向かった。諸葛瞻に対し、迅速に要害を占拠して険阻な地に拠って固守し、敵軍を平原に入らせてはならないと力説した。だが諫言は容れられず蜀軍が敗北すると、激憤のあまり奮って敵陣へと突撃し、戦死を遂げた。","kr":"촉한 말기의 관료이자 상서랑으로, 황권의 아들이다. 아버지 황권은 본래 유장의 부하였으나 훗날 유비에게 귀순하였고, 이릉 대전 이후 퇴로가 끊기자 부득이 조위에 항복했으나 유비의 깊은 이해를 받았다. 상서랑에 오른 그는 등애가 음평을 기습하자 위장군 제갈첨을 따라 면죽으로 가 적을 맞이했다. 제갈첨에게 신속히 요충지를 선점하고 험준한 지형에 기대어 굳게 지켜야 하며, 적군이 평지로 들어서게 해서는 안 된다고 강력히 간언했다. 그러나 간언이 받아들여지지 않아 촉군이 패하자, 비분강개하여 분연히 진으로 돌격해 전사했다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10452","remark":"","surname":"黄","surnameTc":"黃","surnameEn":"Huang","surnameJp":"黄","surnameKr":"황","surnameOther":"","name":"崇","nameTc":"崇","nameEn":"Chong","nameJp":"崇","nameKr":"숭","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"黄崇","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"0","workYear":"222","city":"CS1039","gender":"0","rule":"67","force":"63","wise":"77",