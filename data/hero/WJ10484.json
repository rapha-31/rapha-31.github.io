50","evade":"6","price":"3800","slot":{"zh":"头盔","en":"Helmet"}}],"family":{"father":{"label":{"zh":"父亲","en":"Father"},"people":[{"id":"WJ10225","code":"0"}]}},"clans":[{"id":"GI111315","name":{"zh":"河东毌丘氏","en":"The Guanqiu clan of Hedong"},"years":["0","255"],"desc":{"zh":"出自姬姓，以地为氏。曹魏军事世家。毌丘俭文武双全，两次出塞远征，摧毁高句骊王国，征服朝鲜半岛，官至幽州刺史、度辽将军，后不满司马氏专权，起兵讨司马师。","en":"Originating from the Ji surname, they took their surname from their fief, becoming a prominent military lineage of Cao Wei. Guanqiu Jian was accomplished in both civil and military Assignments, twice leading expeditions beyond the frontier to crush the Kingdom of Goguryeo and subjugate the Korean Peninsula. Rising to Inspector of You Province and General Who Crosses the Liao, he later raised troops against Sima Shi in defiance of the Sima clan's autocratic rule."},"talent":{"military":"8","commerce":"1","politics":"6"}}],"friendGroups":[],"body":null,"honorifics":[],"selfAddress":[],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"25","startPregnantAge":"0"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":null,"city":"CS1027","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[63,60,69,70,47,75],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1007002","armor":"WP1013805","helmet":"WP1028305"},"couple":[]},{"story":{"id":"S10215","name":{"zh":"汉末三杰","en":"Three Heroes of the Late Han"},"year":"185","month":"3"},"faction":null,"city":"CS1072","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[63,60,69,70,47,75],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1007002","armor":"WP1013805","helmet":"WP1028305"},"couple":[]},{"story":{"id":"S10615","name":{"zh":"十常侍之乱","en":"Turmoil of the Ten Attendants"},"year":"188","month":"11"},"faction":null,"city":"CS1027","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[63,6