{"id":"WJ10484","icon":"毌丘甸","surname":{"zh":"毌丘","tc":"毌丘","en":"Guanqiu","jp":"毌丘","kr":"관구"},"givenName":{"zh":"甸","tc":"甸","en":"Dian","jp":"甸","kr":"전"},"courtesy":{"zh":"子邦","tc":"子邦","en":"Zibang","jp":"子邦","kr":"자방"},"gender":0,"type":{"code":0,"en":"Civil","zh":"文官"},"years":{"birth":224,"debut":238,"death":255,"deathReasonCode":"1","workYear":"238","age":"0"},"faction":null,"hostileFaction":null,"city":{"id":"CS1027","name":{"zh":"河内","en":"Henei"},"region":{"zh":"司隶","en":"Si Protectorate"}},"stats":[{"key":"rule","zh":"统率","en":"LEA","value":63,"talent":6},{"key":"force","zh":"武力","en":"STR","value":60,"talent":6},{"key":"wise","zh":"智略","en":"INT","value":69,"talent":7},{"key":"politics","zh":"政略","en":"POL","value":70,"talent":8},{"key":"charm","zh":"魅力","en":"CHA","value":47,"talent":4},{"key":"will","zh":"意志","en":"DET","value":75,"talent":9}],"attribute2":"50/50/50/50/50/50","weaponMastery":[{"zh":"长柄穿刺","en":"Long Pierce","value":21},{"zh":"长柄挥砍","en":"Long Slash","value":21},{"zh":"短柄穿刺","en":"Short Pierce","value":21},{"zh":"短柄挥砍","en":"Short Slash","value":21},{"zh":"远程","en":"Ranged","value":21},{"zh":"文官","en":"Scholar","value":73},{"zh":"艺术","en":"Art","value":25},{"zh":"盾","en":"Shield","value":21}],"duelWeaponMultipliers":[{"zh":"长柄穿刺","en":"Long Pierce","value":1.0},{"zh":"长柄挥砍","en":"Long Slash","value":1.0},{"zh":"短柄穿刺","en":"Short Pierce","value":1.0},{"zh":"短柄挥砍","en":"Short Slash","value":1.0},{"zh":"远程","en":"Ranged","value":1.0},{"zh":"文官","en":"Scholar","value":1.0},{"zh":"艺术","en":"Art","value":1.0},{"zh":"盾","en":"Shield","value":1.0}],"debateAttribute":"1/1/1","professions":[{"zh":"短兵","en":"Blade","value":1},{"zh":"枪兵","en":"Spear","value":0},{"zh":"骑兵","en":"Cavalry","value":1},{"zh":"弓兵","en":"Archery","value":1},{"zh":"器械","en":"Siege","value":1},{"zh":"水军","en":"Navy","value":0},{"zh":"军学","en":"Military Science","value":1},{"zh":"商业","en":"Commerce","value":2},{"zh":"农业","en":"Agriculture","value":3},{"zh":"建造","en":"Const