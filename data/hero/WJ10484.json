69,70,47,75],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1007002","armor":"WP1013805","helmet":"WP1028305"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ1000115","city":"CS1027","noRecruit":false,"reject":null,"state":"2","role":3,"stats":[63,60,69,70,47,75],"title":-1,"rank":"5","loyalty":"99","reputation":"0","equipment":{"weapon":"WP1007002","armor":"WP1013805","helmet":"WP1028305"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1027","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[63,60,69,70,47,75],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1007002","armor":"WP1013805","helmet":"WP1028305"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10225","city":"CS1072","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[63,60,69,70,47,75],"title":-1,"rank":"9","loyalty":"120","reputation":"0","equipment":{"weapon":"WP1007002","armor":"WP1013805","helmet":"WP1028305"},"couple":[]}],"storyEvents":[{"kind":"plot","id":"1004818","name":{"zh":"淮鸯惊师","en":"Wen Yang Rattles the Host at the Huai"},"year":"255","month":"1","desc":{"zh":"魏帝曹芳被司马师废黜，毌丘俭、文钦率淮南将士举兵勤王，讨伐司马氏。\n\n触发条件：汝南、洛阳、襄阳、寿春、许昌属曹髦，建业属孙亮，<高平陵之变>中司马懿、司马师、司马昭没有死亡\n\n禁忌条件：主角为毌丘俭、毌丘甸、文钦、司马师时无法触发\n\n亲历条件：【身属曹髦势力且不为曹髦、毌丘俭、毌丘甸、文钦、王肃、钟会、王基、傅嘏、尹大目、诸葛诞、胡遵、郭宁】\n\n逆天改命：【帮助毌丘俭自立并避免毌丘俭死亡（不为文鸯）】或【帮助司马师平叛，避免毌丘俭死亡并收为家将】","en":"Emperor Cao Fang of Wei was deposed by Sima Shi. Guanqiu Jian and Wen Qin led the soldiers of Huainan to take up arms in defense of the throne and subjugate the Sima clan.\n\n\n\nTrigger Condition: Runan, Luoyang, Xiangyang, Shouchun, and Xuchang belong to Cao Mao, Jianye belongs to Sun Liang, Sima Yi, Sima Shi, and Sima Zhao did not die in the <Incident at Gaoping Tombs>\n\n\n\nRestriction: Cannot be triggered if the protagonist is Guanqiu Jian, Guanqiu Dian, Wen Qin, or Sima Shi\n\n\n\nParticipation Requirement: 【Belong to Cao Mao's Faction and not be Cao Mao, Guanqiu Jian, Guanqiu Dian, Wen Qin, Wang Su, Zhong Hui, Wang Ji, Fu Jia, Yin Damu, Zhuge Dan, Hu Zun, or Guo Ning】\n\n\n\nDefy Fate: 【Help Guanqiu Jian establish independence and prevent the death of Guanqiu Jian (not playing as Wen Yang)】 or 【Help Sima Shi quell the rebellion, prevent the death of Guanqiu Jian, and recruit him as a Retainer】"}}],"biography":{"zh":"曹魏大臣，官至治书侍御史。毌丘俭之子。有名于洛阳，与夏侯玄、李丰等名士交好。魏帝曹芳被废后，劝手握重兵的父亲毌丘俭起兵讨伐司马师。在毌丘俭起兵前，携家属逃至新安灵山。灵山被攻破后，毌丘甸被杀，毌丘俭被夷三族。","tc":"曹魏大臣，官至治書侍御史。毌丘儉之子。有名于洛陽，與夏侯玄、李豐等名士交好。魏帝曹芳被廢后，勸手握重兵的父親毌丘儉起兵討伐司馬師。在毌丘儉起兵前，攜家屬逃至新安靈山。靈山被攻破后，毌丘甸被殺，毌丘儉被夷三族。","en":"A minister of Cao Wei who rose to the rank of Attendant Censor of Documents. Son of Guanqiu Jian. He was renowned in Luoyang and close friends with Xiahou Xuan, Li Feng, and other notable figures. After Emperor Cao Fang was deposed, he urged his father Guanqiu Jian, who commanded significant military forces, to raise an army against Sima Shi. Before Guanqiu Jian rose in revolt, he fled with his family to Mount Ling in Xinan. When Mount Ling was overrun, Guanqiu Dian was killed, and Guanqiu Jian's clan was exterminated to the third degree.","jp":"曹魏の臣。官位は治書侍御史に至る。毌丘倹の子。洛陽で名高く、夏侯玄や李豊ら名士と親交を結んだ。魏帝の曹芳が廃位されると、重兵を率いる父の毌丘倹に司馬師討伐の挙兵を勧めた。毌丘倹の挙兵前、家族を連れて新安の霊山へ逃れた。霊山が攻め落とされると毌丘甸は殺害され、毌丘倹は三族皆殺しとなった。","kr":"조위의 대신으로, 관직은 치서시어사에 이르렀다. 관구검의 아들이다. 낙양에서 명성이 높아 하후현, 이풍 등 명사들과 친교를 맺었다. 위제 조방이 폐위되자, 중병을 쥐고 있던 아버지 관구검에게 거병하여 사마사를 토벌할 것을 권했다. 관구검이 거병하기 전 가솔들을 이끌고 신안의 영산으로 피신했으나, 영산이 함락된 후 관구전은 피살되었고 관구검은 삼족이 멸해졌다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10484","remark":"","surname":"毌丘","surnameTc":"毌丘","surnameEn":"Guanqiu","surnameJp":"毌丘","surnameKr":"관구","surnameOther":"","name":"甸","nameTc":"甸","nameEn":"Dian","nameJp":"甸","n