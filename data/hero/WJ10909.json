th":"3"},"faction":"WJ10104","city":"CS1051","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[51,67,20,17,40,47],"title":-1,"rank":"9","loyalty":"90","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1004705","helmet":"WP1023305"},"couple":[]},{"story":{"id":"S10915","name":{"zh":"北伐中原","en":"Northern Expedition"},"year":"227","month":"3"},"faction":"WJ10127","city":"CS1051","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[51,67,20,17,40,47],"title":-1,"rank":"9","loyalty":"90","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1004705","helmet":"WP1023305"},"couple":[]},{"story":{"id":"S11015","name":{"zh":"再出岐山","en":"Return to Qishan"},"year":"231","month":"1"},"faction":"WJ10127","city":"CS1051","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[51,67,20,17,40,47],"title":-1,"rank":"9","loyalty":"90","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1004705","helmet":"WP1023305"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":"WJ10127","city":"CS1051","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[51,67,20,17,40,47],"title":-1,"rank":"9","loyalty":"90","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1004705","helmet":"WP1023305"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ1000115","city":"CS1051","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[51,67,20,17,40,47],"title":-1,"rank":"9","loyalty":"90","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1004705","helmet":"WP1023305"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1051","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[51,67,20,17,40,47],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1004705","helmet":"WP1023305"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10127","city":"CS1016","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[51,67,20,17,40,47],"title":-1,"rank":"9","loyalty":"90","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1004705","helmet":"WP1023305"},"couple":[]}],"storyEvents":[],"biography":{"zh":"魏国武将，韩当之子。初为吴将，但任职期间淫乱不轨，孙权念韩当之功将其免罪，韩综害怕孙权秋后算账，便携家眷部下数千人投奔魏国，并受封昭武将军 ，屡次侵扰吴国边境。后东兴之战期间，被丁奉雪中奇袭所斩首，首级亦被送往孙权灵前祭拜。","tc":"魏國武將，韓當之子。初為吳將，但任職期間淫亂不軌，孫權念韓當之功將其免罪，韓綜害怕孫權秋后算賬，便攜家眷部下數千人投奔魏國，并受封昭武將軍 ，屢次侵擾吳國邊境。后東興之戰期間，被丁奉雪中奇襲所斬首，首級亦被送往孫權靈前祭拜。","en":"An officer of Wei and the son of Han Dang. Initially a general of Wu, he committed licentious and disorderly acts during his service. Sun Quan, out of respect for Han Dang's past contributions, pardoned him. Fearing eventual retribution, Han Zong fled to Wei with his family and several thousand followers, where he was granted the title of General Who Glorifies Martial Valor. He repeatedly raided Wu's border regions. During the Battle of Dongxing, he was beheaded in a surprise snow raid led by Ding Feng, and his severed head was sent to Sun Quan's memorial altar as an offering.","jp":"魏の武将で韓当の子。初めは呉の将であったが、在任中に淫乱不軌を働き、孫権は韓当の功績に免じて罪を許した。しかし韓綜は後日の追及を恐れ、家族や部下数千人を率いて魏に身を寄せ、昭武将軍に封じられて幾度となく呉の国境を侵犯した。後に東興の戦いにて、丁奉の雪中奇襲によって斬首され、その首級は孫権の霊前に捧げられた。","kr":"위나라 무장이자 한당의 아들이다. 처음에는 오나라 무장이었으나 재임 기간 동안 음란하고 불궤한 짓을 저질렀다. 손권이 한당의 공을 참작하여 죄를 면해 주었으나, 한종은 손권이 가을이 지난 뒤 셈을 치르듯 훗날 죄를 추궁할까 두려워 가솔과 부하 수천 명을 이끌고 위나라로 투항하였다. 이후 소무장군에 봉해져 여러 차례 오나라 국경을 침범하였다. 훗날 동흥 전투 중에 정봉의 눈 속 기습을 받아 참수되었으며, 수급 또한 손권의 영전에 보내져 제물로 바쳐졌다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10909","remark":"","surname":"韩","surnameTc":"韓","surnameEn":"Han","surnameJp":"韓","surnameKr":"한","surnameOther":"","name":"综","nameTc":"綜","nameEn":"Zong","nameJp":"綜","nameKr":"종","nameO