p":"470","price":"7800","slot":{"zh":"武器","en":"Weapon"}},{"id":"WP1017405","name":{"zh":"华丽布袍","en":"Ornate Robe"},"level":"1","description":{"zh":"采用了稍微好一些的面料并进行了纹饰处理的衣袍，衣服的边缘处也添加了简单的纹饰。","en":"A robe made of slightly better fabric with decorative patterning, also featuring simple trim along the edges."},"defenceVal":"3","hp":"450","price":"3200","slot":{"zh":"护甲","en":"Armor"}},{"id":"WP1026705","name":{"zh":"应权冠","en":"Authority Crown"},"level":"2","description":{"zh":"特殊的小冠，多为朝中职务特殊之士佩戴。","en":"A special small crown, mostly worn by officials with unique court duties."},"mp":"1320","price":"8400","slot":{"zh":"头盔","en":"Helmet"}}],"family":{},"clans":[{"id":"GI100115","name":{"zh":"汝南袁氏","en":"The Yuan clan of Runan"},"years":["0","207"],"desc":{"zh":"出自妫姓，虞舜之后，周武王封胡公满于陈，后裔以地为氏，汝南郡顶级望族。东汉“四世三公”之首，门生故吏遍天下。袁氏影响力冠绝一时。袁绍籍此得以平定河北，一度成为汉末最强诸侯。最终于官渡之战败给曹操，家族盛极而衰。","en":"Descended from the Gui surname and the lineage of Emperor Shun. King Wu of Zhou enfeoffed Duke Hu Man in Chen, whose descendants adopted the place name as their surname, becoming the premier prominent clan of Runan Commandery. Foremost among the Eastern Han lineages of 'Three Excellencies across Four Generations', their disciples and former subordinates spread across the realm. The Yuan clan's influence was unmatched in its era. Relying on this prestige, Yuan Shao pacified Hebei and briefly became the mightiest warlord of the late Han. Ultimately defeated by Cao Cao at the Battle of Guandu, the Family waned after reaching its zenith."},"talent":{"military":"7","commerce":"6","politics":"10"}}],"friendGroups":[],"body":null,"honorifics":[],"selfAddress":[],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"25","startPregnantAge":"0"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":"WJ10072","city":"CS1028","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[31,23,78,85,75,63],"title":7,