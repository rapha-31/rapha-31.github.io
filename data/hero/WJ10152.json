uipment":[{"id":"WP10014","name":{"zh":"长剑","en":"Longsword"},"level":"1","description":{"zh":"流传最久、随处可见的经典款式。","en":"The most enduring and ubiquitous classic design."},"atkVal":"5","price":"2000","slot":{"zh":"武器","en":"Weapon"}},{"id":"WP1012405","name":{"zh":"虎口战袍","en":"Tiger Maw War Robe"},"level":"2","description":{"zh":"在山纹甲的一侧覆盖了带有特殊纹饰的罩袍，多为军师、统率者穿戴。除此之外，肩甲上配有吞肩兽。","en":"Mountain-pattern armor draped on one side with a specially patterned surcoat, mostly worn by strategists and commanders. In addition, the pauldrons are adorned with beast heads."},"defenceVal":"11","mp":"200","price":"9500","slot":{"zh":"护甲","en":"Armor"}},{"id":"WP1025305","name":{"zh":"高堂委貌冠","en":"Gaotang Weimao Crown"},"level":"2","description":{"zh":"略高于普通的委貌冠，多为朝中身居要职之人佩戴。","en":"Slightly taller than an ordinary formal cap, worn by those holding high court positions."},"defenceVal":"7","mp":"1400","price":"9500","slot":{"zh":"头盔","en":"Helmet"}},{"id":"WP29001","name":{"zh":"战马","en":"Warhorse"},"level":"1","description":{"zh":"战场上必不可少的身影。","en":"An indispensable presence on the battlefield."},"price":"2000","slot":{"zh":"坐骑","en":"Mount"}}],"family":{"children":{"label":{"zh":"子女","en":"Children"},"people":[{"id":"WJ11040","code":"100"}]}},"clans":[{"id":"GI106015","name":{"zh":"南郡黄氏","en":"The Huang clan of Nan Commandery"},"years":["0","999"],"desc":{"zh":"出自嬴姓，黄国之后。西汉邔侯黄极忠开基，东汉司徒黄尚、沔南名士黄承彦、江夏太守黄祖相继。荆襄最古老豪族之一。黄承彦为诸葛亮岳父，黄祖镇守江夏十余年射杀孙坚，为荆州士族网络核心节点。","en":"Originating from the Ying surname, descendants of the ancient State of Huang. Founded in the Western Han by Huang Jizhong, Marquis of Qi, followed successively by Minister over the Masses Huang Shang of the Eastern Han, the renowned scholar of Miannan Huang Chengyan, and Governor of Jiangxia Huang Zu. They were one of the oldest prominent clans in Jingxiang. Huang Chengyan was the father-in-law of Zhuge Liang, and Huang Zu guarded Jiangxia for over a decade and killed Sun Jian with arrows, they served as a vital hub in the gentry network of Jing Province."},"talent":{"military":"6","commerce":"2","politics":"5"}}],"friendGroups":[{"story":"S10802","members":["WJ10058","WJ10284","WJ10285","WJ10151","WJ10522","WJ10150","WJ10382","WJ10286"]},{"story":"S10802","members":["WJ10016","WJ10741","WJ10021"]},{"story":"S10615","members":["WJ10058","WJ10284","WJ10285","WJ10151","WJ10522","WJ10150","WJ10382","WJ10286"]},{"story":"S10615","members":["WJ10016","WJ10021","WJ10741"]},{"story":"S10402","members":["WJ10058","WJ10284","WJ10285","WJ10151","WJ10522","WJ10150","WJ10382","WJ10286"]},{"story":"S10402","members":["WJ10016","WJ10021","WJ10741"]},{"story":"S10415","members":["WJ10058","WJ10284","WJ10285","WJ10151","WJ10522","WJ10150","WJ10382","WJ10286"]},{"story":"S10415","members":["WJ10016","WJ10021","WJ10741"]},{"story":"S10202","members":["WJ10058","WJ10284","WJ10285","WJ10151","WJ10522","WJ10150","WJ10382","WJ10286"]},{"story":"S10202","members":["WJ10016","WJ10021"]},{"story":"S10715","members":["WJ10058","WJ10284","WJ10285","WJ10151","WJ10522","WJ10150","WJ10382","WJ10286"]},{"story":"S10102","members":["WJ10058","WJ10284","WJ10285","WJ10151","WJ10522","WJ10150","WJ10382","WJ10286"]},{"story":"S10102","members":["WJ10016","WJ10021","WJ10118"]},{"story":"S10315","members":["WJ10058","WJ10284","WJ10285","WJ10151","WJ10522","WJ10382","WJ10286"]},{"story":"S10315","members":["WJ10016","WJ10021","WJ10118"]},{"story":"S10302","members":["WJ10058","WJ10284","WJ10285","WJ10151","WJ10522","WJ10382","WJ10286"]},{"story":"S10302","members":["WJ10016","WJ10021","WJ10118"]},{"story":"S10215","members":["WJ10058","WJ10284","WJ10285","WJ10151","WJ10522","WJ10150","WJ10382","WJ10286"]},{"story":"S10215","members":["WJ10016","WJ10741","WJ10021"]},{"story":"S10208","members":["WJ10058","WJ10284","WJ10285","WJ10151","WJ10522","WJ10150","WJ10382","WJ10286"]},{"story":"S10208","members":["WJ10016","WJ10021","WJ10741"]},{"story":"S10108","members":["WJ10058","WJ10284","WJ10285","WJ10151","WJ10522","WJ10150","WJ10382","W