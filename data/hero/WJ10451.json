,30,38,58],"title":-1,"rank":"9","loyalty":"0","reputation":"650","equipment":{"weapon":"WP10014","armor":"WP1002705","helmet":"WP1023305"},"couple":[]},{"story":{"id":"S10915","name":{"zh":"北伐中原","en":"Northern Expedition"},"year":"227","month":"3"},"faction":"WJ10311","city":"CS1006","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[54,59,38,30,38,58],"title":-1,"rank":"9","loyalty":"99","reputation":"650","equipment":{"weapon":"WP10014","armor":"WP1002705","helmet":"WP1023305"},"couple":[]},{"story":{"id":"S11015","name":{"zh":"再出岐山","en":"Return to Qishan"},"year":"231","month":"1"},"faction":"WJ10223","city":"CS1006","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[54,59,38,30,38,58],"title":-1,"rank":"9","loyalty":"99","reputation":"650","equipment":{"weapon":"WP10014","armor":"WP1002705","helmet":"WP1023305"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":"WJ10223","city":"CS1006","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[54,59,38,30,38,58],"title":-1,"rank":"9","loyalty":"99","reputation":"650","equipment":{"weapon":"WP10014","armor":"WP1002705","helmet":"WP1023305"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1006","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[54,59,38,30,38,58],"title":-1,"rank":"9","loyalty":"0","reputation":"650","equipment":{"weapon":"WP10014","armor":"WP1002705","helmet":"WP1023305"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1006","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[54,59,38,30,38,58],"title":-1,"rank":"9","loyalty":"0","reputation":"600","equipment":{"weapon":"WP10014","armor":"WP1002705","helmet":"WP1023305"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10223","city":"CS1061","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[54,59,38,30,38,58],"title":-1,"rank":"9","loyalty":"100","reputation":"600","equipment":{"weapon":"WP10014","armor":"WP1002705","helmet":"WP1023305"},"couple":[]}],"storyEvents":[],"biography":{"zh":"公孙渊部下武将。公孙渊自立为燕王后负责驻兵城外，为抵御魏军来袭做防御工事准备。司马懿奉命前来镇压后与之交战，但被夏侯霸所击退。后襄平城的处境陷入危急，粮尽则吃人，且经久战，死伤惨重，公孙渊集团内部发生了分裂，杨作等出城降魏。","tc":"公孫淵部下武將。公孫淵自立為燕王后負責駐兵城外，為抵御魏軍來襲做防御工事準備。司馬懿奉命前來鎮壓后與之交戰，但被夏侯霸所擊退。后襄平城的處境陷入危急，糧盡則吃人，且經久戰，死傷慘重，公孫淵集團內部發生了分裂，楊作等出城降魏。","en":"An officer under Gongsun Yuan. After Gongsun Yuan proclaimed himself King of Yan, he was tasked with garrisoning troops outside the city and constructing defensive works against the expected Wei attack. When Sima Yi arrived to suppress the rebellion, he engaged the Wei forces but was repelled by Xiahou Ba. As the situation in Xiangping grew desperate with supplies exhausted and the starving garrison resorting to cannibalism, and after prolonged fighting with heavy casualties, internal fractures emerged within Gongsun Yuan's faction. Yang Zuo and others eventually left the city to surrender to Wei.","jp":"公孫淵配下の武将。公孫淵が燕王を自称した後は城外に駐屯し、魏軍の来襲を防ぐべく防御陣地の構築を担った。討伐の命を受けた司馬懿が来襲するとこれと交戦したが、夏侯覇に撃退された。その後、襄平城は窮地に陥り、兵糧が尽きて人肉を喰らう事態となり、長期戦による死傷者も多数出た。公孫淵陣営の内部で分裂が起きると、楊作らは城を出て魏に降伏した。","kr":"공손연 휘하의 무장. 공손연이 연왕을 자칭한 뒤 성 밖에 주둔하며 위군의 침공을 막기 위한 방어 공사를 준비했다. 사마의가 명을 받고 토벌하러 오자 맞서 싸웠으나 하후패에게 격퇴당했다. 이후 양평성의 상황이 위급해져 군량이 바닥나 사람을 잡아먹는 지경에 이르렀고, 오랜 전투로 사상자가 속출하자 공손연 진영 내부에서 분열이 일어나 양작 등은 성을 나와 위에 투항했다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10451","remark":"","surname":"杨","surnameTc":"楊","surnameEn":"Yang","surnameJp":"楊","surnameKr":"양","surnameOther":"","name":"祚","nameTc":"祚","nameEn":"Zuo","nameJp":"祚","nameKr":"조","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"杨祚","power":"","rejectPower":"","reje