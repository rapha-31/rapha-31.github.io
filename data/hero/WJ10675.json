2","role":0,"stats":[65,82,42,21,42,72],"title":-1,"rank":"9","loyalty":"85","reputation":"150","equipment":{"weapon":"WP1005502","armor":"WP1006005","helmet":"WP1020905"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ10128","city":"CS1042","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[65,82,42,21,42,72],"title":-1,"rank":"9","loyalty":"85","reputation":"150","equipment":{"weapon":"WP1005502","armor":"WP1006005","helmet":"WP1020905"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1042","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[65,82,42,21,42,72],"title":-1,"rank":"9","loyalty":"0","reputation":"150","equipment":{"weapon":"WP1005502","armor":"WP1006005","helmet":"WP1020905"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10637","city":"CS1044","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[65,82,42,21,42,72],"title":-1,"rank":"9","loyalty":"92","reputation":"150","equipment":{"weapon":"WP1005502","armor":"WP1006005","helmet":"WP1020905"},"couple":[]}],"storyEvents":[],"biography":{"zh":"蜀国武将，太守高定的部将，擅用长戟。高定响应孟获一同叛乱时作为高定的先锋迎战蜀军，但被魏延等人所擒获。后被诸葛亮放还，并劝说高定停止叛乱，并奉命击杀叛乱的同党，与高定归蜀，被封为牙门将军。","tc":"蜀國武將，太守高定的部將，擅用長戟。高定響應孟獲一同叛亂時作為高定的先鋒迎戰蜀軍，但被魏延等人所擒獲。后被諸葛亮放還，并勸說高定停止叛亂，并奉命擊殺叛亂的同黨，與高定歸蜀，被封為牙門將軍。","en":"An officer of Shu and a subordinate of Governor Gao Ding, skilled with a long halberd. When Gao Ding answered Meng Huo's call to rebel, E Huan served as Gao Ding's vanguard against the Shu army but was captured by Wei Yan and others. After being released by Zhuge Liang, he persuaded Gao Ding to cease the rebellion and was ordered to kill the rebel conspirators. He and Gao Ding subsequently submitted to Shu, and he was appointed Gatekeeper.","jp":"蜀の武将。太守・高定の部将で、長戟の扱いに長けていた。高定が孟獲に呼応して反乱を起こした際、先鋒として蜀軍を迎え撃つも、魏延らに捕らえられた。後に諸葛亮に釈放されると、高定を説得して反乱をやめさせ、命を受けて反乱の同党を討伐した。高定とともに蜀に帰順し、牙門将軍に任じられた。","kr":"촉나라의 무장이자 태수 고정의 부장으로, 장극을 능숙하게 다루었다. 고정이 맹획에게 호응하여 함께 반란을 일으켰을 때 선봉으로서 촉군을 요격했으나, 위연 등에게 사로잡혔다. 이후 제갈량에게 풀려나 돌아가 고정을 설득하여 반란을 멈추게 하였고, 명을 받아 반란 동조자를 처단한 뒤 고정과 함께 촉에 귀순하여 아문장군에 봉해졌다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10675","remark":"","surname":"鄂","surnameTc":"鄂","surnameEn":"E","surnameJp":"鄂","surnameKr":"악","surnameOther":"","name":"焕","nameTc":"煥","nameEn":"Huan","nameJp":"煥","nameKr":"환","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"鄂焕","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"0","workYear":"220","city":"CS1042","gender":"0","rule":"65","force":"82","wise":"42","politics":"21","charm":"42","will":"72","ruleTalent":"7","forceTalent":"11","wiseTalent":"3","politicsTalent":"1","charmTalent":"3","willTalent":"8","weaponMaster":"37/83/37/37/37/15/50/37","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"","battleSkill":"1006000;1009902","debateCard":"","warSoul":"","battleSoul":"1013605","debateSoul":"","warSoulPoint":"4200","battleSoulPoint":"6700","debateSoulPoint":"1700","strategy":"","strategy2":"","professions":"3/0/1/0/0/0/1/0/0/0/2/2/2/0/1/0/0/0/0/1/0/2/0/0","attribute2":"50/50/50/50/50/50","morality":"3","compatible":"42","loyalty":"0","reputation":"150","evaluate":"0","title":"","rank":"9","birth":"196","show":"214","death":"251","age":"0","injury":"","deathReason":"0","type":"1","npcTag":"0","npcNum":"1","microScene":"0","isImportant":"0","speaking":"0","weapon":"WP1005502","armor":"WP1006005","helmet":"WP1020905","treasure":"","horse":"","shield":"","character":"0/1;2/1;10/1;19/1;31/1;13/0;30/0","father":"","mother":"","children":"","family":"","modInfo":"","brother":"","couple":"