:"WP1014005","helmet":"WP1024805"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1055","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[44,66,64,64,72,77],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1007002","armor":"WP1014005","helmet":"WP1024805"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1055","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[44,66,64,64,72,77],"title":-1,"rank":"9","loyalty":"0","reputation":"4000","equipment":{"weapon":"WP1007002","armor":"WP1014005","helmet":"WP1024805"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10164","city":"CS1055","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[44,66,64,64,72,77],"title":-1,"rank":"9","loyalty":"96","reputation":"4000","equipment":{"weapon":"WP1007002","armor":"WP1014005","helmet":"WP1024805"},"couple":[]}],"storyEvents":[],"biography":{"zh":"东汉末年吴郡太守。曾秘密上表汉帝，认为孙策骁勇如同项羽，建议朝廷“召还京邑”，若放在外面终成后患。因不满孙策对吴郡的征讨而企图投靠曹操，被孙策发现行迹后所杀。因许贡手下有三名忠心门客对此事不满，便向孙策复仇。孙策被暗伤后门客亦被护卫所杀，但归营后不久便负伤身亡。","tc":"東漢末年吳郡太守。曾秘密上表漢帝，認為孫策驍勇如同項羽，建議朝廷“召還京邑”，若放在外面終成后患。因不滿孫策對吳郡的征討而企圖投靠曹操，被孫策發現行跡后所殺。因許貢手下有三名忠心門客對此事不滿，便向孫策復仇。孫策被暗傷后門客亦被護衛所殺，但歸營后不久便負傷身亡。","en":"Governor of Wu Commandery during the late Eastern Han. He once secretly submitted a memorial to the Han Emperor, warning that Sun Ce was as fierce as Xiang Yu and recommending that the court ‘recall him to the capital,’ arguing that leaving him unchecked would create a future threat. His plan to defect to Cao Cao out of resentment toward Sun Ce's conquest of Wu Commandery was discovered, and Sun Ce had him executed. Three loyal retainers of Xu Gong, enraged by their lord's death, ambushed Sun Ce in revenge. Although Sun Ce's guards killed the assassins, Sun Ce had been mortally wounded and died shortly after returning to camp.","jp":"後漢末期の呉郡太守。かつて漢帝へ密かに上奏し、孫策の勇猛さは項羽に匹敵するため「京邑に召還」すべきであり、外に放っておけば必ずや後患になると進言した。孫策による呉郡征伐に不満を抱いて曹操を頼ろうと画策したが、孫策に察知されて殺害された。後に許貢配下の忠義な3人の門客がこれを無念として孫策に復讐を企てた。孫策を急襲して傷を負わせた後に門客らも護衛に討ち取られたが、孫策も帰営後まもなくその傷がもとで命を落とした。","kr":"동한 말년의 오군태수. 일찍이 한제에게 비밀리에 표문을 올려 손책의 용맹이 항우와 같으니 조정에서 '경읍으로 불러들여야' 하며, 밖에 그대로 둔다면 끝내 후환이 될 것이라 진언했다. 손책이 오군을 정벌하는 데 불만을 품고 조조에게 의탁하려다 행적이 발각되어 손책에게 살해당했다. 허공 수하의 충성스러운 문객 세 명이 이에 앙심을 품고 손책에게 복수를 꾀했다. 손책은 기습을 당해 부상을 입었고 문객들 역시 호위병에게 살해당했으나, 손책 또한 군영으로 돌아간 지 얼마 지나지 않아 부상으로 숨을 거두었다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10553","remark":"","surname":"许","surnameTc":"許","surnameEn":"Xu","surnameJp":"許","surnameKr":"허","surnameOther":"","name":"贡","nameTc":"貢","nameEn":"Gong","nameJp":"貢","nameKr":"공","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"许贡","power":"WJ10164","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"2","workYear":"184","city":"CS1055","gender":"0","rule":"44","force":"66","wise":"64","politics":"64","charm":"72","will":"77","ruleTalent":"3","forceTalent":"7","wiseTalent":"6","politicsTalent":"6","charmTalent":"8","willTalent":"9","weaponMaster":"21/21/21/21/21/65/36/21","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"","battleSkill":"","debateCard":"1001901","warSoul":"","battleSoul":"","debateSoul":"","warSoulPoint":"1900","battleSoulPoint":"4300","debateSoulPoint":"4000","strategy":"1000301","strategy2":"","professions":"1/0/0/3/0/1/0/1/1/1/1/1/1/2/3/2/1/1/1/0/0/0/0/1","attribute2":"50/50/50/50/50/50","morality":"5","compatible":"92","loyalty":"0","reputation":"4000","evaluate":"0","title":"","rank":"9","birth":"155","show":"184","death":"200","age":"0","injury":"","deathReason":"1","type":"0","npcTag":"0","npcNu