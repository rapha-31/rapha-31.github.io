ty":"100","reputation":"0","equipment":{"weapon":"WP1007202","armor":"WP1014802","helmet":"WP1013102"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ10020","city":"CS1059","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[71,55,75,81,89,70],"title":-1,"rank":"5","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1007202","armor":"WP1014802","helmet":"WP1013102"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1047","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[71,55,75,81,89,70],"title":-1,"rank":"7","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1007202","armor":"WP1014802","helmet":"WP1013102"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10038","city":"CS1071","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[71,55,75,81,89,70],"title":-1,"rank":"7","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1007202","armor":"WP1014802","helmet":"WP1013102"},"couple":[]}],"storyEvents":[],"biography":{"zh":"孙坚次女，孙策、孙权之姊，孙坚在担任县长期间与吴旖所生，孙灵阳与孙灵月为孪生姐妹。灵月政略过人，在早期孙坚四处征讨的岁月中，就在帮助母亲照顾和保护孙策，分担后方劳务，后嫁给名门陈氏。","tc":"孫堅次女，孫策、孫權之姊，孫堅在擔任縣長期間與吳旖所生，孫靈陽與孫靈月為孿生姐妹。靈月政略過人，在早期孫堅四處征討的歲月中，就在幫助母親照顧和保護孫策，分擔后方勞務，后嫁給名門陳氏。","en":"The second daughter of Sun Jian and the elder sister of Sun Ce and Sun Quan, born to Sun Jian and Wu Yi during his tenure as a county magistrate. Sun Lingyang and Sun Lingyue were twin sisters. Possessing exceptional political acumen, Lingyue helped her mother care for and protect Sun Ce and share duties in the rear during Sun Jian's early years of constant campaigning. She later married into the distinguished Chen family.","jp":"孫堅の次女で、孫策・孫権の姉。孫堅が県長を務めていた頃に呉旖との間に生まれた子で、孫霊陽と孫霊月は双子の姉妹である。霊月は政治の才に優れ、孫堅が各地を転戦していた初期には、母を助けて孫策の世話や保護にあたり、後方の務めを分担した。後に名門の陳氏へと嫁いだ。","kr":"손견의 차녀이자 손책과 손권의 누이다. 손견이 현장을 지내던 시절 오의와의 사이에서 태어났으며, 손령양과 손령월은 쌍둥이 자매다. 령월은 정치가 뛰어났는데, 손견이 각지를 정벌하러 다니던 초기 시절부터 어머니를 도와 손책을 보살피고 보호하며 후방의 노고를 분담했고, 훗날 명문 진씨 가문으로 시집갔다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ11004","remark":"","surname":"孙","surnameTc":"孫","surnameEn":"Sun","surnameJp":"孫","surnameKr":"손","surnameOther":"","name":"灵月","nameTc":"靈月","nameEn":"Lingyue","nameJp":"霊月","nameKr":"영월","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"孙灵月","power":"WJ10038","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"2","workYear":"190","city":"CS1047","gender":"1","rule":"71","force":"55","wise":"75","politics":"81","charm":"89","will":"70","ruleTalent":"9","forceTalent":"7","wiseTalent":"9","politicsTalent":"10","charmTalent":"11","willTalent":"9","weaponMaster":"17/17/17/17/17/79/60/17","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"","battleSkill":"1004305;1000202","debateCard":"","warSoul":"S1000705","battleSoul":"1001202","debateSoul":"","warSoulPoint":"5000","battleSoulPoint":"3000","debateSoulPoint":"6000","strategy":"","strategy2":"1001505","professions":"2/0/0/3/0/3/2/1/2/1/1/1/0/2/0/5/2/1/4/3/3/2/4/1","attribute2":"79/65/80/89/89/73","morality":"4","compatible":"80","loyalty":"100","reputation":"0","evaluate":"0","title":"","rank":"7","birth":"173","show":"185","death":"250","age":"0","injury":"","deathReason":"0","type":"0","npcTag":"0","npcNum":"1","microScene":"0","isImportant":"0","speaking":"1","weapon":"WP1007202","armor":"WP1014802","helmet":"WP1013102","treasure":"","horse":"","shield":"","character":"1/1;58/1;11/1;31/1;37/1;20/2;45/2;42/2;36/2;47/1","father":"WJ10038/0","mother":"WJ11001/0","children":"","family":"WJ10030/100;WJ11003/100;WJ10393/100;WJ10020/100;WJ10617/100;WJ10621/100;WJ10040/100","mod