505"},"couple":[]},{"story":{"id":"S10915","name":{"zh":"北伐中原","en":"Northern Expedition"},"year":"227","month":"3"},"faction":"WJ10128","city":"CS1039","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[81,56,74,60,64,83],"title":-1,"rank":"8","loyalty":"100","reputation":"5350","equipment":{"weapon":"WP10019","armor":"WP1007505","helmet":"WP1022505"},"couple":[]},{"story":{"id":"S11015","name":{"zh":"再出岐山","en":"Return to Qishan"},"year":"231","month":"1"},"faction":"WJ10128","city":"CS1039","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[81,56,74,60,64,83],"title":-1,"rank":"8","loyalty":"100","reputation":"5350","equipment":{"weapon":"WP10019","armor":"WP1007505","helmet":"WP1022505"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":"WJ10128","city":"CS1039","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[81,56,74,60,64,83],"title":-1,"rank":"8","loyalty":"100","reputation":"5350","equipment":{"weapon":"WP10019","armor":"WP1007505","helmet":"WP1022505"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ10128","city":"CS1040","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[81,56,74,60,64,83],"title":-1,"rank":"8","loyalty":"100","reputation":"5350","equipment":{"weapon":"WP10019","armor":"WP1007505","helmet":"WP1022505"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1039","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[81,56,74,60,64,83],"title":-1,"rank":"9","loyalty":"0","reputation":"5150","equipment":{"weapon":"WP10019","armor":"WP1007505","helmet":"WP1022505"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10045","city":"CS1040","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[81,56,74,60,64,83],"title":-1,"rank":"9","loyalty":"120","reputation":"5150","equipment":{"weapon":"WP10019","armor":"WP1007505","helmet":"WP1022505"},"couple":[]}],"storyEvents":[],"biography":{"zh":"刘璋长子，益州少主。作为刘璋长子，本可继承益州基业。建安十八年，刘备反目南下，刘循被任命为雒城守将，与名将张任、刘璝共同负责益州北部门户的防御。这场持久战持续一年，导致庞统中箭身亡，刘备不得不从荆州调诸葛亮、张飞增援，极大延缓了蜀汉政权的建立进程。建安十九年，雒城终因粮尽援绝而破。刘循审时度势，率余部投降。刘备感其忠勇，不仅未加杀害，反而授以奉车中郎将之职，后升任谏议大夫。","tc":"劉璋長子，益州少主。作為劉璋長子，本可繼承益州基業。建安十八年，劉備反目南下，劉循被任命為雒城守將，與名將張任、劉璝共同負責益州北部門戶的防御。這場持久戰持續一年，導致龐統中箭身亡，劉備不得不從荊州調諸葛亮、張飛增援，極大延緩了蜀漢政權的建立進程。建安十九年，雒城終因糧盡援絕而破。劉循審時度勢，率余部投降。劉備感其忠勇，不僅未加殺害，反而授以奉車中郎將之職，后升任諫議大夫。","en":"The eldest son of Liu Zhang and the young heir of Yi Province. As Liu Zhang's firstborn, he was poised to inherit the Yi Province domain. In the eighteenth year of Jian'an (213 AD), when Liu Bei turned against Liu Zhang and marched south, Liu Xun was appointed commander of Luocheng, sharing responsibility for the defense of Yi Province's northern gateway with the renowned general Zhang Ren and Liu Gui. The prolonged siege lasted a year, during which Pang Tong was killed by an arrow, forcing Liu Bei to summon Zhuge Liang and Zhang Fei as reinforcements from Jing Province, significantly delaying the establishment of the Shu-Han regime. In the nineteenth year of Jian'an (214 AD), Luocheng finally fell after supplies were exhausted and no relief came. Liu Xun assessed the situation and surrendered with his remaining troops. Liu Bei, respecting his valor and loyalty, not only spared his life but appointed him General of the Imperial Carriage and later promoted him to Negotiator.","jp":"劉璋の長男で、益州の若君。劉璋の長子として本来は益州の基盤を継ぐ立場にあった。建安十八年、劉備が反目して南下すると、劉循は雒城の守将に任命され、名将である張任や劉璝らと共に益州北部の玄関口の防御を担った。この持久戦は一年に及び、龐統が矢に当たって戦死し、劉備は荊州から諸葛亮や張飛らの援軍を呼び寄せることを余儀なくされ、蜀漢政権樹立の歩みを大いに遅らせた。建安十九年、雒城はついに兵糧が尽き援軍も絶たれて陥落した。劉循は時勢を見極めて残部を率いて降伏した。劉備はその忠勇を評価し、処刑しなかっただけでなく奉車中郎将に任じ、後に諫議大夫へと昇進させた。","kr":"유장의 장남이자 익주의 소주. 유장의 장남으로서 본래 익주의 가업을 계승할 수 있었다. 건안 18년, 유비가 반목하여 남하하자 유순은 낙성의 수장으로 임명되어 명장 장임, 유괴와 함께 익주 북부 관문의 방어를 도맡았다. 이 지구전은 1년 동안 이어져 방통이 화살에 맞아 목숨을 잃었고, 유비는 형주에서 제갈량과 장비를 증원군으로 불러와야 했기에 촉한 정권의 건국 과정을 크게 지연시켰다. 건안 19년, 낙성은 끝내 군량이 바닥나고 원군마저 끊겨 함락되었다. 유순은 형세를 살펴 남은 군사를 이끌고 항복했다. 유비는 그 충용을 가상히 여겨 해치지 않았을 뿐만 아니라 오히려 봉거중랑장의 직위를 내렸으며, 훗날 간의대부로 승진시켰다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10615","remark":"","surname":"刘","surnameTc":"劉","surnameEn":"Liu","surnameJp":"劉","surnameKr":"유","surnameOther":"","name":"循","nameTc":"循","nameEn":"Xun","nameJp":"循","nameKr":"순","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"刘循","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"0","workYear":"198","city":"CS1039","gender":"0","rule":"81","force":"56","wise":"74","politics":"60","charm":"64","will":"83","ruleTalent":"6","forceTalent":"4","wiseTalent":"6","politicsTalent":"4","charmTalent":"6","willTalent":"9","weaponMaster":"19/19/51/19/19/13/50/19","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"1006702;1005502","battleSkill":"","debateCard":"","warSoul":"S1004705;S1002005","battleSoul":"","debateSoul":"","warSoulPoint":"7000","battleSoulPoint":"2100","debateSoulPoint":"1600","strategy":"1002408","strategy2":"","professions":"2/2/0/4/0/0/1/1/0/1/3/2/3/4/5/0/2/1/0/0/0/0/0/0","attribute2":"50/50/50/50/50/50","morality":"4","compatible":"36","loyalty":"0","reputation":"5150","evaluate":"0","title":"","rank":"9","birth":"184","show":"198","death":"239","age":"0","injury":"","deathReason":"0","type":"1","npcTag":"0","npcNum":"1","microScene":"0","isImportant":"0","speaking":"3","weapon":"WP10019","armor":"WP1007505","helmet":"WP1022505","treasure":"","horse":"","shield":"","character":"0/1;1/1;21/2;26/3;31/1;27/1;38/1;57/1","father":"WJ10046/0","mother":"","children":"","family":"WJ11025/100","modInfo":"","brother":"","couple":"","otherRelatio