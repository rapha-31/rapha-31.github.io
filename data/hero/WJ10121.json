":"2","description2":{"zh":"对自身50米范围内的敌人造成2.5倍武力差伤害，中等概率引发混战。","en":"Deals 2.5x STR-diff damage to enemies within 50m of self. Medium chance to trigger Melee."},"shortName":{"zh":"横千","en":"Sweep Legions"}}],"battleCards":[{"id":"1001802","name":{"zh":"嘲讽","en":"Taunt"},"level":"1","description2":{"zh":"对战场上的敌人发起嘲讽。短时间内，若自身处于敌人攻击范围内，则会成为敌人的优先攻击目标。","en":"Taunt enemies on the field. Briefly become their priority target while within enemy attack range."},"ap":"1","mp":"150"},{"id":"1002200","name":{"zh":"霸王拔山","en":"Hegemon's Might"},"level":"2","description2":{"zh":"长柄绝学之一，将武器插于地面后进行蓄能一击，提升自身防御力。","en":"A polearm art: plant the weapon into the ground to deliver a charged strike, raising your own Defense."},"ap":"4","mp":"1100"},{"id":"1004502","name":{"zh":"自疗决","en":"Self-Heal Mantra"},"level":"1","description2":{"zh":"习武之人中较为常见的活血秘术，使自身在接下来的两个回合开始阶段恢复少量生命值。","en":"A blood-invigorating secret art fairly common among martial artists, causing you to recover a small amount of HP at the start of the next two turns."},"ap":"2"}],"debateCards":[],"warSouls":[{"id":"S1002605","name":{"zh":"强攻[大]","en":"Assault [Great]"},"level":"1","description2":{"zh":"攻击提高22%","en":"Attack increased by 22%"}}],"battleSouls":[{"id":"1003102","name":{"zh":"中流砥柱","en":"Pillar"},"level":"2","description2":{"zh":"自身反伤率提高35%，回合开始，若处于嘲讽状态，获得1点行动AP和回复5%生命","en":"Own Damage Reflect +35%, at the start of the turn, if under Taunt status, gain 1 AP and restore 5% HP"}}],"debateSouls":[],"soulPoints":{"war":7000,"battle":7500,"debate":2300},"equipment":[{"id":"WP1006002","name":{"zh":"竹柄木枪","en":"Bamboo-Shaft Wooden Spear"},"level":"2","description":{"zh":"虽是竹制兵器，但是意外的结实耐用。","en":"Though made of bamboo, it is surprisingly sturdy and durable."},"atkVal":"8","price":"7000","slot":{"zh":"武器","en":"Weapon"}},{"id":"WP1003705","name":{"zh":"铁札将军铠","en":"Iron Lamellar General Armor"},"level":"2","description":{"zh":"在铁札甲基础上增添了披风和吞肩兽，多为统军者、统领者所穿戴。","en":"Iron lamellar armor enhanced with a cloak and beast-head pauldrons, typically worn by army commanders and leaders."},"defenceVal":"9","mp":"400","price":"7200","slot":{"zh":"护甲","en":"Armor"}},{"id":"WP1021305","name":{"zh":"金铆陷阵盔","en":"Gold-Rivet Shock Helm"},"level":"2","description":{"zh":"在盔沿添加了镀金铆扣的陷阵盔，方便在战场上表明自己的身份。","en":"A vanguard helm with gilded rivets on the brim, helping identify the wearer on the battlefield."},"defenceVal":"7","price":"7000","slot":{"zh":"头盔","en":"Helmet"}},{"id":"WP29001","name":{"zh":"战马","en":"Warhorse"},"level":"1","description":{"zh":"战场上必不可少的身影。","en":"An indispensable presence on the battlefield."},"price":"2000","slot":{"zh":"坐骑","en":"Mount"}}],"family":{"father":{"label":{"zh":"父亲","en":"Father"},"people":[{"id":"WJ10013","code":"0"}]},"children":{"label":{"zh":"子女","en":"Children"},"people":[{"id":"WJ10703","code":"100"}]},"family":{"label":{"zh":"亲属","en":"Relatives"},"people":[{"id":"WJ10661","code":"100"},{"id":"WJ10228","code":"100"}]}},"clans":[{"id":"GI111615","name":{"zh":"涿郡张氏","en":"The Zhang Clan of Zhuo Commandery"},"years":["209","999"],"desc":{"zh":"出自姬姓，黄帝之后。张飞世居涿郡，刘备称帝后进封西乡侯，家族显赫。蜀汉核心将门、外戚。张飞为“万人敌”，蜀汉元勋；两女为刘禅皇后；子张绍袭爵，孙张遵尽忠死节。","en":"Originating from the Ji surname, descendants of the Yellow Emperor. Zhang Fei's Family resided in Zhuo Commandery for generations. After Liu Bei proclaimed Emperor, Zhang Fei was promoted and enfeoffed as Marquis of Xixiang, elevating his Family to great prominence. A core military lineage and imperial in-laws of Shu Han. Renowned as a ‘match for ten thousand men,’ Zhang Fei was a founding pillar of Shu Han, his two daughters both served as Empresses to Liu Shan, his son Zhang Shao inherited his title, and his grandson Zhang Zun died a martyr in steadfast loyalty."},"talent":{"military":"8","commerce":"4","politics":"5"}}],"friendGroups":[],"body":null,"honorifics":[],"selfAddress":[],"specialNames":[[["WJ10121","WJ10012","伯父"],["WJ10121","WJ10012","伯父"],["WJ10121","WJ10012","Elder Uncle"],["WJ10121","WJ10012","伯父上"],["WJ10121","W