:1},{"zh":"征兵","en":"Conscription","value":3},{"zh":"练兵","en":"Drill","value":0},{"zh":"治安","en":"Order","value":1},{"zh":"巡访","en":"Outreach","value":1},{"zh":"城防","en":"Fortification","value":1},{"zh":"探索","en":"Explore","value":2},{"zh":"外交","en":"Diplomacy","value":0},{"zh":"辩才","en":"Eloquence","value":1},{"zh":"潜伏","en":"Stealth","value":3},{"zh":"科研","en":"Research","value":0},{"zh":"医术","en":"Medicine","value":0},{"zh":"酒力","en":"Drinking","value":0},{"zh":"旅游","en":"Travel","value":1},{"zh":"驯兽","en":"Taming","value":1}],"traits":[{"id":2,"level":1},{"id":15,"level":1},{"id":21,"level":1},{"id":24,"level":1},{"id":29,"level":1},{"id":38,"level":1},{"id":57,"level":1},{"id":26,"level":2},{"id":43,"level":2},{"id":42,"level":2}],"values":{"morality":"3","alignment":"2000","affinity":"22","loyalty":"0","reputation":"0","belief":"0"},"officialTitle":null,"officialRank":{"index":9,"name":{"zh":"九品官","en":"Ninth Rank"}},"personalTitles":[{"id":"1013915","name":{"zh":"四世三公","en":"Four Generations of the Three Excellencies"},"level":"2","description":{"zh":"◆ 自身外交能力增加10%\n\n◆ 自身登用能力增加10%","en":"◆ Own Diplomacy Ability +10%\n\n\n\n◆ Own Recruitment Ability +10%"},"effect":"33/0//10;32/0//10"}],"strategies":[],"warSkills":[],"battleCards":[],"debateCards":[],"warSouls":[],"battleSouls":[],"debateSouls":[],"soulPoints":{"war":3800,"battle":1800,"debate":5000},"equipment":[{"id":"WP1007102","name":{"zh":"竹简","en":"Bamboo Slip"},"level":"1","description":{"zh":"与木简一样用来记载文字的竹简，竹简在南方更为常见。","en":"Bamboo slips used for writing like wooden slips, more common in the south."},"atkVal":"3","hp":"110","mp":"160","price":"2000","slot":{"zh":"武器","en":"Weapon"}},{"id":"WP1014705","name":{"zh":"披肩衣","en":"Shoulder Wrap Garment"},"level":"0","description":{"zh":"在粗布衣的基础上增添了披肩作为装饰，曾在中原一带流行。","en":"Coarse clothing enhanced with a shoulder wrap for decoration, once fashionable in the Central Plains."},"defenceVal":"1","mp":"150","price":"300","slot":{"zh":"护甲","en":"Armor"}},{"id":"WP1024605","name":{"zh":"儒巾","en":"Confucian Kerchief"},"level":"1","description":{"zh":"学府中最常见的巾帻，掌柜文书等要职的官员也有佩戴。","en":"The most common headcloth in academies, also worn by officials holding key posts in charge of records and documents."},"defenceVal":"2","mp":"850","price":"2800","slot":{"zh":"头盔","en":"Helmet"}}],"family":{"father":{"label":{"zh":"父亲","en":"Father"},"people":[{"id":"WJ1042415","code":"0"}]}},"clans":[{"id":"GI100515","name":{"zh":"弘农杨氏","en":"The Yang clan of Hongnong"},"years":["0","999"],"desc":{"zh":"出自姬姓，晋武公之子伯侨封于杨，后裔以邑为氏，弘农郡顶级望族。“四世三公”，与袁氏并称。杨震“关西孔子”开基，杨彪、杨修显于汉末，为关中第一望族。南北朝至隋唐，多有人自托弘农杨氏后裔。隋文帝杨坚家族承袭“弘农杨氏”身份，建立隋朝。唐朝时期，弘农杨氏有十一人拜相，被称为“十一宰相”之家，杨贵妃亦出自该族 。","en":"Originating from the Ji surname, when Boqiao, son of Duke Wu of Jin, was enfeoffed at Yang, his descendants took the fief as their clan name, becoming the preeminent noble lineage of Hongnong Commandery. Renowned for ‘Four Generations of the Three Excellencies’, they were spoken of alongside the Yuan clan. Yang Zhen, ‘the Confucius of the West’, laid their foundation, while Yang Biao and Yang Xiu flourished during the late Han, making them the foremost clan of Guanzhong. From the Northern and Southern Dynasties through the Sui and Tang, many claimed descent from the Yang clan of Hongnong. The family of Emperor Wen of Sui, Yang Jian, inherited the mantle of the ‘Yang clan of Hongnong’ and founded the Sui dynasty. During the Tang dynasty, eleven of their kin were appointed Chancellor, earning renown as the family of the ‘Eleven Chancellors’, and Imperial Consort Yang also hailed from this lineage."},"talent":{"military":"2","commerce":"6","politics":"10"}}],"friendGroups":[],"body":{"name":"杨众","height":"较矮","shape":"一般"},"honorifics":[],"selfAddress":[],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"25","startPregnantAge":"0"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":null,