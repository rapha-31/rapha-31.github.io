ar":"227","month":"3"},"faction":null,"city":"CS1029","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[56,54,64,67,70,76],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1007102","armor":"WP1014705","helmet":"WP1024605"},"couple":[]},{"story":{"id":"S11015","name":{"zh":"再出岐山","en":"Return to Qishan"},"year":"231","month":"1"},"faction":null,"city":"CS1029","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[56,54,64,67,70,76],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1007102","armor":"WP1014705","helmet":"WP1024605"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":null,"city":"CS1029","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[56,54,64,67,70,76],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1007102","armor":"WP1014705","helmet":"WP1024605"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1029","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[56,54,64,67,70,76],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1007102","armor":"WP1014705","helmet":"WP1024605"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1029","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[56,54,64,67,70,76],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP1007102","armor":"WP1014705","helmet":"WP1024605"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10957","city":"CS1030","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[56,54,64,67,70,76],"title":-1,"rank":"9","loyalty":"82","reputation":"0","equipment":{"weapon":"WP1007102","armor":"WP1014705","helmet":"WP1024605"},"couple":[]}],"storyEvents":[],"biography":{"zh":"东汉大臣，太尉杨震曾孙、杨奉之孙、杨敷之子，西晋三杨祖父。出身弘农杨氏，传习先祖学业，初任谒者仆射，后随汉献帝西入函谷关，累迁至御史中丞。汉献帝率公卿东返时，杨众随其乘船渡过黄河，后率官员属吏步行至太阳县，被任命为侍中。汉献帝追论其此前功劳，封杨众为‘蓩亭侯’。","tc":"東漢大臣，太尉楊震曾孫、楊奉之孫、楊敷之子，西晉三楊祖父。出身弘農楊氏，傳習先祖學業，初任謁者仆射，后隨漢獻帝西入函谷關，累遷至御史中丞。漢獻帝率公卿東返時，楊眾隨其乘船渡過黃河，后率官員屬吏步行至太陽縣，被任命為侍中。漢獻帝追論其此前功勞，封楊眾為‘蓩亭侯’。","en":"A minister of the Eastern Han dynasty, great-grandson of Chief Officer Yang Zhen, grandson of Yang Feng, son of Yang Fu, and grandfather of the ‘Three Yangs’ of Western Jin. Coming from the Yang clan of Hongnong, he carried on his ancestors' scholarly traditions. He initially served as Snr Advisor, and later accompanied Emperor Xian of Han west through Hangu Gate, rising through successive promotions to Chief of Records. When Emperor Xian led his ministers east in return, Yang Zhong accompanied him across the Yellow River by boat, then led the officials and subordinates on foot to Taiyang County, where he was appointed Commandant. Later, reflecting on his past merits, Emperor Xian enfeoffed Yang Zhong as the ‘Marquis of Mou Pavilion’.","jp":"後漢の大臣。太尉・楊震の曾孫、楊奉の孫、楊敷の子であり、西晋の「三楊」の祖父。弘農楊氏の出身で、先祖の学業を受け継ぎ、はじめ謁者僕射に任じられた。のちに献帝に従って西の函谷関に入り、昇進を重ねて御史中丞に至った。献帝が公卿を率いて東へ帰還した際、楊衆はこれに従って船で黄河を渡り、のちに官吏らを率いて太陽県まで徒歩で進み、侍中に任じられた。献帝はそれまでの功績を追論し、楊衆を「蓩亭侯」に封じた。","kr":"동한의 대신으로, 태위 양진의 증손이자 양봉의 손자, 양부의 아들이며 서진 삼양의 조부입니다. 홍농 양씨 출신으로 선조의 학문을 이어받아 처음에 알자복야를 지냈고, 이후 헌제를 따라 서쪽으로 함곡관에 들어갔으며 승진을 거듭하여 어사중승에 이르렀습니다. 헌제가 공경들을 이끌고 동쪽으로 귀환할 때, 양중은 헌제를 수행하여 배를 타고 황하를 건넜으며 이후 관원과 속리들을 이끌고 태양현까지 도보로 이동하여 시중에 임명되었습니다. 헌제는 지난 공로를 기려 양중을 '무정후'에 봉했습니다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ1042515","remark":"","surname":"杨","surnameTc":"楊","surnameEn":"Yang","surnameJp":"楊","surnameKr":"양","surnameOther":"","name":"众","nameTc":"眾","nameEn":"Zhong","nameJp":"衆","nameKr":"중","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"杨众","p