ritical":"4","price":"10000","slot":{"zh":"武器","en":"Weapon"}},{"id":"WP1011805","name":{"zh":"山纹陷阵铠","en":"Mountain Pattern Vanguard Armor"},"level":"2","description":{"zh":"在山纹甲基础上增添了披风和吞肩兽，多为统军者、统领者所穿戴。此甲曾为陷阵营统领者所穿戴。","en":"Mountain-pattern armor with an added cloak and beast-head pauldrons, mostly worn by commanders. This armor was once worn by the commander of the Xianzhen Battalion."},"defenceVal":"10","evade":"2","price":"12000","slot":{"zh":"护甲","en":"Armor"}},{"id":"WP1023905","name":{"zh":"翡翠屋山帻","en":"Jade Ridge Cap"},"level":"2","description":{"zh":"在帻沿中间带有玉石装饰的屋山帻，方便在战场上表明自己的身份。","en":"A ridged cap with jade decoration at the center of the brim, helping identify the wearer on the battlefield."},"defenceVal":"3","hp":"850","price":"6000","slot":{"zh":"头盔","en":"Helmet"}},{"id":"WP29001","name":{"zh":"战马","en":"Warhorse"},"level":"1","description":{"zh":"战场上必不可少的身影。","en":"An indispensable presence on the battlefield."},"price":"2000","slot":{"zh":"坐骑","en":"Mount"}}],"family":{"family":{"label":{"zh":"亲属","en":"Relatives"},"people":[{"id":"WJ10900","code":"100"}]}},"clans":[{"id":"GI111515","name":{"zh":"河东关氏","en":"The Guan Clan of Hedong"},"years":["200","264"],"desc":{"zh":"出自姬姓，周太王古公亶父之后。关羽为河东解人，蜀汉核心将门。关公为“万人敌”，蜀汉元勋；其子关兴承袭爵位；孙关统娶公主，一门在蜀汉地位尊崇。","en":"Originating from the Ji clan, descendants of King Tai of Zhou, Gugong Danfu. Guan Yu was a native of Xie in Hedong, heading a core military Family of Shu Han. Lord Guan was known as ‘a match for ten thousand men’ and a founding stalwart of Shu Han, his son Guan Xing inherited his noble rank, his grandson Guan Tong married an imperial princess. The Family held an exalted status throughout Shu Han."},"talent":{"military":"8","commerce":"3","politics":"4"}}],"friendGroups":[{"story":"S10315","members":["WJ10202","WJ10012","WJ10013","WJ10011"]},{"story":"S10302","members":["WJ10202","WJ10012","WJ10013","WJ10011"]},{"story":"S10602","members":["WJ10202","WJ10012","WJ10013","WJ10011"]},{"story":"S10502","member