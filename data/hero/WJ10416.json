":"WP1027005"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":"WJ10128","city":"CS1039","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[28,9,74,79,71,70],"title":-1,"rank":"8","loyalty":"100","reputation":"4100","equipment":{"weapon":"WP1007002","armor":"WP1014005","helmet":"WP1027005"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ10128","city":"CS1039","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[28,9,74,79,71,70],"title":-1,"rank":"8","loyalty":"100","reputation":"4100","equipment":{"weapon":"WP1007002","armor":"WP1014005","helmet":"WP1027005"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1046","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[28,9,74,79,71,70],"title":-1,"rank":"9","loyalty":"0","reputation":"1850","equipment":{"weapon":"WP1007002","armor":"WP1014005","helmet":"WP1027005"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10128","city":"CS1039","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[28,9,74,79,71,70],"title":-1,"rank":"9","loyalty":"100","reputation":"1850","equipment":{"weapon":"WP1007002","armor":"WP1014005","helmet":"WP1027005"},"couple":[]}],"storyEvents":[],"biography":{"zh":"蜀汉大臣、侍中。出身南阳士族，早年在刘表麾下任文学从事，以校勘典籍闻名。刘备入蜀后，经同乡费祎引荐加入蜀汉阵营，被刘备任命为黄门侍郎，负责教导太子刘禅。诸葛亮在《出师表》中将郭攸之列为首位推荐大臣，称其志虑忠纯，并强调宫中之事，事无大小，悉以咨之。诸葛亮北伐期间负责辅佐成都的朝政。在董允、费祎等能臣去世后，其与陈祗等人共同辅政，官至光禄大夫。","tc":"蜀漢大臣、侍中。出身南陽士族，早年在劉表麾下任文學從事，以校勘典籍聞名。劉備入蜀后，經同鄉費祎引薦加入蜀漢陣營，被劉備任命為黃門侍郎，負責教導太子劉禪。諸葛亮在《出師表》中將郭攸之列為首位推薦大臣，稱其志慮忠純，并強調宮中之事，事無大小，悉以咨之。諸葛亮北伐期間負責輔佐成都的朝政。在董允、費祎等能臣去世后，其與陳祗等人共同輔政，官至光祿大夫。","en":"A minister and Commandant of Shu Han. Hailing from the gentry of Nanyang, he served as a Literary Attendant under Liu Biao in his early years, renowned for collating classical texts. After Liu Bei entered Shu, he was recommended by his townsman Fei Yi to join Shu Han and was appointed Attendant by Liu Bei to tutor Crown Prince Liu Shan. In his ‘Memorial on Taking the Field,’ Zhuge Liang placed Guo Youzhi at the head of his recommended ministers, praising his pure and devoted heart and urging that ‘all palace affairs, great or small, ought to be consulted with him.’ During Zhuge Liang's Northern Expeditions, Guo Youzhi oversaw court affairs in Chengdu. Following the deaths of capable ministers such as Dong Yun and Fei Yi, he assisted in governing alongside Chen Zhi and others, ultimately rising to Minister of Oration.","jp":"蜀漢の重臣、侍中。南陽の士族出身。若くして劉表の配下で「文学従事」を務め、典籍の校勘で名を馳せた。劉備の入蜀後、同郷の費禕の推挙により蜀漢陣営に加わり、劉備から黄門侍郎に任ぜられて太子劉禅の教育を任された。諸葛亮は『出師の表』において郭攸之を筆頭に推薦し、その人柄を「志慮忠純」と評して「宮中の事は、事の大小を問わず、悉くこれに諮るべし」と強調した。諸葛亮の北伐中は成都の朝政補佐を務めた。董允や費禕ら能臣の没後は、陳祗らとともに国政を補佐し、官位は光禄大夫に至った。","kr":"촉한의 대신이자 시중이다. 남양의 사족 출신으로, 젊은 시절 유표 휘하에서 문학종사를 지내며 전적을 교감한 것으로 명성을 떨쳤다. 유비가 입촉한 뒤 동향인 비의의 천거로 촉한 진영에 합류하였고, 유비에게 황문시랑으로 임명되어 태자 유선을 가르치는 일을 맡았다. 제갈량은 《출사표》에서 곽유지를 첫머리에 추천하며 그의 뜻과 생각이 충성스럽고 순수하다(志慮忠純)고 평하였고, 궁중의 일은 크고 작음을 막론하고 모두 그에게 자문해야 한다고 강조했다. 제갈량의 북벌 기간에는 성도의 조정을 보좌했다. 동윤, 비의 등 유능한 신하들이 세상을 떠난 뒤에는 진지 등과 함께 조정을 보좌하였으며, 관직은 광록대부에 이르렀다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10416","remark":"","surname":"郭","surnameTc":"郭","surnameEn":"Guo","surnameJp":"郭","surnameKr":"곽","surnameOther":"","name":"攸之","nameTc":"攸之","nameEn":"Youzhi","nameJp":"攸之","nameKr":"유지","nameOther":"","word":"演长","wordTc":"演長","wordEn":"Yanzhang","wordJp":"演長","wordKr":"연장","wordOther":"","icon":"郭攸之","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"0","workYear":"209","city":"CS1046","gender":"0","rule":"28","force":"9","wise":"74","politics":"79","charm":"71","will":"70","ruleTa