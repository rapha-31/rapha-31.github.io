100","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1015702","helmet":"WP1013202"},"couple":[]},{"story":{"id":"S10915","name":{"zh":"北伐中原","en":"Northern Expedition"},"year":"227","month":"3"},"faction":"WJ11050","city":"CS1066","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[78,41,83,68,84,68],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1015702","helmet":"WP1013202"},"couple":[]},{"story":{"id":"S11015","name":{"zh":"再出岐山","en":"Return to Qishan"},"year":"231","month":"1"},"faction":"WJ11050","city":"CS1066","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[78,41,83,68,84,68],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1015702","helmet":"WP1013202"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":"WJ11050","city":"CS1066","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[78,41,83,68,84,68],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1015702","helmet":"WP1013202"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ11051","city":"CS1066","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[78,41,83,68,84,68],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1015702","helmet":"WP1013202"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1066","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[78,41,83,68,84,68],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1015702","helmet":"WP1013202"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ11050","city":"CS1066","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[78,41,83,68,84,68],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP10014","armor":"WP1015702","helmet":"WP1013202"},"couple":[]}],"storyEvents":[],"biography":{"zh":"卑弥呼手下的千名侍女之一，幼时因灵慧被选入宫中，原为卑弥呼手下负责农业的大夫，后被选为六名被献给魏明帝的生口之一。松殿为人安静勤奋，被安排的事务多半提前完成，故在进入魏国后很快成为了宫内引人注目的婢女。魏明帝见贡礼丰厚，大悦，诏封卑弥呼为“亲魏倭王”。","tc":"卑彌呼手下的千名侍女之一，幼時因靈慧被選入宮中，原為卑彌呼手下負責農業的大夫，后被選為六名被獻給魏明帝的生口之一。松殿為人安靜勤奮，被安排的事務多半提前完成，故在進入魏國后很快成為了宮內引人注目的婢女。魏明帝見貢禮豐厚，大悅，詔封卑彌呼為“親魏倭王”。","en":"One of Himiko's thousand handmaidens. Recognized for her intelligence in childhood, she was selected for palace service. Originally a minister of agriculture under Himiko, she was later chosen as one of the six captives offered as tribute to Emperor Ming of Wei. Matsudono was quiet and diligent by nature, typically completing her assigned tasks ahead of schedule. After entering Wei, she quickly became a prominent maidservant in the palace. Emperor Ming, delighted by the generous tribute, conferred upon Himiko the title of ‘Queen of Wa, Friend of Wei.’","jp":"卑弥呼に仕える千人の侍女の一人。幼少期より聡明さを見出されて宮中に入り、元は卑弥呼の下で農業を司る大夫を務めていたが、後に魏の明帝へ献上される六人の生口の一人に選ばれた。松殿は物静かで勤勉な人柄であり、任された役目は前倒しで果たすことが多かったため、魏へ渡った後もすぐに宮中で目を引く侍女となった。魏の明帝は手厚い貢物に大いに喜び、詔を下して卑弥呼を「親魏邪馬台王」に封じた。","kr":"히미코 휘하의 시녀 천 명 중 한 사람으로, 어려서 영민하여 궁에 발탁되었다. 본래 히미코 휘하에서 농업을 관장하던 대부였으나, 훗날 위 명제에게 바쳐질 여섯 생구 중 하나로 선발되었다. 마츠도노는 성품이 조용하고 근면하여 맡겨진 일을 대부분 기한보다 앞서 마쳤기에, 위나라로 건너간 뒤 궁내에서 금세 눈에 띄는 비녀가 되었다. 위 명제는 공물이 풍성한 것을 보고 크게 기뻐하며, 조서를 내려 히미코를 '친위왜왕'에 봉했다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ20137","remark":"","surname":"松","surnameTc":"松","surnameEn":"Song","surnameJp":"松","surnameKr":"송","surnameOther":"","name":"殿","nameTc":"殿","nameEn":"Dian","nameJp":"殿","nameKr":"전","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"松殿","power":"WJ11050","rejectPower":"","rejec