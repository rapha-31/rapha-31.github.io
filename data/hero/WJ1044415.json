023605","horse":"WP29009"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1075","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[72,69,53,45,64,57],"title":-1,"rank":"9","loyalty":"0","reputation":"0","equipment":{"weapon":"WP12006","armor":"WP1005805","helmet":"WP1023605","horse":"WP29009"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1075","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[72,69,53,45,64,57],"title":1,"rank":"1","loyalty":"0","reputation":"0","equipment":{"weapon":"WP12006","armor":"WP1005805","helmet":"WP1023605","horse":"WP29009"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10172","city":"CS1075","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[72,69,53,45,64,57],"title":1,"rank":"1","loyalty":"100","reputation":"0","equipment":{"weapon":"WP12006","armor":"WP1005805","helmet":"WP1023605","horse":"WP29009"},"couple":[]}],"storyEvents":[],"biography":{"zh":"南匈奴单于，在位期间最重要的事是出兵助汉平叛。中平四年，前中山相张纯联合鲜卑造反，汉灵帝下诏征发南匈奴骑兵。羌渠派儿子於夫罗率兵前往幽州。然而，匈奴部众担心无休止的征发，于中平五年发动叛乱，联合屠各胡共十余万人攻杀了羌渠。","tc":"南匈奴單于，在位期間最重要的事是出兵助漢平叛。中平四年，前中山相張純聯合鮮卑造反，漢靈帝下詔征發南匈奴騎兵。羌渠派兒子於夫羅率兵前往幽州。然而，匈奴部眾擔心無休止的征發，于中平五年發動叛亂，聯合屠各胡共十余萬人攻殺了羌渠。","en":"Chanyu of the South Xiongnu, whose most significant act during his reign was dispatching troops to aid the Han in suppressing rebellions. In the fourth year of Zhongping, Zhang Chun, former Chancellor of Zhongshan, allied with the Xianbei in rebellion, prompting Emperor Ling of Han to issue an imperial decree levying South Xiongnu cavalry. Qiangqu dispatched his son Yufuluo to lead troops to You Province. However, fearing ceaseless levies, the Xiongnu tribesmen revolted in the fifth year of Zhongping, joining with over 100,000 Tuge Hu warriors to attack and kill Qiangqu.","jp":"南匈奴の単于。在位中の最も重要な事績は、漢を助けて反乱鎮圧に出兵したことである。中平4年、元中山相の張純が鮮卑と結んで反乱を起こすと、漢の霊帝は詔を下して南匈奴の騎兵を徴発した。羌渠は子の於夫羅に兵を率いさせて幽州へと派遣した。しかし、際限なき徴発を恐れた匈奴の部衆は中平5年に反乱を起こし、屠各胡と連合した計10万余人によって羌渠は攻め殺された。","kr":"남흉노의 선우로, 재위 기간 중 가장 중요한 행적은 한나라를 도와 반란을 평정하기 위해 군사를 파견한 일이다. 중평 4년, 전 중산상 장순이 선비와 연합하여 반란을 일으키자, 한 영제는 조서를 내려 남흉노 기병을 징발했다. 강거는 아들 어부라에게 군사를 이끌고 유주로 향하게 했다. 그러나 흉노 부족민들은 끝없는 징발을 우려하여 중평 5년에 반란을 일으켰고, 도각호와 연합한 10여만 무리로 강거를 공격해 살해했다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ1044415","remark":"粗壮","surname":"","surnameTc":"","surnameEn":"","surnameJp":"","surnameKr":"","surnameOther":"","name":"羌渠","nameTc":"羌渠","nameEn":"Qiangqu","nameJp":"羌渠","nameKr":"강거","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"羌渠","power":"WJ10172","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"2","workYear":"184","city":"CS1075","gender":"0","rule":"72","force":"69","wise":"53","politics":"45","charm":"64","will":"57","ruleTalent":"8","forceTalent":"7","wiseTalent":"3","politicsTalent":"4","charmTalent":"7","willTalent":"7","weaponMaster":"31/36/39/69/36/30/29/34","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"1005402","battleSkill":"","debateCard":"","warSoul":"","battleSoul":"","debateSoul":"","warSoulPoint":"5400","battleSoulPoint":"4200","debateSoulPoint":"500","strategy":"1000301;1015615","strategy2":"1005001","professions":"2/0/4/3/0/0/2/0/0/0/3/2/0/0/0/0/0/0/0/0/0/3/2/3","attribute2":"50/50/50/50/50/50","morality":"2","compatible":"4","loyalty":"0","reputation":"0","evaluate":"-7000","title":"1","rank":"1","birth":"135","show":"184","death":"187","age":"0","injury":"","deathReason":"1","type":"1","npcTag":"0","npcNum":"1","microScene":"0","isImportant":"0","speaking":"4","weapon":"WP12006","armor":"WP1005805","helmet":"WP1023605","treasur