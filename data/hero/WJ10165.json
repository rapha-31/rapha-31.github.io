000","slot":{"zh":"坐骑","en":"Mount"}}],"family":{"family":{"label":{"zh":"亲属","en":"Relatives"},"people":[{"id":"WJ10257","code":"100"},{"id":"WJ10133","code":"100"}]}},"clans":[{"id":"GI105915","name":{"zh":"东海糜氏\t","en":"The Mi clan of Donghai"},"years":["0","999"],"desc":{"zh":"出自夏代，以职业和封地为姓。世代经商，僮客万人，资产巨亿。徐州巨富，糜竺倾家财助刘备，位在诸葛亮之上。为刘备早期核心支持者，对蜀汉奠基贡献巨大。","en":"Originating from the Xia dynasty, taking their surname from occupation and fief. Engaged in Commerce for generations, they possessed ten thousand servants and retainers and wealth numbering hundreds of millions. A tycoon of Xu Province, Mi Zhu expended his family fortune to aid Liu Bei and ranked above Zhuge Liang. As a core early supporter of Liu Bei, he contributed enormously to laying the foundation of Shu Han."},"talent":{"military":"2","commerce":"10","politics":"5"}}],"friendGroups":[{"story":"S10802","members":["WJ10068","WJ1014802","WJ10323","WJ10322"]},{"story":"S10615","members":["WJ10068","WJ1014802","WJ10323","WJ10322"]},{"story":"S10402","members":["WJ10068","WJ1014802","WJ10323","WJ10322"]},{"story":"S10415","members":["WJ10068","WJ1014802","WJ10323","WJ10322"]},{"story":"S10202","members":["WJ10011","WJ10138","WJ10352","WJ10133","WJ1014802","WJ10183","WJ10257","WJ10322","WJ10323","WJ10577","WJ10012","WJ10013"]},{"story":"S10715","members":["WJ10011","WJ10138","WJ10352","WJ10133","WJ1014802","WJ10183","WJ10257","WJ10322","WJ10323","WJ10577","WJ10012","WJ10013"]},{"story":"S10102","members":["WJ10011","WJ10138","WJ10352","WJ10133","WJ1014802","WJ10183","WJ10257","WJ10322","WJ10323","WJ10577","WJ10012","WJ10013"]},{"story":"S10315","members":["WJ10011","WJ10138","WJ10352","WJ10133","WJ1014802","WJ10183","WJ10257","WJ10322","WJ10323","WJ10012","WJ10013","WJ10017","WJ10111","WJ10014","WJ10018"]},{"story":"S10302","members":["WJ10011","WJ10138","WJ10352","WJ10133","WJ1014802","WJ10183","WJ10257","WJ10322","WJ10323","WJ10012","WJ10013","WJ10017","WJ10111","WJ10014","WJ10018"]},{"story":"S10602","members