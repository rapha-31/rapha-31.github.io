,78],"title":-1,"rank":"9","loyalty":"0","reputation":"1950","equipment":{"weapon":"WP18005","armor":"WP1000505","helmet":"WP1026005"},"couple":[]},{"story":{"id":"S11015","name":{"zh":"再出岐山","en":"Return to Qishan"},"year":"231","month":"1"},"faction":null,"city":"CS1035","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[78,71,75,65,76,78],"title":-1,"rank":"9","loyalty":"0","reputation":"1950","equipment":{"weapon":"WP18005","armor":"WP1000505","helmet":"WP1026005"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":null,"city":"CS1035","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[78,71,75,65,76,78],"title":-1,"rank":"9","loyalty":"0","reputation":"1950","equipment":{"weapon":"WP18005","armor":"WP1000505","helmet":"WP1026005"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1035","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[78,71,75,65,76,78],"title":-1,"rank":"9","loyalty":"0","reputation":"1950","equipment":{"weapon":"WP18005","armor":"WP1000505","helmet":"WP1026005"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1035","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[78,71,75,65,76,78],"title":-1,"rank":"9","loyalty":"0","reputation":"150","equipment":{"weapon":"WP18005","armor":"WP1000505","helmet":"WP1026005"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":null,"city":"CS1074","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[78,71,75,65,76,78],"title":-1,"rank":"9","loyalty":"99","reputation":"150","equipment":{"weapon":"WP18005","armor":"WP1000505","helmet":"WP1026005"},"couple":[]}],"storyEvents":[],"biography":{"zh":"前仇池国的开国君主。因被舅舅、氐族首领杨飞龙收为养子而改姓杨。西晋元康六年，为躲避齐万年之乱，率部落四千家从略阳重返易守难攻的仇池山根据地。占据仇池后，杨茂搜自号辅国将军、右贤王，被氐族部众拥戴为王，正式建立前仇池国。","tc":"前仇池國的開國君主。因被舅舅、氐族首領楊飛龍收為養子而改姓楊。西晉元康六年，為躲避齊萬年之亂，率部落四千家從略陽重返易守難攻的仇池山根據地。占據仇池后，楊茂搜自號輔國將軍、右賢王，被氐族部眾擁戴為王，正式建立前仇池國。","en":"The founding ruler of Former Chouchi. He adopted the surname Yang after being taken in as an adopted son by his maternal uncle, the Di chieftain Yang Feilong. In the sixth year of Yuankang of Western Jin, to escape the turmoil of Qi Wannian's rebellion, he led four thousand households of his tribe from Lueyang back to the easily defensible stronghold of Mount Chouchi. After securing Chouchi, Yang Maosou assumed the titles of General Who Assists the State and Worthy Prince of the Right, and was acclaimed king by his Di followers, formally establishing Former Chouchi.","jp":"前仇池国の開国君主。母方の叔父である氐族の首領・楊飛龍の養子となったことで楊姓に改めた。西晋の元康六年、斉万年の乱を避けるため、部族四千家を率いて略陽から要害の地・仇池山の根拠地へと戻った。仇池を占拠した後、楊茂搜は輔国将軍・右賢王を自称し、氐族の衆に推戴されて王となり、正式に前仇池国を建てた。","kr":"전구지국의 개국 군주입니다. 외숙이자 저족 우두머리인 양비룡의 양자로 입적되며 양씨로 성을 고쳤습니다. 서진 원강 6년, 제만년의 난을 피해 부락 4천 가구를 이끌고 약양에서 험준한 요새인 구지산 근거지로 되돌아갔습니다. 구지를 점령한 뒤 양무수는 보국장군과 우현왕을 자칭하였고, 저족 무리에게 왕으로 추대받아 정식으로 전구지국을 건국했습니다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ1048115","remark":"普武","surname":"杨","surnameTc":"楊","surnameEn":"Yang","surnameJp":"楊","surnameKr":"양","surnameOther":"","name":"茂搜","nameTc":"茂搜","nameEn":"Maosou","nameJp":"茂捜","nameKr":"무수","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"杨茂搜","power":"","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"2","workYear":"184","city":"CS1035","gender":"0","rule":"78","force":"71","wise":"75","politics":"65","charm":"76","will":"78","ruleTalent":"7","forceTalent":"8","wiseTalent":"9","politicsTalent":"4","charmTalent":"9","willTalent":"8","weaponMaster":"29/29/30/37/71/36/33/39","battleAttribute":"1/1/1/1/1/1/1/1","deba