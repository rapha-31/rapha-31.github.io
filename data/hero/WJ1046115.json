1305","helmet":"WP1023705","horse":"WP1001015"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1076","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[72,65,75,65,70,75],"title":1,"rank":"1","loyalty":"100","reputation":"6600","equipment":{"weapon":"WP1006702","armor":"WP1001305","helmet":"WP1023705","horse":"WP1001015"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1076","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[72,65,75,65,70,75],"title":-1,"rank":"9","loyalty":"0","reputation":"3400","equipment":{"weapon":"WP1006702","armor":"WP1001305","helmet":"WP1023705","horse":"WP1001015"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":null,"city":"CS1076","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[72,65,75,65,70,75],"title":-1,"rank":"9","loyalty":"100","reputation":"3400","equipment":{"weapon":"WP1006702","armor":"WP1001305","helmet":"WP1023705","horse":"WP1001015"},"couple":[]}],"storyEvents":[],"biography":{"zh":"三国时期鲜卑族首领，慕容鲜卑及十六国时期多个燕国的始祖。曹魏初年率部从塞外迁至辽西（今辽宁西部）。景初二年，莫护跋抓住机会追随曹魏司马懿讨伐割据辽东的公孙渊，立下战功。因战功被曹魏封为率义王，获准在棘城以北（今辽宁北票附近）建立政权，成为慕容鲜卑的第一个政治中心。","tc":"三國時期鮮卑族首領，慕容鮮卑及十六國時期多個燕國的始祖。曹魏初年率部從塞外遷至遼西（今遼寧西部）。景初二年，莫護跋抓住機會追隨曹魏司馬懿討伐割據遼東的公孫淵，立下戰功。因戰功被曹魏封為率義王，獲準在棘城以北（今遼寧北票附近）建立政權，成為慕容鮮卑的第一個政治中心。","en":"A Xianbei chieftain during the Three Kingdoms period, and the founding ancestor of the Murong Xianbei as well as several Yan dynasties during the Sixteen Kingdoms. In the early years of Cao Wei, he led his tribe from beyond the frontier to settle in Liaoxi (modern western Liaoning). In the second year of Jingchu, Mohuba seized the opportunity to follow Sima Yi of Cao Wei to subjugate Gongsun Yuan, who held Liaodong, and earned distinction in battle. For his achievements, Cao Wei conferred upon him the title King of Leading Righteousness and permitted him to establish his seat north of Jicheng (near modern Beipiao, Liaoning), which became the first political center of the Murong Xianbei.","jp":"三国時代の鮮卑族の首領。慕容鮮卑および十六国時代の諸燕国の始祖。曹魏の初年に部族を率いて塞外から遼西（現在の遼寧省西部）へと移住した。景初二年、莫護跋は好機を捉えて曹魏の司馬懿に従軍し、遼東に割拠する公孫淵を討伐して戦功を挙げた。その功績により曹魏から率義王に封じられ、棘城の北（現在の遼寧省北票付近）に政権を樹立することを許され、慕容鮮卑の最初の政治的中心地となった。","kr":"삼국 시대 선비족의 수령이자 모용선비 및 십육국 시대 여러 연나라의 시조이다. 조위 초년에 부족을 이끌고 새외에서 요서(현 랴오닝성 서부)로 이주했다. 경초 2년, 모호발은 기회를 포착하여 조위의 사마의를 따라 요동을 할거하던 공손연을 토벌하고 전공을 세웠다. 그 공으로 조위로부터 솔의왕에 봉해졌으며, 극성 이북(현 랴오닝성 베이퍄오 부근)에 정권을 수립하는 것을 허락받아 모용선비의 첫 번째 정치적 중심지를 구축했다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ1046115","remark":"普武","surname":"","surnameTc":"","surnameEn":"","surnameJp":"","surnameKr":"","surnameOther":"","name":"莫护跋","nameTc":"莫護跋","nameEn":"Mohuba","nameJp":"莫護跋","nameKr":"막호발","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"莫护跋","power":"WJ10377","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"2","workYear":"214","city":"CS1076","gender":"0","rule":"72","force":"65","wise":"75","politics":"65","charm":"70","will":"75","ruleTalent":"8","forceTalent":"7","wiseTalent":"9","politicsTalent":"6","charmTalent":"7","willTalent":"6","weaponMaster":"28/33/37/31/65/27/29/27","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"1015202","battleSkill":"","debateCard":"","warSoul":"","battleSoul":"","debateSoul":"","warSoulPoint":"6000","battleSoulPoint":"5300","debateSoulPoint":"5400","strategy":"","strategy2":"1010301;1001005;1001715","professions":"2/3/3/3/0/0/3/0/0/0/3/3/2/1/2/0/3/1/0/0/0/4/4/1","attribute2":"50/50/50/50/50/50","morality":"3","compatible":"32","loyalty":"0","reputation":"3400","evaluate":"1300","title":"","rank":"9","birth":"200",