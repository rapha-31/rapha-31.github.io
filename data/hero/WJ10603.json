":"WP1023105"},"couple":[]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":"WJ10020","city":"CS1060","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[58,45,64,58,24,23],"title":-1,"rank":"5","loyalty":"97","reputation":"3350","equipment":{"weapon":"WP12013","armor":"WP1003105","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":"WJ10020","city":"CS1060","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[58,45,64,58,24,23],"title":-1,"rank":"5","loyalty":"97","reputation":"3350","equipment":{"weapon":"WP12013","armor":"WP1003105","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1060","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[58,45,64,58,24,23],"title":-1,"rank":"9","loyalty":"0","reputation":"2300","equipment":{"weapon":"WP12013","armor":"WP1003105","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10169","city":"CS1060","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[58,45,64,58,24,23],"title":-1,"rank":"9","loyalty":"120","reputation":"2300","equipment":{"weapon":"WP12013","armor":"WP1003105","helmet":"WP1023105"},"couple":[]}],"storyEvents":[],"biography":{"zh":"士壹之子，吴国中郎将。其祖父士赐曾在东汉桓帝时任日南太守，父亲士壹官至偏将军，封都乡侯。其叔父士燮为交趾太守，威望显著，使士氏家族在交州势力庞大。士匡的堂兄士徽在士燮死后，未得孙权正式任命便自称交趾太守，此举引发了东吴中央政权的讨伐。孙权派遣大将吕岱征讨士徽。吕岱与士匡有旧交，于是派遣士匡前去劝降士徽，并承诺保全其性命。士匡成功说服了士徽投降。然而，吕岱为了战功，在士徽投降后仍将其斩杀。士匡也因此受到牵连，被贬为庶人。","tc":"士壹之子，吳國中郎將。其祖父士賜曾在東漢桓帝時任日南太守，父親士壹官至偏將軍，封都鄉侯。其叔父士燮為交趾太守，威望顯著，使士氏家族在交州勢力龐大。士匡的堂兄士徽在士燮死后，未得孫權正式任命便自稱交趾太守，此舉引發了東吳中央政權的討伐。孫權派遣大將呂岱征討士徽。呂岱與士匡有舊交，于是派遣士匡前去勸降士徽，并承諾保全其性命。士匡成功說服了士徽投降。然而，呂岱為了戰功，在士徽投降后仍將其斬殺。士匡也因此受到牽連，被貶為庶人。","en":"The son of Shi Yi and a General of the Household in Wu. His grandfather Shi Ci once served as Governor of Rinan during Emperor Huan's reign in the Eastern Han, and his father Shi Yi held the rank of Lieutenant and was enfeoffed as Marquis of Duxiang. His uncle Shi Xie served as Governor of Jiaozhi and commanded great prestige, making the Shi family immensely powerful in Jiao Province. After Shi Xie's death, Shi Kuang's cousin Shi Hui proclaimed himself Governor of Jiaozhi without Sun Quan's formal appointment, triggering a punitive expedition from the Eastern Wu central government. Sun Quan sent the general Lu Dai to subjugate Shi Hui. Because Lu Dai had an old acquaintance with Shi Kuang, he dispatched Shi Kuang to persuade Shi Hui to surrender, promising to spare his life. Shi Kuang successfully convinced Shi Hui to surrender. However, Lu Dai, seeking military glory, had Shi Hui executed despite his surrender. Shi Kuang was also implicated and demoted to commoner status.","jp":"士壱の子で、呉の中郎将。祖父の士賜は後漢の桓帝の時代に日南太守を務め、父の士壱は官位が偏将軍に至り、都郷侯に封じられた。叔父の士燮は交趾太守として名声高く、士氏の家族は交州で強大な勢力を誇っていた。士匡の従兄弟である士徽は、士燮の死後、孫権による正式な任命を受けぬまま交趾太守を自称したため、東呉の中央政権から討伐を受けることとなった。孫権は大将の呂岱を派遣して士徽を討伐させた。呂岱は士匡と旧交があったため、士匡を遣わして士徽に降伏を促させ、その命を保障すると約束した。士匡は説得に成功して士徽を降伏させたが、呂岱は軍功のために士徽が降伏した後にこれを斬殺した。士匡もこれに連座し、庶人に落とされた。","kr":"사일의 아들이자 오나라의 중랑장입니다. 조부 사사는 동한 환제 시절 일남태수를 지냈고, 아버지 사일은 관직이 편장군에 이르고 도향후에 봉해졌습니다. 숙부 사섭은 교지태수로서 명망이 높아 교주에서 사씨 가문의 세력이 막강했습니다. 사광의 사촌 형 사휘는 사섭이 죽은 뒤 손권의 정식 임명을 받지 못했음에도 스스로 교지태수를 칭했으며, 이는 동오 중앙 정권의 토벌을 불러일으켰습니다. 손권은 대장 여대를 파견하여 사휘를 토벌하게 했습니다. 여대는 사광과 옛 친분이 있었기에 사광을 보내 사휘에게 항복을 권유하며 목숨을 보전해 주겠다고 약속했습니다. 사광은 사휘를 설득하여 항복을 이끌어내는 데 성공했습니다. 그러나 여대는 전공을 탐내어 사휘가 항복한 후에도 끝내 참수했습니다. 사광 또한 이 일에 연루되어 서인으로 강등되었습니다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10603","remark":"","surname":"士","surnameTc":"士","surnameEn":"Shi","surnameJp":"士","surnameKr":"사","surnameOther":"","name":"匡","nameTc":"匡","nameEn":"Kuang","nameJp":"匡","nameKr":"광","nameOther":"","word":"","wordTc":"","wordE