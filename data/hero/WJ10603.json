,{"zh":"征兵","en":"Conscription","value":0},{"zh":"练兵","en":"Drill","value":0},{"zh":"治安","en":"Order","value":0},{"zh":"巡访","en":"Outreach","value":0},{"zh":"城防","en":"Fortification","value":0},{"zh":"探索","en":"Explore","value":1},{"zh":"外交","en":"Diplomacy","value":2},{"zh":"辩才","en":"Eloquence","value":1},{"zh":"潜伏","en":"Stealth","value":1},{"zh":"科研","en":"Research","value":2},{"zh":"医术","en":"Medicine","value":1},{"zh":"酒力","en":"Drinking","value":0},{"zh":"旅游","en":"Travel","value":0},{"zh":"驯兽","en":"Taming","value":0}],"traits":[{"id":0,"level":1},{"id":1,"level":1},{"id":10,"level":1},{"id":26,"level":1},{"id":42,"level":1},{"id":8,"level":1},{"id":19,"level":1}],"values":{"morality":"3","alignment":"0","affinity":"96","loyalty":"0","reputation":"2300","belief":"0"},"officialTitle":null,"officialRank":{"index":9,"name":{"zh":"九品官","en":"Ninth Rank"}},"personalTitles":[],"strategies":[],"warSkills":[],"battleCards":[],"debateCards":[],"warSouls":[],"battleSouls":[],"debateSouls":[],"soulPoints":{"war":3300,"battle":2000,"debate":4000},"equipment":[{"id":"WP12013","name":{"zh":"铁刀","en":"Iron Saber"},"level":"1","description":{"zh":"流传最久、随处可见的经典款式。","en":"The most enduring and ubiquitous classic design."},"atkVal":"5","price":"2000","slot":{"zh":"武器","en":"Weapon"}},{"id":"WP1003105","name":{"zh":"铁札甲·乙","en":"Lamellar Armor - II"},"level":"1","description":{"zh":"历史悠久的甲胄，由于甲片形似书札，故称扎甲。经过几代改良，扎甲既贴身又灵活，因此各地战场皆能看到它的身影。","en":"An ancient armor type named for plates resembling writing slips. Refined over generations, lamellar armor is both form-fitting and flexible, found on battlefields everywhere."},"defenceVal":"6","mp":"180","price":"2500","slot":{"zh":"护甲","en":"Armor"}},{"id":"WP1023105","name":{"zh":"铁胄·甲","en":"Iron Helm - I"},"level":"0","description":{"zh":"最简易的头盔，在士兵与伍长之间最为常见。","en":"The simplest helmet, most common among soldiers and squad leaders."},"defenceVal":"2","price":"800","slot":{"zh":"头盔","en":"Helmet"}}],"family":{"father":{"label":{"zh":"父亲","en":"Father"},"people":[{"id":"WJ10331","code":"0"}]}},"clans":[{"id":"GI106815","name":{"zh":"苍梧士氏","en":"The Shi clan of Cangwu"},"years":["184","226"],"desc":{"zh":"出自姬姓，帝尧之后。士氏世为交州大族。交州割据势力士燮家族，控制交州近四十年，为岭南地区文化保存者。士燮及其三个兄弟共领四郡，占岭南疆土过半。在岭南及越南历史上，士燮威望极高，不在南越王赵佗之下。后越南陈朝追赠士燮善感嘉应灵武大王。","en":"Descended from the Ji surname, lineage of Emperor Yao. The Shi clan was an eminent house of Jiao Province for generations. They were the Family of Shi Xie, an independent warlord Faction who held sway over Jiao Province for nearly four decades and preserved the cultural heritage of the Lingnan region. Shi Xie and his three brothers governed four commanderies among them, encompassing over half the territories of Lingnan. In the histories of Lingnan and Vietnam, Shi Xie enjoyed supreme prestige, rivaling even Zhao Tuo, King of Nanyue. In later centuries, the Trần dynasty of Vietnam posthumously honored Shi Xie as King Shangan Jiaying Lingwu."},"talent":{"military":"5","commerce":"6","politics":"7"}}],"friendGroups":[],"body":null,"honorifics":[],"selfAddress":[],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"25","startPregnantAge":"0"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":null,"city":"CS1060","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[58,45,64,58,24,23],"title":-1,"rank":"9","loyalty":"0","reputation":"2800","equipment":{"weapon":"WP12013","armor":"WP1003105","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S10215","name":{"zh":"汉末三杰","en":"Three Heroes of the Late Han"},"year":"185","month":"3"},"faction":null,"city":"CS1060","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[58,45,64,58,24,23],"title":-1,"rank":"9","loyalty":"0","reputation":"2800","equipment":{"weapon":"WP12013","armor":"WP1003105","helmet":"WP1023105"},"couple":[]},{"story":{"id":"S10615","name":{"zh":"十常侍之乱","en":"Turmoil of the Ten Attendants"},"year