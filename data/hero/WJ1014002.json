"evade":"5","price":"6000","slot":{"zh":"头盔","en":"Helmet"}}],"family":{"father":{"label":{"zh":"父亲","en":"Father"},"people":[{"id":"WJ10031","code":"0"}]}},"clans":[{"id":"GI100715","name":{"zh":"沛国曹氏","en":"The Cao clan of Pei"},"years":["0","265"],"desc":{"zh":"出自姬姓，周文王之子曹叔振铎后裔，沛国谯郡顶级望族。曹魏皇族，曹操统一北方，曹丕代汉建魏。与夏侯氏世代联姻，构成曹魏政权核心。高平陵之变后，曹氏皇权逐渐为司马氏架空并最终被其取代。","en":"Originating from the Ji clan, descendants of Cao Shu Zhenduo, son of King Wen of Zhou, and a premier prominent clan of Qiao in the State of Pei. The imperial house of Cao Wei, Cao Cao unified the North, and Cao Pi replaced Han to establish Wei. Bound by generations of intermarriage with the Xiahou clan, they formed the core of the Cao Wei regime. After the Incident at Gaoping Tombs, the imperial power of the Cao clan was gradually hollowed out by the Sima clan and ultimately usurped."},"talent":{"military":"10","commerce":"5","politics":"8"}}],"friendGroups":[],"body":null,"honorifics":[],"selfAddress":[[["WJ1014002","小女子"],["WJ1014002","小女子"],["WJ1014002","This humble maiden"],["WJ1014002","私め"],["WJ1014002","소녀"]]],"specialNames":[],"vip":{"isVIP":0,"from":"0","to":"0"},"marriage":{"aiMarriageAge":"35","startPregnantAge":"0"},"scenarios":[{"story":{"id":"S10802","name":{"zh":"黄巾起义","en":"Yellow Turban Rebellion"},"year":"184","month":"3"},"faction":null,"city":"CS1026","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[15,8,65,69,89,34],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1008702","armor":"WP1015702","helmet":"WP1013102"},"couple":[]},{"story":{"id":"S10215","name":{"zh":"汉末三杰","en":"Three Heroes of the Late Han"},"year":"185","month":"3"},"faction":null,"city":"CS1026","noRecruit":false,"reject":null,"state":"0","role":0,"stats":[15,8,65,69,89,34],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP1008702","armor":"WP1015702","helmet":"WP1013102"},"couple":[]},{"story":{"id":"S10615","name":{"zh":"十常侍之乱","en":"Turmoil of the