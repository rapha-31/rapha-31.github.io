18","armor":"WP1011102","helmet":"WP1013102","shield":"WP10010"},"couple":["WJ10957"]},{"story":{"id":"S11115","name":{"zh":"五丈原","en":"Wuzhang Plains"},"year":"234","month":"1"},"faction":null,"city":"CS1027","noRecruit":false,"reject":["WJ10127",0],"state":"2","role":0,"stats":[79,77,75,42,86,78],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP10018","armor":"WP1011102","helmet":"WP1013102","shield":"WP10010"},"couple":["WJ10957"]},{"story":{"id":"S10515","name":{"zh":"高平陵之变","en":"Incident at Gaoping Tombs"},"year":"249","month":"1"},"faction":null,"city":"CS1026","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[79,77,75,42,86,78],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP10018","armor":"WP1011102","helmet":"WP1013102","shield":"WP10010"},"couple":["WJ10957"]},{"story":{"id":"S11315","name":{"zh":"西陵之战","en":"Battle of Xiling"},"year":"272","month":"1"},"faction":null,"city":"CS1030","noRecruit":false,"reject":null,"state":"3","role":0,"stats":[79,77,75,42,86,78],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP10018","armor":"WP1011102","helmet":"WP1013102","shield":"WP10010"},"couple":[]},{"story":{"id":"S10108","name":{"zh":"英雄集结","en":"A Gathering of Heroes"},"year":"300","month":"3"},"faction":"WJ10957","city":"CS1030","noRecruit":false,"reject":null,"state":"2","role":0,"stats":[79,77,75,42,86,78],"title":-1,"rank":"9","loyalty":"100","reputation":"0","equipment":{"weapon":"WP10018","armor":"WP1011102","helmet":"WP1013102","shield":"WP10010"},"couple":[]}],"storyEvents":[],"biography":{"zh":"曹操之女，自幼便表现出了对刀枪武艺等事强烈的热爱。建安十八年，曹操以束帛五万匹为聘礼，将曹宪与曹节、曹华一同送入汉宫，初封夫人，次年晋为贵人。曹丕篡汉后，随汉献帝被贬为山阳公夫人。据传在陈留一代曾有人遇到一对喜爱行侠仗义的姐妹，或为曹家姐妹。","tc":"曹操之女，自幼便表現出了對刀槍武藝等事強烈的熱愛。建安十八年，曹操以束帛五萬匹為聘禮，將曹憲與曹節、曹華一同送入漢宮，初封夫人，次年晉為貴人。曹丕篡漢后，隨漢獻帝被貶為山陽公夫人。據傳在陳留一代曾有人遇到一對喜愛行俠仗義的姐妹，或為曹家姐妹。","en":"A daughter of Cao Cao who displayed from a young age a passionate love for martial arts, especially the saber and spear. In the eighteenth year of Jianan, Cao Cao offered fifty thousand bolts of bundled silk as a betrothal gift, sending Cao Xian into the Han imperial palace alongside Cao Jie and Cao Hua. Initially titled Lady, she was promoted to Noble Lady the following year. After Cao Pi usurped the Han throne, she accompanied Emperor Xian of Han upon his demotion to Lady of Shanyang. Legend has it that in the region of Chenliu, some encountered a pair of sisters who loved performing chivalrous deeds, who may well have been the Cao sisters.","jp":"曹操の娘。幼少より刀槍の武芸などに強い熱意を示していた。建安十八年、曹操は束帛五万匹を結納の品として、曹憲を曹節や曹華とともに漢の後宮へ入内させた。初めは夫人に封じられ、翌年に貴人へと進んだ。曹丕が漢を簒奪した後は、献帝に従って山陽公夫人に降格された。陳留一帯で義侠の行いを好む姉妹を見かけた者がいると伝えられており、あるいは曹家の姉妹であったのかもしれない。","kr":"조조의 딸로, 어려서부터 도창과 무예 등에 남다른 열정을 보였습니다. 건안 18년, 조조가 비단 5만 필을 예물로 삼아 조헌을 조절, 조화와 함께 한실 궁궐에 들여보냈으며, 처음에는 부인에 봉해졌다가 이듬해 귀인으로 승봉되었습니다. 조비가 한나라를 찬탈한 후에는 한 헌제를 따라 산양공 부인으로 강등되었습니다. 전하는 바에 따르면 진류 일대에서 협행을 즐기는 자매를 만났다는 이야기가 있는데, 어쩌면 조씨 가문의 자매들이었을지도 모릅니다."},"notRecommended":{"type":"0","year":"999","reason":{"zh":"","tc":"","en":"","jp":"","kr":""}},"raw":{"userIndex":"15","id":"WJ10968","remark":"","surname":"曹","surnameTc":"曹","surnameEn":"Cao","surnameJp":"曹","surnameKr":"조","surnameOther":"","name":"宪","nameTc":"憲","nameEn":"Xian","nameJp":"憲","nameKr":"헌","nameOther":"","word":"","wordTc":"","wordEn":"","wordJp":"","wordKr":"","wordOther":"","icon":"曹宪","power":"WJ10001","rejectPower":"","rejectDuration":"0","ignoreUnRecruit":"0","ignoreUnSelectable":"0","unSelectable":"0","recruit":"1","travel":"0","state":"0","workYear":"213","city":"CS1030","gender":"1","rule":"79","force":"77","wise":"75","politics":"42","charm":"86","will":"78","ruleTalent":"10","forceTalent":"10","wiseTalent":"9","politicsTalent":"5","charmTalent":"11","willTalent":"10","weaponMaster":"25/25/83/25/25/18/78/25","battleAttribute":"1/1/1/1/1/1/1/1","debateAttribute":"1/1/1","warSkill":"1009102;1002702","battleSkill":"","debateCard":"","warSoul":"S1000105;S1002205","battle