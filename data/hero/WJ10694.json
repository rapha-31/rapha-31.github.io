3년(271년) 교지를 함락하고 진나라 장수 모경을 사로잡아 참수하여 구진, 일남 등의 군을 수복했다. 이 전투를 통해 교주가 다시 동오의 판도로 편입되었으니, 이는 손호 치세에 거둔 보기 드문 중대한 군사적 승리였다. 설후는 이 공으로 도향후에 봉해졌으나, 개선하던 도중 병으로 사망했다.","descriptionOther":"","noRecommendType":"0","noRecommendYear":"999","noRecommendReson":"","noRecommendResonTc":"","noRecommendResonEn":"","noRecommendResonJp":"","noRecommendResonKr":"","noRecommendResonOther":"","aiMarriageAge":"25","startPregnantAge":"0","toneJp":"0","isSpecialTone":"0"}}